# Binary search: the smallest program most people write to evaluate a new
# language, and the one #1128 was filed about because it did not run.
#
# The loop is what changed. `while` is now a Stage 2 Core statement, so an
# iterative scan over an indexed `List[Int]` executes rather than stopping at
# `E2S10`.
#
# Two spellings here are narrower than the language reads, and both are
# boundaries rather than style:
#
#   - the miss branch nests `else { if ... }` instead of `else if`, because
#     chained `else if` is not yet a Core form;
#   - `main` binds `data` before passing it, because a `List[Int]` literal is
#     refused as a call argument.
#
# Neither has anything to do with looping; both reproduce with no loop present.

fn binary_search(values: List[Int], target: Int) -> Int {
    let mut left = 0
    let mut right = len(values) - 1

    while left <= right {
        let middle = left + (right - left) // 2
        let value = values[middle]
        if value == target {
            return middle
        } else {
            if value < target {
                left = middle + 1
            } else {
                right = middle - 1
            }
        }
    }
    return -1
}

fn main() {
    let data = [1, 3, 5, 7, 9, 11]
    print(binary_search(data, 7))
    print(binary_search(data, 1))
    print(binary_search(data, 11))
    print(binary_search(data, 4))
}
