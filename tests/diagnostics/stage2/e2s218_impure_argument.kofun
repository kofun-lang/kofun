# diagnostic-mode: compile
# expect-code: E2S218
# expect-span: byte 253
fn noisy(x: Int) -> Int {
    print(x)
    return x
}

fn apply_pure(f: pure (Int) -> Int, x: Int) -> Int {
    return f(x)
}

pure fn quiet(x: Int) -> Int {
    return apply_pure(noisy, x)
}

fn main() -> Int {
    return 0
}
