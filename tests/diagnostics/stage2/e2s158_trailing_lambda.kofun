# diagnostic-mode: compile
# expect-code: E2S158
# expect-span: byte 1067
# A block-bodied lambda outside the trailing position (#1398). The trailing
# position is admitted — `spec/grammar.ebnf` derives `trailing_block_lambda`
# and the call-arguments gate executes it — and this spelling is not that
# position.
#
# The span is the `fn` that opens the lambda, not the binding it initializes,
# because that is the token the author would move to make the program compile
# today.
#
# Refusing by name matters more here than for a shape nobody can write. Before
# #1398 this shape made `lambda_parameters_end` span to -1 and the parameter
# never bound, so the author was told `value` was an unknown lexical binding —
# the parameter of their own lambda, a symbol they did not write. Spanning the
# block body fixed the span and would have moved that accident to a different
# token rather than removing it; naming the position is what removes it.
fn apply(value: Int, action: Int -> Int) -> Int {
    return action(value)
}

fn main() -> Int {
    let double = fn(value: Int) {
        return value * 2
    }
    print(apply(1) fn(x: Int) => double(x))
    return 0
}
