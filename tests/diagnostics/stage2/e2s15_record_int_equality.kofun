# diagnostic-mode: compile
# expect-code: E2S15
# expect-span: byte 275
# #1658. A record against an Int is refused by the record operand, on
# either side of the operator.
type Point = { x: Int }
fn main() -> Int {
    let a: Point = Point(x: 1)
    let b: Int = 1
    if a == b {
        return 1
    }
    return 0
}
