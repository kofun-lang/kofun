# v1 has one scope, not a tree of them. A `par` inside a `par` block is refused
# where the inner one starts, so the reader is not left to infer that nesting
# was merely unimplemented along with everything else.
fn main() {
    par |outer| {
        par |inner| {
            let x = 1
        }
    }
}
