# diagnostic-mode: compile
# expect-code: E2S15
# expect-span: byte 406
# #1658. Records define no equality (spec/records-v1.md), and the C11
# lowering declares every non-Text comparison operand `int64_t`, so this
# reached the host C compiler after `check` accepted it.
type Point = { x: Int, y: Int }
fn main() -> Int {
    let a: Point = Point(x: 1, y: 2)
    let b: Point = Point(x: 1, y: 2)
    if a == b {
        return 1
    }
    return 0
}
