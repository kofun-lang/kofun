# The program #1128 was filed about: a plain binary search over a borrowed
# List[Int], iterative rather than recursive.

fn binary_search(values: List[Int], target: Int) -> Int {
    let mut left = 0
    let mut right = len(values) - 1

    while left <= right {
        let middle = left + (right - left) // 2
        let value = values[middle]
        if value == target {
            return middle
        } else {
            if value < target {
                left = middle + 1
            } else {
                right = middle - 1
            }
        }
    }
    return -1
}

fn main() {
    let data = [1, 3, 5, 7, 9, 11]
    print(binary_search(data, 1))
    print(binary_search(data, 7))
    print(binary_search(data, 11))
    print(binary_search(data, 4))
    print(binary_search(data, 0))
}
