# Chain shapes (#1174): a ladder with a trailing else, a chain without one,
# a chain whose links return rather than assign, and a chain nested in a loop.

fn grade(score: Int) -> Int {
    let mut g = 0
    if score >= 90 {
        g = 4
    } else if score >= 80 {
        g = 3
    } else if score >= 70 {
        g = 2
    } else if score >= 60 {
        g = 1
    } else {
        g = 0
    }
    return g
}

# No trailing else: falling off the end leaves the initial value.
fn code(n: Int) -> Int {
    let mut r = -1
    if n == 1 {
        r = 10
    } else if n == 2 {
        r = 20
    }
    return r
}

# Links that return, with the chain not the final statement.
fn classify(n: Int) -> Int {
    if n < 0 {
        return -1
    } else if n == 0 {
        return 0
    } else if n < 10 {
        return 1
    }
    return 2
}

fn main() {
    print(grade(95))
    print(grade(85))
    print(grade(75))
    print(grade(65))
    print(grade(10))
    print(code(1))
    print(code(2))
    print(code(9))
    print(classify(-5))
    print(classify(0))
    print(classify(5))
    print(classify(50))
    let mut i = 0
    while i < 4 {
        if i == 0 {
            print(100)
        } else if i == 1 {
            print(200)
        } else if i == 2 {
            print(300)
        } else {
            print(400)
        }
        i = i + 1
    }
}
