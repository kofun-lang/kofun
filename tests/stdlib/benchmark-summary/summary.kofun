# Deterministic benchmark-summary witness for issues #859 and #1320.
#
# The gate prepends the production benchmark-report summary helpers. Keep this original
# eight-observation golden while exercising its shared segmented summaries;
# the former Samples8 sorting network and duplicate summary builder are gone.

fn main() {
    # Intentionally unsorted. Ascending order is 3, 7, 11, 17, 19, 23, 29, 41.
    let samples0: List[Int] = [41, 7, 19, 3, 23, 11, 29, 17]
    let samples1: List[Int] = []
    let summary: ReportSummary = summarize_segments(samples0, samples1)

    print(summary.minimum)
    print(summary.maximum)
    print(summary.median)
    print(summary.p25)
    print(summary.p75)
    print(summary.median_absolute_deviation)
}
