# Deterministic benchmark-summary evidence for issue #859.
#
# This small record regression retains a successful complete typed-sidecar
# projection that the full report model exceeds. It uses eight scaled integer
# observations and is not the public benchmark API. The production report
# path is certified by task benchmark-report. Sorting and all six summaries
# remain source-computed here for the original regression.

type Samples8 = {
    sample0: Int,
    sample1: Int,
    sample2: Int,
    sample3: Int,
    sample4: Int,
    sample5: Int,
    sample6: Int,
    sample7: Int,
}

type BenchmarkSummary = {
    minimum: Int,
    maximum: Int,
    median: Int,
    p25: Int,
    p75: Int,
    median_absolute_deviation: Int,
}

# A 19-comparator sorting network. Its control flow and comparison count are
# independent of sample values, so replaying one report cannot choose a
# different ordering path.
fn sort_samples(samples: Samples8) -> Samples8 {
    let mut a0 = samples.sample0
    let mut a1 = samples.sample1
    let mut a2 = samples.sample2
    let mut a3 = samples.sample3
    let mut a4 = samples.sample4
    let mut a5 = samples.sample5
    let mut a6 = samples.sample6
    let mut a7 = samples.sample7

    if a0 > a1 {
        let temporary = a0
        a0 = a1
        a1 = temporary
    }
    if a2 > a3 {
        let temporary = a2
        a2 = a3
        a3 = temporary
    }
    if a4 > a5 {
        let temporary = a4
        a4 = a5
        a5 = temporary
    }
    if a6 > a7 {
        let temporary = a6
        a6 = a7
        a7 = temporary
    }

    if a0 > a2 {
        let temporary = a0
        a0 = a2
        a2 = temporary
    }
    if a1 > a3 {
        let temporary = a1
        a1 = a3
        a3 = temporary
    }
    if a4 > a6 {
        let temporary = a4
        a4 = a6
        a6 = temporary
    }
    if a5 > a7 {
        let temporary = a5
        a5 = a7
        a7 = temporary
    }

    if a1 > a2 {
        let temporary = a1
        a1 = a2
        a2 = temporary
    }
    if a5 > a6 {
        let temporary = a5
        a5 = a6
        a6 = temporary
    }
    if a0 > a4 {
        let temporary = a0
        a0 = a4
        a4 = temporary
    }
    if a3 > a7 {
        let temporary = a3
        a3 = a7
        a7 = temporary
    }

    if a1 > a5 {
        let temporary = a1
        a1 = a5
        a5 = temporary
    }
    if a2 > a6 {
        let temporary = a2
        a2 = a6
        a6 = temporary
    }

    if a1 > a4 {
        let temporary = a1
        a1 = a4
        a4 = temporary
    }
    if a3 > a6 {
        let temporary = a3
        a3 = a6
        a6 = temporary
    }

    if a2 > a4 {
        let temporary = a2
        a2 = a4
        a4 = temporary
    }
    if a3 > a5 {
        let temporary = a3
        a3 = a5
        a5 = temporary
    }

    if a3 > a4 {
        let temporary = a3
        a3 = a4
        a4 = temporary
    }

    let sorted: Samples8 = Samples8(
        sample0: a0,
        sample1: a1,
        sample2: a2,
        sample3: a3,
        sample4: a4,
        sample5: a5,
        sample6: a6,
        sample7: a7
    )
    return sorted
}

fn absolute_distance(value: Int, centre: Int) -> Int {
    if value < centre {
        return centre - value
    }
    return value - centre
}

fn deviations(samples: Samples8, centre: Int) -> Samples8 {
    let result: Samples8 = Samples8(
        sample0: absolute_distance(samples.sample0, centre),
        sample1: absolute_distance(samples.sample1, centre),
        sample2: absolute_distance(samples.sample2, centre),
        sample3: absolute_distance(samples.sample3, centre),
        sample4: absolute_distance(samples.sample4, centre),
        sample5: absolute_distance(samples.sample5, centre),
        sample6: absolute_distance(samples.sample6, centre),
        sample7: absolute_distance(samples.sample7, centre)
    )
    return result
}

fn summarize(samples: Samples8) -> BenchmarkSummary {
    let sorted: Samples8 = sort_samples(samples)

    # Nearest-rank over eight observations is one-based. p25 is rank 2,
    # median is rank 4 (the lower middle), and p75 is rank 6.
    let median = sorted.sample3
    let sorted_deviations: Samples8 = sort_samples(deviations(sorted, median))
    let summary: BenchmarkSummary = BenchmarkSummary(
        minimum: sorted.sample0,
        maximum: sorted.sample7,
        median: median,
        p25: sorted.sample1,
        p75: sorted.sample5,
        median_absolute_deviation: sorted_deviations.sample3
    )
    return summary
}

fn main() {
    # Intentionally unsorted. Ascending order is 3, 7, 11, 17, 19, 23, 29, 41.
    let samples: Samples8 = Samples8(
        sample0: 41,
        sample1: 7,
        sample2: 19,
        sample3: 3,
        sample4: 23,
        sample5: 11,
        sample6: 29,
        sample7: 17
    )
    let summary: BenchmarkSummary = summarize(samples)

    print(summary.minimum)
    print(summary.maximum)
    print(summary.median)
    print(summary.p25)
    print(summary.p75)
    print(summary.median_absolute_deviation)
}
