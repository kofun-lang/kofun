# The #1311 corpus: the inputs the model is exercised on, and the groups the
# gate runs.
#
# `check.sh` concatenates `model.kofun`, this file, and one generated `main`
# per group. The groups exist because the bounded Text arena is a whole-run
# 4096-byte budget that is never reclaimed (#1359): validating four SHA-256
# digests costs 256 bytes of one-byte slices per report, so a single program
# cannot construct every case. Every group is a separate process, and no case
# depends on state from another.
#
# The sample values are one arithmetic pattern with two planted extremes —
# index 5 sits above the upper Tukey fence and index 40 below the lower one —
# so both fence directions are crossed by raw samples rather than by a
# hand-chosen expectation. Raw order is deliberately not ascending.

fn corpus_segment0_64() -> List[Int] {
    let values: List[Int] = [
        1000, 1481, 1962, 1182, 1663, 100000, 1364, 1845,
        1065, 1546, 2027, 1247, 1728, 2209, 1429, 1910,
        1130, 1611, 2092, 1312, 1793, 1013, 1494, 1975,
        1195, 1676, 2157, 1377, 1858, 1078, 1559, 2040,
        1260, 1741, 2222, 1442, 1923, 1143, 1624, 2105,
        1, 1806, 1026, 1507, 1988, 1208, 1689, 2170,
        1390, 1871, 1091, 1572, 2053, 1273, 1754, 2235,
        1455, 1936, 1156, 1637, 2118, 1338, 1819, 1039
    ]
    return values
}

fn corpus_segment0_63() -> List[Int] {
    let values: List[Int] = [
        1000, 1481, 1962, 1182, 1663, 100000, 1364, 1845,
        1065, 1546, 2027, 1247, 1728, 2209, 1429, 1910,
        1130, 1611, 2092, 1312, 1793, 1013, 1494, 1975,
        1195, 1676, 2157, 1377, 1858, 1078, 1559, 2040,
        1260, 1741, 2222, 1442, 1923, 1143, 1624, 2105,
        1, 1806, 1026, 1507, 1988, 1208, 1689, 2170,
        1390, 1871, 1091, 1572, 2053, 1273, 1754, 2235,
        1455, 1936, 1156, 1637, 2118, 1338, 1819
    ]
    return values
}

fn corpus_segment1_36() -> List[Int] {
    let values: List[Int] = [
        1520, 2001, 1221, 1702, 2183, 1403, 1884, 1104,
        1585, 2066, 1286, 1767, 2248, 1468, 1949, 1169,
        1650, 2131, 1351, 1832, 1052, 1533, 2014, 1234,
        1715, 2196, 1416, 1897, 1117, 1598, 2079, 1299,
        1780, 1000, 1481, 1962
    ]
    return values
}

fn corpus_segment1_35() -> List[Int] {
    let values: List[Int] = [
        1520, 2001, 1221, 1702, 2183, 1403, 1884, 1104,
        1585, 2066, 1286, 1767, 2248, 1468, 1949, 1169,
        1650, 2131, 1351, 1832, 1052, 1533, 2014, 1234,
        1715, 2196, 1416, 1897, 1117, 1598, 2079, 1299,
        1780, 1000, 1481
    ]
    return values
}

fn corpus_segment1_1() -> List[Int] {
    let values: List[Int] = [1520]
    return values
}

# Eight samples placed so that both Tukey fences are met exactly.
#
# Sorted, this is 94, 100, 101, 102, 103, 104, 105, 110. At n=8 the nearest
# ranks put p25 at 100 and p75 at 104, so the spread is 4 and three times it is
# 12; the low sample is 2 * (100 - 94) = 12 below and the high one
# 2 * (110 - 104) = 12 above. Equality is not an outlier, so neither is
# flagged — and a model that wrote `>=` would flag both. Without this case the
# fence predicate has no observation that distinguishes the two spellings,
# which is a rule the corpus states and nothing checks.

fn corpus_fence_8() -> List[Int] {
    let values: List[Int] = [110, 100, 94, 103, 101, 105, 102, 104]
    return values
}

fn corpus_identity() -> ReportIdentity {
    let value: ReportIdentity = ReportIdentity(
        suite: "kofun.core",
        case: "list_int_sum",
        parameter_present: true,
        parameter: "n=64",
        metric: "duration",
        direction_tag: 0
    )
    return value
}

fn corpus_schedule(count: Int, cap: Int, sampling_stop_tag: Int) -> ReportSchedule {
    let value: ReportSchedule = ReportSchedule(
        clock_tag: 0,
        warmup_cap_ns: 1000000,
        sampling_cap_ns: 2000000000,
        sample_cap: cap,
        warmup_iterations: 32,
        warmup_stop_tag: 1,
        iterations_per_sample: 8,
        sample_count: count,
        sampling_stop_tag: sampling_stop_tag,
        harness_overhead_ns: 12
    )
    return value
}

fn corpus_counters() -> ReportCounters {
    let value: ReportCounters = ReportCounters(
        allocated_bytes_available: true,
        allocated_bytes_value: 4096,
        allocation_count_available: true,
        allocation_count_value: 0,
        gc_collections_available: false,
        gc_collections_value: 0,
        vm_peak_bytes_available: true,
        vm_peak_bytes_value: 1048576,
        cpu_cycles_available: false,
        cpu_cycles_value: 0
    )
    return value
}

fn corpus_digests() -> ReportDigests {
    let value: ReportDigests = ReportDigests(
        toolchain_sha256: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        source_sha256: "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210",
        artifact_sha256: "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"
    )
    return value
}

fn corpus_host() -> ReportHost {
    let value: ReportHost = ReportHost(
        host_id_sha256: "abcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcd",
        host_os: "linux",
        host_arch: "x86_64",
        host_cpu: "reference",
        host_affinity_available: true,
        host_affinity: "0-3",
        host_frequency_hz_available: false,
        host_frequency_hz: 0,
        host_noise: ""
    )
    return value
}

fn run_case(
    name: Text,
    samples0: List[Int],
    samples1: List[Int],
    cap: Int,
    stop: Int
) -> Int {
    let identity: ReportIdentity = corpus_identity()
    let count = len(samples0) + len(samples1)
    let schedule: ReportSchedule = corpus_schedule(count, cap, stop)
    let counters: ReportCounters = corpus_counters()
    let digests: ReportDigests = corpus_digests()
    let host: ReportHost = corpus_host()
    let report: BenchReport = produce_report(
        identity,
        schedule,
        counters,
        digests,
        host,
        samples0,
        samples1
    )
    return print_case(name, report)
}

# A case whose schedule is deliberately wrong. The samples stay valid, so the
# refusal comes from the stated invariant and not from the series.

fn run_schedule_case(name: Text, cap: Int, count: Int, stop: Int, warmup_cap: Int, warmup_iterations: Int, warmup_stop: Int) -> Int {
    let identity: ReportIdentity = corpus_identity()
    let counters: ReportCounters = corpus_counters()
    let digests: ReportDigests = corpus_digests()
    let host: ReportHost = corpus_host()
    let samples0: List[Int] = [1000, 1481]
    let samples1: List[Int] = []
    let schedule: ReportSchedule = ReportSchedule(
        clock_tag: 0,
        warmup_cap_ns: warmup_cap,
        sampling_cap_ns: 2000000000,
        sample_cap: cap,
        warmup_iterations: warmup_iterations,
        warmup_stop_tag: warmup_stop,
        iterations_per_sample: 8,
        sample_count: count,
        sampling_stop_tag: stop,
        harness_overhead_ns: 12
    )
    let report: BenchReport = produce_report(
        identity,
        schedule,
        counters,
        digests,
        host,
        samples0,
        samples1
    )
    return print_case(name, report)
}

# A Bool is a record field here and never a parameter: a Core parameter is an
# Int, Text, concrete enum, or nominal record. The two Bool-valued refusals
# therefore get one function each rather than a flag argument, which also keeps
# each case's record construction visible in one place.

fn run_identity_case(name: Text, suite: Text) -> Int {
    let counters: ReportCounters = corpus_counters()
    let digests: ReportDigests = corpus_digests()
    let host: ReportHost = corpus_host()
    let samples0: List[Int] = [1000, 1481]
    let samples1: List[Int] = []
    let schedule: ReportSchedule = corpus_schedule(2, 2, 0)
    let identity: ReportIdentity = ReportIdentity(
        suite: suite,
        case: "list_int_sum",
        parameter_present: true,
        parameter: "n=64",
        metric: "duration",
        direction_tag: 0
    )
    let report: BenchReport = produce_report(
        identity,
        schedule,
        counters,
        digests,
        host,
        samples0,
        samples1
    )
    return print_case(name, report)
}

fn run_digest_case(name: Text, toolchain: Text) -> Int {
    let identity: ReportIdentity = corpus_identity()
    let counters: ReportCounters = corpus_counters()
    let host: ReportHost = corpus_host()
    let samples0: List[Int] = [1000, 1481]
    let samples1: List[Int] = []
    let schedule: ReportSchedule = corpus_schedule(2, 2, 0)
    let digests: ReportDigests = ReportDigests(
        toolchain_sha256: toolchain,
        source_sha256: "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210",
        artifact_sha256: "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"
    )
    let report: BenchReport = produce_report(
        identity,
        schedule,
        counters,
        digests,
        host,
        samples0,
        samples1
    )
    return print_case(name, report)
}

fn run_absent_parameter_case(name: Text) -> Int {
    let counters: ReportCounters = corpus_counters()
    let digests: ReportDigests = corpus_digests()
    let host: ReportHost = corpus_host()
    let samples0: List[Int] = [1000, 1481]
    let samples1: List[Int] = []
    let schedule: ReportSchedule = corpus_schedule(2, 2, 0)
    # Absent means empty Text. A present value alongside `false` is two
    # physical encodings of one logical value, which the flat outcome forbids.
    let identity: ReportIdentity = ReportIdentity(
        suite: "kofun.core",
        case: "list_int_sum",
        parameter_present: false,
        parameter: "n=64",
        metric: "duration",
        direction_tag: 0
    )
    let report: BenchReport = produce_report(
        identity,
        schedule,
        counters,
        digests,
        host,
        samples0,
        samples1
    )
    return print_case(name, report)
}

fn run_counter_case(name: Text, value: Int) -> Int {
    let identity: ReportIdentity = corpus_identity()
    let digests: ReportDigests = corpus_digests()
    let host: ReportHost = corpus_host()
    let samples0: List[Int] = [1000, 1481]
    let samples1: List[Int] = []
    let schedule: ReportSchedule = corpus_schedule(2, 2, 0)
    # Unavailable with a number attached: the counter has no value to carry.
    let counters: ReportCounters = ReportCounters(
        allocated_bytes_available: false,
        allocated_bytes_value: value,
        allocation_count_available: true,
        allocation_count_value: 0,
        gc_collections_available: false,
        gc_collections_value: 0,
        vm_peak_bytes_available: true,
        vm_peak_bytes_value: 1048576,
        cpu_cycles_available: false,
        cpu_cycles_value: 0
    )
    let report: BenchReport = produce_report(
        identity,
        schedule,
        counters,
        digests,
        host,
        samples0,
        samples1
    )
    return print_case(name, report)
}

# ------------------------------------------------------------------- groups
#
# Every group is named here rather than in the generated driver, so the driver
# is three lines and the cases stay in the tracked corpus. A group runs in its
# own process; the arena is the reason, and the count each group returns is
# what the golden pins.

fn run_group(group: Int) -> Int {
    let empty: List[Int] = []
    let mut cases = 0

    if group == 0 {
        # The two smallest series, and either side of a full first segment.
        let one: List[Int] = [1000]
        let two: List[Int] = [1000, 1481]
        cases = cases + run_case("n1", one, empty, 1, 0)
        cases = cases + run_case("n2", two, empty, 2, 0)
        let segment0_63: List[Int] = corpus_segment0_63()
        cases = cases + run_case("n63", segment0_63, empty, 63, 0)
        let segment0_64: List[Int] = corpus_segment0_64()
        cases = cases + run_case("n64", segment0_64, empty, 64, 0)
        let fence: List[Int] = corpus_fence_8()
        cases = cases + run_case("fence", fence, empty, 8, 0)
    }

    if group == 1 {
        # Either side of the 100-sample ceiling, and a `time-cap` stop.
        let segment0_64: List[Int] = corpus_segment0_64()
        let segment1_1: List[Int] = corpus_segment1_1()
        cases = cases + run_case("n65", segment0_64, segment1_1, 65, 0)
        let segment1_35: List[Int] = corpus_segment1_35()
        cases = cases + run_case("n99", segment0_64, segment1_35, 99, 0)
        let segment1_36: List[Int] = corpus_segment1_36()
        cases = cases + run_case("n100", segment0_64, segment1_36, 100, 0)
        let segment0_63: List[Int] = corpus_segment0_63()
        cases = cases + run_case("timecap", segment0_63, empty, 64, 1)
    }

    if group == 2 {
        # Series shape: an empty series, a noncanonical split, and a second
        # segment that overflows its own bound is not reachable — a literal
        # cannot exceed the carrier — so the split rule carries that weight.
        cases = cases + run_case("empty", empty, empty, 1, 0)
        let short0: List[Int] = [1000, 1481, 1962]
        let segment1_1: List[Int] = corpus_segment1_1()
        cases = cases + run_case("split", short0, segment1_1, 4, 0)
        # A count that disagrees with the series it describes.
        cases = cases + run_schedule_case("count", 2, 3, 0, 1000000, 32, 1)
        # `sample-cap` with fewer samples than the cap, and `time-cap` with
        # exactly the cap: each is the other's boundary.
        cases = cases + run_schedule_case("capshort", 3, 2, 0, 1000000, 32, 1)
        cases = cases + run_schedule_case("capfull", 2, 2, 1, 1000000, 32, 1)
    }

    if group == 3 {
        # Warmup pairing, identity, digest, and counter availability.
        cases = cases + run_schedule_case("warmzero", 2, 2, 0, 0, 0, 1)
        cases = cases + run_schedule_case("warmiter", 2, 2, 0, 1000000, 0, 1)
        cases = cases + run_identity_case("emptysuite", "")
        cases = cases + run_absent_parameter_case("absentparam")
        cases = cases + run_digest_case("shortdigest", "0123456789abcdef")
        cases = cases + run_digest_case("upperdigest",
            "0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef")
        cases = cases + run_counter_case("counterneutral", 7)
    }

    return cases
}
