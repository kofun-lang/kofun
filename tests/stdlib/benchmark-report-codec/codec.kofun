# Revalidate public model fields before encoding; derived fields are checked,
# never repaired. The model computes summaries over copies of raw samples.
fn codec_report_status(report: BenchReport) -> Int {
    let identity: ReportIdentity = ReportIdentity(
        suite: report.suite,
        case: report.case,
        parameter_present: report.parameter_present,
        parameter: report.parameter,
        metric: report.metric,
        direction_tag: report.direction_tag
    )
    let schedule: ReportSchedule = ReportSchedule(
        clock_tag: report.clock_tag,
        warmup_cap_ns: report.warmup_cap_ns,
        sampling_cap_ns: report.sampling_cap_ns,
        sample_cap: report.sample_cap,
        warmup_iterations: report.warmup_iterations,
        warmup_stop_tag: report.warmup_stop_tag,
        iterations_per_sample: report.iterations_per_sample,
        sample_count: report.sample_count,
        sampling_stop_tag: report.sampling_stop_tag,
        harness_overhead_ns: report.harness_overhead_ns
    )
    let counters: ReportCounters = ReportCounters(
        allocated_bytes_available: report.allocated_bytes_available,
        allocated_bytes_value: report.allocated_bytes_value,
        allocation_count_available: report.allocation_count_available,
        allocation_count_value: report.allocation_count_value,
        gc_collections_available: report.gc_collections_available,
        gc_collections_value: report.gc_collections_value,
        vm_peak_bytes_available: report.vm_peak_bytes_available,
        vm_peak_bytes_value: report.vm_peak_bytes_value,
        cpu_cycles_available: report.cpu_cycles_available,
        cpu_cycles_value: report.cpu_cycles_value
    )
    let digests: ReportDigests = ReportDigests(
        toolchain_sha256: report.toolchain_sha256,
        source_sha256: report.source_sha256,
        artifact_sha256: report.artifact_sha256
    )
    let host: ReportHost = ReportHost(
        host_id_sha256: report.host_id_sha256,
        host_os: report.host_os,
        host_arch: report.host_arch,
        host_cpu: report.host_cpu,
        host_affinity_available: report.host_affinity_available,
        host_affinity: report.host_affinity,
        host_frequency_hz_available: report.host_frequency_hz_available,
        host_frequency_hz: report.host_frequency_hz,
        host_noise: report.host_noise
    )
    let expected: BenchReport = produce_report(identity, schedule, counters, digests, host, report.sample_segment0, report.sample_segment1)
    if expected.status_tag != 0 { return expected.status_tag }
    if report.summary_minimum != expected.summary_minimum { return 6 }
    if report.summary_maximum != expected.summary_maximum { return 6 }
    if report.summary_median != expected.summary_median { return 6 }
    if report.summary_p25 != expected.summary_p25 { return 6 }
    if report.summary_p75 != expected.summary_p75 { return 6 }
    if report.summary_median_absolute_deviation != expected.summary_median_absolute_deviation { return 6 }
    if len(report.outlier_segment0) != len(expected.outlier_segment0) { return 6 }
    let mut index = 0
    while index < len(expected.outlier_segment0) {
        if report.outlier_segment0[index] != expected.outlier_segment0[index] { return 6 }
        index = index + 1
    }
    if len(report.outlier_segment1) != len(expected.outlier_segment1) { return 6 }
    let mut index1 = 0
    while index1 < len(expected.outlier_segment1) {
        if report.outlier_segment1[index1] != expected.outlier_segment1[index1] { return 6 }
        index1 = index1 + 1
    }
    return 0
}

