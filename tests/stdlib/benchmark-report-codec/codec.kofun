fn codec_tag(read source: Bytes, at: Int, choices: Text) -> CodecNumber {
    if codec_byte(source, at) != 34 { let result: CodecNumber = CodecNumber(status: 3, value: 0)
        return result }
    let word = stage2_bytes_empty()
    stage2_bytes_assign_text(word, choices)
    if stage2_bytes_len(word) != len(choices) { let result: CodecNumber = CodecNumber(status: 12, value: 0)
        return result }
    let mut start = 0
    let mut tag = 0
    while start < len(choices) {
