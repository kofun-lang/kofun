        while codec_and(codec_lt(end, len(choices)), codec_ne(codec_byte(word, end), 44)) == 1 { end = end + 1 }
        if codec_key_word(source, at, word, start, end - start) == 1 { let result: CodecNumber = CodecNumber(status: 0, value: tag)
        return result }
        start = end + 1
        tag = tag + 1
    }
    let result: CodecNumber = CodecNumber(status: 3, value: 0)
        return result
}

fn codec_counter(read source: Bytes, read ends: Bytes, at: Int) -> CodecCounter {
    let shape = codec_fields(source, ends, at, "state,value")
    if shape != 0 { let result: CodecCounter = CodecCounter(status: shape, available: false, value: 0)
        return result }
    let state = codec_field(source, ends, at, "state")
    let value = codec_field(source, ends, at, "value")
    if codec_or(codec_eq(state, -12), codec_eq(value, -12)) == 1 { let result: CodecCounter = CodecCounter(status: 12, available: false, value: 0)
        return result }
    let tag: CodecNumber = codec_tag(source, state, "unavailable,available")
    if tag.status != 0 { let result: CodecCounter = CodecCounter(status: tag.status, available: false, value: 0)
        return result }
    if tag.value == 0 {
        if value >= 0 { let result: CodecCounter = CodecCounter(status: 3, available: false, value: 0)
        return result }
        let result: CodecCounter = CodecCounter(status: 0, available: false, value: 0)
        return result
    }
    let integer: CodecNumber = codec_integer(source, ends, value, 0, 9007199254740991)
    if integer.status != 0 { let result: CodecCounter = CodecCounter(status: integer.status, available: false, value: 0)
        return result }
    let result: CodecCounter = CodecCounter(status: 0, available: true, value: integer.value)
        return result
}

fn codec_available_text(read source: Bytes, read ends: Bytes, at: Int) -> CodecAvailableText {
    let shape = codec_fields(source, ends, at, "state,value")
    if shape != 0 { let result: CodecAvailableText = CodecAvailableText(status: shape, available: false, value: "")
        return result }
    let state = codec_field(source, ends, at, "state")
    let value = codec_field(source, ends, at, "value")
    if codec_or(codec_eq(state, -12), codec_eq(value, -12)) == 1 { let result: CodecAvailableText = CodecAvailableText(status: 12, available: false, value: "")
        return result }
    let tag: CodecNumber = codec_tag(source, state, "unavailable,available")
    if tag.status != 0 { let result: CodecAvailableText = CodecAvailableText(status: tag.status, available: false, value: "")
        return result }
    if tag.value == 0 {
        if value >= 0 { let result: CodecAvailableText = CodecAvailableText(status: 3, available: false, value: "")
        return result }
        let result: CodecAvailableText = CodecAvailableText(status: 0, available: false, value: "")
        return result
    }
    let text: CodecText = codec_text(source, value, 128, 0)
    if text.status != 0 { let result: CodecAvailableText = CodecAvailableText(status: text.status, available: false, value: "")
        return result }
    let result: CodecAvailableText = CodecAvailableText(status: 0, available: true, value: text.value)
        return result
}

fn codec_series_error(status: Int) -> CodecSeries {
    let first: List[Int] = []
    let second: List[Int] = []
    let result: CodecSeries = CodecSeries(status: status, first: first, second: second)
        return result
}

fn codec_series(read source: Bytes, read ends: Bytes, at: Int, flags: Int) -> CodecSeries {
    if codec_byte(source, at) != 91 { return codec_series_error(3) }
    let mut cursor = codec_space(source, at + 1)
    let mut count = 0
    while codec_byte(source, cursor) != 93 {
        count = count + 1
        cursor = codec_space(source, codec_end(ends, cursor))
        if codec_byte(source, cursor) == 44 { cursor = codec_space(source, cursor + 1) }
    }
    if count > 100 { return codec_series_error(4) }
    let mut first_count = count
    if first_count > 64 { first_count = 64 }
    let mut first: List[Int] = codec_zero_segment(first_count)
    let mut second: List[Int] = codec_zero_segment(count - first_count)
    cursor = codec_space(source, at + 1)
    let mut index = 0
    let mut status = 0
    while index < count {
        let mut value = 0
        if flags == 0 {
            let integer: CodecNumber = codec_integer(source, ends, cursor, 0, 9007199254740991)
            status = first_failure(status, integer.status)
            value = integer.value
        } else {
            let byte = codec_byte(source, cursor)
            if byte == 116 { value = 1 } else {
                if byte != 102 { status = first_failure(status, 3) }
            }
        }
        if index < 64 { first[index] = value } else { second[index - 64] = value }
        index = index + 1
        cursor = codec_space(source, codec_end(ends, cursor))
        if codec_byte(source, cursor) == 44 { cursor = codec_space(source, cursor + 1) }
    }
    if status != 0 { return codec_series_error(status) }
    let result: CodecSeries = CodecSeries(status: 0, first: first, second: second)
        return result
}

