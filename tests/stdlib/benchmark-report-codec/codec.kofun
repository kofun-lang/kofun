# Integer predicates fit the current Stage 2 executable condition profile.
# Operands here are total bounded byte/scalar observations.
fn codec_or(left: Int, right: Int) -> Int {
    if left != 0 { return 1 }
    return right
}
fn codec_and(left: Int, right: Int) -> Int {
    if left == 0 { return 0 }
    return right
}
fn codec_eq(left: Int, right: Int) -> Int {
    if left == right { return 1 }
    return 0
}
fn codec_ne(left: Int, right: Int) -> Int {
    if left != right { return 1 }
    return 0
}
fn codec_ge(left: Int, right: Int) -> Int {
    if left >= right { return 1 }
    return 0
}
fn codec_le(left: Int, right: Int) -> Int {
    if left <= right { return 1 }
    return 0
}
fn codec_gt(left: Int, right: Int) -> Int {
    if left > right { return 1 }
    return 0
}
fn codec_lt(left: Int, right: Int) -> Int {
    if left < right { return 1 }
    return 0
}

# Pure bounded benchmark-report/v1 codec (#1312).
# Concatenate with ../benchmark-report-model/model.kofun on C11 Stage 2.
# The scanner retains byte offsets, never Text slices or borrowed views.

type CodecScalar = { next: Int, value: Int }
type CodecNumber = { status: Int, value: Int }

fn codec_byte(read source: Bytes, at: Int) -> Int {
    if codec_lt(at, 0) == 1 { return -1 }
    if codec_ge(at, stage2_bytes_len(source)) == 1 { return -1 }
    return stage2_bytes_byte_at(source, at)
}

fn codec_space(read source: Bytes, start: Int) -> Int {
    let mut at = start
    let mut more = 1
    while codec_eq(more, 1) == 1 {
        let byte = codec_byte(source, at)
        if codec_or(codec_eq(byte, 32), codec_or(codec_eq(byte, 9), codec_or(codec_eq(byte, 10), codec_eq(byte, 13)))) == 1 {
            at = at + 1
        } else { more = 0 }
    }
    return at
}

fn codec_digit(byte: Int) -> Int { return codec_and(codec_ge(byte, 48), codec_le(byte, 57)) }

fn codec_hex(byte: Int) -> Int {
    if codec_and(codec_ge(byte, 48), codec_le(byte, 57)) == 1 { return byte - 48 }
    if codec_and(codec_ge(byte, 65), codec_le(byte, 70)) == 1 { return byte - 55 }
    if codec_and(codec_ge(byte, 97), codec_le(byte, 102)) == 1 { return byte - 87 }
    return -1
}

fn codec_hex4(read source: Bytes, at: Int) -> Int {
    let mut value = 0
    let mut i = 0
    while codec_lt(i, 4) == 1 {
        let digit = codec_hex(codec_byte(source, at + i))
        if codec_lt(digit, 0) == 1 { return -1 }
        value = value * 16 + digit
        i = i + 1
    }
    return value
}

# Invalid UTF-8 is BR001, even in a document that also exceeds depth 16.
fn codec_utf8(read source: Bytes) -> Int {
    let mut at = 0
    while codec_lt(at, stage2_bytes_len(source)) == 1 {
        let first = codec_byte(source, at)
        let mut count = 1
        let mut scalar = first
        let mut minimum = 0
        if codec_ge(first, 128) == 1 {
            if codec_and(codec_ge(first, 194), codec_le(first, 223)) == 1 {
                count = 2
                scalar = first - 192
                minimum = 128
            } else {
                if codec_and(codec_ge(first, 224), codec_le(first, 239)) == 1 {
                    count = 3
                    scalar = first - 224
                    minimum = 2048
                } else {
                    if codec_and(codec_ge(first, 240), codec_le(first, 244)) == 1 {
                        count = 4
                        scalar = first - 240
                        minimum = 65536
                    } else { return 1 }
                }
            }
            let mut i = 1
            while codec_lt(i, count) == 1 {
                let byte = codec_byte(source, at + i)
                if codec_or(codec_lt(byte, 128), codec_gt(byte, 191)) == 1 { return 1 }
                scalar = scalar * 64 + byte - 128
                i = i + 1
            }
            if codec_or(codec_lt(scalar, minimum), codec_gt(scalar, 1114111)) == 1 { return 1 }
            if codec_and(codec_ge(scalar, 55296), codec_le(scalar, 57343)) == 1 { return 1 }
        }
        at = at + count
    }
    return 0
}

# JSON itself permits escaped unpaired surrogates. Preserve them here so the
# identity policy reports BR005 only after the whole syntax/depth/key pass.
fn codec_scalar(read source: Bytes, at: Int) -> CodecScalar {
    let byte = codec_byte(source, at)
    let mut next = at + 1
    let mut value = byte
    if codec_eq(byte, 92) == 1 {
        let escape = codec_byte(source, next)
        next = next + 1
        value = -1
        if codec_or(codec_eq(escape, 34), codec_or(codec_eq(escape, 92), codec_eq(escape, 47))) == 1 { value = escape }
        if codec_eq(escape, 98) == 1 { value = 8 }
        if codec_eq(escape, 102) == 1 { value = 12 }
        if codec_eq(escape, 110) == 1 { value = 10 }
        if codec_eq(escape, 114) == 1 { value = 13 }
        if codec_eq(escape, 116) == 1 { value = 9 }
        if codec_eq(escape, 117) == 1 {
            value = codec_hex4(source, next)
            next = next + 4
            if codec_and(codec_ge(value, 55296), codec_le(value, 56319)) == 1 {
                if codec_and(codec_eq(codec_byte(source, next), 92), codec_eq(codec_byte(source, next + 1), 117)) == 1 {
                    let low = codec_hex4(source, next + 2)
                    if codec_and(codec_ge(low, 56320), codec_le(low, 57343)) == 1 {
                        value = 65536 + (value - 55296) * 1024 + low - 56320
                        next = next + 6
                    }
                }
            }
        }
    } else {
        if codec_ge(byte, 128) == 1 {
            let mut count = 2
            value = byte - 192
            if codec_ge(byte, 224) == 1 { count = 3
                value = byte - 224 }
            if codec_ge(byte, 240) == 1 { count = 4
                value = byte - 240 }
            let mut i = 1
            while codec_lt(i, count) == 1 {
                value = value * 64 + codec_byte(source, at + i) - 128
                i = i + 1
            }
            next = at + count
        }
    }
    let result: CodecScalar = CodecScalar(next: next, value: value)
    return result
}

fn codec_string_end(read source: Bytes, start: Int) -> Int {
    let mut at = start + 1
    while codec_lt(at, stage2_bytes_len(source)) == 1 {
        let byte = codec_byte(source, at)
        if codec_eq(byte, 34) == 1 { return at + 1 }
        if codec_lt(byte, 32) == 1 { return -1 }
        let scalar: CodecScalar = codec_scalar(source, at)
        if codec_lt(scalar.value, 0) == 1 { return -1 }
        at = scalar.next
    }
    return -1
}

fn codec_number_end(read source: Bytes, start: Int) -> Int {
    let mut at = start
    if codec_eq(codec_byte(source, at), 45) == 1 { at = at + 1 }
    if codec_eq(codec_byte(source, at), 48) == 1 {
        at = at + 1
    } else {
        if codec_eq(codec_digit(codec_byte(source, at)), 0) == 1 { return -1 }
        while codec_digit(codec_byte(source, at)) == 1 { at = at + 1 }
    }
    if codec_eq(codec_byte(source, at), 46) == 1 {
        at = at + 1
        if codec_eq(codec_digit(codec_byte(source, at)), 0) == 1 { return -1 }
        while codec_digit(codec_byte(source, at)) == 1 { at = at + 1 }
    }
    let exponent = codec_byte(source, at)
    if codec_or(codec_eq(exponent, 69), codec_eq(exponent, 101)) == 1 {
        at = at + 1
        let sign = codec_byte(source, at)
        if codec_or(codec_eq(sign, 43), codec_eq(sign, 45)) == 1 { at = at + 1 }
        if codec_eq(codec_digit(codec_byte(source, at)), 0) == 1 { return -1 }
        while codec_digit(codec_byte(source, at)) == 1 { at = at + 1 }
    }
    return at
}

fn codec_matches(read source: Bytes, at: Int, read word: Bytes) -> Int {
    let mut i = 0
    while codec_lt(i, stage2_bytes_len(word)) == 1 {
        if codec_ne(codec_byte(source, at + i), codec_byte(word, i)) == 1 { return 0 }
        i = i + 1
    }
    return 1
}

fn codec_literal_end(read source: Bytes, at: Int) -> Int {
    let byte = codec_byte(source, at)
    if codec_eq(byte, 116) == 1 {
        if codec_and(codec_eq(codec_byte(source, at + 1), 114), codec_and(codec_eq(codec_byte(source, at + 2), 117), codec_eq(codec_byte(source, at + 3), 101))) == 1 { return at + 4 }
    }
    if codec_eq(byte, 102) == 1 {
        if codec_and(codec_eq(codec_byte(source, at + 1), 97), codec_and(codec_eq(codec_byte(source, at + 2), 108), codec_and(codec_eq(codec_byte(source, at + 3), 115), codec_eq(codec_byte(source, at + 4), 101)))) == 1 { return at + 5 }
    }
    if codec_eq(byte, 110) == 1 {
        if codec_and(codec_eq(codec_byte(source, at + 1), 117), codec_and(codec_eq(codec_byte(source, at + 2), 108), codec_eq(codec_byte(source, at + 3), 108))) == 1 { return at + 4 }
    }
    return -1
}

fn codec_put16(edit buffer: Bytes, at: Int, value: Int) -> Int {
    stage2_bytes_byte_set(buffer, at, value % 256)
    stage2_bytes_byte_set(buffer, at + 1, value // 256)
    return 0
}

fn codec_get16(read buffer: Bytes, at: Int) -> Int {
    return codec_byte(buffer, at) + codec_byte(buffer, at + 1) * 256
}

fn codec_end(read ends: Bytes, at: Int) -> Int {
    return codec_get16(ends, at * 2)
}

# A byte offset indexes the token's exclusive end. The explicit stack has one
# three-byte slot per possible opener, so even near-wire-limit nesting cannot
# recurse on the host stack. Syntax is completed before depth is reported.
fn codec_scan(read source: Bytes, edit ends: Bytes) -> Int {
    let length = stage2_bytes_len(source)
    if codec_gt(length, 16384) == 1 { return 4 }
    if codec_and(codec_eq(codec_byte(source, 0), 239), codec_and(codec_eq(codec_byte(source, 1), 187), codec_eq(codec_byte(source, 2), 191))) == 1 { return 1 }
    if codec_ne(codec_utf8(source), 0) == 1 { return 1 }
    if codec_eq(length, 0) == 1 { return 1 }
    stage2_bytes_assign_zeroed(ends, length * 2)
    if codec_ne(stage2_bytes_len(ends), length * 2) == 1 { return 12 }
    let stack = stage2_bytes_empty()
    stage2_bytes_assign_zeroed(stack, length * 3)
    if codec_ne(stage2_bytes_len(stack), length * 3) == 1 { return 12 }
    let mut at = codec_space(source, 0)
    let mut depth = 0
    let mut maximum = 0
    let mut root_done = 0
    let mut done = 0
    while codec_eq(done, 0) == 1 {
        at = codec_space(source, at)
        let byte = codec_byte(source, at)
        let mut value = 0
        if codec_eq(depth, 0) == 1 {
            if codec_eq(root_done, 1) == 1 { done = 1 } else {
                value = 1
                root_done = 1
            }
        } else {
            let slot = (depth - 1) * 3
            let state = codec_byte(stack, slot + 2)
            let mut close = 0
            if codec_or(codec_eq(state, 0), codec_eq(state, 1)) == 1 {
                if codec_and(codec_eq(state, 0), codec_eq(byte, 93)) == 1 { close = 1 } else {
                    value = 1
                    stage2_bytes_byte_set(stack, slot + 2, 2)
                }
            }
            if codec_or(codec_eq(state, 2), codec_eq(state, 7)) == 1 {
                let mut delimiter = 93
                let mut following = 1
                if codec_eq(state, 7) == 1 { delimiter = 125
                following = 4 }
                if codec_eq(byte, delimiter) == 1 { close = 1 } else {
                    if codec_ne(byte, 44) == 1 { return 1 }
                    stage2_bytes_byte_set(stack, slot + 2, following)
                    at = at + 1
                }
            }
            if codec_or(codec_eq(state, 3), codec_eq(state, 4)) == 1 {
                if codec_and(codec_eq(state, 3), codec_eq(byte, 125)) == 1 { close = 1 } else {
                    if codec_ne(byte, 34) == 1 { return 1 }
                    let end = codec_string_end(source, at)
                    if codec_lt(end, 0) == 1 { return 1 }
                    codec_put16(ends, at * 2, end)
                    at = end
                    stage2_bytes_byte_set(stack, slot + 2, 5)
                }
            }
            if codec_eq(state, 5) == 1 {
                if codec_ne(byte, 58) == 1 { return 1 }
                at = at + 1
                stage2_bytes_byte_set(stack, slot + 2, 6)
            }
            if codec_eq(state, 6) == 1 {
                value = 1
                stage2_bytes_byte_set(stack, slot + 2, 7)
            }
            if codec_eq(close, 1) == 1 {
                let open = codec_get16(stack, slot)
                codec_put16(ends, open * 2, at + 1)
                at = at + 1
                depth = depth - 1
            }
        }
        if codec_eq(value, 1) == 1 {
            if codec_or(codec_eq(byte, 123), codec_eq(byte, 91)) == 1 {
                codec_put16(stack, depth * 3, at)
                let mut state = 0
                if codec_eq(byte, 123) == 1 { state = 3 }
                stage2_bytes_byte_set(stack, depth * 3 + 2, state)
                depth = depth + 1
                if codec_gt(depth, maximum) == 1 { maximum = depth }
                at = at + 1
            } else {
                let mut end = -1
                if codec_eq(byte, 34) == 1 { end = codec_string_end(source, at) } else {
                    if codec_or(codec_eq(byte, 45), codec_digit(byte)) == 1 {
                        end = codec_number_end(source, at)
                    } else { end = codec_literal_end(source, at) }
                }
                if codec_lt(end, 0) == 1 { return 1 }
                codec_put16(ends, at * 2, end)
                at = end
            }
        }
    }
    if codec_ne(at, length) == 1 { return 1 }
    if codec_gt(maximum, 17) == 1 { return 4 }
    return 0
}

fn codec_key_equal(read source: Bytes, left: Int, right: Int) -> Int {
    let mut a = left + 1
    let mut b = right + 1
    while codec_and(codec_ne(codec_byte(source, a), 34), codec_ne(codec_byte(source, b), 34)) == 1 {
        let first: CodecScalar = codec_scalar(source, a)
        let second: CodecScalar = codec_scalar(source, b)
        if codec_ne(first.value, second.value) == 1 { return 0 }
        a = first.next
        b = second.next
    }
    return codec_eq(codec_byte(source, a), codec_byte(source, b))
}

fn codec_value_at(read source: Bytes, read ends: Bytes, key: Int) -> Int {
    return codec_space(source, codec_space(source, codec_end(ends, key)) + 1)
}

fn codec_next_key(read source: Bytes, read ends: Bytes, key: Int) -> Int {
    let value = codec_value_at(source, ends, key)
    let after = codec_space(source, codec_end(ends, value))
    if codec_eq(codec_byte(source, after), 125) == 1 { return -1 }
    return codec_space(source, after + 1)
}

fn codec_duplicates(read source: Bytes, read ends: Bytes) -> Int {
    let mut at = 0
    while codec_lt(at, stage2_bytes_len(source)) == 1 {
        # Only token starts have an end; braces inside strings are not tokens.
        if codec_and(codec_eq(codec_byte(source, at), 123), codec_gt(codec_end(ends, at), 0)) == 1 {
            let mut key = codec_space(source, at + 1)
            if codec_eq(codec_byte(source, key), 125) == 1 { key = -1 }
            while codec_ge(key, 0) == 1 {
                let mut other = codec_next_key(source, ends, key)
                while codec_ge(other, 0) == 1 {
                    if codec_key_equal(source, key, other) == 1 { return 2 }
                    other = codec_next_key(source, ends, other)
                }
                key = codec_next_key(source, ends, key)
            }
        }
        at = at + 1
    }
    return 0
}

type CodecText = { status: Int, value: Text }
type CodecCounter = { status: Int, available: Bool, value: Int }
type CodecAvailableText = { status: Int, available: Bool, value: Text }
type CodecPresence = { value: Bool }
type CodecSeries = { status: Int, first: List[Int], second: List[Int] }

fn codec_presence(at: Int) -> CodecPresence {
    if at < 0 {
        let result: CodecPresence = CodecPresence(value: false)
        return result
    }
    let result: CodecPresence = CodecPresence(value: true)
    return result
}

fn codec_key_word(read source: Bytes, key: Int, read word: Bytes, start: Int, length: Int) -> Int {
    let mut at = key + 1
    let mut i = 0
    while i < length {
        if codec_byte(source, at) == 34 { return 0 }
        let scalar: CodecScalar = codec_scalar(source, at)
        if scalar.value != codec_byte(word, start + i) { return 0 }
        at = scalar.next
        i = i + 1
    }
    return codec_eq(codec_byte(source, at), 34)
}

fn codec_is(read source: Bytes, at: Int, name: Text) -> Int {
    if codec_byte(source, at) != 34 { return 0 }
    let word = stage2_bytes_empty()
    stage2_bytes_assign_text(word, name)
    if stage2_bytes_len(word) != len(name) { return -12 }
    return codec_key_word(source, at, word, 0, len(name))
}

# The names are a comma-separated closed ASCII vocabulary, not input Text.
fn codec_fields(read source: Bytes, read ends: Bytes, at: Int, names: Text) -> Int {
    if codec_byte(source, at) != 123 { return 3 }
    let word = stage2_bytes_empty()
    stage2_bytes_assign_text(word, names)
    if stage2_bytes_len(word) != len(names) { return 12 }
    let mut key = codec_space(source, at + 1)
    if codec_byte(source, key) == 125 { return 0 }
    while key >= 0 {
        let mut start = 0
        let mut found = 0
        while start < len(names) {
            let mut end = start
            while codec_and(codec_lt(end, len(names)), codec_ne(codec_byte(word, end), 44)) == 1 {
                end = end + 1
            }
            if codec_key_word(source, key, word, start, end - start) == 1 { found = 1 }
            start = end + 1
        }
        if found == 0 { return 3 }
        key = codec_next_key(source, ends, key)
    }
    return 0
}

fn codec_field(read source: Bytes, read ends: Bytes, object: Int, name: Text) -> Int {
    if codec_byte(source, object) != 123 { return -1 }
    let word = stage2_bytes_empty()
    stage2_bytes_assign_text(word, name)
    if stage2_bytes_len(word) != len(name) { return -12 }
    let mut key = codec_space(source, object + 1)
    if codec_byte(source, key) == 125 { return -1 }
    while key >= 0 {
        if codec_key_word(source, key, word, 0, len(name)) == 1 {
            return codec_value_at(source, ends, key)
        }
        key = codec_next_key(source, ends, key)
    }
    return -1
}

fn codec_emit_scalar(edit destination: Bytes, scalar: Int) -> Int {
    let before = stage2_bytes_len(destination)
    let mut width = 1
    if scalar < 128 {
        stage2_bytes_append(destination, scalar)
    } else {
        if scalar < 2048 {
            width = 2
            stage2_bytes_append(destination, 192 + scalar // 64)
            stage2_bytes_append(destination, 128 + scalar % 64)
        } else {
            if scalar < 65536 {
                width = 3
                stage2_bytes_append(destination, 224 + scalar // 4096)
                stage2_bytes_append(destination, 128 + scalar // 64 % 64)
                stage2_bytes_append(destination, 128 + scalar % 64)
            } else {
                width = 4
                stage2_bytes_append(destination, 240 + scalar // 262144)
                stage2_bytes_append(destination, 128 + scalar // 4096 % 64)
                stage2_bytes_append(destination, 128 + scalar // 64 % 64)
                stage2_bytes_append(destination, 128 + scalar % 64)
            }
        }
    }
    if stage2_bytes_len(destination) != before + width { return 12 }
    return 0
}

# policy: 0 nonempty identity, 1 noise (TAB/LF/CR admitted), 2 hex digest.
# Only a fully validated, non-NUL, <=255-byte scalar string reaches the bridge.
fn codec_text(read source: Bytes, at: Int, maximum: Int, policy: Int) -> CodecText {
    let mut status = 0
    if codec_byte(source, at) != 34 {
        status = 3
        if policy == 2 { status = 5 }
        let result: CodecText = CodecText(status: status, value: "")
        return result
    }
    let buffer = stage2_bytes_empty()
    stage2_bytes_reserve(buffer, 256)
    if stage2_bytes_capacity(buffer) < 256 { let result: CodecText = CodecText(status: 12, value: "")
        return result }
    let mut cursor = at + 1
    let mut length = 0
    while codec_byte(source, cursor) != 34 {
        let scalar: CodecScalar = codec_scalar(source, cursor)
        let value = scalar.value
        let mut width = 1
        if value >= 128 { width = 2 }
        if value >= 2048 { width = 3 }
        if value >= 65536 { width = 4 }
        length = length + width
        if codec_and(codec_ge(value, 55296), codec_le(value, 57343)) == 1 { status = first_failure(status, 5) }
        if codec_or(codec_le(value, 31), codec_eq(value, 127)) == 1 {
            let allowed = codec_and(codec_eq(policy, 1), codec_or(codec_eq(value, 9), codec_or(codec_eq(value, 10), codec_eq(value, 13))))
            if allowed == 0 { status = first_failure(status, 5) }
        }
        if policy == 2 {
            if codec_or(codec_and(codec_ge(value, 48), codec_le(value, 57)), codec_and(codec_ge(value, 97), codec_le(value, 102))) == 0 {
                status = first_failure(status, 5)
            }
        }
        if codec_and(codec_le(length, maximum), codec_eq(status, 0)) == 1 {
            let emitted = codec_emit_scalar(buffer, value)
            if emitted != 0 { let result: CodecText = CodecText(status: emitted, value: "")
        return result }
        }
        cursor = scalar.next
    }
    if policy == 2 {
        if length != 64 { status = 5 }
    } else {
        if length > maximum { status = first_failure(status, 4) }
        if codec_and(codec_eq(length, 0), codec_eq(policy, 0)) == 1 { status = first_failure(status, 4) }
    }
    if status != 0 { let result: CodecText = CodecText(status: status, value: "")
        return result }
    let value = stage2_bytes_text(buffer, 0, length)
    let result: CodecText = CodecText(status: 0, value: value)
        return result
}

# Decimal JSON number -> exact integer, without binary floating point or an
# overflowing intermediate. Trailing zeroes may be removed by a negative
# exponent; a nonzero fractional remainder is a schema error.
fn codec_integer(read source: Bytes, read ends: Bytes, at: Int, minimum: Int, maximum: Int) -> CodecNumber {
    let byte = codec_byte(source, at)
    if codec_or(codec_digit(byte), codec_eq(byte, 45)) == 0 { let result: CodecNumber = CodecNumber(status: 3, value: 0)
        return result }
    let end = codec_end(ends, at)
    let mut cursor = at
    let mut negative = 0
    if byte == 45 { negative = 1
        cursor = cursor + 1 }
    let mut digits = 0
    let mut fraction = 0
    let mut after_dot = 0
    let mut first = -1
    let mut last = -1
    let mantissa = cursor
    while codec_or(codec_digit(codec_byte(source, cursor)), codec_eq(codec_byte(source, cursor), 46)) == 1 {
        let current = codec_byte(source, cursor)
        if current == 46 { after_dot = 1 } else {
            if current != 48 {
                if first < 0 { first = digits }
                last = digits
            }
            digits = digits + 1
            if after_dot == 1 { fraction = fraction + 1 }
        }
        cursor = cursor + 1
    }
    let mantissa_end = cursor
    let mut exponent = 0
    let mut exponent_negative = 0
    if cursor < end {
        cursor = cursor + 1
        if codec_byte(source, cursor) == 45 { exponent_negative = 1 }
        if codec_or(codec_eq(codec_byte(source, cursor), 45), codec_eq(codec_byte(source, cursor), 43)) == 1 { cursor = cursor + 1 }
        while cursor < end {
            # Saturation is above every possible wire digit count.
            if exponent < 100000 { exponent = exponent * 10 + codec_byte(source, cursor) - 48 }
            cursor = cursor + 1
        }
    }
    if exponent_negative == 1 { exponent = 0 - exponent }
    let decimal = digits - fraction + exponent
    let mut value = 0
    if first >= 0 {
        if decimal <= last { let result: CodecNumber = CodecNumber(status: 3, value: 0)
        return result }
        if decimal - first > 16 { let result: CodecNumber = CodecNumber(status: 4, value: 0)
        return result }
        cursor = mantissa
        let mut index = 0
        while cursor < mantissa_end {
            let digit = codec_byte(source, cursor)
            if digit != 46 {
