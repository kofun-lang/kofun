# #1695. Indexing a bounded record list yields the element record, and a field
# read on it is a borrowed `read` view.
type Header = {
    name: Bytes,
    value: Bytes,
}

fn main() -> Int {
    let a: Header = Header(name: stage2_bytes_empty(), value: stage2_bytes_empty())
    let b: Header = Header(name: stage2_bytes_empty(), value: stage2_bytes_empty())
    let headers: List[Header] = [a, b]
    print(len(headers))
    print(stage2_bytes_len(headers[0].name))
    return 0
}
