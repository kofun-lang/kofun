# #1698. Exactly 128 appends fill the capacity-128 profile row without a
# refusal.
type Header = {
    name: Bytes,
    value: Bytes,
}

fn main() -> Int {
    let headers: List[Header] = []
    let mut count = 0
    while count < 128 {
        let entry: Header = Header(name: stage2_bytes_empty(), value: stage2_bytes_empty())
        stage2_list_append(headers, entry)
        count = count + 1
    }
    print(len(headers))
    return 0
}
