fn cents() -> Result[Fixed[2], DecimalError] {
    let a: Fixed[2] = match take Fixed.from_decimal(1.5, HalfUp) {
        Ok(v) => v,
        Err(e) => return Err(e),
    }
    let mut n = 2
    while n > 0 {
        let more: Fixed[2] = match take Fixed.from_decimal(2.5, HalfUp) {
            Ok(v) => v,
            Err(e) => return Err(e),
        }
        let extra: Fixed[2] = match take Fixed.from_decimal(0.5, HalfUp) {
            Ok(v) => v,
            Err(e) => return Err(e),
        }
        let kept: Result[Fixed[2], DecimalError] = Ok(extra)
        n = n - 1
    }
    return Ok(a)
}

fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match take outcome {
        Ok(amount) => {
            print(0)
        },
        Err(error) => {
            print(1)
        },
    }
    return 0
}
