fn source() -> Result[Fixed[2], DecimalError] {
    return Fixed.from_decimal(1.25, Floor)
}

fn cents() -> Result[Fixed[2], DecimalError] {
    let first: Fixed[2] = match take source() {
        Ok(v) => v,
        Err(e) => return Err(e),
    }
    let outcome: Result[Fixed[2], DecimalError] = Ok(first)
    let last: Fixed[2] = match take outcome {
        Ok(v) => v,
        Err(e) => return Err(e),
    }
    return Ok(last)
}

fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match take outcome {
        Ok(amount) => { print(0) },
        Err(error) => { print(DecimalError.code(error)) },
    }
    return 0
}
