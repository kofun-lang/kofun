fn cents() -> Result[Fixed[2], DecimalError] {
    let a: Fixed[2] = match take Fixed.from_decimal(1.5, HalfUp) {
        Ok(v) => v,
        Err(e) => return Err(e),
    }
    let flag = 1
    if flag > 0 {
        let more: Fixed[2] = match take Fixed.from_decimal(2.5, HalfUp) {
            Ok(v) => v,
            Err(e) => return Err(e),
        }
        let big = 9223372036854775807
        print(big + 1)
    }
    return Ok(a)
}

fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match take outcome {
        Ok(amount) => {
            print(0)
        },
        Err(error) => {
            print(1)
        },
    }
    return 0
}
