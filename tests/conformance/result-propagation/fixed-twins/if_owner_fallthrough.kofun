fn cents() -> Result[Fixed[2], DecimalError] {
    let flag = 1
    let a: Fixed[2] = match take Fixed.from_decimal(1.5, HalfUp) {
        Ok(v) => v,
        Err(e) => return Err(e),
    }
    if flag > 0 {
        let more: Fixed[2] = match take Fixed.from_decimal(2.5, HalfUp) {
            Ok(v) => v,
            Err(e) => return Err(e),
        }
        let kept: Result[Fixed[2], DecimalError] = Ok(more)
        print(0)
    } else {
        let less: Fixed[2] = match take Fixed.from_decimal(0.5, HalfUp) {
            Ok(v) => v,
            Err(e) => return Err(e),
        }
        print(1)
    }
    if flag < 0 {
        print(1)
    } else {
        let other: Fixed[2] = match take Fixed.from_decimal(3.5, HalfUp) {
            Ok(v) => v,
            Err(e) => return Err(e),
        }
        print(0)
    }
    return Ok(a)
}

fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match take outcome {
        Ok(amount) => {
            print(0)
        },
        Err(error) => {
            print(1)
        },
    }
    return 0
}
