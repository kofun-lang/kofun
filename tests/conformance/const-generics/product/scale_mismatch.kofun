# The erasure sentinel.
#
# Under an annotation reader that returns only the head token, `Scaled[3]` and
# `Scaled[2]` are both `Scaled`, this source compiles, and the capability is
# silently broken while every gate stays green. It must be refused.
type Scaled[const scale: Int] = {
    significand: Int,
}

fn cents(value: Scaled[2]) -> Scaled[2] {
    return value
}

fn mills(value: Scaled[3]) -> Scaled[2] {
    return value
}

fn main() {
    print(0)
}
