# Distinct types must reach distinct emitted structs.
#
# `Scaled[2]` specializes to the C struct `KofunRecord_Scaled__2`, and a record
# actually named `Scaled__2` would generate the same one. Two different Kofun
# types sharing a C struct is the defect this gate exists for — it is what an
# earlier revision did to `Scaled[2]` and `Scaled[3]` under a comment claiming it
# was safe.
type Scaled[const scale: Int] = {
    significand: Int,
}

type Scaled__2 = {
    significand: Int,
}

fn cents(value: Scaled[2]) -> Scaled[2] {
    return value
}

fn other(value: Scaled__2) -> Scaled__2 {
    return value
}

fn main() {
    print(0)
}
