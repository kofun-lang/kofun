# contract: kofun.backend-differential/v1
# expect-stdout: 250
# expect-stdout: 2500
#
# The #725 Part B handoff, executed rather than described.
#
# Two scales are constructed, kept apart by the type system, and observed at
# runtime. `Scaled[2]` and `Scaled[3]` reach two distinct emitted structs — that
# is the specialization — so nothing here depends on them accidentally sharing
# a lowering, and `validate_struct_identity` refuses the source outright if
# they ever do.
#
# Part B replaces the field and the operations with real decimal semantics.
# What it no longer has to build is the type-level parameter: a literal `Int`
# argument, per-literal identity, a compile-time scale mismatch, and a value it
# can construct and run.

type Scaled[const scale: Int] = {
    significand: Int,
}

fn keep_cents(value: Scaled[2]) -> Scaled[2] {
    return value
}

fn keep_mills(value: Scaled[3]) -> Scaled[3] {
    return value
}

fn main() {
    let cents: Scaled[2] = Scaled[2](significand: 250)
    let mills: Scaled[3] = Scaled[3](significand: 2500)
    let kept_cents: Scaled[2] = keep_cents(cents)
    let kept_mills: Scaled[3] = keep_mills(mills)
    print(kept_cents.significand)
    print(kept_mills.significand)
}
