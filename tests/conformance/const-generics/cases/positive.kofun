# The shared positive. This source type-checks in the bounded const generic
# frontend *and* through the ordinary compile path the CLI takes, so the two
# agree on what a literal `Int` type argument means rather than one of them
# accepting a surface the other silently flattens.
type Scaled[const scale: Int] = {
    significand: Int,
}

type Money = {
    amount: Int,
}

fn keep_cents(value: Scaled[2]) -> Scaled[2] {
    let same: Scaled[2] = value
    return same
}

fn keep_mills(value: Scaled[3]) -> Scaled[3] {
    return value
}

# `Scaled[02]` normalizes by value, not by digits, so it is the same type as
# `Scaled[2]` and folds into the same monomorphization.
fn round_trip(cents: Scaled[02]) -> Scaled[2] {
    let kept: Scaled[2] = keep_cents(cents)
    return kept
}

# `Money` is used before it is declared above, so a nominal identity never
# depends on declaration order.
fn plain(amount: Money) -> Money {
    return amount
}

fn main() {
    print(0)
}
