# Transparent outer parentheses retain the read BindingId at the transactional
# producer destination; they cannot bypass the read-to-edit refusal.
fn misuse(read destination: Bytes) -> Int {
    stage2_bytes_assign_zeroed(((destination)), 4)
    return 0
}

fn main() -> Int {
    let owned = stage2_bytes_empty()
    return misuse(owned)
}
