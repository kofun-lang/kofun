# #1517. An ordinary positional call rejects a read Bytes view when the
# callee's second parameter requires edit access.
fn writes(prefix: Int?, edit target: Bytes) -> Int {
    return 0
}

fn lends(read source: Bytes) -> Int {
    let absent: Int? = null
    return writes(absent, source)
}

fn main() -> Int {
    let owned = stage2_bytes_empty()
    return lends(owned)
}
