type X = { amount: Int }
fn cents() -> Result[Fixed[2], DecimalError] {
    let amount: Fixed[2] = Fixed.from_decimal(1.999, HalfUp)?
    let x: X = X(amount: Fixed.from_decimal(1.6, HalfUp))
    return Ok(amount)
}

fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match take outcome {
        Ok(amount) => {
            print(0)
        },
        Err(error) => {
            print(1)
        },
    }
    return 0
}
