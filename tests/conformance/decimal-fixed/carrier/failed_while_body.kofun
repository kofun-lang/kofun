fn cents() -> Result[Fixed[2], DecimalError] {
    let a: Fixed[2] = Fixed.from_decimal(1.5, HalfUp)?
    let big = 9223372036854775807
    let mut n = 2
    while n > 0 {
        let more: Fixed[2] = Fixed.from_decimal(2.5, HalfUp)?
        n = n - 1
        let step = big - n + 1
    }
    return Ok(a)
}

fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match take outcome {
        Ok(amount) => {
            print(0)
        },
        Err(error) => {
            print(1)
        },
    }
    return 0
}
