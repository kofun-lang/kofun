fn cents() -> Result[Fixed[2], DecimalError] {
    print(Fixed.from_decimal(1.65, Floor))
    return Fixed.from_decimal(1.5, HalfUp)
}
fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match take outcome {
        Ok(amount) => {
            print(0)
        },
        Err(error) => {
            print(1)
        },
    }
    return 0
}
