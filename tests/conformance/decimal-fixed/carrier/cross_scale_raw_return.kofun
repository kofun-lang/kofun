fn cents() -> Result[Fixed[2], DecimalError] {
    let amount: Fixed[3] = Fixed.from_decimal(1.999, HalfUp)?
    return amount
}

fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match take outcome {
        Ok(amount) => {
            print(0)
        },
        Err(error) => {
            print(1)
        },
    }
    return 0
}
