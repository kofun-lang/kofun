fn cents() -> Result[Fixed[2], DecimalError] {
    let r: Result[Fixed[2], DecimalError] = Fixed.from_decimal(1.9, HalfUp)
    if 1 == 1 {
        let value: Fixed[2] = r?
        return Ok(value)
    }
    return Fixed.from_decimal(1.5, HalfUp)
}

fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match take outcome {
        Ok(amount) => {
            print(0)
        },
        Err(error) => {
            print(1)
        },
    }
    return 0
}
