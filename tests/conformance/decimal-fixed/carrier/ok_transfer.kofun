fn cents() -> Result[Fixed[2], DecimalError] {
    let amount: Fixed[2] = Fixed.from_decimal(1.999, HalfUp)?
    let kept: Result[Fixed[2], DecimalError] = Ok(amount)
    return Fixed.from_decimal(2.5, HalfUp)
}

fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match take outcome {
        Ok(amount) => {
            print(0)
        },
        Err(error) => {
            print(1)
        },
    }
    return 0
}
