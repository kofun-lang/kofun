fn cents() -> Result[Fixed[2], DecimalError] {
    let amount: Fixed[2] = Fixed.from_decimal(1.5, HalfUp)?
    return Ok(amount)
}

fn main() -> Int {
    let outcome: Result[Fixed[2], DecimalError] = cents()
    match outcome {
        Ok(amount) => { print(0) },
        Err(error) => { print(1) },
    }
    return 0
}
