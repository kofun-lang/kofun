# #1697. The ADT is closed: a match that leaves a kind out is refused, with the
# missing kind named, unless a catch-all follows.
# BEGIN kofun.http-error/v1
type ProtocolDetail = {
    phase: Int,
    retry_safe: Bool,
    offset: Int,
}

type LimitDetail = {
    phase: Int,
    retry_safe: Bool,
    dimension: Int,
    limit: Int,
    observed_at_most: Int,
}

type TruncatedDetail = {
    phase: Int,
    retry_safe: Bool,
    offset: Int,
}

type TransportDetail = {
    phase: Int,
    retry_safe: Bool,
    cause: Int,
    offset: Int,
}

type HttpError =
    | Protocol(detail: ProtocolDetail)
    | LimitExceeded(detail: LimitDetail)
    | BodyTruncated(detail: TruncatedDetail)
    | Transport(detail: TransportDetail)
# END kofun.http-error/v1

fn main() -> Int {
    let protocol: ProtocolDetail = ProtocolDetail(phase: 2, retry_safe: false, offset: 17)
    let error: HttpError = Protocol(protocol)
    match error {
        Protocol(detail) => { print(detail.phase) },
        LimitExceeded(detail) => { print(detail.phase) },
        BodyTruncated(detail) => { print(detail.phase) },
    }
    return 0
}
