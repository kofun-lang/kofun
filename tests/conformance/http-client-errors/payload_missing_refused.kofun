# #1697. A constructor that carries a record is not a value without it.
# BEGIN kofun.http-error/v1
type ProtocolDetail = {
    phase: Int,
    retry_safe: Bool,
    offset: Int,
}

type LimitDetail = {
    phase: Int,
    retry_safe: Bool,
    dimension: Int,
    limit: Int,
    observed_at_most: Int,
}

type TruncatedDetail = {
    phase: Int,
    retry_safe: Bool,
    offset: Int,
}

type TransportDetail = {
    phase: Int,
    retry_safe: Bool,
    cause: Int,
    offset: Int,
}

type HttpError =
    | Protocol(detail: ProtocolDetail)
    | LimitExceeded(detail: LimitDetail)
    | BodyTruncated(detail: TruncatedDetail)
    | Transport(detail: TransportDetail)
# END kofun.http-error/v1

fn main() -> Int {
    let error: HttpError = Protocol
    return 0
}
