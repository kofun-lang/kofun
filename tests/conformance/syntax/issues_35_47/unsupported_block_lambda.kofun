# A block-body lambda in a `let` initializer. #1398 admits the block body in
# the trailing position — after a call's `)` — and `spec/grammar.ebnf` derives
# exactly that as `trailing_block_lambda`. This spelling is not that position,
# and this fixture pins the boundary so the three surfaces cannot drift apart
# again unnoticed.
#
# It used to record that the refusal was not a refusal: the parameter list was
# not recognised, so `value` never bound and the diagnostic named it as an
# unknown lexical binding — a symbol the author did not write. #1398 replaced
# that with a named position refusal, which is the change this comment asked
# for.

fn main() -> Int {
    let double = fn(value) {
        return value * 2
    }
    print(double(21))
    return 0
}
