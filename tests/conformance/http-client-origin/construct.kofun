# #1696. A checked `HttpOrigin`: a host of 1..255 visible-ASCII bytes without a
# comma, an origin-form target, and a port in `-1` or `0..65535` all construct,
# validate, and read back.
type HttpOrigin = {
    host: Bytes,
    target: Bytes,
    port: Int,
}

fn main() -> Int {
    let host = stage2_bytes_empty()
    stage2_bytes_assign_text(host, "example.com")
    let target = stage2_bytes_empty()
    stage2_bytes_assign_text(target, "/index.html")
    let origin: HttpOrigin = HttpOrigin(host: host, target: target, port: 443)
    stage2_http_origin(origin)
    print(origin.port)
    print(stage2_bytes_len(origin.host))
    print(stage2_bytes_text(origin.target, 0, stage2_bytes_len(origin.target)))
    return 0
}
