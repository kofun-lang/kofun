# #1696. A target over 2048 bytes fails the checked construction with R040. The
# target is grown past the bound with appends: a leading `/` and then 2048 more
# visible-ASCII bytes.
type HttpOrigin = {
    host: Bytes,
    target: Bytes,
    port: Int,
}

fn main() -> Int {
    let host = stage2_bytes_empty()
    stage2_bytes_assign_text(host, "example.com")
    let target = stage2_bytes_empty()
    stage2_bytes_append(target, 47)
    let mut at = 0
    while at < 2048 {
        stage2_bytes_append(target, 97)
        at = at + 1
    }
    let origin: HttpOrigin = HttpOrigin(host: host, target: target, port: 80)
    stage2_http_origin(origin)
    print(origin.port)
    return 0
}
