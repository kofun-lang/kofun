# #1696. A target that is not an origin-form `/`-prefixed path fails the
# checked construction with R040.
type HttpOrigin = {
    host: Bytes,
    target: Bytes,
    port: Int,
}

fn main() -> Int {
    let host = stage2_bytes_empty()
    stage2_bytes_assign_text(host, "example.com")
    let target = stage2_bytes_empty()
    stage2_bytes_assign_text(target, "index.html")
    let origin: HttpOrigin = HttpOrigin(host: host, target: target, port: 80)
    stage2_http_origin(origin)
    print(origin.port)
    return 0
}
