# #1537. The same nine parameters as `labelled_parameter_bound.kofun`, called
# positionally. Accepted, and it must stay accepted: the eight-parameter bound
# belongs to the fixed-slot labelled lowering, not to declarations, and a fix
# that narrowed declarations to eight would be a language change wearing a
# repair's clothes.
fn nine(
    x1: Int,
    x2: Int,
    x3: Int,
    x4: Int,
    x5: Int,
    x6: Int,
    x7: Int,
    x8: Int,
    x9: Int
) -> Int {
    return x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9
}

fn main() -> Int {
    return nine(1, 2, 3, 4, 5, 6, 7, 8, 9)
}
