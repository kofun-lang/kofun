# A partial move refused by the compiler a user runs (#946).
#
# `partial_move.kofun` beside this file makes the same claim against the
# standalone `bootstrap/stage2/record_frontend.c`; this one gates the
# production path and pins the same wording, because two frontends that
# disagree about what `take value.field` is called would be two languages.
# Int-only was once forced by that file's `Text` field, which #1181 admitted;
# what remains is which frontend is under test.
#
# `take token.start` moved nothing before #946: the production frontend read
# `take` as a name nobody declared, and once that was fixed the statement was
# quietly accepted as two expressions. The whole `take token.start` is the span,
# not the field alone — the refusal is of the statement, not of the read.
type Token = {
    start: Int,
}

fn steal(token: Token) -> Int {
    take token.start
    return 0
}

fn main() -> Int {
    let first: Token = Token(start: 1)
    print(steal(first))
    return 0
}
