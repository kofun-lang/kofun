# A nominal record carrying a bounded List[Int] field alongside Int and Bool
# (#1183, RFC-0011). Declaration, construction, and execution — the shapes
# increment 5 of #868 owes.
#
# The layout claim is not made in this file's output. It is made by the
# emitted C, which carries
#
#   _Static_assert(offsetof(KofunRecord_Bag, f_samples) == 0)
#   _Static_assert(offsetof(KofunRecord_Bag, f_count) == 520)
#   _Static_assert(sizeof(KofunRecord_Bag) == 528)
#
# and is built with -Werror by this corpus, so compiling it is the assertion.
# Those three numbers are what spec/aggregate-layout-v1 computes for
# `bounded_list[Int, 64]` followed by an `Int`, independently of the emitter.
#
# Reading the list field back is deliberately not exercised: RFC-0011 leaves
# the List[Int] value form's record-field read to a separate change, and it
# still refuses with E2S157.

type Bag = {
    samples: List[Int],
    count: Int,
}

type Reading = {
    ok: Bool,
    samples: List[Int],
    label: Text,
}

fn main() {
    let xs: List[Int] = [10, 20, 30]
    let b: Bag = Bag(samples: xs, count: 3)
    print(b.count)

    let ys: List[Int] = [7]
    let r: Reading = Reading(ok: true, samples: ys, label: "sensor")
    print(r.label)
    print(r.ok)
}
