# A second move refused by the compiler a user runs (#946).
#
# The mirror of `double_take.kofun`, which makes the same claim against the
# standalone `bootstrap/stage2/record_frontend.c`. This one gates the
# production path — the compiler `./bin/kofun check` actually runs — so the two
# frontends are held to one wording rather than drifting apart.
#
# It is Int-only. That was once forced, because the sibling's `Text` field was
# refused by the field slice before ownership was consulted; #1181 admitted
# `Text`, so the separation is now about which frontend is under test, not
# about what the slice accepts.
#
# Moving twice and reading after a move are one condition and two sentences.
# The second `take` is not a use of the value, so it is not reported as one:
# both spans underline a whole `take token` statement, and the message says
# `already moved` rather than `cannot be used again`. The distinction is the
# standalone frontend's, and repeating it here is what keeps the two producers
# one language rather than two dialects.
type Token = {
    start: Int,
}

fn twice(token: Token) -> Int {
    take token
    take token
    return 0
}

fn main() -> Int {
    let first: Token = Token(start: 1)
    print(twice(first))
    return 0
}
