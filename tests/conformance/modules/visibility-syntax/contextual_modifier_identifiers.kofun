fn pub(value: Int) -> Int {
    return value
}

fn internal() -> Int {
    return 1
}

fn private() -> Int {
    return 1
}

fn pure() -> Int {
    return 0
}

fn main() -> Int {
    let pub: Int = internal()
    let internal: Int = private()
    let pure: Int = pure()
    print(pub(pub + internal + pure + 40))
    return 0
}
