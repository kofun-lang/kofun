{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kofun-lang.invalid/tests/fuzz/findings.schema.json",
  "title": "Kofun scheduled fuzz findings register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "findings"],
  "properties": {
    "schema": {
      "const": "kofun.scheduled-fuzz-findings/v1"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "generator",
        "seed",
        "run_id",
        "run_attempt",
        "exit_status",
        "failure_kind",
        "severity",
        "resolution",
        "reproduction",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^scheduled-fuzz/[0-9]+/[1-9][0-9]*/[a-z0-9-]+$"
        },
        "date": {
          "type": "string",
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
        },
        "generator": {
          "enum": [
            "grammar",
            "semantic-differential",
            "value-if",
            "match-guard",
            "match-value",
            "match-value-invalid",
            "enum-match",
            "optional-narrowing",
            "visibility-artifacts"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]+$"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "exit_status": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "failure_kind": {
          "enum": ["generator-exit", "seed-report-missing"]
        },
        "severity": {
          "enum": ["untriaged", "critical", "high", "medium", "low"]
        },
        "resolution": {
          "enum": ["unresolved", "resolved", "false-positive"]
        },
        "resolution_note": {
          "type": "string",
          "minLength": 1
        },
        "reproduction": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "pattern": "^logs/[a-z0-9-]+[.]log$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution": {
                "enum": ["resolved", "false-positive"]
              }
            }
          },
          "then": {
            "required": ["resolution_note"]
          }
        }
      ]
    }
  }
}
