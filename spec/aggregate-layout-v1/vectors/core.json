        { "name": "Wide", "payload": "Int" },
        { "name": "Handle", "payload": "Text" }
      ]
    },
    { "id": "Optional[Int]", "kind": "optional", "payload": "Int" }
  ],
  "objects": [
    { "id": "text-ascii", "type": "Text", "text": "ok" },
    { "id": "text-mixed", "type": "Text", "text": "a日本語" },
    { "id": "text-empty", "type": "Text", "text": "" },
    { "id": "list-int-three", "type": "List[Int]", "elements": 3 },
    { "id": "list-text-two", "type": "List[Text]", "elements": 2 },
