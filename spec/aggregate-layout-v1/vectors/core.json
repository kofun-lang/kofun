{
  "schema": "kofun.aggregate-layout-document/v1",
  "types": [
    { "id": "Bool", "kind": "scalar", "scalar": "Bool" },
    { "id": "Int", "kind": "scalar", "scalar": "Int" },
    { "id": "Text", "kind": "text" },
    { "id": "List[Int]", "kind": "list", "element": "Int" },
    { "id": "List[Text]", "kind": "list", "element": "Text" },
    {
      "id": "BoundedList[Int, 64]",
      "kind": "bounded_list",
      "element": "Int",
      "capacity": "64"
    },
    {
      "id": "BoundedList[Int, 2]",
      "kind": "bounded_list",
      "element": "Int",
      "capacity": "2"
    },
    {
      "id": "BoundedList[Text, 3]",
