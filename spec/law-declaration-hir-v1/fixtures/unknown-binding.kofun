law Identity[T] {
    operation identity(x: T) -> T
    equation unit(x: T in values) = identity(x) == x
}
fn operation(x: Bool) -> Bool { return x }
impl Concrete: Identity[Bool] { identity = missing }
check laws Checked {
    instance = Concrete
    domain values: Bool = all
    equality Bool = structural
    require assurance = proven_finite
    budget = standard
}
