{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kofun.generic-adt-hir.v1.schema.json",
  "title": "kofun.generic-adt-hir/v1",
  "description": "Closed generic-ADT HIR analysis document (#1675). See generic-adt-hir-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "file_id", "limits", "declarations"],
  "properties": {
    "schema": { "const": "kofun.generic-adt-hir/v1" },
    "profile": { "const": "kofun.stage2-analysis/generic-adt/v1" },
    "file_id": { "$ref": "#/definitions/identity" },
    "limits": { "$ref": "#/definitions/limits" },
    "declarations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/recordDeclaration" },
          { "$ref": "#/definitions/adtDeclaration" }
        ]
      }
    }
  },
  "definitions": {
    "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binders_per_declaration",
        "constructed_depth",
        "constructors_per_declaration",
        "declarations",
        "document_bytes",
        "fields_per_declaration",
        "instantiations_per_declaration",
        "name_bytes",
        "payload_fields_per_constructor"
      ],
      "properties": {
        "binders_per_declaration": { "const": 2 },
        "constructed_depth": { "const": 8 },
        "constructors_per_declaration": { "const": 64 },
        "declarations": { "const": 64 },
        "document_bytes": { "const": 1048576 },
        "fields_per_declaration": { "const": 256 },
        "instantiations_per_declaration": { "const": 8 },
        "name_bytes": { "const": 65535 },
        "payload_fields_per_constructor": { "const": 1 }
      }
    },
    "typeRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "id"],
          "properties": {
            "tag": { "const": "primitive" },
            "id": { "$ref": "#/definitions/identity" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "id"],
          "properties": {
            "tag": { "const": "parameter" },
            "id": { "$ref": "#/definitions/identity" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "id", "arguments"],
          "properties": {
            "tag": { "const": "nominal" },
            "id": { "$ref": "#/definitions/identity" },
            "arguments": { "type": "array", "items": { "$ref": "#/definitions/typeRef" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "id"],
          "properties": {
            "tag": { "const": "constructed" },
            "id": { "$ref": "#/definitions/identity" }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/definitions/typeRef" }
      }
    },
    "constructor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ordinal", "payload"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 63 },
        "payload": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/definitions/field" }
        }
      }
    },
    "constructors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": { "$ref": "#/definitions/constructor" }
    },
    "fields": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/definitions/field" }
    },
    "binder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "ordinal"],
      "properties": {
        "id": { "$ref": "#/definitions/identity" },
        "kind": { "const": "type" },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "binders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/definitions/binder" }
    },
    "recordApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "arguments", "fields"],
      "properties": {
        "id": { "$ref": "#/definitions/identity" },
        "arguments": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/definitions/typeRef" } },
        "fields": { "$ref": "#/definitions/fields" }
      }
    },
    "adtApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "arguments", "constructors"],
      "properties": {
        "id": { "$ref": "#/definitions/identity" },
        "arguments": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/definitions/typeRef" } },
        "constructors": { "$ref": "#/definitions/constructors" }
      }
    },
    "recordDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "binders", "fields", "applications"],
      "properties": {
        "id": { "$ref": "#/definitions/identity" },
        "kind": { "const": "record" },
        "name": { "type": "string", "minLength": 1 },
        "binders": { "$ref": "#/definitions/binders" },
        "fields": { "$ref": "#/definitions/fields" },
        "applications": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/definitions/recordApplication" }
        }
      }
    },
    "adtDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "binders", "constructors", "applications"],
      "properties": {
        "id": { "$ref": "#/definitions/identity" },
        "kind": { "const": "adt" },
        "name": { "type": "string", "minLength": 1 },
        "binders": { "$ref": "#/definitions/binders" },
        "constructors": { "$ref": "#/definitions/constructors" },
        "applications": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/definitions/adtApplication" }
        }
      }
    }
  }
}
