#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/bootstrap/stage2/semantic-objects.sh"
BUILD_DIR=${KOFUN_BUILD_DIR:-"$ROOT/build/bootstrap-stage1"}
SEED_C="$ROOT/bootstrap/stage1/compiler.c"
COMPILER="$BUILD_DIR/kofun-stage1"
NATIVE_BUILD_DIR=${KOFUN_NATIVE_BUILD_DIR:-"$ROOT/build/native-core"}
NATIVE_SEED_C="$ROOT/bootstrap/native/core_compiler.c"
NATIVE_COMPILER="$NATIVE_BUILD_DIR/kofun-native-core"
WASM_BUILD_DIR=${KOFUN_WASM_BUILD_DIR:-"$ROOT/build/wasm-core"}
WASM_SEED_C="$ROOT/bootstrap/wasm/compiler.c"
WASM_OBJECT_ARENA_H="$ROOT/bootstrap/wasm/object_arena.h"
WASM_TEXT_PROFILE_H="$ROOT/bootstrap/wasm/text_profile.h"
WASM_LIST_PROFILE_H="$ROOT/bootstrap/wasm/list_profile.h"
WASM_COMPILER="$WASM_BUILD_DIR/kofun-wasm-core"
STAGE2_BUILD_DIR=${KOFUN_STAGE2_BUILD_DIR:-"$ROOT/build/stage2"}
STAGE2_SEED_C="$ROOT/bootstrap/stage2/compiler.c"
STAGE2_DECIMAL_C="$ROOT/bootstrap/stage2/decimal_v1.c"
STAGE2_DECIMAL_H="$ROOT/bootstrap/stage2/decimal_v1.h"
STAGE2_COMPILER="$STAGE2_BUILD_DIR/kofun-stage2"

# A supplied semantic-object bundle is runner/session state, not a persistent
# compiler cache.  `task verify` supplies both build directories inside its
# unique run directory.  A direct `bin/kofun check --emit-*` invocation that
# supplies only the bundle gets one private link session, removed when this
# launcher exits.  Explicit build-directory overrides remain caller-owned.
STAGE2_SEMANTIC_LINK_SESSION=
if test "${KOFUN_STAGE2_SEMANTIC_OBJECT_DIR+x}" = x &&
   test "${1-}" = check && test "$#" -gt 2 &&
   { test -z "${KOFUN_STAGE2_EVENTS_BUILD_DIR:-}" ||
     test -z "${KOFUN_STAGE2_KIF_BUILD_DIR:-}"; }
then
    mkdir -p "$ROOT/build"
    STAGE2_SEMANTIC_LINK_SESSION=$(mktemp -d \
        "$ROOT/build/stage2-semantic-links.XXXXXX")
    cleanup_stage2_semantic_link_session() {
        if test -n "${STAGE2_SEMANTIC_LINK_SESSION:-}" &&
           { test -e "$STAGE2_SEMANTIC_LINK_SESSION" ||
             test -L "$STAGE2_SEMANTIC_LINK_SESSION"; }
        then
            kofun_stage2_owned_tree_remove \
                "$STAGE2_SEMANTIC_LINK_SESSION" 2>/dev/null || true
        fi
    }
    trap cleanup_stage2_semantic_link_session 0
    trap 'exit 129' 1
    trap 'exit 130' 2
    trap 'exit 143' 15
    KOFUN_STAGE2_EVENTS_BUILD_DIR=${KOFUN_STAGE2_EVENTS_BUILD_DIR:-"$STAGE2_SEMANTIC_LINK_SESSION/events"}
    KOFUN_STAGE2_KIF_BUILD_DIR=${KOFUN_STAGE2_KIF_BUILD_DIR:-"$STAGE2_SEMANTIC_LINK_SESSION/kif"}
    export KOFUN_STAGE2_EVENTS_BUILD_DIR KOFUN_STAGE2_KIF_BUILD_DIR
fi
STAGE2_EVENTS_BUILD_DIR=${KOFUN_STAGE2_EVENTS_BUILD_DIR:-"$ROOT/build/stage2-events-cli"}
STAGE2_EVENTS_COMPILER="$STAGE2_EVENTS_BUILD_DIR/kofun-stage2-semantic-events"
STAGE2_KIF_BUILD_DIR=${KOFUN_STAGE2_KIF_BUILD_DIR:-"$ROOT/build/stage2-kif-cli"}
STAGE2_KIF_COMPILER="$STAGE2_KIF_BUILD_DIR/kofun-stage2-kif"
STAGE2_KIF_SOURCE="$ROOT/bootstrap/stage2/stage2_kif_producer.c"
STAGE2_KIF_CODEC="$ROOT/bootstrap/stage2/kif_v1.c"
TYPED_SIDECAR_EMITTER="$ROOT/tooling/typed-sidecar/emit-stage2.mjs"
C_ABI_BUILD_DIR=${KOFUN_C_ABI_BUILD_DIR:-"$ROOT/build/c-abi"}
C_ABI_SEED_C="$ROOT/bootstrap/c_abi/compiler.c"
C_ABI_COMPILER="$C_ABI_BUILD_DIR/kofun-c-abi"
CLI_BUILD_DIR=${KOFUN_CLI_BUILD_DIR:-"$ROOT/build/native-cli"}
CLI_SEED_C="$ROOT/framework/cli/compiler.c"
CLI_TEMPLATE="$ROOT/framework/cli/runtime_template.inc"
CLI_COMPILER="$CLI_BUILD_DIR/kofun-cli-compiler"
PACKAGE_MANAGER="$ROOT/package/manager.sh"
CC=${CC:-cc}
UNICODE_C="$ROOT/unicode/kofun_unicode.c"
UNICODE_H="$ROOT/unicode/kofun_unicode.h"
UNICODE_TABLES="$ROOT/unicode/kofun_unicode_tables.inc"
UTF8PROC_C="$ROOT/vendor/utf8proc/utf8proc.c"
UTF8PROC_H="$ROOT/vendor/utf8proc/utf8proc.h"
UTF8PROC_DATA="$ROOT/vendor/utf8proc/utf8proc_data.c"

usage() {
    cat <<'EOF'
usage:
  kofun build INPUT.kofun [-o OUTPUT] [--emit-c OUTPUT.c]
              [--backend c --c-abi [--link-library FILE|--package NAME]...]
              [--offline]
              [--framework cli]
              [--target x86_64-linux|aarch64-linux|wasm32|wasm32-hostabi1] [-g]
  kofun build [TARGET...] [FROST_OPTIONS]  # with ./kofun.toml
  kofun package lock
  kofun package fetch [--offline]
  kofun new DIRECTORY --template cli
  kofun run INPUT.kofun
  kofun check INPUT.kofun
  kofun check INPUT.kofun --emit-typed-sidecar OUTPUT.kofun-semantic.json
                            --generation UNSIGNED_INTEGER
      The sidecar is non-authoritative tooling data.
  kofun check INPUT.kofun --emit-kif OUTPUT.kif
      KIF is an authoritative, source-free Stage 2 interface.
  kofun test [PATH]
  kofun unittest [PATH ...] [--filter SUBSTRING] [--list] [--watch]
                 [--no-color] [--keep-going]
      Runs kotest unit-test suites (*_test.kofun and embedded fn test_*
      functions); see tooling/kotest/README.md.
  kofun bootstrap
  kofun emit-c INPUT.kofun OUTPUT.c
  kofun bindgen-c HEADER.h --out-dir DIR [--module NAME]
                  [-D NAME[=VALUE]]... [-I DIR]... [--std STD]
                  [--target TRIPLE] [--sysroot DIR] [--clang PATH]
      Generates raw trusted C bindings plus a machine-readable audit
      report from the Clang AST. Generated bindings are not safe; see
      tooling/bindgen-c/README.md.
  kofun --version
EOF
}

ensure_compiler() {
    mkdir -p "$BUILD_DIR"
    if [ ! -x "$COMPILER" ] ||
       [ "$SEED_C" -nt "$COMPILER" ] ||
       [ "$UNICODE_C" -nt "$COMPILER" ] ||
       [ "$UNICODE_H" -nt "$COMPILER" ] ||
       [ "$UNICODE_TABLES" -nt "$COMPILER" ] ||
       [ "$UTF8PROC_C" -nt "$COMPILER" ] ||
       [ "$UTF8PROC_H" -nt "$COMPILER" ] ||
       [ "$UTF8PROC_DATA" -nt "$COMPILER" ]
    then
        "$CC" -std=c11 -O2 -Wall -Wextra -Werror \
            "$SEED_C" -lm -o "$COMPILER"
    fi
}

ensure_native_compiler() {
    mkdir -p "$NATIVE_BUILD_DIR"
    if [ ! -x "$NATIVE_COMPILER" ] ||
       [ "$NATIVE_SEED_C" -nt "$NATIVE_COMPILER" ] ||
       [ "$UNICODE_C" -nt "$NATIVE_COMPILER" ] ||
       [ "$UNICODE_H" -nt "$NATIVE_COMPILER" ] ||
       [ "$UNICODE_TABLES" -nt "$NATIVE_COMPILER" ] ||
       [ "$UTF8PROC_C" -nt "$NATIVE_COMPILER" ] ||
       [ "$UTF8PROC_H" -nt "$NATIVE_COMPILER" ] ||
       [ "$UTF8PROC_DATA" -nt "$NATIVE_COMPILER" ]
    then
        "$CC" -std=c11 -O2 -Wall -Wextra -Werror \
            "$NATIVE_SEED_C" -o "$NATIVE_COMPILER"
    fi
}

ensure_wasm_compiler() {
    mkdir -p "$WASM_BUILD_DIR"
    if [ ! -x "$WASM_COMPILER" ] ||
       [ "$WASM_SEED_C" -nt "$WASM_COMPILER" ] ||
       [ "$WASM_OBJECT_ARENA_H" -nt "$WASM_COMPILER" ] ||
       [ "$WASM_TEXT_PROFILE_H" -nt "$WASM_COMPILER" ] ||
       [ "$WASM_LIST_PROFILE_H" -nt "$WASM_COMPILER" ]
    then
        "$CC" -std=c11 -O2 -Wall -Wextra -Werror \
            "$WASM_SEED_C" -o "$WASM_COMPILER"
    fi
}

ensure_stage2_compiler() {
    mkdir -p "$STAGE2_BUILD_DIR"
    # #1202 taught the gate scripts and the conformance adapter to reuse the
    # compiler `task verify` already built and exported as
    # KOFUN_STAGE2_COMPILER. This driver was the remaining path that did not:
    # it rebuilt the same 27k lines with the same flags into its own build
    # directory, so every gate that runs `bin/kofun` with a fresh or wiped
    # `build/` still paid for it. Copying costs milliseconds.
    #
    # Staleness belongs to whoever set the variable, exactly as it does in
    # `bootstrap/stage2/build.sh`: naming a compiler asserts it is the one to
    # use. Unset, every branch below behaves as before.
    if [ -n "${KOFUN_STAGE2_COMPILER:-}" ] &&
       [ -x "$KOFUN_STAGE2_COMPILER" ]
    then
        if [ ! -x "$STAGE2_COMPILER" ] ||
           [ "$KOFUN_STAGE2_COMPILER" -nt "$STAGE2_COMPILER" ]
        then
            cp "$KOFUN_STAGE2_COMPILER" "$STAGE2_COMPILER"
        fi
        return 0
    fi
    if [ ! -x "$STAGE2_COMPILER" ] ||
       [ "$STAGE2_SEED_C" -nt "$STAGE2_COMPILER" ] ||
       [ "$STAGE2_DECIMAL_C" -nt "$STAGE2_COMPILER" ] ||
       [ "$STAGE2_DECIMAL_H" -nt "$STAGE2_COMPILER" ] ||
       [ "$UNICODE_C" -nt "$STAGE2_COMPILER" ] ||
       [ "$UNICODE_H" -nt "$STAGE2_COMPILER" ] ||
       [ "$UNICODE_TABLES" -nt "$STAGE2_COMPILER" ] ||
       [ "$UTF8PROC_C" -nt "$STAGE2_COMPILER" ] ||
       [ "$UTF8PROC_H" -nt "$STAGE2_COMPILER" ] ||
       [ "$UTF8PROC_DATA" -nt "$STAGE2_COMPILER" ]
    then
        "$CC" -std=c11 -O2 -Wall -Wextra -Werror \
            "$STAGE2_SEED_C" -o "$STAGE2_COMPILER"
    fi
}

ensure_stage2_events_compiler() {
    # Validate a supplied bundle on every call, including the path that can
    # reuse an executable built earlier in this process.  An incomplete bundle
    # must never be hidden by that executable cache.
    kofun_stage2_semantic_inputs "$ROOT" main
    mkdir -p "$STAGE2_EVENTS_BUILD_DIR"
    stage2_events_link=false
    if [ -n "$KOFUN_STAGE2_SEMANTIC_OBJECT_ID" ]; then
        kofun_stage2_semantic_executable_identity "$ROOT" events \
            "$KOFUN_STAGE2_SEMANTIC_PRODUCER_INPUT" \
            "$KOFUN_STAGE2_SEMANTIC_EVENTS_INPUT" \
            "$KOFUN_STAGE2_SEMANTIC_SHA256_INPUT"
        # Output kind, exact link profile, resolved compiler, and only the
        # relevant object bytes own this key.  Path and mtime are absent.
        STAGE2_EVENTS_COMPILER="$STAGE2_EVENTS_BUILD_DIR/kofun-stage2-semantic-events.$KOFUN_STAGE2_SEMANTIC_EXECUTABLE_ID"
        kofun_stage2_semantic_executable_validate "$STAGE2_EVENTS_COMPILER"
        [ -x "$STAGE2_EVENTS_COMPILER" ] || stage2_events_link=true
    elif [ ! -x "$STAGE2_EVENTS_COMPILER" ] ||
         [ "$KOFUN_STAGE2_SEMANTIC_PRODUCER_INPUT" -nt "$STAGE2_EVENTS_COMPILER" ] ||
         [ "$KOFUN_STAGE2_SEMANTIC_EVENTS_INPUT" -nt "$STAGE2_EVENTS_COMPILER" ] ||
         [ "$KOFUN_STAGE2_SEMANTIC_SHA256_INPUT" -nt "$STAGE2_EVENTS_COMPILER" ] ||
         [ "$STAGE2_SEED_C" -nt "$STAGE2_EVENTS_COMPILER" ]
    then
        stage2_events_link=true
    fi
    if [ "$stage2_events_link" = true ]; then
        kofun_stage2_semantic_executable_link "$STAGE2_EVENTS_COMPILER" \
            "$CC" -std=c11 -O2 -Wall -Wextra -Werror -pedantic \
            -I"$ROOT/bootstrap/stage2" \
            "$KOFUN_STAGE2_SEMANTIC_PRODUCER_INPUT" \
            "$KOFUN_STAGE2_SEMANTIC_EVENTS_INPUT" \
            "$KOFUN_STAGE2_SEMANTIC_SHA256_INPUT"
    fi
}

ensure_stage2_kif_compiler() {
    kofun_stage2_semantic_inputs "$ROOT" library
    mkdir -p "$STAGE2_KIF_BUILD_DIR"
    stage2_kif_link=false
    if [ -n "$KOFUN_STAGE2_SEMANTIC_OBJECT_ID" ]; then
        kofun_stage2_semantic_executable_identity "$ROOT" kif \
            "$KOFUN_STAGE2_SEMANTIC_PRODUCER_INPUT" \
            "$KOFUN_STAGE2_SEMANTIC_EVENTS_INPUT" \
            "$KOFUN_STAGE2_SEMANTIC_SHA256_INPUT"
        STAGE2_KIF_COMPILER="$STAGE2_KIF_BUILD_DIR/kofun-stage2-kif.$KOFUN_STAGE2_SEMANTIC_EXECUTABLE_ID"
        kofun_stage2_semantic_executable_validate "$STAGE2_KIF_COMPILER"
        if [ ! -x "$STAGE2_KIF_COMPILER" ]; then
            stage2_kif_link=true
        fi
    elif [ ! -x "$STAGE2_KIF_COMPILER" ] ||
         [ "$STAGE2_KIF_SOURCE" -nt "$STAGE2_KIF_COMPILER" ] ||
         [ "$KOFUN_STAGE2_SEMANTIC_PRODUCER_INPUT" -nt "$STAGE2_KIF_COMPILER" ] ||
         [ "$KOFUN_STAGE2_SEMANTIC_EVENTS_INPUT" -nt "$STAGE2_KIF_COMPILER" ] ||
         [ "$STAGE2_KIF_CODEC" -nt "$STAGE2_KIF_COMPILER" ] ||
         [ "$KOFUN_STAGE2_SEMANTIC_SHA256_INPUT" -nt "$STAGE2_KIF_COMPILER" ] ||
         [ "$STAGE2_SEED_C" -nt "$STAGE2_KIF_COMPILER" ]
    then
        stage2_kif_link=true
    fi
    if [ "$stage2_kif_link" = true ]; then
        kofun_stage2_semantic_executable_link "$STAGE2_KIF_COMPILER" \
            "$CC" -std=c11 -O2 -Wall -Wextra -Werror -pedantic \
            -DKOFUN_STAGE2_SEMANTIC_PRODUCER_LIBRARY \
            -I"$ROOT/bootstrap/stage2" \
            "$STAGE2_KIF_SOURCE" \
            "$KOFUN_STAGE2_SEMANTIC_PRODUCER_INPUT" \
            "$KOFUN_STAGE2_SEMANTIC_EVENTS_INPUT" \
            "$STAGE2_KIF_CODEC" \
            "$KOFUN_STAGE2_SEMANTIC_SHA256_INPUT"
    fi
}

ensure_c_abi_compiler() {
    mkdir -p "$C_ABI_BUILD_DIR"
    if [ ! -x "$C_ABI_COMPILER" ] ||
       [ "$C_ABI_SEED_C" -nt "$C_ABI_COMPILER" ]
    then
        "$CC" -std=c11 -O2 -Wall -Wextra -Werror \
            "$C_ABI_SEED_C" -o "$C_ABI_COMPILER"
    fi
}

ensure_cli_compiler() {
    mkdir -p "$CLI_BUILD_DIR"
    if [ ! -x "$CLI_COMPILER" ] ||
       [ "$CLI_SEED_C" -nt "$CLI_COMPILER" ] ||
       [ "$CLI_TEMPLATE" -nt "$CLI_COMPILER" ]
    then
        "$CC" -std=c11 -O2 -Wall -Wextra -Werror \
            "$CLI_SEED_C" -o "$CLI_COMPILER"
    fi
}

resolve_frost() {
    if test -n "${KOFUN_FROST-}"; then
        test -x "$KOFUN_FROST" || {
            printf '%s\n' \
                "kofun: KOFUN_FROST is not executable: $KOFUN_FROST" >&2
            exit 2
        }
        printf '%s\n' "$KOFUN_FROST"
        return
    fi
    if command -v frost >/dev/null 2>&1; then
        command -v frost
        return
    fi
    printf '%s\n' \
        "kofun: kofun.toml requires the frost-build engine; set KOFUN_FROST or install frost" >&2
    exit 2
}

prepare_frost_workspace() {
    project_root=$1
    engine_root=$2
    manifest=$project_root/kofun.toml

    test ! -L "$project_root/.kofun" &&
        test ! -L "$engine_root" || {
        printf '%s\n' \
            "kofun: refusing a symlinked .kofun build directory" >&2
        exit 2
    }
    mkdir -p "$engine_root"
    if test ! -f "$engine_root/frost.toml" ||
       ! cmp -s "$manifest" "$engine_root/frost.toml"
    then
        temporary_manifest="$engine_root/frost.toml.tmp.$$"
        trap 'rm -f "$temporary_manifest"' 0 1 2 15
        cp "$manifest" "$temporary_manifest"
        mv "$temporary_manifest" "$engine_root/frost.toml"
        trap - 0 1 2 15
    fi

    for mirrored in \
        "$engine_root"/* \
        "$engine_root"/.[!.]* \
        "$engine_root"/..?*
    do
        test -e "$mirrored" || test -L "$mirrored" || continue
        name=${mirrored##*/}
        case $name in
            .|..|.frost|frost.toml) continue ;;
        esac
        if test -L "$mirrored"; then
            test -e "$mirrored" || rm -f "$mirrored"
        else
            printf '%s\n' \
                "kofun: unexpected generated workspace entry: $mirrored" >&2
            exit 2
        fi
    done

    for entry in \
        "$project_root"/* \
        "$project_root"/.[!.]* \
        "$project_root"/..?*
    do
        test -e "$entry" || test -L "$entry" || continue
        name=${entry##*/}
        case $name in
            .|..|.git|.frost|.kofun|frost.toml|kofun.toml) continue ;;
        esac
        mirrored=$engine_root/$name
        if test -L "$mirrored"; then
            test "$(readlink "$mirrored")" = "$entry" || {
                printf '%s\n' \
                    "kofun: stale project mirror: $mirrored" >&2
                exit 2
            }
        elif test -e "$mirrored"; then
            printf '%s\n' \
                "kofun: project mirror conflicts with: $mirrored" >&2
            exit 2
        else
            ln -s "$entry" "$mirrored"
        fi
    done
}

build_project() (
    project_root=$(pwd -P)
    manifest=$project_root/kofun.toml
    test -f "$manifest" || {
        printf '%s\n' \
            "kofun: project build requires ./kofun.toml" >&2
        exit 2
    }
    frost=$(resolve_frost)
    engine_root=$project_root/.kofun/frost-workspace
    prepare_frost_workspace "$project_root" "$engine_root"
    PATH="$ROOT/bin${PATH:+:$PATH}" \
        "$frost" -C "$engine_root" build "$@"
)

require_source() {
    case ${1-} in
        *.kofun) ;;
        *)
            printf '%s\n' "kofun: source must use the .kofun extension" >&2
            exit 2
            ;;
    esac
    test -f "$1" || {
        printf '%s\n' "kofun: source not found: $1" >&2
        exit 2
    }
}

sidecar_cli_error() {
    printf '%s\n' "ETS01: $1" >&2
    exit 2
}

kif_cli_error() {
    printf '%s\n' "EKI01: $1" >&2
    exit 2
}

canonical_sidecar_generation() {
    value=$1
    case $value in
        ''|*[!0-9]*)
            return 1
            ;;
        0)
            return 0
            ;;
        0*)
            return 1
            ;;
    esac
    test "${#value}" -le 16 || return 1
    if test "${#value}" -eq 16; then
        first=$(
            printf '%s\n%s\n' "$value" 9007199254740991 |
                LC_ALL=C sort |
                sed -n '1p'
        )
        test "$first" = "$value" || return 1
    fi
}

sidecar_logical_path() (
    source=$1
    case $source in
        "$ROOT"/*)
            printf '%s\n' "${source#"$ROOT"/}"
            ;;
        /*)
            basename "$source"
            ;;
        *)
            while test "${source#./}" != "$source"; do
                source=${source#./}
            done
            case /$source/ in
                */../*|*/./*|*//*)
                    basename "$source"
                    ;;
                *)
                    printf '%s\n' "$source"
                    ;;
            esac
            ;;
    esac
)

validate_sidecar_destination() {
    source=$1
    destination=$2
    test "$destination" != "-" ||
        sidecar_cli_error "typed-sidecar output cannot be standard output"
    parent=$(dirname "$destination")
    test -d "$parent" ||
        sidecar_cli_error "typed-sidecar output parent must already exist"
    test ! -L "$destination" ||
        sidecar_cli_error "typed-sidecar output cannot be a symlink"
    if test -e "$destination"; then
        test -f "$destination" ||
            sidecar_cli_error "typed-sidecar output must be a regular file"
        test ! "$destination" -ef "$source" ||
            sidecar_cli_error "typed-sidecar output cannot replace the source"
    fi
}

validate_kif_destination() {
    source=$1
    destination=$2
    test "$destination" != "-" ||
        kif_cli_error "KIF output cannot be standard output"
    parent=$(dirname "$destination")
    test -d "$parent" ||
        kif_cli_error "KIF output parent must already exist"
    test ! -L "$destination" ||
        kif_cli_error "KIF output cannot be a symlink"
    if test -e "$destination"; then
        test -f "$destination" ||
            kif_cli_error "KIF output must be a regular file"
        test ! "$destination" -ef "$source" ||
            kif_cli_error "KIF output cannot replace the source"
    fi
}

check_with_kif() (
    input=$1
    output=$2
    validate_kif_destination "$input" "$output"
    logical_path=$(sidecar_logical_path "$input")
    ensure_stage2_kif_compiler
    exec "$STAGE2_KIF_COMPILER" \
        "$input" "$logical_path" "$output" 2026
)

check_with_typed_sidecar() (
    input=$1
    shift
    output=
    generation=
    emit_seen=false
    generation_seen=false
    test "$#" -eq 4 ||
        sidecar_cli_error "typed-sidecar output and generation are required together"
    while test "$#" -gt 0; do
        option=$1
        shift
        test "$#" -gt 0 ||
            sidecar_cli_error "typed-sidecar option value is missing"
        value=$1
        shift
        case $option in
            --emit-typed-sidecar)
                test "$emit_seen" = false ||
                    sidecar_cli_error "typed-sidecar output option is repeated"
                emit_seen=true
                output=$value
                ;;
            --generation)
                test "$generation_seen" = false ||
                    sidecar_cli_error "typed-sidecar generation option is repeated"
                generation_seen=true
                generation=$value
                ;;
            *)
                sidecar_cli_error "unsupported typed-sidecar check option"
                ;;
        esac
    done
    test "$emit_seen" = true && test "$generation_seen" = true ||
        sidecar_cli_error "typed-sidecar output and generation are required together"
    canonical_sidecar_generation "$generation" ||
        sidecar_cli_error "generation must be canonical decimal 0..9007199254740991"
    validate_sidecar_destination "$input" "$output"
    command -v node >/dev/null 2>&1 ||
        sidecar_cli_error "typed-sidecar emission requires node"

    mkdir -p "$ROOT/build"
    work=$(mktemp -d "$ROOT/build/kofun-check-sidecar.XXXXXX")
    trap 'rm -rf "$work"' 0 1 2 15
    compile_events=$work/compile-events.kse
    ownership_events=$work/ownership-events.kse
    producer_stdout=$work/compile.stdout
    producer_stderr=$work/compile.stderr
    ownership_stdout=$work/ownership.stdout
    ownership_stderr=$work/ownership.stderr
    stage1_stdout=$work/stage1.stdout
    stage1_stderr=$work/stage1.stderr
    frozen_stdout=$work/frozen.stdout
    frozen_stderr=$work/frozen.stderr
    emitter_stdout=$work/emitter.stdout
    emitter_stderr=$work/emitter.stderr
    logical_path=$(sidecar_logical_path "$input")
    ensure_stage2_events_compiler
    set +e
    "$STAGE2_EVENTS_COMPILER" \
        "$input" "$logical_path" "$compile_events" "$generation" \
        >"$producer_stdout" 2>"$producer_stderr"
    compile_status=$?
    set -e

    compiler_status=$compile_status
    selected_events=$compile_events
    tooling_failure=
    : >"$frozen_stdout"
    : >"$frozen_stderr"

    if test ! -f "$compile_events"; then
        # The event adapter failed before it could publish the compiler result.
        # Run the unchanged public check path to freeze language behavior; the
        # tooling failure remains output-only and cannot affect that authority.
        set +e
        "$0" check "$input" >"$frozen_stdout" 2>"$frozen_stderr"
        compiler_status=$?
        set -e
        if grep -Eq '^ETS0[2346]: ' "$producer_stderr"; then
            tooling_failure=$producer_stderr
        else
            printf '%s\n' \
                "ETS02: committed source identity or span basis is unavailable" \
                >"$emitter_stderr"
            tooling_failure=$emitter_stderr
        fi
        selected_events=
    elif test "$compile_status" -eq 0; then
        printf '%s\n' "ok: $input" >"$frozen_stdout"
    else
        stage1_accepted=false
        if test "$compile_status" -eq 3; then
            ensure_compiler
            set +e
            "$COMPILER" "$input" "$work/stage1.c" \
                >"$stage1_stdout" 2>"$stage1_stderr"
            stage1_status=$?
            set -e
            if test "$stage1_status" -eq 0 &&
               test -s "$work/stage1.c"
            then
                stage1_accepted=true
            fi
        fi
        if "$stage1_accepted"; then
            printf '%s\n' "ok: $input" >"$frozen_stdout"
            compiler_status=0
            selected_events=
            printf '%s\n' \
                "ETS02: Stage 1 compatibility acceptance has no Stage 2 semantic stream" \
                >"$emitter_stderr"
            tooling_failure=$emitter_stderr
        else
            set +e
            "$STAGE2_EVENTS_COMPILER" --check-ownership \
                "$input" "$logical_path" "$ownership_events" "$generation" \
                >"$ownership_stdout" 2>"$ownership_stderr"
            ownership_status=$?
            set -e
            if test ! -f "$ownership_events" &&
               grep -Eq '^ETS0[2346]: ' "$ownership_stderr"
            then
                # Preserve the established compiler/fallback orchestration if
                # the optional event projection itself could not be captured.
                set +e
                "$0" check "$input" >"$frozen_stdout" 2>"$frozen_stderr"
                compiler_status=$?
                set -e
                selected_events=
                tooling_failure=$ownership_stderr
            elif test "$ownership_status" -ne 0 &&
                 grep -Eq 'error\[(E007|E2S21)\]' "$ownership_stdout"
            then
                test ! -s "$ownership_stderr" ||
                    cat "$ownership_stderr" >"$frozen_stderr"
                test ! -s "$ownership_stdout" ||
                    cat "$ownership_stdout" >>"$frozen_stderr"
                compiler_status=$ownership_status
                selected_events=$ownership_events
            elif test "$compile_status" -eq 3 &&
                 test "$ownership_status" -eq 0
            then
                printf '%s\n' \
                    "ok: $input (Stage 2 Copy/borrow ownership slice; codegen unavailable)" \
                    >"$frozen_stdout"
                compiler_status=0
                selected_events=$ownership_events
            else
                test ! -s "$producer_stderr" ||
                    cat "$producer_stderr" >"$frozen_stderr"
                test ! -s "$producer_stdout" ||
                    cat "$producer_stdout" >>"$frozen_stderr"
                compiler_status=$compile_status
                selected_events=$compile_events
            fi
        fi
    fi

    emitter_status=3
    if test -n "$selected_events"; then
        set +e
        node "$TYPED_SIDECAR_EMITTER" \
            "$selected_events" "$output" "$input" \
            >"$emitter_stdout" 2>"$emitter_stderr"
        emitter_status=$?
        set -e
        test "$emitter_status" -eq 0 || tooling_failure=$emitter_stderr
    fi

    test ! -s "$frozen_stdout" || cat "$frozen_stdout"
    test ! -s "$frozen_stderr" || cat "$frozen_stderr" >&2
    if test "$emitter_status" -ne 0; then
        test -z "$tooling_failure" ||
            test ! -s "$tooling_failure" ||
            cat "$tooling_failure" >&2
        if test "$compiler_status" -ne 0; then
            exit "$compiler_status"
        fi
        exit 3
    fi
    exit "$compiler_status"
)

emit_c() (
    require_source "$1"
    temporary="$2.tmp.$$.c"
    stage1_stdout="$2.stage1.stdout.$$"
    stage1_stderr="$2.stage1.stderr.$$"
    stage2_stdout="$2.stage2.stdout.$$"
    stage2_stderr="$2.stage2.stderr.$$"
    stage2_ir="$2.stage2.ir.$$"
    stage2_tokens="$2.stage2.tokens.$$"
    trap 'rm -f "$temporary" "$stage1_stdout" "$stage1_stderr" "$stage2_stdout" "$stage2_stderr" "$stage2_ir" "$stage2_tokens"' 0 1 2 15
    ensure_stage2_compiler
    set +e
    "$STAGE2_COMPILER" \
        --compile-outcome \
        "$1" "$temporary" "$stage2_ir" "$stage2_tokens" \
        >"$stage2_stdout" 2>"$stage2_stderr"
    stage2_status=$?
    set -e
    if test "$stage2_status" -ne 0; then
        rm -f "$temporary"
        if test "$stage2_status" -eq 3; then
            ensure_compiler
            set +e
            "$COMPILER" "$1" "$temporary" \
                >"$stage1_stdout" 2>"$stage1_stderr"
            stage1_status=$?
            set -e
            if test "$stage1_status" -eq 0 && test -s "$temporary"; then
                mv "$temporary" "$2"
                printf '%s\n' "$2"
                exit 0
            fi
        fi
        test ! -s "$stage2_stderr" || cat "$stage2_stderr" >&2
        test ! -s "$stage2_stdout" || cat "$stage2_stdout" >&2
        exit "$stage2_status"
    fi
    test -s "$temporary" || exit 1
    mv "$temporary" "$2"
    printf '%s\n' "$2"
)

emit_c_abi() (
    require_source "$1"
    ensure_c_abi_compiler
    temporary="$2.tmp.$$"
    trap 'rm -f "$temporary"' 0 1 2 15
    "$C_ABI_COMPILER" "$1" "$temporary"
    test -s "$temporary" || exit 1
    mv "$temporary" "$2"
)

build_file() (
    emit_c "$1" "$3" >/dev/null
    "$CC" -std=c11 -O2 -Wall -Wextra -Werror \
        -I"$ROOT/bootstrap/stage2" "$3" -o "$2"
)

canonical_link_library() (
    candidate=$1
    case $candidate in
        -*|*'
'*)
            printf '%s\n' \
                "kofun: --link-library must be a file path, not an option" >&2
            exit 2
            ;;
    esac
    test -f "$candidate" || {
        printf '%s\n' \
            "kofun: --link-library is not a regular file: $candidate" >&2
        exit 2
    }
    directory=$(dirname "$candidate")
    basename=$(basename "$candidate")
    canonical_directory=$(CDPATH= cd -P -- "$directory" && pwd)
    printf '%s/%s\n' "$canonical_directory" "$basename"
)

build_c_abi_file() (
    input=$1
    output=$2
    emitted=$3
    link_libraries=$4
    package_names=$5
    offline=$6
    package_build_directory=
    if test -n "$package_names"; then
        previous_umask=$(umask)
        umask 077
        package_build_directory=$(
            mktemp -d "${TMPDIR:-/tmp}/kofun-package-build.XXXXXX"
        )
        umask "$previous_umask"
        trap 'rm -rf "$package_build_directory"' 0 1 2 15
        set -f
        previous_ifs=$IFS
        IFS='
'
        for package_name in $package_names; do
            package_library=$(
                KOFUN_OFFLINE=$offline \
                    sh "$PACKAGE_MANAGER" snapshot \
                    "$package_name" "$package_build_directory"
            )
            if test -z "$link_libraries"; then
                link_libraries=$package_library
            else
                link_libraries="$link_libraries
$package_library"
            fi
        done
        IFS=$previous_ifs
    fi
    emit_c_abi "$input" "$emitted"
    set -f
    if test -n "$link_libraries"; then
        previous_ifs=$IFS
        IFS='
'
        set -- $link_libraries
        IFS=$previous_ifs
    else
        set --
    fi
    "$CC" -std=c11 -O2 -Wall -Wextra -Werror \
        "$emitted" "$@" -o "$output"
)

build_native_file() (
    ensure_native_compiler
    temporary="$2.tmp.$$"
    trap 'rm -f "$temporary"' 0 1 2 15
    if test "$4" = true; then
        "$NATIVE_COMPILER" "$1" "$3" -g "$temporary"
    else
        "$NATIVE_COMPILER" "$1" "$3" "$temporary"
    fi
    test -s "$temporary"
    chmod +x "$temporary"
    mv "$temporary" "$2"
)

build_wasm_file() (
    ensure_wasm_compiler
    temporary="$2.tmp.$$"
    trap 'rm -f "$temporary"' 0 1 2 15
    if test "$3" = hostabi1; then
        "$WASM_COMPILER" --hostabi1 "$1" "$temporary"
    else
        "$WASM_COMPILER" "$1" "$temporary"
    fi
    test -s "$temporary"
    mv "$temporary" "$2"
)

build_cli_file() (
    ensure_cli_compiler
    temporary="$2.tmp.$$"
    trap 'rm -f "$temporary"' 0 1 2 15
    "$CLI_COMPILER" "$1" "$temporary"
    test -s "$temporary"
    chmod +x "$temporary"
    mv "$temporary" "$2"
)

new_cli_project() (
    project=$1
    case $project in
        ''|-*|*[!A-Za-z0-9_./-]*)
            printf '%s\n' \
                "kofun: CLI project path contains unsupported characters: $project" >&2
            exit 2
            ;;
    esac
    test ! -e "$project" && test ! -L "$project" || {
        printf '%s\n' "kofun: project path already exists: $project" >&2
        exit 2
    }
    project_name=${project##*/}
    case $project_name in
        ''|[!A-Za-z]*|*[!A-Za-z0-9_-]*)
            printf '%s\n' \
                "kofun: CLI project name must start with a letter and use letters, digits, '_' or '-'" >&2
            exit 2
            ;;
    esac
    type_name=$(printf '%s' "$project_name" | tr '-' '_')
    mkdir -p "$project/src"
    cat >"$project/src/main.kofun" <<EOF
cli $type_name {
    name "$project_name"
    version "0.1.0"
    about "A native Kofun CLI application"

    command greet {
        about "Greet a person"
        position NAME "Person to greet"
        option shout "--shout" bool "Uppercase the greeting"
        option prefix "--prefix" text "Greeting prefix" default "Hello"
        action greet
    }

    command status {
        about "Render a terminal-aware progress status"
        position LABEL "Status label"
        action status
    }
}
EOF
    cat >"$project/README.md" <<EOF
# $project_name

Build the Linux x86-64 static executable:

\`\`\`sh
kofun build src/main.kofun --framework cli -o build/$project_name
./build/$project_name --help
\`\`\`
EOF
    printf '%s\n' "$project"
)

case ${1-} in
    --version|-V|version)
        # VERSION is the one authority. Reporting a literal here is how the
        # reported version drifted eleven tags behind the repository while a
        # test asserted the stale string, so the number is read rather than
        # written twice.
        version=$(cat "$ROOT/VERSION" 2>/dev/null) || version=""
        test -n "$version" || {
            printf '%s\n' "kofun: VERSION is missing or empty" >&2
            exit 1
        }
        printf '%s\n' "Kofun Stage 1 $version"
        ;;
    bootstrap)
        test "$#" -eq 1 || { usage >&2; exit 2; }
        exec sh "$ROOT/bootstrap/stage1/check.sh"
        ;;
    new)
        test "$#" -eq 4 &&
            test "$3" = --template &&
            test "$4" = cli || {
            usage >&2
            exit 2
        }
        new_cli_project "$2"
        ;;
    emit-c)
        test "$#" -eq 3 || { usage >&2; exit 2; }
        emit_c "$2" "$3"
        ;;
    bindgen-c)
        shift
        command -v node >/dev/null 2>&1 || {
            printf '%s\n' "kofun: bindgen-c requires node" >&2
            exit 2
        }
        exec node "$ROOT/tooling/bindgen-c/bindgen-c.mjs" "$@"
        ;;
    package)
        shift
        exec sh "$PACKAGE_MANAGER" "$@"
        ;;
    check)
        if test "$#" -eq 4 && test "$3" = --emit-kif; then
            require_source "$2"
            check_with_kif "$2" "$4"
            exit $?
        fi
        if test "$#" -ne 2; then
            test "$#" -ge 3 ||
                sidecar_cli_error "typed-sidecar check arguments are incomplete"
            require_source "$2"
            input=$2
            shift 2
            check_with_typed_sidecar "$input" "$@"
            exit $?
        fi
        require_source "$2"
        work=$(mktemp -d "${TMPDIR:-/tmp}/kofun-check.XXXXXX")
        trap 'rm -rf "$work"' 0 1 2 15
        set +e
        emit_c "$2" "$work/output.c" \
            >"$work/compile.stdout" 2>"$work/compile.stderr"
        compile_status=$?
        set -e
        if test "$compile_status" -eq 0; then
            printf '%s\n' "ok: $2"
            exit 0
        fi
        if test "$compile_status" -eq 1 ||
           test "$compile_status" -eq 3
        then
            ensure_stage2_compiler
            set +e
            "$STAGE2_COMPILER" --check-ownership "$2" \
                >"$work/ownership.stdout" 2>"$work/ownership.stderr"
            ownership_status=$?
            set -e
            if test "$ownership_status" -ne 0 &&
               grep -Eq 'error\[(E007|E2S21)\]' "$work/ownership.stdout"
            then
                test ! -s "$work/ownership.stderr" ||
                    cat "$work/ownership.stderr" >&2
                test ! -s "$work/ownership.stdout" ||
                    cat "$work/ownership.stdout" >&2
                exit "$ownership_status"
            fi
            if test "$compile_status" -eq 3 &&
               test "$ownership_status" -eq 0
            then
                printf '%s\n' \
                    "ok: $2 (Stage 2 Copy/borrow ownership slice; codegen unavailable)"
                exit 0
            fi
        fi
        test ! -s "$work/compile.stderr" ||
            cat "$work/compile.stderr" >&2
        test ! -s "$work/compile.stdout" ||
            cat "$work/compile.stdout" >&2
        exit "$compile_status"
        ;;
    build)
        shift
        case ${1-} in
            *.kofun) ;;
            *)
                if test -f ./kofun.toml; then
                    build_project "$@"
                    exit $?
                fi
                test "$#" -gt 0 || {
                    printf '%s\n' \
                        "kofun: build needs INPUT.kofun or ./kofun.toml" >&2
                    exit 2
                }
                ;;
        esac
        input=${1-}
        test "$#" -gt 0 && shift
        require_source "$input"
        output=${input%.kofun}
        emitted=
        backend=
        c_abi=false
        framework=
        link_libraries=
        package_names=
        offline=false
        target=
        debug=false
        while test "$#" -gt 0; do
            case "$1" in
                -o|--output)
                    test "$#" -ge 2 || { usage >&2; exit 2; }
                    output=$2
                    shift 2
                    ;;
                --emit-c)
                    test "$#" -ge 2 || { usage >&2; exit 2; }
                    emitted=$2
                    shift 2
                    ;;
                --backend)
                    test "$#" -ge 2 && test "$2" = c || {
                        printf '%s\n' "kofun: Stage 1 exposes only the C11 bootstrap backend" >&2
                        exit 2
                    }
                    backend=c
                    shift 2
                    ;;
                --c-abi)
                    c_abi=true
                    shift
                    ;;
                --framework)
                    test "$#" -ge 2 && test "$2" = cli || {
                        printf '%s\n' \
                            "kofun: supported application framework is cli" >&2
                        exit 2
                    }
                    framework=cli
                    shift 2
                    ;;
                --link-library)
                    test "$#" -ge 2 || { usage >&2; exit 2; }
                    link_library=$(canonical_link_library "$2")
                    if test -z "$link_libraries"; then
                        link_libraries=$link_library
                    else
                        link_libraries="$link_libraries
$link_library"
                    fi
                    shift 2
                    ;;
                --link-library=*)
                    printf '%s\n' \
                        "kofun: pass --link-library and its file path separately" >&2
                    exit 2
                    ;;
                --package)
                    test "$#" -ge 2 || { usage >&2; exit 2; }
                    if test -z "$package_names"; then
                        package_names=$2
                    else
                        package_names="$package_names
$2"
                    fi
                    shift 2
                    ;;
                --package=*)
                    printf '%s\n' \
                        "kofun: pass --package and its dependency name separately" >&2
                    exit 2
                    ;;
                --offline)
                    offline=true
                    shift
                    ;;
                --target)
                    test "$#" -ge 2 || { usage >&2; exit 2; }
                    target=$2
                    shift 2
                    ;;
                -g)
                    debug=true
                    shift
                    ;;
                *)
                    printf '%s\n' "kofun: unknown build option: $1" >&2
                    exit 2
                    ;;
            esac
        done
        if "$c_abi"; then
            test "$backend" = c || {
                printf '%s\n' \
                    "kofun: --c-abi requires explicit --backend c" >&2
                exit 2
            }
        elif test -n "$link_libraries"; then
            printf '%s\n' \
                "kofun: --link-library requires --backend c --c-abi" >&2
            exit 2
        fi
        if test -n "$package_names" && ! "$c_abi"; then
            printf '%s\n' \
                "kofun: --package requires --backend c --c-abi" >&2
            exit 2
        fi
        if "$offline" && test -z "$package_names"; then
            printf '%s\n' \
                "kofun: --offline currently applies only to --package" >&2
            exit 2
        fi
        if test -n "$framework"; then
            test -z "$backend" &&
                test -z "$target" &&
                test -z "$emitted" &&
                test "$debug" = false || {
                printf '%s\n' \
                    "kofun: --framework cli cannot be combined with backend, target, emit-c, or debug options" >&2
                exit 2
            }
            mkdir -p "$(dirname "$output")"
            build_cli_file "$input" "$output"
            printf '%s\n' "$output"
            exit 0
        fi
        if test -n "$target"; then
            test -z "$emitted" || {
                printf '%s\n' \
                    "kofun: --emit-c cannot be combined with --target" >&2
                exit 2
            }
            test -z "$backend" || {
                printf '%s\n' \
                    "kofun: --backend c cannot be combined with --target" >&2
                exit 2
            }
            if "$debug"; then
                case "$target" in
                    x86_64-linux|aarch64-linux) ;;
                    *)
                        printf '%s\n' \
                            "kofun: -g currently requires --target x86_64-linux or --target aarch64-linux" >&2
                        exit 2
                        ;;
                esac
            fi
            mkdir -p "$(dirname "$output")"
            case "$target" in
                wasm32)
                    build_wasm_file "$input" "$output" legacy
                    ;;
                wasm32-hostabi1)
                    build_wasm_file "$input" "$output" hostabi1
                    ;;
                x86_64-linux|aarch64-linux)
                    build_native_file "$input" "$output" "$target" "$debug"
                    ;;
                *)
                    printf '%s\n' \
                        "kofun: unsupported target: $target" >&2
                    exit 2
                    ;;
            esac
            printf '%s\n' "$output"
            exit 0
        fi
        if "$debug"; then
            printf '%s\n' \
                "kofun: -g requires --target x86_64-linux or --target aarch64-linux" >&2
            exit 2
        fi
        if test -z "$emitted"; then
            emitted="$BUILD_DIR/$(basename "${input%.kofun}").c"
        fi
        mkdir -p "$(dirname "$output")" "$(dirname "$emitted")"
        if "$c_abi"; then
            build_c_abi_file \
                "$input" "$output" "$emitted" "$link_libraries" \
                "$package_names" "$offline"
        else
            build_file "$input" "$output" "$emitted"
        fi
        printf '%s\n' "$output"
        ;;
    run)
        test "$#" -eq 2 || { usage >&2; exit 2; }
        require_source "$2"
        work=$(mktemp -d "${TMPDIR:-/tmp}/kofun-run.XXXXXX")
        trap 'rm -rf "$work"' 0 1 2 15
        build_file "$2" "$work/program" "$work/program.c"
        "$work/program"
        ;;
    unittest)
        shift
        exec sh "$ROOT/tooling/kotest/run.sh" "$@"
        ;;
    test)
        test "$#" -le 2 || { usage >&2; exit 2; }
        root=${2-"$ROOT/bootstrap/fixtures"}
        if test -d "$root" &&
           test -f "$root/expectations.kofun" &&
           test -f "$ROOT/tests/conformance/run.sh"
        then
            exec sh "$ROOT/tests/conformance/run.sh" "$root"
        fi
        ensure_compiler
        work=$(mktemp -d "${TMPDIR:-/tmp}/kofun-test.XXXXXX")
        trap 'rm -rf "$work"' 0 1 2 15
        passed=0
        skipped=0
        failed=0
        if test -f "$root"; then
            files=$root
        else
            files=$(find "$root" -type f -name '*.kofun' \
                ! -name 'expectations.kofun' -print | LC_ALL=C sort)
        fi
        for source in $files; do
            stem=$(basename "${source%.kofun}")
            c_file="$work/$stem.c"
            binary="$work/$stem"
            if ! emit_c "$source" "$c_file" >/dev/null 2>&1; then
                printf '%s\n' "SKIP $source (outside Stage 1 Core)"
                skipped=$((skipped + 1))
                continue
            fi
            if ! "$CC" -std=c11 -O2 -Wall -Wextra -Werror \
                -I"$ROOT/bootstrap/stage2" "$c_file" -o "$binary"; then
                printf '%s\n' "FAIL $source"
                failed=$((failed + 1))
                continue
            fi
            set +e
            "$binary" >"$work/$stem.stdout" 2>"$work/$stem.stderr"
            status=$?
            set -e
            actual_stdout=$(cat "$work/$stem.stdout")
            actual_stderr=$(cat "$work/$stem.stderr")
            expected_status=$(sed -n 's/^# expect-exit: //p' "$source" | sed -n '1p')
            expected_stdout=$(sed -n \
                -e 's/^# expect: //p' \
                -e 's/^# expect-stdout: //p' "$source")
            expected_stderr=$(sed -n 's/^# expect-stderr: //p' "$source")
            if test -z "$expected_status"; then
                expected_status=0
            fi
            if test "$status" -ne "$expected_status"; then
                printf '%s\n' "FAIL $source (expected exit $expected_status, got $status)"
                failed=$((failed + 1))
                continue
            fi
            if test -n "$expected_stdout" && test "$actual_stdout" != "$expected_stdout"; then
                printf '%s\n' "FAIL $source (stdout mismatch)"
                failed=$((failed + 1))
                continue
            fi
            if test -n "$expected_stderr" && test "$actual_stderr" != "$expected_stderr"; then
                printf '%s\n' "FAIL $source (stderr mismatch)"
                failed=$((failed + 1))
                continue
            fi
            printf '%s\n' "PASS $source"
            passed=$((passed + 1))
        done
        total=$((passed + failed + skipped))
        executed=$((passed + failed))
        printf '%s\n' \
            "$passed passed; $failed failed; $skipped explicitly skipped" \
            "coverage: $executed/$total cases executed by Stage 1"
        test "$passed" -gt 0
        test "$failed" -eq 0
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        printf '%s\n' "kofun: unknown command: ${1-}" >&2
        usage >&2
        exit 2
        ;;
esac
