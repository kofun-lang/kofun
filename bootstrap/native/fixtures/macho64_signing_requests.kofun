# The gate prepends macho64_signing_request_status from encoder.kofun.

fn main() {
    print(macho64_signing_request_status(16777223, 9, 0, 255, 5, 102, 117))
    print(macho64_signing_request_status(0, 9, 0, 255, 5, 102, 117))
    print(macho64_signing_request_status(16777223, 0, 0, 0, 5, 102, 117))
    print(macho64_signing_request_status(16777228, 3585, 0, 255, 5, 102, 117))
    print(macho64_signing_request_status(16777223, 9, -1, 255, 5, 102, 117))
    print(macho64_signing_request_status(16777228, 12, 0, 256, 5, 102, 117))
    print(macho64_signing_request_status(16777223, 9, 0, 255, 0, 0, 0))
    print(macho64_signing_request_status(16777228, 12, 0, 255, 64, 1, 127))
    print(macho64_signing_request_status(16777223, 9, 0, 255, 5, 0, 117))
    print(macho64_signing_request_status(16777228, 12, 0, 255, 5, 102, 128))
}
