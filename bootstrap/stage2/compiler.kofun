# Kofun Stage 2 semantic-front-end checkpoint.
#
# This compiler is intentionally written in the typed bootstrap subset already
# used by Stage 1: Int, Bool, Text, List[Text], control flow, direct calls, and
# file/text builtins.  Its first fixed-point projection is conservative:
# tokenize and parse a Kofun compilation unit, emit a stable textual IR, then
# reproduce the accepted Kofun source byte-for-byte. A statement/expression
# parser also lowers the integer Core to deterministic, checked C11.
#
# The exact source projection remains useful before this compiler can lower its
# own full source: any change made by the front end would make the second
# projection differ.

fn identifier_start(symbol: Text) -> Bool {
    return symbol == "_" || is_xid_start(symbol)
}

fn identifier_continue(symbol: Text) -> Bool {
    return symbol == "_" || is_xid_continue(symbol)
}

fn skip_trivia(source: Text, start: Int) -> Int {
    let symbols = chars(source)
    let mut cursor = start
    while cursor < len(symbols) {
        if is_space(symbols[cursor]) {
            cursor = cursor + 1
        } else if symbols[cursor] == "#" {
            while cursor < len(symbols) && symbols[cursor] != "\n" {
                cursor = cursor + 1
            }
        } else {
            return cursor
        }
    }
    return cursor
}

fn string_end(source: Text, start: Int) -> Int {
    let symbols = chars(source)
    let mut cursor = start + 1
    let mut escaped = false
    while cursor < len(symbols) {
        let symbol = symbols[cursor]
        if escaped {
            escaped = false
        } else if symbol == "\\" {
            escaped = true
        } else if symbol == "\"" {
            return cursor + 1
        } else if symbol == "\n" {
            return -1
        }
        cursor = cursor + 1
    }
    return -1
}

# ---------------------------------------------------------- text literals
#
# #1357. A `Text` literal used to reach the emitter as a slice of the source,
# quotes and backslashes included, so every escape meant whatever the host C
# compiler decided. Three spellings emitted invalid C while the compiler
# exited 0, `\0` truncated the value at the NUL, and `\u{41}` depended on the
# host compiler being new enough to implement delimited escapes.
#
# The set below is closed and is the same fact as the one written in
# `docs/SEMANTICS.md` and `spec/grammar.ebnf`. It was chosen by measuring what
# Kofun sources actually contain rather than by copying C's table: every source
# this backend lowers uses only `\n`, `\t`, `\r`, `\\`, and `\"`, and `\b`
# and `\f` are added because `stdlib/json` and `stdlib/toml` already write them
# as Text literals.
#
# Anything else is refused at the escape's own byte, which is the difference
# between a diagnostic a reader can act on and `cc` naming a generated file.

fn text_escape_byte(symbol: Text) -> Text {
    if symbol == "n" {
        return "\n"
    }
    if symbol == "t" {
        return "\t"
    }
    if symbol == "r" {
        return "\r"
    }
    if symbol == "b" {
        return "\b"
    }
    if symbol == "f" {
        return "\f"
    }
    if symbol == "\\" {
        return "\\"
    }
    if symbol == "\"" {
        return "\""
    }
    return ""
}

# The canonical C spelling of one decoded character. Only the five control
# characters and the two C metacharacters are escaped; every other byte,
# including a UTF-8 continuation byte, is written as itself so the emitted C
# reads the way the source did.
fn text_c_escape(symbol: Text) -> Text {
    if symbol == "\n" {
        return "\\n"
    }
    if symbol == "\t" {
        return "\\t"
    }
    if symbol == "\r" {
        return "\\r"
    }
    if symbol == "\b" {
        return "\\b"
    }
    if symbol == "\f" {
        return "\\f"
    }
    if symbol == "\\" {
        return "\\\\"
    }
    if symbol == "\"" {
        return "\\\""
    }
    return symbol
}

# Decode the literal at `start` and re-encode it as a canonical C string
# literal, or return an `error[...]` the caller propagates. The emitted C
# cannot contain an escape the source did not define, because every byte is
# written by `text_c_escape` rather than copied.
fn text_literal_c_form(source: Text, start: Int) -> Text {
    let symbols = chars(source)
    let finish = string_end(source, start)
    if finish < 0 {
        return "error[E2S12]: unterminated Text literal at byte " +
        to_text(start)
    }
    let mut cursor = start + 1
    let mut emitted = "\""
    while cursor < finish - 1 {
        let symbol = symbols[cursor]
        if symbol == "\\" {
            if cursor + 1 >= finish - 1 {
                return "error[E2S12]: Text literal ends inside an escape at byte " +
                to_text(cursor)
            }
            let escape = symbols[cursor + 1]
            if escape == "0" {
                return "error[E2S12]: `\\0` is not a Kofun Text escape; Text cannot carry an embedded NUL at byte " +
                to_text(cursor)
            }
            let decoded = text_escape_byte(escape)
            if len(decoded) == 0 {
                return "error[E2S12]: `\\" + escape +
                "` is not a Kofun Text escape; the set is \\n \\t \\r \\b \\f \\\\ \\\" at byte " +
                to_text(cursor)
            }
            emitted = emitted + text_c_escape(decoded)
            cursor = cursor + 2
        } else {
            emitted = emitted + text_c_escape(symbol)
            cursor = cursor + 1
        }
    }
    return emitted + "\""
}

fn pair_token(token: Text) -> Bool {
    return token == "->" || token == "==" || token == "!=" ||
    token == "<=" || token == ">=" || token == "&&" ||
    token == "||" || token == "//" || token == ".." ||
    token == "**" || token == "??" || token == "|>" ||
    token == "=>"
}

fn token_end(source: Text, start: Int) -> Int {
    let symbols = chars(source)
    if start >= len(symbols) {
        return start
    }

    let first = symbols[start]
    if first == "\"" {
        return string_end(source, start)
    }

    let mut cursor = start + 1
    if identifier_start(first) {
        while cursor < len(symbols) && identifier_continue(symbols[cursor]) {
            cursor = cursor + 1
        }
        return cursor
    }

    if is_digit(first) {
        while cursor < len(symbols) &&
              (is_digit(symbols[cursor]) || symbols[cursor] == "_") {
            cursor = cursor + 1
        }
        # docs/DECIMAL.md: maximal munch with the range exception. A fraction
        # needs a digit after the point, so 1..2 stays Int, range, Int and 1.
        # stays Int followed by the point.
        if cursor + 1 < len(symbols) && symbols[cursor] == "." &&
           is_digit(symbols[cursor + 1]) {
            cursor = cursor + 1
            while cursor < len(symbols) &&
                  (is_digit(symbols[cursor]) || symbols[cursor] == "_") {
                cursor = cursor + 1
            }
        }
        # An exponent joins the token only when digits actually follow, so 1e
        # remains Int followed by the identifier e.
        if cursor < len(symbols) &&
           (symbols[cursor] == "e" || symbols[cursor] == "E") {
            let mut probe = cursor + 1
            if probe < len(symbols) &&
               (symbols[probe] == "+" || symbols[probe] == "-") {
                probe = probe + 1
            }
            if probe < len(symbols) && is_digit(symbols[probe]) {
                cursor = probe
                while cursor < len(symbols) &&
                      (is_digit(symbols[cursor]) || symbols[cursor] == "_") {
                    cursor = cursor + 1
                }
            }
        }
        # f64 is part of the numeric token, not an identifier.
        if cursor + 3 <= len(symbols) && symbols[cursor] == "f" &&
           symbols[cursor + 1] == "6" && symbols[cursor + 2] == "4" {
            cursor = cursor + 3
        }
        return cursor
    }

    if cursor < len(symbols) {
        let pair = text_slice(source, start, cursor + 1)
        if pair_token(pair) {
            return cursor + 1
        }
    }
    return cursor
}

fn token_text(source: Text, start: Int) -> Text {
    let end = token_end(source, start)
    if end < 0 {
        return ""
    }
    return text_slice(source, start, end)
}

fn keyword(token: Text) -> Bool {
    return token == "fn" || token == "let" || token == "mut" ||
    token == "return" || token == "if" || token == "else" ||
    token == "while" || token == "for" || token == "in" ||
    token == "break" || token == "continue" || token == "true" ||
    token == "false" || token == "match" || token == "type" ||
    token == "par"
}

fn token_kind(source: Text, start: Int) -> Text {
    let token = token_text(source, start)
    if len(token) == 0 {
        return "invalid"
    }
    let symbols = chars(token)
    if symbols[0] == "\"" {
        return "string"
    }
    if identifier_start(symbols[0]) {
        if keyword(token) {
            return "keyword"
        }
        return "identifier"
    }
    if is_digit(symbols[0]) {
        # An unsuffixed fractional or scientific literal denotes Decimal; the
        # f64 suffix selects binary64 Float (docs/DECIMAL.md). Neither has a
        # representation yet, so the kinds exist to gate the token contract and
        # to let a backend refuse them explicitly.
        let size = len(symbols)
        if size >= 3 && symbols[size - 3] == "f" &&
           symbols[size - 2] == "6" && symbols[size - 1] == "4" {
            return "float"
        }
        let mut scan = 0
        while scan < size {
            if symbols[scan] == "." || symbols[scan] == "e" ||
               symbols[scan] == "E" {
                return "decimal"
            }
            scan = scan + 1
        }
        return "integer"
    }
    return "punctuation"
}

fn line_at(source: Text, target: Int) -> Int {
    let symbols = chars(source)
    let mut line = 1
    let mut cursor = 0
    while cursor < target && cursor < len(symbols) {
        if symbols[cursor] == "\n" {
            line = line + 1
        }
        cursor = cursor + 1
    }
    return line
}

# Why the malformed forms are diagnosed here rather than in `token_end`, and
# what "malformed" means for each of them.
#
# `token_end` is deliberately permissive about `.`: a fraction needs a digit
# after the point, so `1..2` stays `Int`, `..`, `Int` and `1.` stays `Int`
# followed by the point. Tightening the scanner instead would have to decide
# between the range operator and a fraction with one character of lookahead,
# which is the collision `docs/DECIMAL.md` states the range exception exists to
# avoid. So the scanner keeps producing tokens and this pass reads the result,
# where `..` and a lone `.` are already distinct tokens.
#
# The rules, all measured against `docs/DECIMAL.md:97-118`:
#
# - a numeric token immediately followed by an identifier character is one
#   malformed literal, not a literal beside a name. This is what makes `1e`,
#   `1e+`, `1.0e` and `1._0` errors, and it is also why `42f64` is one token
#   while `42 f64` is two: the suffix joins only without a gap.
# - a numeric token immediately followed by a lone `.` is `1.`, a fraction with
#   no digits. A following `..` is the range operator and is left alone.
# - a lone `.` immediately followed by a digit is `.5`, a fraction with no
#   integer part.
# - `_` must sit between two digits, so `1_`, `1.0_` and `1_.0` are errors
#   while `1_000.000_1` is not.
#
# `_1` is absent on purpose. It is a well-formed identifier under the
# identifier grammar, not a numeric literal, and it already reports as an
# unknown binding at its own byte. Making it lexical here would ban an
# identifier spelling on the strength of a rule about numbers.
fn numeric_underscore_error(source: Text, start: Int, end: Int) -> Bool {
    let symbols = chars(source)
    let mut cursor = start
    while cursor < end {
        if symbols[cursor] == "_" {
            if cursor == start || cursor + 1 >= end {
                return true
            }
            if !is_digit(symbols[cursor - 1]) || !is_digit(symbols[cursor + 1]) {
                return true
            }
        }
        cursor = cursor + 1
    }
    return false
}

fn malformed_numeric_literal(source: Text, start: Int, end: Int) -> Bool {
    let symbols = chars(source)
    let kind = token_kind(source, start)
    if kind == "integer" || kind == "decimal" || kind == "float" {
        if numeric_underscore_error(source, start, end) {
            return true
        }
        if end < len(symbols) && identifier_start(symbols[end]) {
            return true
        }
        if end < len(symbols) && symbols[end] == "." {
            return end + 1 >= len(symbols) || symbols[end + 1] != "."
        }
        return false
    }
    # A lone `.` — `..` lexes as one two-character token, so a one-character
    # `.` token here is never the range operator.
    if end == start + 1 && symbols[start] == "." {
        return end < len(symbols) && is_digit(symbols[end])
    }
    return false
}

fn lex(source: Text) -> Text {
    let unicode_error = validate_unicode_source(source)
    if len(unicode_error) > 0 {
        return unicode_error
    }
    let mut tape = "kofun-token-tape/v1\n"
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        let end = token_end(source, cursor)
        if end <= cursor {
            return "error[E2S01]: unterminated string at byte " +
            to_text(cursor)
        }
        if malformed_numeric_literal(source, cursor, end) {
            return "error[E2S98]: malformed numeric literal at byte " +
            to_text(cursor) +
            "; `.` and an exponent need digits, and `_` must sit between " +
            "two digits"
        }
        tape = tape + token_kind(source, cursor) + "|" +
        to_text(cursor) + "|" + to_text(end) + "|" +
        to_text(line_at(source, cursor)) + "\n"
        cursor = skip_trivia(source, end)
    }
    return tape
}

# General Pattern syntax is preserved independently from executable match
# semantics. Results use a one-line state header followed by post-order node
# records so the bootstrap subset does not need tuples or mutable globals.

fn pattern_depth_limit() -> Int {
    return 32
}

fn pattern_node_limit() -> Int {
    return 256
}

fn pattern_line_field(value: Text, line_start: Int, wanted: Int) -> Text {
    let symbols = chars(value)
    let mut cursor = line_start
    let mut field = 0
    let mut field_start = line_start
    while cursor < len(symbols) && symbols[cursor] != "\n" {
        if symbols[cursor] == "|" {
            if field == wanted {
                return text_slice(value, field_start, cursor)
            }
            field = field + 1
            field_start = cursor + 1
        }
        cursor = cursor + 1
    }
    if field == wanted {
        return text_slice(value, field_start, cursor)
    }
    return ""
}

fn pattern_result_field(result: Text, wanted: Int) -> Text {
    return pattern_line_field(result, 0, wanted)
}

fn pattern_result_records(result: Text) -> Text {
    let symbols = chars(result)
    let mut cursor = 0
    while cursor < len(symbols) && symbols[cursor] != "\n" {
        cursor = cursor + 1
    }
    if cursor >= len(symbols) {
        return ""
    }
    return text_slice(result, cursor + 1, len(result))
}

fn pattern_result(
    end: Int,
    root: Int,
    next_id: Int,
    nodes: Int,
    errors: Int,
    fatal: Bool,
    kind: Text,
    limit_id: Int,
    records: Text
) -> Text {
    let mut fatal_text = "0"
    if fatal {
        fatal_text = "1"
    }
    return to_text(end) + "|" + to_text(root) + "|" +
    to_text(next_id) + "|" + to_text(nodes) + "|" +
    to_text(errors) + "|" + fatal_text + "|" + kind + "|" +
    to_text(limit_id) + "\n" + records
}

fn pattern_result_int(result: Text, field: Int) -> Int {
    return decimal_value(pattern_result_field(result, field))
}

fn pattern_error_result(
    start: Int,
    end: Int,
    reason: Text,
    next_id: Int,
    nodes: Int,
    errors: Int,
    limit_id: Int,
    fatal: Bool
) -> Text {
    if nodes >= pattern_node_limit() {
        return pattern_result(
            end, -1, next_id, nodes, errors, true, "ErrorPattern",
            limit_id, ""
        )
    }
    let id = next_id
    let records = "node|" + to_text(id) + "|ErrorPattern|" +
    to_text(start) + "|" + to_text(end) + "|" + reason + "\n" +
    "pattern-diagnostic|E2S58|" + reason + "|" +
    to_text(start) + "|" + to_text(end) + "\n"
    return pattern_result(
        end, id, next_id + 1, nodes + 1, errors + 1, fatal,
        "ErrorPattern", limit_id, records
    )
}

fn pattern_limit_result(
    source: Text,
    start: Int,
    next_id: Int,
    nodes: Int,
    errors: Int,
    limit_id: Int
) -> Text {
    let end = token_end(source, start)
    if limit_id >= 0 {
        return pattern_result(
            end, limit_id, next_id, nodes, errors, true,
            "ErrorPattern", limit_id, ""
        )
    }
    let id = next_id
    let records = "node|" + to_text(id) + "|ErrorPattern|" +
    to_text(start) + "|" + to_text(end) + "|node-limit\n" +
    "pattern-diagnostic|E2S58|node-limit|" + to_text(start) +
    "|" + to_text(end) + "\n"
    return pattern_result(
        end, id, next_id + 1, nodes, errors + 1, true,
        "ErrorPattern", id, records
    )
}

fn pattern_stop_token(source: Text, start: Int) -> Bool {
    let token = token_text(source, start)
    return start >= len(source) || token == "=>" || token == "," ||
    token == ")" || token == "}" || token == "if"
}

fn pattern_recovery_end(source: Text, start: Int) -> Int {
    let mut cursor = skip_trivia(source, start)
    let mut parens = 0
    let mut brackets = 0
    while cursor < len(source) {
        let token = token_text(source, cursor)
        if token == "=>" {
            return cursor
        }
        if token == "{" && parens == 0 && brackets == 0 {
            return cursor
        }
        if token == "}" && parens == 0 && brackets == 0 {
            return cursor
        }
        if token == "," && parens == 0 && brackets == 0 {
            return cursor
        }
        if token == "(" {
            parens = parens + 1
        } else if token == ")" {
            if parens == 0 {
                return cursor
            }
            parens = parens - 1
        } else if token == "[" {
            brackets = brackets + 1
        } else if token == "]" {
            if brackets == 0 {
                return cursor
            }
            brackets = brackets - 1
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return cursor
}

fn parse_pattern_or_result(
    source: Text,
    start: Int,
    depth: Int,
    next_id: Int,
    nodes: Int,
    errors: Int,
    limit_id: Int
) -> Text {
    let cursor = skip_trivia(source, start)
    let token = token_text(source, cursor)
    if token == "|" || token == "||" {
        let mut reason = "leading-or"
        if token == "||" {
            reason = "doubled-or"
        }
        return pattern_error_result(
            cursor, token_end(source, cursor), reason, next_id, nodes,
            errors, limit_id, false
        )
    }

    let first = parse_pattern_atomic_result(
        source, cursor, depth, next_id, nodes, errors, limit_id
    )
    if pattern_result_field(first, 5) == "1" {
        return first
    }
    let mut separator = skip_trivia(
        source,
        pattern_result_int(first, 0)
    )
    if token_text(source, separator) == "||" {
        return pattern_error_result(
            cursor, token_end(source, separator), "doubled-or",
            next_id, nodes, errors, limit_id, false
        )
    }
    if token_text(source, separator) != "|" {
        if token_text(source, separator) == ".." {
            let recovered = pattern_recovery_end(
                source,
                token_end(source, separator)
            )
            return pattern_error_result(
                cursor, recovered, "unsupported-range-pattern",
                next_id, nodes, errors, limit_id, false
            )
        }
        return first
    }

    let mut records = pattern_result_records(first)
    let mut children = pattern_result_field(first, 1)
    let mut current_next = pattern_result_int(first, 2)
    let mut current_nodes = pattern_result_int(first, 3)
    let mut current_errors = pattern_result_int(first, 4)
    let mut current_limit = pattern_result_int(first, 7)
    let mut alternatives = 1
    let mut end = pattern_result_int(first, 0)
    while separator < len(source) && token_text(source, separator) == "|" {
        records = records + "separator|OrPattern|" + to_text(cursor) +
        "|" + to_text(alternatives - 1) + "|" + to_text(separator) +
        "|" + to_text(token_end(source, separator)) + "\n"
        let next = skip_trivia(source, token_end(source, separator))
        if token_text(source, next) == "|" ||
           token_text(source, next) == "||" {
            return pattern_error_result(
                cursor, token_end(source, next), "doubled-or",
                next_id, nodes, errors, limit_id, false
            )
        }
        if pattern_stop_token(source, next) {
            return pattern_error_result(
                cursor, token_end(source, separator), "trailing-or",
                next_id, nodes, errors, limit_id, false
            )
        }
        let alternative = parse_pattern_atomic_result(
            source, next, depth, current_next, current_nodes,
            current_errors, current_limit
        )
        if pattern_result_field(alternative, 5) == "1" {
            return alternative
        }
        records = records + pattern_result_records(alternative)
        children = children + "," + pattern_result_field(alternative, 1)
        current_next = pattern_result_int(alternative, 2)
        current_nodes = pattern_result_int(alternative, 3)
        current_errors = pattern_result_int(alternative, 4)
        current_limit = pattern_result_int(alternative, 7)
        alternatives = alternatives + 1
        end = pattern_result_int(alternative, 0)
        separator = skip_trivia(source, end)
    }
    if token_text(source, separator) == "||" {
        return pattern_error_result(
            cursor, token_end(source, separator), "doubled-or",
            next_id, nodes, errors, limit_id, false
        )
    }
    if token_text(source, separator) == ".." {
        let recovered = pattern_recovery_end(
            source,
            token_end(source, separator)
        )
        return pattern_error_result(
            cursor, recovered, "unsupported-range-pattern",
            next_id, nodes, errors, limit_id, false
        )
    }
    if current_nodes >= pattern_node_limit() {
        return pattern_limit_result(
            source, cursor, current_next, current_nodes,
            current_errors, current_limit
        )
    }
    let id = current_next
    records = records + "node|" + to_text(id) + "|OrPattern|" +
    to_text(cursor) + "|" + to_text(end) + "|" +
    to_text(alternatives) + "|" + children + "\n"
    return pattern_result(
        end, id, current_next + 1, current_nodes + 1,
        current_errors, false, "OrPattern", current_limit, records
    )
}

fn parse_pattern_atomic_result(
    source: Text,
    start: Int,
    depth: Int,
    next_id: Int,
    nodes: Int,
    errors: Int,
    limit_id: Int
) -> Text {
    let cursor = skip_trivia(source, start)
    if nodes >= pattern_node_limit() {
        return pattern_limit_result(
            source, cursor, next_id, nodes, errors, limit_id
        )
    }
    if depth > pattern_depth_limit() {
        return pattern_error_result(
            cursor, pattern_recovery_end(source, cursor), "depth-limit",
            next_id, nodes, errors, limit_id, false
        )
    }
    let token = token_text(source, cursor)
    if cursor >= len(source) || pattern_stop_token(source, cursor) ||
       token == "|" {
        return pattern_error_result(
            cursor, token_end(source, cursor), "missing-pattern",
            next_id, nodes, errors, limit_id, false
        )
    }
    let token_finish = token_end(source, cursor)
    if token == "{" {
        let close = balanced_end(source, cursor, "{", "}")
        let mut end = close
        if close < 0 {
            end = pattern_recovery_end(source, cursor)
        }
        return pattern_error_result(
            cursor, end, "unsupported-record-pattern", next_id, nodes,
            errors, limit_id, false
        )
    }
    if token == "[" || token == ".." {
        let mut reason = "unsupported-pattern-token"
        if token == ".." {
            reason = "unsupported-rest-pattern"
        }
        return pattern_error_result(
            cursor, pattern_recovery_end(source, token_finish), reason,
            next_id, nodes, errors, limit_id, false
        )
    }

    if token == "(" {
        let inner = parse_pattern_or_result(
            source, skip_trivia(source, token_finish), depth + 1,
            next_id, nodes, errors, limit_id
        )
        if pattern_result_field(inner, 5) == "1" {
            return inner
        }
        let close = skip_trivia(source, pattern_result_int(inner, 0))
        if token_text(source, close) != ")" {
            return pattern_error_result(
                cursor, pattern_recovery_end(source, close),
                "missing-closing-parenthesis", next_id, nodes,
                errors, limit_id, false
            )
        }
        let current_nodes = pattern_result_int(inner, 3)
        let current_next = pattern_result_int(inner, 2)
        let current_errors = pattern_result_int(inner, 4)
        let current_limit = pattern_result_int(inner, 7)
        if current_nodes >= pattern_node_limit() {
            return pattern_limit_result(
                source, cursor, current_next, current_nodes,
                current_errors, current_limit
            )
        }
        let end = token_end(source, close)
        let id = current_next
        let records = pattern_result_records(inner) + "node|" +
        to_text(id) + "|ParenthesizedPattern|" + to_text(cursor) +
        "|" + to_text(end) + "|" + to_text(cursor) + "|" +
        to_text(token_finish) + "|" + to_text(close) + "|" +
        to_text(end) + "|" + pattern_result_field(inner, 1) + "\n"
        return pattern_result(
            end, id, current_next + 1, current_nodes + 1,
            current_errors, false, "ParenthesizedPattern",
            current_limit, records
        )
    }

    if token == "_" {
        let records = "node|" + to_text(next_id) +
        "|WildcardPattern|" + to_text(cursor) + "|" +
        to_text(token_finish) + "\n"
        return pattern_result(
            token_finish, next_id, next_id + 1, nodes + 1, errors,
            false, "WildcardPattern", limit_id, records
        )
    }
    if token == "true" || token == "false" || token == "null" ||
       token_kind(source, cursor) == "integer" {
        let mut literal_kind = "Bool"
        if token == "null" {
            literal_kind = "Null"
        } else if token_kind(source, cursor) == "integer" {
            literal_kind = "Int"
        }
        let records = "node|" + to_text(next_id) +
        "|LiteralPattern|" + to_text(cursor) + "|" +
        to_text(token_finish) + "|" + literal_kind + "|" + token + "|" +
        to_text(cursor) + "|" + to_text(token_finish) + "\n"
        return pattern_result(
            token_finish, next_id, next_id + 1, nodes + 1, errors,
            false, "LiteralPattern", limit_id, records
        )
    }
    if token_kind(source, cursor) != "identifier" {
        return pattern_error_result(
            cursor, pattern_recovery_end(source, token_finish),
            "unsupported-pattern-token", next_id, nodes, errors,
            limit_id, false
        )
    }

    let after_name = skip_trivia(source, token_finish)
    if token_text(source, after_name) == "{" {
        let close = balanced_end(source, after_name, "{", "}")
        let mut end = close
        if close < 0 {
            end = pattern_recovery_end(source, after_name)
        }
        return pattern_error_result(
            cursor, end, "unsupported-record-pattern", next_id, nodes,
            errors, limit_id, false
        )
    }
    if token_text(source, after_name) != "(" {
        let records = "node|" + to_text(next_id) + "|NamePattern|" +
        to_text(cursor) + "|" + to_text(token_finish) + "|" + token +
        "|" + to_text(cursor) + "|" + to_text(token_finish) + "\n"
        return pattern_result(
            token_finish, next_id, next_id + 1, nodes + 1, errors,
            false, "NamePattern", limit_id, records
        )
    }

    let open = after_name
    let mut payload = skip_trivia(source, token_end(source, open))
    if token_text(source, payload) == ")" {
        return pattern_error_result(
            cursor, token_end(source, payload), "empty-constructor-payload",
            next_id, nodes, errors, limit_id, false
        )
    }
    let mut records = ""
    let mut children = ""
    let mut payload_count = 0
    let mut close = -1
    let mut current_next = next_id
    let mut current_nodes = nodes
    let mut current_errors = errors
    let mut current_limit = limit_id
    while payload < len(source) && close < 0 {
        let child = parse_pattern_or_result(
            source, payload, depth + 1, current_next, current_nodes,
            current_errors, current_limit
        )
        if pattern_result_field(child, 5) == "1" {
            return child
        }
        records = records + pattern_result_records(child)
        if payload_count > 0 {
            children = children + ","
        }
        children = children + pattern_result_field(child, 1)
        current_next = pattern_result_int(child, 2)
        current_nodes = pattern_result_int(child, 3)
        current_errors = pattern_result_int(child, 4)
        current_limit = pattern_result_int(child, 7)
        payload_count = payload_count + 1
        let separator = skip_trivia(
            source,
            pattern_result_int(child, 0)
        )
        if token_text(source, separator) == "," {
            records = records + "delimiter|ConstructorPattern|" +
            to_text(cursor) + "|payload-comma|" +
            to_text(payload_count - 1) + "|" + to_text(separator) +
            "|" + to_text(token_end(source, separator)) + "\n"
            payload = skip_trivia(source, token_end(source, separator))
            if token_text(source, payload) == ")" {
                close = payload
            }
        } else if token_text(source, separator) == ")" {
            close = separator
        } else {
            let mut recovered = pattern_recovery_end(source, separator)
            if token_text(source, recovered) == ")" {
                recovered = token_end(source, recovered)
            }
            let mut reason = "missing-comma"
            if pattern_stop_token(source, separator) {
                reason = "missing-closing-parenthesis"
            }
            return pattern_error_result(
                cursor, recovered, reason, next_id, nodes,
                errors, limit_id, false
            )
        }
    }
    if close < 0 {
        return pattern_error_result(
            cursor, pattern_recovery_end(source, payload),
            "missing-closing-parenthesis", next_id, nodes, errors,
            limit_id, false
        )
    }
    if current_nodes >= pattern_node_limit() {
        return pattern_limit_result(
            source, cursor, current_next, current_nodes,
            current_errors, current_limit
        )
    }
    let end = token_end(source, close)
    let id = current_next
    records = records + "node|" + to_text(id) +
    "|ConstructorPattern|" + to_text(cursor) + "|" + to_text(end) +
    "|" + token + "|" + to_text(cursor) + "|" +
    to_text(token_finish) + "|" + to_text(open) + "|" +
    to_text(token_end(source, open)) + "|" + to_text(close) + "|" +
    to_text(end) + "|" + to_text(payload_count) + "|" + children + "\n"
    return pattern_result(
        end, id, current_next + 1, current_nodes + 1,
        current_errors, false, "ConstructorPattern", current_limit,
        records
    )
}

fn pattern_match_open(source: Text, match_start: Int) -> Int {
    let mut cursor = skip_trivia(source, token_end(source, match_start))
    let mut parens = 0
    let mut brackets = 0
    while cursor < len(source) {
        let token = token_text(source, cursor)
        if token == "(" {
            parens = parens + 1
        } else if token == ")" {
            if parens > 0 {
                parens = parens - 1
            }
        } else if token == "[" {
            brackets = brackets + 1
        } else if token == "]" {
            if brackets > 0 {
                brackets = brackets - 1
            }
        } else if token == "{" && parens == 0 && brackets == 0 {
            return cursor
        } else if token == "}" && parens == 0 && brackets == 0 {
            return -1
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return -1
}

fn pattern_arm_arrow(source: Text, start: Int, match_close: Int) -> Int {
    let mut cursor = skip_trivia(source, start)
    let mut parens = 0
    let mut brackets = 0
    while cursor < match_close {
        let token = token_text(source, cursor)
        if token == "=>" {
            return cursor
        }
        if token == "," && parens == 0 && brackets == 0 {
            return -1
        }
        if token == "(" {
            parens = parens + 1
        } else if token == ")" {
            if parens > 0 {
                parens = parens - 1
            }
        } else if token == "[" {
            brackets = brackets + 1
        } else if token == "]" {
            if brackets > 0 {
                brackets = brackets - 1
            }
        } else if token == "{" && parens == 0 && brackets == 0 {
            return -1
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return -1
}

fn parse_pattern_trees(source: Text) -> Text {
    let mut tree = "kofun-pattern-tree/v1\n" +
    "limits|depth|32|nodes-per-compilation|256\n"
    let mut cursor = skip_trivia(source, 0)
    let mut match_id = 0
    let mut next_id = 0
    let mut nodes = 0
    let mut errors = 0
    let mut limit_id = -1
    let mut budget_exhausted = false
    while cursor < len(source) && !budget_exhausted {
        if token_text(source, cursor) == "match" {
            let open = pattern_match_open(source, cursor)
            let mut match_end = -1
            if open >= 0 {
                match_end = balanced_end(source, open, "{", "}")
            }
            if open >= 0 && match_end >= 0 {
                let close = match_end - 1
                let mut arms = ""
                let mut arm_cursor = skip_trivia(
                    source,
                    token_end(source, open)
                )
                let mut arm_id = 0
                while arm_cursor < close &&
                      token_text(source, arm_cursor) != "}" {
                    let checkpoint_next = next_id
                    let checkpoint_nodes = nodes
                    let checkpoint_errors = errors
                    let checkpoint_limit = limit_id
                    let mut pattern = parse_pattern_or_result(
                        source, arm_cursor, 1, next_id, nodes,
                        errors, limit_id
                    )
                    let after_pattern = skip_trivia(
                        source,
                        pattern_result_int(pattern, 0)
                    )
                    if pattern_result_field(pattern, 5) != "1" &&
                       pattern_result_field(pattern, 6) != "ErrorPattern" &&
                       token_text(source, after_pattern) != "=>" &&
                       token_text(source, after_pattern) != "if" {
                        let recovered = pattern_recovery_end(
                            source,
                            after_pattern
                        )
                        pattern = pattern_error_result(
                            arm_cursor,
                            recovered,
                            "unexpected-token-after-pattern",
                            checkpoint_next,
                            checkpoint_nodes,
                            checkpoint_errors,
                            checkpoint_limit,
                            false
                        )
                    }
                    next_id = pattern_result_int(pattern, 2)
                    nodes = pattern_result_int(pattern, 3)
                    errors = pattern_result_int(pattern, 4)
                    limit_id = pattern_result_int(pattern, 7)
                    arms = arms + pattern_result_records(pattern)
                    let arrow = pattern_arm_arrow(
                        source,
                        pattern_result_int(pattern, 0),
                        close
                    )
                    let mut arrow_end = -1
                    if arrow >= 0 {
                        arrow_end = token_end(source, arrow)
                    }
                    arms = arms + "arm|" + to_text(match_id) + "|" +
                    to_text(arm_id) + "|" + pattern_result_field(pattern, 1) +
                    "|" + to_text(arm_cursor) + "|" +
                    pattern_result_field(pattern, 0) + "|" +
                    to_text(arrow) + "|" + to_text(arrow_end) + "\n"
                    arm_id = arm_id + 1
                    if pattern_result_field(pattern, 5) == "1" &&
                       pattern_result_int(pattern, 7) >= 0 {
                        budget_exhausted = true
                        arm_cursor = close
                    } else if arrow < 0 {
                        let recovery = skip_trivia(
                            source,
                            pattern_result_int(pattern, 0)
                        )
                        if recovery < close &&
                           token_text(source, recovery) == "," {
                            arm_cursor = skip_trivia(
                                source,
                                token_end(source, recovery)
                            )
                        } else {
                            arm_cursor = close
                        }
                    } else {
                        let body = skip_trivia(
                            source,
                            token_end(source, arrow)
                        )
                        if body >= close || token_text(source, body) != "{" {
                            arm_cursor = pattern_recovery_end(source, body)
                        } else {
                            let body_end = balanced_end(
                                source,
                                body,
                                "{",
                                "}"
                            )
                            if body_end < 0 {
                                arm_cursor = close
                            } else {
                                arm_cursor = skip_trivia(source, body_end)
                            }
                        }
                        if arm_cursor < close &&
                           token_text(source, arm_cursor) == "," {
                            arm_cursor = skip_trivia(
                                source,
                                token_end(source, arm_cursor)
                            )
                        }
                    }
                }
                tree = tree + "match|" + to_text(match_id) + "|" +
                to_text(cursor) + "|" + to_text(open) + "|" +
                to_text(token_end(source, open)) + "|" + to_text(close) +
                "|" + to_text(token_end(source, close)) + "|" +
                to_text(arm_id) + "\n" + arms
                match_id = match_id + 1
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return tree + "match-count|" + to_text(match_id) + "\n"
}

fn pattern_find_from(value: Text, wanted: Text, start: Int) -> Int {
    if len(wanted) == 0 {
        return start
    }
    let mut cursor = start
    while cursor + len(wanted) <= len(value) {
        if text_slice(value, cursor, cursor + len(wanted)) == wanted {
            return cursor
        }
        cursor = cursor + 1
    }
    return -1
}

fn pattern_first_error(tree: Text) -> Text {
    let mut search = 0
    let mut best_record = -1
    let mut best_start = -1
    while search < len(tree) {
        let record = pattern_find_from(
            tree,
            "pattern-diagnostic|",
            search
        )
        if record < 0 {
            search = len(tree)
        } else {
            let start = decimal_value(pattern_line_field(tree, record, 3))
            if best_start < 0 || start < best_start {
                best_record = record
                best_start = start
            }
            search = record + 1
        }
    }
    if best_record < 0 {
        return ""
    }
    return "error[E2S58]: invalid pattern (" +
    pattern_line_field(tree, best_record, 2) +
    ") at bytes " + pattern_line_field(tree, best_record, 3) + ".." +
    pattern_line_field(tree, best_record, 4)
}

fn pattern_summary(source: Text, start: Int) -> Text {
    let parsed = parse_pattern_or_result(source, start, 1, 0, 0, 0, -1)
    return pattern_result_field(parsed, 6) + "|" +
    pattern_result_field(parsed, 0)
}

fn pattern_summary_kind(summary: Text) -> Text {
    return pattern_line_field(summary, 0, 0)
}

fn pattern_summary_end(summary: Text) -> Int {
    return decimal_value(pattern_line_field(summary, 0, 1))
}

# Reject repeated resolved binding names from the lossless Pattern tree before
# the bounded executable-shape check.  This deliberately reads NamePattern
# records rather than rescanning constructor/wildcard token spellings.  An
# or-pattern is left to the resolved ADT projector, where sibling alternatives
# publish one shared BindingId and therefore are not same-scope declarations.
fn pattern_duplicate_binding_error(source: Text, start: Int) -> Text {
    let parsed = parse_pattern_or_result(source, start, 1, 0, 0, 0, -1)
    let records = pattern_result_records(parsed)
    if contains(records, "|OrPattern|") {
        return ""
    }
    let symbols = chars(records)
    let mut line = 0
    let mut seen = ""
    while line < len(symbols) {
        let kind = pattern_line_field(records, line, 2)
        if pattern_line_field(records, line, 0) == "node" &&
           kind == "NamePattern" {
            let name = pattern_line_field(records, line, 5)
            let declaration = pattern_line_field(records, line, 3)
            if len(enum_constructor_owner(source, name)) == 0 &&
               enum_binding_catchall_name(name) {
                let mut prior = 0
                while prior < len(seen) {
                    if pattern_line_field(seen, prior, 0) == name {
                        return "error[E2S47]: duplicate binding `" + name +
                        "` in pattern at byte " + declaration +
                        "; first declaration at byte " +
                        pattern_line_field(seen, prior, 1)
                    }
                    while prior < len(seen) && seen[prior] != "\n" {
                        prior = prior + 1
                    }
                    prior = prior + 1
                }
                seen = seen + name + "|" + declaration + "\n"
            }
        }
        while line < len(symbols) && symbols[line] != "\n" {
            line = line + 1
        }
        line = line + 1
    }
    return ""
}

# The executable constructor pattern is exactly `C(name)` or `C(_)`: one
# parenthesised payload sub-pattern that is a single token.  A nested payload
# such as `Ok(Present(x))` stays parsed-but-not-executable here, and whether the
# constructor belongs to the scrutinee's enum with a matching arity is decided
# later, where the enum type is known and the diagnostic can name it.
fn executable_constructor_pattern(source: Text, arm: Int) -> Bool {
    if arm >= len(source) || token_kind(source, arm) != "identifier" {
        return false
    }
    let open = skip_trivia(source, token_end(source, arm))
    if open >= len(source) || token_text(source, open) != "(" {
        return false
    }
    let field = skip_trivia(source, token_end(source, open))
    if field >= len(source) || token_kind(source, field) != "identifier" {
        return false
    }
    let close = skip_trivia(source, token_end(source, field))
    return close < len(source) && token_text(source, close) == ")"
}

fn validate_executable_patterns(source: Text) -> Text {
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        if token_text(source, cursor) == "match" {
            let open = pattern_match_open(source, cursor)
            let mut match_end = -1
            if open >= 0 {
                match_end = balanced_end(source, open, "{", "}")
            }
            if open >= 0 && match_end >= 0 {
                let close = match_end - 1
                let mut arm = skip_trivia(source, token_end(source, open))
                while arm < close && token_text(source, arm) != "}" {
                    let duplicate = pattern_duplicate_binding_error(
                        source,
                        arm
                    )
                    if starts_with(duplicate, "error[") {
                        return duplicate
                    }
                    let summary = pattern_summary(source, arm)
                    let kind = pattern_summary_kind(summary)
                    let executable = kind == "WildcardPattern" ||
                    kind == "NamePattern" ||
                    (kind == "ConstructorPattern" &&
                     executable_constructor_pattern(source, arm)) ||
                    (kind == "LiteralPattern" &&
                     (token_text(source, arm) == "true" ||
                      token_text(source, arm) == "false"))
                    if !executable {
                        return "error[E2S24]: general pattern syntax is parsed " +
                        "but not executable in Stage 2 Core at byte " +
                        to_text(arm)
                    }
                    let arrow = pattern_arm_arrow(
                        source,
                        pattern_summary_end(summary),
                        close
                    )
                    if arrow < 0 {
                        arm = close
                    } else {
                        let body = skip_trivia(
                            source,
                            token_end(source, arrow)
                        )
                        if body >= close || token_text(source, body) != "{" {
                            arm = close
                        } else {
                            let body_end = balanced_end(
                                source,
                                body,
                                "{",
                                "}"
                            )
                            if body_end < 0 {
                                arm = close
                            } else {
                                arm = skip_trivia(source, body_end)
                                if arm < close &&
                                   token_text(source, arm) == "," {
                                    arm = skip_trivia(
                                        source,
                                        token_end(source, arm)
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return "ok"
}

fn balanced_end(source: Text, start: Int, open: Text, close: Text) -> Int {
    let mut cursor = start
    let mut depth = 0
    while cursor < len(source) {
        cursor = skip_trivia(source, cursor)
        if cursor >= len(source) {
            return -1
        }
        let token = token_text(source, cursor)
        let end = token_end(source, cursor)
        if len(token) == 0 || end <= cursor {
            return -1
        }
        if token == open {
            depth = depth + 1
        } else if token == close {
            depth = depth - 1
            if depth == 0 {
                return end
            }
        }
        cursor = end
    }
    return -1
}

fn basic_visibility_modifier(source: Text, start: Int) -> Bool {
    let token = token_text(source, start)
    return token == "pub" || token == "internal" || token == "private"
}

fn visibility_word(source: Text, start: Int) -> Bool {
    let token = token_text(source, start)
    return basic_visibility_modifier(source, start) ||
    token == "public" || token == "protected"
}

fn visibility_prefix_candidate(source: Text, start: Int) -> Bool {
    if visibility_word(source, start) {
        return true
    }
    if token_kind(source, start) != "identifier" {
        return false
    }
    let next = skip_trivia(source, token_end(source, start))
    return token_text(source, next) == "fn" ||
    token_text(source, next) == "type"
}

fn function_declaration_start(source: Text, start: Int) -> Int {
    if token_text(source, start) == "fn" {
        return start
    }
    if !basic_visibility_modifier(source, start) {
        return -1
    }
    let after_modifier = skip_trivia(source, token_end(source, start))
    if after_modifier < len(source) &&
       token_text(source, after_modifier) == "fn" {
        return after_modifier
    }
    return -1
}

fn type_declaration_start(source: Text, start: Int) -> Int {
    if token_text(source, start) == "type" {
        return start
    }
    if !basic_visibility_modifier(source, start) {
        return -1
    }
    let after_modifier = skip_trivia(source, token_end(source, start))
    if after_modifier < len(source) &&
       token_text(source, after_modifier) == "type" {
        return after_modifier
    }
    return -1
}

# A top-level `let NAME = <integer literal>` module constant. Constants carry
# no visibility modifier in this slice, so a declaration always starts at the
# `let` keyword itself and stays internal to its compilation unit.
#
# The byte just past a well-formed constant, or -1. The initializer is exactly
# one integer literal with an optional leading `-`, which the lexer emits as a
# separate punctuation token.
fn constant_declaration_end(source: Text, start: Int) -> Int {
    if token_text(source, start) != "let" {
        return -1
    }
    let name = skip_trivia(source, token_end(source, start))
    if name >= len(source) || token_kind(source, name) != "identifier" {
        return -1
    }
    let equals = skip_trivia(source, token_end(source, name))
    if equals >= len(source) || token_text(source, equals) != "=" {
        return -1
    }
    let mut value = skip_trivia(source, token_end(source, equals))
    if value < len(source) && token_text(source, value) == "-" {
        value = skip_trivia(source, token_end(source, value))
    }
    if value >= len(source) || token_kind(source, value) != "integer" {
        return -1
    }
    # The initializer is the whole declaration. Requiring the next token to
    # open another top-level declaration keeps `let A = 1 + 2` a constant
    # diagnostic instead of an unexpected-token one at the operator.
    let close = token_end(source, value)
    let next = skip_trivia(source, close)
    if next < len(source) && token_text(source, next) != "fn" &&
       token_text(source, next) != "type" &&
       token_text(source, next) != "let" &&
       !visibility_prefix_candidate(source, next) {
        return -1
    }
    return close
}

fn constant_name(source: Text, start: Int) -> Text {
    if constant_declaration_end(source, start) < 0 {
        return ""
    }
    return token_text(source, skip_trivia(source, token_end(source, start)))
}

# The constant's value as C source: the integer literal text with its optional
# `-` restored.
fn constant_value_text(source: Text, start: Int) -> Text {
    if constant_declaration_end(source, start) < 0 {
        return ""
    }
    let name = skip_trivia(source, token_end(source, start))
    let equals = skip_trivia(source, token_end(source, name))
    let mut value = skip_trivia(source, token_end(source, equals))
    let mut sign = ""
    if token_text(source, value) == "-" {
        sign = "-"
        value = skip_trivia(source, token_end(source, value))
    }
    return sign + text_slice(source, value, token_end(source, value))
}

# Walk to the next top-level constant at or after `from`. Type and function
# bodies are stepped over, so a `let` statement inside a body is never mistaken
# for a module constant.
fn next_constant_start(source: Text, from: Int) -> Int {
    let mut cursor = skip_trivia(source, from)
    while cursor < len(source) {
        let type_start = type_declaration_start(source, cursor)
        if type_start >= 0 {
            let type_close = type_declaration_end(source, type_start)
            if type_close < 0 {
                return len(source)
            }
            cursor = skip_trivia(source, type_close)
        } else {
            let function_start = function_declaration_start(source, cursor)
            if function_start >= 0 {
                let function_close = function_end(source, function_start)
                if function_close < 0 {
                    return len(source)
                }
                cursor = skip_trivia(source, function_close)
            } else {
                if token_text(source, cursor) == "let" {
                    return cursor
                }
                return len(source)
            }
        }
    }
    return len(source)
}

fn constant_declaration_count(source: Text, wanted: Text) -> Int {
    let mut cursor = next_constant_start(source, 0)
    let mut found = 0
    while cursor < len(source) {
        if constant_name(source, cursor) == wanted {
            found = found + 1
        }
        let close = constant_declaration_end(source, cursor)
        if close < 0 {
            return found
        }
        cursor = next_constant_start(source, close)
    }
    return found
}

fn constant_is_declared(source: Text, wanted: Text) -> Bool {
    return constant_declaration_count(source, wanted) > 0
}

# The C name a module constant lowers to. Constants share one prefix that no
# lowered function, record, or local binding uses.
fn constant_c_name(name: Text) -> Text {
    return "kofun_k_" + name
}

fn visibility_level(source: Text, start: Int) -> Text {
    if token_text(source, start) == "pub" {
        return "public"
    }
    if token_text(source, start) == "internal" {
        return "internal"
    }
    return "private"
}

fn visibility_prefix_error(source: Text, start: Int) -> Text {
    let modifier = token_text(source, start)
    if modifier == "public" || modifier == "protected" {
        return "error[E2S34]: unsupported visibility modifier `" +
        modifier + "`; use `pub`, `internal`, or `private` at bytes " +
        to_text(start) + ".." + to_text(token_end(source, start))
    }
    if !basic_visibility_modifier(source, start) {
        let next = skip_trivia(source, token_end(source, start))
        if token_kind(source, start) == "identifier" &&
           next < len(source) &&
           (token_text(source, next) == "fn" ||
            token_text(source, next) == "type") {
            return "error[E2S33]: unknown visibility modifier `" +
            modifier + "`; expected `pub`, `internal`, or `private` at bytes " +
            to_text(start) + ".." + to_text(token_end(source, start))
        }
        return ""
    }

    let next = skip_trivia(source, token_end(source, start))
    if next < len(source) &&
       (token_text(source, next) == "fn" ||
        token_text(source, next) == "type") {
        return ""
    }
    if next < len(source) && basic_visibility_modifier(source, next) {
        let second = token_text(source, next)
        let mut kind = "conflicting"
        if modifier == second {
            kind = "repeated"
        }
        return "error[E2S33]: " + kind + " visibility modifiers `" +
        modifier + "` and `" + second + "` at bytes " +
        to_text(start) + ".." + to_text(token_end(source, next))
    }
    if modifier == "pub" && next < len(source) &&
       token_text(source, next) == "(" {
        let mut form_end = balanced_end(source, next, "(", ")")
        if form_end < 0 {
            form_end = token_end(source, next)
        }
        let form_name = skip_trivia(source, token_end(source, next))
        let name = token_text(source, form_name)
        let mut form_kind = "restricted"
        if name == "crate" || name == "super" || name == "in" {
            form_kind = "Rust-style"
        }
        return "error[E2S34]: " + form_kind +
        " `pub(...)` visibility is not supported in this frontend slice at bytes " +
        to_text(start) + ".." + to_text(form_end)
    }
    return "error[E2S33]: visibility modifier `" + modifier +
    "` must be followed by a top-level `fn` or `type` declaration at bytes " +
    to_text(start) + ".." + to_text(token_end(source, start))
}

fn local_visibility_error(
    source: Text,
    function_start: Int,
    function_close: Int
) -> Text {
    let open = parameter_open(source, function_start)
    if open < 0 {
        return ""
    }
    let mut cursor = balanced_end(source, open, "(", ")")
    while cursor >= 0 && cursor < function_close &&
          token_text(source, cursor) != "{" {
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    if cursor < 0 || cursor >= function_close {
        return ""
    }
    cursor = skip_trivia(source, token_end(source, cursor))
    while cursor < function_close {
        let token = token_text(source, cursor)
        let basic = basic_visibility_modifier(source, cursor)
        let alias = token == "public" || token == "protected"
        if basic || alias {
            let next = skip_trivia(source, token_end(source, cursor))
            let next_token = token_text(source, next)
            let declaration_like = next < function_close &&
            (next_token == "fn" || next_token == "let" ||
             next_token == "var" || next_token == "type" ||
             basic_visibility_modifier(source, next))
            if declaration_like {
                let mut code = "E2S33"
                if alias {
                    code = "E2S34"
                }
                return "error[" + code + "]: visibility modifier `" +
                token + "` is not supported in local scope at bytes " +
                to_text(cursor) + ".." + to_text(token_end(source, cursor))
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return ""
}

fn function_name(source: Text, start: Int) -> Text {
    let after_fn = skip_trivia(source, token_end(source, start))
    if after_fn >= len(source) || token_kind(source, after_fn) != "identifier" {
        return ""
    }
    return token_text(source, after_fn)
}

fn parameter_open(source: Text, start: Int) -> Int {
    let after_fn = skip_trivia(source, token_end(source, start))
    let after_name = skip_trivia(source, token_end(source, after_fn))
    if after_name >= len(source) || token_text(source, after_name) != "(" {
        return -1
    }
    return after_name
}

fn parameter_count(source: Text, start: Int) -> Int {
    let open = parameter_open(source, start)
    if open < 0 {
        return -1
    }
    let close = balanced_end(source, open, "(", ")")
    if close < 0 {
        return -1
    }

    let mut cursor = skip_trivia(source, token_end(source, open))
    if cursor >= close || token_text(source, cursor) == ")" {
        return 0
    }

    let mut count = 1
    let mut paren_depth = 0
    let mut bracket_depth = 0
    while cursor < close {
        let token = token_text(source, cursor)
        if token == "(" {
            paren_depth = paren_depth + 1
        } else if token == ")" {
            if paren_depth == 0 {
                return count
            }
            paren_depth = paren_depth - 1
        } else if token == "[" {
            bracket_depth = bracket_depth + 1
        } else if token == "]" {
            bracket_depth = bracket_depth - 1
        } else if token == "," && paren_depth == 0 && bracket_depth == 0 {
            count = count + 1
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return count
}

fn function_end(source: Text, start: Int) -> Int {
    if token_text(source, start) != "fn" || len(function_name(source, start)) == 0 {
        return -1
    }

    let open = parameter_open(source, start)
    if open < 0 {
        return -1
    }
    let parameters_end = balanced_end(source, open, "(", ")")
    if parameters_end < 0 {
        return -1
    }

    let mut cursor = skip_trivia(source, parameters_end)
    if cursor < len(source) && token_text(source, cursor) == "->" {
        cursor = skip_trivia(source, token_end(source, cursor))
        let mut type_tokens = 0
        while cursor < len(source) && token_text(source, cursor) != "{" {
            if token_text(source, cursor) == "=" {
                return -1
            }
            type_tokens = type_tokens + 1
            cursor = skip_trivia(source, token_end(source, cursor))
        }
        if type_tokens == 0 {
            return -1
        }
    }

    if cursor >= len(source) || token_text(source, cursor) != "{" {
        return -1
    }
    return balanced_end(source, cursor, "{", "}")
}

fn type_name(source: Text, start: Int) -> Text {
    let name = skip_trivia(source, token_end(source, start))
    if name >= len(source) || token_kind(source, name) != "identifier" {
        return ""
    }
    return token_text(source, name)
}

# The `[` of a `type NAME[...]` parameter list, or -1 when there is none.
#
# #916 admits exactly one shape here, `[const NAME: Int]`. An ordinary type
# parameter needs field substitution and per-instantiation layout, neither of
# which this slice builds, so it is refused by name rather than half-parsed.
fn type_parameter_open(source: Text, start: Int) -> Int {
    if token_text(source, start) != "type" {
        return -1
    }
    let name = skip_trivia(source, token_end(source, start))
    if name >= len(source) || token_kind(source, name) != "identifier" {
        return -1
    }
    let bracket = skip_trivia(source, token_end(source, name))
    if bracket < len(source) && token_text(source, bracket) == "[" {
        return bracket
    }
    return -1
}

# The `=` of a type declaration, skipping an optional parameter list. `-1`
# when the parameter brackets do not close.
fn type_equals_token(source: Text, start: Int) -> Int {
    let name = skip_trivia(source, token_end(source, start))
    let bracket = type_parameter_open(source, start)
    if bracket < 0 {
        return skip_trivia(source, token_end(source, name))
    }
    let close = balanced_end(source, bracket, "[", "]")
    if close < 0 {
        return -1
    }
    return skip_trivia(source, close)
}

# The declared const parameter of `type NAME[const P: Int]`, or "" when the
# declaration has no parameter list or the list is not that shape.
fn const_parameter_name(source: Text, start: Int) -> Text {
    let bracket = type_parameter_open(source, start)
    if bracket < 0 {
        return ""
    }
    let keyword = skip_trivia(source, token_end(source, bracket))
    if keyword >= len(source) || token_text(source, keyword) != "const" {
        return ""
    }
    let parameter = skip_trivia(source, token_end(source, keyword))
    if parameter >= len(source) ||
       token_kind(source, parameter) != "identifier" {
        return ""
    }
    return token_text(source, parameter)
}

# The const parameter declared by the type named `wanted`, or "".
fn const_parameter_of_type(source: Text, wanted: Text) -> Text {
    let mut cursor = after_optional_module_header(source, 0)
    while cursor < len(source) {
        let type_start = type_declaration_start(source, cursor)
        if type_start >= 0 && type_name(source, type_start) == wanted {
            return const_parameter_name(source, type_start)
        }
        let end = top_level_end(source, cursor)
        if end <= cursor {
            return ""
        }
        cursor = skip_trivia(source, end)
    }
    return ""
}

fn type_declaration_end(source: Text, start: Int) -> Int {
    if token_text(source, start) != "type" || len(type_name(source, start)) == 0 {
        return -1
    }
    let equals = type_equals_token(source, start)
    if equals < 0 || equals >= len(source) ||
       token_text(source, equals) != "=" {
        return -1
    }
    let mut pipe = skip_trivia(source, token_end(source, equals))
    if pipe < len(source) && token_text(source, pipe) == "{" {
        let close = balanced_end(source, pipe, "{", "}")
        if close < 0 {
            return -1
        }
        let next = skip_trivia(source, close)
        if next < len(source) && token_text(source, next) != "fn" &&
           token_text(source, next) != "type" &&
           token_text(source, next) != "let" &&
           !visibility_prefix_candidate(source, next) {
            return -1
        }
        return close
    }
    let mut constructors = 0
    let mut last_end = -1
    while pipe < len(source) && token_text(source, pipe) == "|" {
        let constructor = skip_trivia(source, token_end(source, pipe))
        if constructor >= len(source) ||
           token_kind(source, constructor) != "identifier" {
            return -1
        }
        constructors = constructors + 1
        if constructors > 64 {
            return -2
        }
        last_end = token_end(source, constructor)
        pipe = skip_trivia(source, last_end)
        if pipe < len(source) && token_text(source, pipe) == "(" {
            let payload_end = balanced_end(source, pipe, "(", ")")
            if payload_end < 0 {
                return -1
            }
            last_end = payload_end
            pipe = skip_trivia(source, payload_end)
        }
    }
    if constructors == 0 {
        return -1
    }
    if pipe < len(source) && token_text(source, pipe) != "fn" &&
       token_text(source, pipe) != "type" &&
       token_text(source, pipe) != "let" &&
       !visibility_prefix_candidate(source, pipe) {
        return -1
    }
    return last_end
}

fn record_declaration_at(source: Text, start: Int) -> Bool {
    if token_text(source, start) != "type" {
        return false
    }
    let equals = type_equals_token(source, start)
    if equals < 0 {
        return false
    }
    let open = skip_trivia(source, token_end(source, equals))
    return token_text(source, equals) == "=" &&
    token_text(source, open) == "{"
}

# The declaration a record type identity names. A const argument selects no
# separate declaration — it is part of the *type*, never of the *declaration* —
# so it is dropped here, and this is the single lookup funnel that makes every
# field, layout, and C-name consumer agree on that without knowing about it.
fn record_declaration_start(source: Text, identity: Text) -> Int {
    let wanted = const_type_base(identity)
    let mut cursor = after_optional_module_header(source, 0)
    while cursor < len(source) {
        let type_start = type_declaration_start(source, cursor)
        if type_start >= 0 &&
           record_declaration_at(source, type_start) &&
           type_name(source, type_start) == wanted {
            return type_start
        }
        let end = top_level_end(source, cursor)
        if end <= cursor {
            return -1
        }
        cursor = skip_trivia(source, end)
    }
    return -1
}

# `-2` is an unsupported field type, `-3` malformed or duplicate fields, and
# `-4` the bounded field ceiling. AggregateLayout v1 owns the C layout.
# Where a record field's declared type ends.
#
# A scalar field type is one token, and every walker over a field list used to
# step past that token. #1183 admits `List[Int]`, which is four, so the step
# has to come from the type parser rather than from the identifier. This reuses
# `parameter_list_type_end` instead of restating the `List [ X ]` shape: two
# parsers for one syntax is how the two ends of a field list start disagreeing.
fn record_field_type_end(source: Text, field_type: Int, limit: Int) -> Int {
    let list_end = parameter_list_type_end(source, field_type, limit)
    if list_end >= 0 {
        return list_end
    }
    return token_end(source, field_type)
}

fn record_field_count(source: Text, record_type: Text) -> Int {
    let declaration = record_declaration_start(source, record_type)
    if declaration < 0 {
        return -1
    }
    let equals = type_equals_token(source, declaration)
    if equals < 0 {
        return -3
    }
    let open = skip_trivia(source, token_end(source, equals))
    let close = balanced_end(source, open, "{", "}")
    if close < 0 {
        return -3
    }
    let mut cursor = skip_trivia(source, token_end(source, open))
    let mut covered = "|"
    let mut count = 0
    while cursor < close && token_text(source, cursor) != "}" {
        if token_kind(source, cursor) != "identifier" {
            return -3
        }
        let field = token_text(source, cursor)
        if contains(covered, "|" + field + "|") {
            return -3
        }
        covered = covered + field + "|"
        let colon = skip_trivia(source, token_end(source, cursor))
        let field_type = skip_trivia(source, token_end(source, colon))
        if token_text(source, colon) != ":" ||
           token_kind(source, field_type) != "identifier" {
            return -3
        }
        # #1181: `Text` is one reference, which spec/aggregate-layout-v1
        # already models as a pointer carrier, so admitting it changes the
        # field's C spelling and nothing about placement.
        #
        # #1183: `List[Int]` is several tokens, so the field type ends where
        # the existing parameter-list type parser says it does rather than at
        # the identifier. RFC-0011 admits it as the `bounded_list` kind: 520
        # bytes stored inline, which is why the emitters below carry size and
        # alignment separately.
        let list_end = parameter_list_type_end(source, field_type, close)
        if list_end >= 0 {
            if parameter_list_type_text(source, field_type, close) !=
               "List[Int]" {
                return -2
            }
        } else if token_text(source, field_type) != "Int" &&
           token_text(source, field_type) != "Bool" &&
           token_text(source, field_type) != "Text" {
            return -2
        }
        count = count + 1
        if count > 128 {
            return -4
        }
        let separator = skip_trivia(
            source,
            record_field_type_end(source, field_type, close)
        )
        if separator < close && token_text(source, separator) == "," {
            cursor = skip_trivia(source, token_end(source, separator))
        } else if separator == close ||
                  token_text(source, separator) == "}" {
            cursor = separator
        } else {
            return -3
        }
    }
    if count == 0 {
        return -3
    }
    return count
}

fn record_field_text(
    source: Text,
    record_type: Text,
    wanted_index: Int,
    want_type: Bool
) -> Text {
    let declaration = record_declaration_start(source, record_type)
    if declaration < 0 {
        return ""
    }
    let equals = type_equals_token(source, declaration)
    if equals < 0 {
        return ""
    }
    let open = skip_trivia(source, token_end(source, equals))
    let close = balanced_end(source, open, "{", "}")
    let mut cursor = skip_trivia(source, token_end(source, open))
    let mut index = 0
    while cursor < close && token_text(source, cursor) != "}" {
        let colon = skip_trivia(source, token_end(source, cursor))
        let field_type = skip_trivia(source, token_end(source, colon))
        if index == wanted_index {
            if want_type {
                # #1183: a `List[Int]` field's type is its canonical name, not
                # its first token. Callers compare this against carrier names
                # like `List[Int]`, so returning `List` would make a bounded
                # list field look like an unknown nominal type.
                if parameter_list_type_end(source, field_type, close) >= 0 {
                    return parameter_list_type_text(source, field_type, close)
                }
                return token_text(source, field_type)
            }
            return token_text(source, cursor)
        }
        let separator = skip_trivia(
            source,
            record_field_type_end(source, field_type, close)
        )
        if token_text(source, separator) == "," {
            cursor = skip_trivia(source, token_end(source, separator))
        } else {
            cursor = separator
        }
        index = index + 1
    }
    return ""
}

fn record_field_index(
    source: Text,
    record_type: Text,
    wanted: Text
) -> Int {
    let count = record_field_count(source, record_type)
    let mut index = 0
    while index < count {
        if record_field_text(source, record_type, index, false) == wanted {
            return index
        }
        index = index + 1
    }
    return -1
}

fn top_level_end(source: Text, start: Int) -> Int {
    let type_start = type_declaration_start(source, start)
    if type_start >= 0 {
        return type_declaration_end(source, type_start)
    }
    # Module constants are top-level declarations too, so every walker that
    # steps over one declaration at a time has to step over them as well.
    if token_text(source, start) == "let" {
        return constant_declaration_end(source, start)
    }
    let function_start = function_declaration_start(source, start)
    if function_start < 0 {
        return -1
    }
    return function_end(source, function_start)
}

fn after_optional_module_header(source: Text, start: Int) -> Int {
    let mut cursor = skip_trivia(source, start)
    if token_text(source, cursor) != "module" {
        return cursor
    }
    cursor = skip_trivia(source, token_end(source, cursor))
    if cursor >= len(source) || token_kind(source, cursor) != "identifier" {
        return cursor
    }
    cursor = token_end(source, cursor)
    while cursor < len(source) {
        let dot = skip_trivia(source, cursor)
        if dot >= len(source) || token_text(source, dot) != "." {
            break
        }
        let part = skip_trivia(source, token_end(source, dot))
        if part >= len(source) || token_kind(source, part) != "identifier" {
            break
        }
        cursor = token_end(source, part)
    }
    return skip_trivia(source, cursor)
}

fn next_function_start(source: Text, start: Int) -> Int {
    # Callers advance with function_end's result, which is -1 for a position
    # that is not a function declaration. Restarting the walk from before the
    # source re-emitted every record with fresh identifiers forever, so a
    # rejected position ends the walk instead.
    if start < 0 {
        return len(source)
    }
    let mut cursor = after_optional_module_header(source, start)
    # Types and module constants both precede the functions that read them, so
    # the walk steps over either kind before it looks for `fn`.
    let mut advanced = true
    while cursor < len(source) && advanced {
        advanced = false
        if type_declaration_start(source, cursor) >= 0 {
            let type_start = type_declaration_start(source, cursor)
            let end = type_declaration_end(source, type_start)
            if end <= cursor {
                return len(source)
            }
            cursor = skip_trivia(source, end)
            advanced = true
        } else if token_text(source, cursor) == "let" {
            let constant_close = constant_declaration_end(source, cursor)
            if constant_close <= cursor {
                return len(source)
            }
            cursor = skip_trivia(source, constant_close)
            advanced = true
        }
    }
    let function_start = function_declaration_start(source, cursor)
    if function_start < 0 {
        return cursor
    }
    return function_start
}

fn enum_declaration_start(source: Text, wanted: Text) -> Int {
    let mut cursor = after_optional_module_header(source, 0)
    while cursor < len(source) {
        let type_start = type_declaration_start(source, cursor)
        if type_start >= 0 &&
           !record_declaration_at(source, type_start) &&
           type_name(source, type_start) == wanted {
            return type_start
        }
        let end = top_level_end(source, cursor)
        if end <= cursor {
            return -1
        }
        cursor = skip_trivia(source, end)
    }
    return -1
}

# A constructor may carry one parenthesised payload field.  Every walker below
# steps over that field with this helper: stopping at the `(` instead would
# truncate the constructor set of any enum whose payload-carrying constructor is
# not written last, which silently changes coverage rather than failing.
fn enum_constructor_token_end(source: Text, constructor: Int) -> Int {
    let after = token_end(source, constructor)
    let open = skip_trivia(source, after)
    if open >= len(source) || token_text(source, open) != "(" {
        return after
    }
    let close = balanced_end(source, open, "(", ")")
    if close < 0 {
        return after
    }
    return close
}

# The payload field this Core slice lowers is exactly `name: Int`.  The ADT
# frontend already bounds a constructor to one field with `E2S41`; the extra
# `Int` requirement here is what lets a constructor value be a tag and one
# `Int`, so a wider field type must fail rather than lower.
fn enum_payload_field_supported(source: Text, open: Int) -> Bool {
    let field = skip_trivia(source, token_end(source, open))
    if field >= len(source) || token_kind(source, field) != "identifier" {
        return false
    }
    let colon = skip_trivia(source, token_end(source, field))
    if colon >= len(source) || token_text(source, colon) != ":" {
        return false
    }
    let type_cursor = skip_trivia(source, token_end(source, colon))
    if type_cursor >= len(source) || token_text(source, type_cursor) != "Int" {
        return false
    }
    let close = skip_trivia(source, token_end(source, type_cursor))
    return close < len(source) && token_text(source, close) == ")"
}

fn enum_constructor_count(source: Text, enum_type: Text) -> Int {
    let declaration = enum_declaration_start(source, enum_type)
    if declaration < 0 {
        return -1
    }
    let name = skip_trivia(source, token_end(source, declaration))
    let equals = skip_trivia(source, token_end(source, name))
    let mut pipe = skip_trivia(source, token_end(source, equals))
    let end = type_declaration_end(source, declaration)
    let mut count = 0
    while pipe < end && token_text(source, pipe) == "|" {
        let constructor = skip_trivia(source, token_end(source, pipe))
        count = count + 1
        pipe = skip_trivia(
            source,
            enum_constructor_token_end(source, constructor)
        )
    }
    return count
}

# Payload arity of one named constructor: `0` payload-free, `1` one supported
# `Int` field, `-1` when the constructor does not belong to the enum, and `-2`
# when it declares a payload this slice cannot lower.
fn enum_constructor_payload_arity(
    source: Text,
    enum_type: Text,
    wanted: Text
) -> Int {
    let declaration = enum_declaration_start(source, enum_type)
    if declaration < 0 {
        return -1
    }
    let name = skip_trivia(source, token_end(source, declaration))
    let equals = skip_trivia(source, token_end(source, name))
    let mut pipe = skip_trivia(source, token_end(source, equals))
    let end = type_declaration_end(source, declaration)
    while pipe < end && token_text(source, pipe) == "|" {
        let constructor = skip_trivia(source, token_end(source, pipe))
        if token_text(source, constructor) == wanted {
            let open = skip_trivia(source, token_end(source, constructor))
            if open >= end || token_text(source, open) != "(" {
                return 0
            }
            if enum_payload_field_supported(source, open) {
                return 1
            }
            return -2
        }
        pipe = skip_trivia(
            source,
            enum_constructor_token_end(source, constructor)
        )
    }
    return -1
}

fn enum_constructor_index(
    source: Text,
    enum_type: Text,
    wanted: Text
) -> Int {
    let declaration = enum_declaration_start(source, enum_type)
    if declaration < 0 {
        return -1
    }
    let name = skip_trivia(source, token_end(source, declaration))
    let equals = skip_trivia(source, token_end(source, name))
    let mut pipe = skip_trivia(source, token_end(source, equals))
    let end = type_declaration_end(source, declaration)
    let mut tag = 0
    while pipe < end && token_text(source, pipe) == "|" {
        let constructor = skip_trivia(source, token_end(source, pipe))
        if token_text(source, constructor) == wanted {
            return tag
        }
        tag = tag + 1
        pipe = skip_trivia(
            source,
            enum_constructor_token_end(source, constructor)
        )
    }
    return -1
}

fn enum_constructor_owner(source: Text, wanted: Text) -> Text {
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        let type_start = type_declaration_start(source, cursor)
        if type_start >= 0 {
            let enum_type = type_name(source, type_start)
            if enum_constructor_index(source, enum_type, wanted) >= 0 {
                return enum_type
            }
        }
        let end = top_level_end(source, cursor)
        if end <= cursor {
            return ""
        }
        cursor = skip_trivia(source, end)
    }
    return ""
}

fn enum_binding_catchall_name(name: Text) -> Bool {
    if len(name) == 0 {
        return false
    }
    return !contains(
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        text_slice(name, 0, 1)
    )
}

fn enum_declaration_names(source: Text, constructors: Bool) -> Text {
    let mut names = "|"
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        let type_start = type_declaration_start(source, cursor)
        if type_start >= 0 {
            if constructors {
                let type_cursor = skip_trivia(
                    source,
                    token_end(source, type_start)
                )
                let equals = skip_trivia(
                    source,
                    token_end(source, type_cursor)
                )
                let mut pipe = skip_trivia(
                    source,
                    token_end(source, equals)
                )
                let end = type_declaration_end(source, type_start)
                while pipe < end && token_text(source, pipe) == "|" {
                    let constructor = skip_trivia(
                        source,
                        token_end(source, pipe)
                    )
                    names = names + token_text(source, constructor) + "|"
                    pipe = skip_trivia(
                        source,
                        enum_constructor_token_end(source, constructor)
                    )
                }
            } else {
                names = names + type_name(source, type_start) + "|"
            }
        }
        let end = top_level_end(source, cursor)
        if end <= cursor {
            return names
        }
        cursor = skip_trivia(source, end)
    }
    return names
}

fn enum_constructors_covered(
    source: Text,
    enum_type: Text,
    covered: Text
) -> Bool {
    let declaration = enum_declaration_start(source, enum_type)
    if declaration < 0 {
        return false
    }
    let name = skip_trivia(source, token_end(source, declaration))
    let equals = skip_trivia(source, token_end(source, name))
    let mut pipe = skip_trivia(source, token_end(source, equals))
    let end = type_declaration_end(source, declaration)
    while pipe < end && token_text(source, pipe) == "|" {
        let constructor = skip_trivia(source, token_end(source, pipe))
        let constructor_name = token_text(source, constructor)
        if !contains(covered, "|" + constructor_name + "|") {
            return false
        }
        pipe = skip_trivia(
            source,
            enum_constructor_token_end(source, constructor)
        )
    }
    return true
}

fn enum_missing_constructors(
    source: Text,
    enum_type: Text,
    covered: Text
) -> Text {
    let declaration = enum_declaration_start(source, enum_type)
    let name = skip_trivia(source, token_end(source, declaration))
    let equals = skip_trivia(source, token_end(source, name))
    let mut pipe = skip_trivia(source, token_end(source, equals))
    let end = type_declaration_end(source, declaration)
    let mut missing = ""
    while pipe < end && token_text(source, pipe) == "|" {
        let constructor = skip_trivia(source, token_end(source, pipe))
        let constructor_name = token_text(source, constructor)
        if !contains(covered, "|" + constructor_name + "|") {
            if len(missing) > 0 {
                missing = missing + ", "
            }
            missing = missing + "`" + constructor_name + "`"
        }
        pipe = skip_trivia(
            source,
            enum_constructor_token_end(source, constructor)
        )
    }
    return missing
}

# "" when a parameterized `type` declares exactly `[const NAME: Int]`, and the
# diagnostic that refuses it otherwise. Ordinary type parameters on a nominal
# type are named here rather than reported as a malformed declaration.
fn type_parameter_list_error(source: Text, start: Int) -> Text {
    let bracket = type_parameter_open(source, start)
    if bracket < 0 {
        return ""
    }
    let name = type_name(source, start)
    if balanced_end(source, bracket, "[", "]") < 0 {
        return "error[E2S148]: type `" + name +
        "` has an unterminated parameter list at byte " + to_text(bracket)
    }
    let keyword = skip_trivia(source, token_end(source, bracket))
    if token_text(source, keyword) != "const" {
        return "error[E2S148]: type parameters on a nominal type are unsupported; `" +
        name +
        "` may declare `[const NAME: Int]` only at byte " + to_text(keyword)
    }
    let parameter = skip_trivia(source, token_end(source, keyword))
    if token_kind(source, parameter) != "identifier" {
        return "error[E2S148]: const parameter of `" + name +
        "` must be named at byte " + to_text(parameter)
    }
    let colon = skip_trivia(source, token_end(source, parameter))
    if token_text(source, colon) != ":" {
        return "error[E2S148]: const parameter `" +
        token_text(source, parameter) + "` of `" + name +
        "` requires a `: Int` annotation at byte " + to_text(colon)
    }
    let annotation = skip_trivia(source, token_end(source, colon))
    if token_text(source, annotation) != "Int" {
        return "error[E2S148]: const parameter `" +
        token_text(source, parameter) + "` of `" + name + "` has type `" +
        token_text(source, annotation) +
        "`; only `Int` const parameters exist at byte " +
        to_text(annotation)
    }
    let after = skip_trivia(source, token_end(source, annotation))
    if token_text(source, after) != "]" {
        return "error[E2S148]: type `" + name +
        "` declares more than one parameter; exactly one const parameter is admissible at byte " +
        to_text(after)
    }
    if !record_declaration_at(source, start) {
        return "error[E2S148]: const parameters are admissible on a nominal record only; `" +
        name + "` is not one at byte " + to_text(bracket)
    }
    return ""
}

fn reserved_type_name(name: Text) -> Bool {
    return name == "Int" || name == "Bool" || name == "Float" ||
    name == "Unit" || name == "Text" || name == "List" || name == "_"
}

# Ownership mode is the optional first component of a parameter head.
fn ownership_mode_token(source: Text, cursor: Int) -> Bool {
    let token = token_text(source, cursor)
    return token == "read" || token == "edit" || token == "take"
}

# A word in a parameter head, which is an identifier *or* a keyword. `in` is a
# keyword here, so counting only identifiers made the contract's own headline
# example `fn replace(in text: Text, ...)` read as one word: no refusal fired
# and the misparse this check removes came back as
# `error[E2S35]: unknown lexical binding \`text\``. See the C profile for the
# measurement. `read`, `edit`, and `take` are not keywords, so the ownership
# modes were already counted.
fn parameter_word_token(source: Text, cursor: Int) -> Bool {
    let kind = token_kind(source, cursor)
    return kind == "identifier" || kind == "keyword"
}

# The internal name in one call-arguments-v1 parameter head. Every semantic
# reader uses this helper so mode, label, and body binding stay distinct.
fn parameter_internal_start(source: Text, cursor: Int, limit: Int) -> Int {
    let mut first = cursor
    if ownership_mode_token(source, first) {
        first = skip_trivia(source, token_end(source, first))
    }
    if first >= limit || !parameter_word_token(source, first) {
        return -1
    }
    let after_first = skip_trivia(source, token_end(source, first))
    if after_first < limit && token_text(source, after_first) == ":" {
        return first
    }
    if after_first >= limit || !parameter_word_token(source, after_first) {
        return -1
    }
    let colon = skip_trivia(source, token_end(source, after_first))
    if colon < limit && token_text(source, colon) == ":" {
        return after_first
    }
    return -1
}

fn parameter_external_start(source: Text, cursor: Int, limit: Int) -> Int {
    let mut first = cursor
    if ownership_mode_token(source, first) {
        first = skip_trivia(source, token_end(source, first))
    }
    let internal = parameter_internal_start(source, cursor, limit)
    if internal >= 0 && first != internal {
        return first
    }
    return -1
}

fn parameter_type_start(source: Text, cursor: Int, limit: Int) -> Int {
    let internal = parameter_internal_start(source, cursor, limit)
    if internal < 0 {
        return -1
    }
    let colon = skip_trivia(source, token_end(source, internal))
    if colon >= limit || token_text(source, colon) != ":" {
        return -1
    }
    let type_at = skip_trivia(source, token_end(source, colon))
    if type_at >= limit {
        return -1
    }
    return type_at
}

# The ownership slice has a real `List[Text]` parameter surface. Treat that
# bounded list annotation as one type rather than stopping at its `[` token.
fn parameter_list_type_end(source: Text, type_at: Int, limit: Int) -> Int {
    if type_at < 0 || token_text(source, type_at) != "List" {
        return -1
    }
    let open = skip_trivia(source, token_end(source, type_at))
    if open >= limit || token_text(source, open) != "[" {
        return -1
    }
    let element = skip_trivia(source, token_end(source, open))
    if element >= limit || !parameter_word_token(source, element) {
        return -1
    }
    let close = skip_trivia(source, token_end(source, element))
    if close >= limit || token_text(source, close) != "]" {
        return -1
    }
    return token_end(source, close)
}

fn parameter_list_type_text(source: Text, type_at: Int, limit: Int) -> Text {
    if parameter_list_type_end(source, type_at, limit) < 0 {
        return ""
    }
    let open = skip_trivia(source, token_end(source, type_at))
    let element = skip_trivia(source, token_end(source, open))
    return "List[" + token_text(source, element) + "]"
}

# Preserve any constructed List annotation as one canonical type identity.
# This is deliberately shape-only: lowering separately decides which element
# types are supported, while Scope HIR must not split `List[T]` into bindings.
fn constructed_list_type_end(
    source: Text,
    type_at: Int,
    limit: Int
) -> Int {
    if type_at < 0 || type_at >= limit ||
       token_text(source, type_at) != "List" {
        return -1
    }
    let open = skip_trivia(source, token_end(source, type_at))
    if open >= limit || token_text(source, open) != "[" {
        return -1
    }
    let close = balanced_end(source, open, "[", "]")
    if close < 0 || close > limit {
        return -1
    }
    return close
}

fn constructed_list_type_text(
    source: Text,
    type_at: Int,
    limit: Int
) -> Text {
    let finish = constructed_list_type_end(source, type_at, limit)
    if finish < 0 {
        return ""
    }
    let mut text = ""
    let mut cursor = type_at
    while cursor < finish {
        text = text + token_text(source, cursor)
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return text
}

fn trailing_lambda_refusal(cursor: Int) -> Text {
    return "error[E2S158]: a trailing lambda with a block body is specified " +
    "by call-arguments v1 but not implemented at byte " + to_text(cursor)
}

# The `(` of a trailing lambda attached to the call whose `)` ends just before
# `after_close`, or -1 when no trailing lambda follows.
#
# `) fn(` is the trailing form and nothing else in this profile's grammar. A
# named declaration is `fn` and an identifier, so requiring `(` after `fn`
# leaves `call()` followed by `fn next(...)` alone.
#
# Returning the parameter list's `(` rather than the `fn` is what lets the
# existing consumers treat the lambda as an ordinary argument written at that
# offset: `lambda_parameters_end` spans from there, and `argument_lambda_name`
# already keys lifted definitions on exactly this token.
fn trailing_lambda_open(source: Text, after_close: Int) -> Int {
    if after_close < 0 {
        return -1
    }
    let keyword_at = skip_trivia(source, after_close)
    if keyword_at >= len(source) || token_text(source, keyword_at) != "fn" {
        return -1
    }
    let parameters = skip_trivia(source, token_end(source, keyword_at))
    if parameters >= len(source) || token_text(source, parameters) != "(" {
        return -1
    }
    return parameters
}

# The same attachment keyed by the call's `(`, for the sites that hold the
# opening token rather than the closing one.
fn call_trailing_lambda_open(source: Text, open: Int) -> Int {
    return trailing_lambda_open(source, balanced_end(source, open, "(", ")"))
}

# The declaration slot a trailing lambda binds — the final parameter — or -1
# when the call has none. The emitter that reserves fixed carriers and the
# emitter that fills the ABI vector must agree on exactly which slot is the
# lambda's, or the call passes an unassigned carrier.
fn trailing_lambda_slot(source: Text, open: Int, parameter_count_value: Int) -> Int {
    if parameter_count_value <= 0 {
        return -1
    }
    if call_trailing_lambda_open(source, open) < 0 {
        return -1
    }
    return parameter_count_value - 1
}

fn validate_trailing_lambda_surface(source: Text) -> Text {
    # The expression body is what this profile lowers. The block body is
    # accepted design and not current capability: `lambda_parameters_end`
    # requires `=>`, so a block body would span as -1 and be misread as the
    # start of the next declaration. Naming it here keeps that a refusal the
    # author can act on rather than a misparse blaming a later token.
    let mut scan = skip_trivia(source, 0)
    while scan < len(source) {
        if token_text(source, scan) == ")" {
            let parameters = trailing_lambda_open(source, token_end(source, scan))
            if parameters >= 0 {
                let close = balanced_end(source, parameters, "(", ")")
                if close < 0 {
                    return trailing_lambda_refusal(
                        skip_trivia(source, token_end(source, scan))
                    )
                }
                let arrow = skip_trivia(source, close)
                if arrow >= len(source) || token_text(source, arrow) != "=>" {
                    return trailing_lambda_refusal(
                        skip_trivia(source, token_end(source, scan))
                    )
                }
            }
        }
        scan = skip_trivia(source, token_end(source, scan))
    }

    return ""
}

fn pipeline_refusal(reason: Text, pipe: Int) -> Text {
    return "error[E2S158]: " + reason + " at byte " + to_text(pipe)
}

# The pipeline shapes this slice does not recognize, refused before scope
# construction.
#
# The recognized production survives scope building — its subject is an
# ordinary expression and its callee an ordinary name — so it is refused later,
# where the semantic observer is live and its spans can be published. These
# shapes do not survive: `subject |> callee` with no parentheses reaches
# `E2S35 unknown lexical binding` first, because a bare callee is a name the
# scope builder cannot resolve. Refusing here is what makes the message about
# the pipeline the author wrote rather than about a binding they never meant to
# reference.
#
# Almost no source contains `|>` at all, and a substring scan settles that
# without tokenizing. This is about not doing pointless work rather than about a
# measured regression: best-of-3 self-compiles on a quiet machine put both walks
# inside the noise (84.2s with, 84.6s without, against ~2.7s of run-to-run
# variance).
#
# Note the guard's worst case is the file this project compiles most often.
# This very file names `|>` in the lexer's two-character token table, so the
# self-compile passes the guard and walks — and is still correct, because the
# walk compares whole tokens and a string literal is one token that is not `|>`.
fn validate_pipeline_shapes(source: Text) -> Text {
    if !contains(source, "|>") {
        return ""
    }
    let mut scan = skip_trivia(source, 0)
    while scan < len(source) {
        if token_text(source, scan) == "|>" {
            let call_end = pipeline_call_end(source, scan)
            if call_end < 0 {
                # A member target has its parentheses, so saying it lacks them
                # would describe the wrong defect. `a.b(...)` is a different
                # boundary from `a`, and the two are told apart by the token
                # after the callee.
                let callee = skip_trivia(source, token_end(source, scan))
                let mut member = false
                if callee < len(source) {
                    let after_callee = skip_trivia(
                        source,
                        token_end(source, callee)
                    )
                    if after_callee < len(source) &&
                       token_text(source, after_callee) == "." {
                        member = true
                    }
                }
                if member {
                    return pipeline_refusal(
                        "a pipeline target must be a top-level function, " +
                        "not a member call",
                        scan
                    )
                }
                return pipeline_refusal(
                    "a pipeline target must be a direct call written with " +
                    "its parentheses",
                    scan
                )
            }
            let after = skip_trivia(source, call_end)
            if after < len(source) && token_text(source, after) == "|>" {
                return pipeline_refusal(
                    "a pipeline chain is specified by call-arguments v1 but " +
                    "not recognized",
                    scan
                )
            }
            if trailing_lambda_open(source, call_end) >= 0 {
                return pipeline_refusal(
                    "a pipeline with a trailing lambda is specified by " +
                    "call-arguments v1 but not recognized",
                    scan
                )
            }
        }
        scan = skip_trivia(source, token_end(source, scan))
    }
    return ""
}

fn parse_program(source: Text) -> Text {
    # #882 owns attachment/lowering; refuse before ordinary call analysis can
    # reinterpret the trailing lambda as a separate expression.
    let surface_check = validate_trailing_lambda_surface(source)
    if starts_with(surface_check, "error[") {
        return surface_check
    }
    # #1190: pipeline shapes outside the recognized production, refused before
    # scope construction can report a bare callee as an unknown binding.
    let pipeline_shape_check = validate_pipeline_shapes(source)
    if starts_with(pipeline_shape_check, "error[") {
        return pipeline_shape_check
    }
    # Const generic surface (#916). Both checks run before any declaration is
    # recorded, so a refused source never reaches layout, IR, or an artifact.
    let const_argument_check = validate_const_arguments(source)
    if starts_with(const_argument_check, "error[") {
        return const_argument_check
    }
    let const_erasure_check = validate_const_erasure(source)
    if starts_with(const_erasure_check, "error[") {
        return const_erasure_check
    }
    let mut ir = "kofun-stage2-ir/v1\nsource-bytes|" +
    to_text(len(source)) + "\n"
    let mut cursor = skip_trivia(source, 0)
    let mut functions = 0
    let mut types = 0
    let mut records = 0
    let mut record_fields = 0
    let mut constants = 0
    let mut declared_types = "|"
    let mut declared_constructors = "|"
    while cursor < len(source) {
        let visibility_error = visibility_prefix_error(source, cursor)
        if len(visibility_error) > 0 {
            return visibility_error
        }
        let declaration_start = cursor
        let type_start = type_declaration_start(source, declaration_start)
        if type_start >= 0 {
            let name = type_name(source, type_start)
            let end = type_declaration_end(source, type_start)
            let explicit_visibility = declaration_start != type_start
            let mut origin = "implicit"
            let mut modifier_start = -1
            let mut modifier_end = -1
            if explicit_visibility {
                origin = "explicit"
                modifier_start = declaration_start
                modifier_end = token_end(source, declaration_start)
            }
            let parameter_list_error = type_parameter_list_error(
                source,
                type_start
            )
            if len(parameter_list_error) > 0 {
                return parameter_list_error
            }
            if record_declaration_at(source, type_start) {
                let fields = record_field_count(source, name)
                if len(name) == 0 || end < 0 || fields == -3 {
                    return "error[E2S32]: malformed nominal record declaration at byte " +
                    to_text(cursor)
                }
                if fields == -2 {
                    return "error[E2S32]: record `" + name +
                    "` has a field type outside the Stage 2 Int/Bool/Text/List[Int] slice at byte " +
                    to_text(cursor)
                }
                if fields == -4 {
                    return "error[E2S32]: nominal record field limit is 128 per record at byte " +
                    to_text(cursor)
                }
                if reserved_type_name(name) {
                    return "error[E2S32]: nominal record cannot shadow built-in type `" +
                    name + "` at byte " + to_text(cursor)
                }
                if contains(declared_types, "|" + name + "|") {
                    return "error[E2S32]: duplicate nominal aggregate type `" +
                    name + "` at byte " + to_text(cursor)
                }
                if contains(declared_constructors, "|" + name + "|") {
                    return "error[E2S32]: nominal record type `" + name +
                    "` conflicts with an enum constructor at byte " +
                    to_text(cursor)
                }
                records = records + 1
                record_fields = record_fields + fields
                if records > 16 {
                    return "error[E2S32]: nominal record limit is 16 types at byte " +
                    to_text(cursor)
                }
                if record_fields > 128 {
                    return "error[E2S32]: nominal record field limit is 128 per module at byte " +
                    to_text(cursor)
                }
                declared_types = declared_types + name + "|"
                ir = ir + "record|" + name + "|" + to_text(fields) + "|" +
                to_text(type_start) + "|" + to_text(end) + "|" +
                visibility_level(source, declaration_start) + "|" + origin + "|" +
                to_text(modifier_start) + "|" + to_text(modifier_end) + "\n"
                let mut field_index = 0
                while field_index < fields {
                    ir = ir + "record-field|" + name + "|" +
                    record_field_text(
                        source,
                        name,
                        field_index,
                        false
                    ) + "|" +
                    record_field_text(
                        source,
                        name,
                        field_index,
                        true
                    ) + "|" + to_text(field_index) + "\n"
                    field_index = field_index + 1
                }
                cursor = skip_trivia(source, end)
            } else {
            if end == -2 {
                return "error[E2S31]: concrete enum constructor limit is 64 at byte " +
                to_text(cursor)
            }
            if len(name) == 0 || end < 0 {
                return "error[E2S31]: malformed concrete enum declaration at byte " +
                to_text(cursor)
            }
            if reserved_type_name(name) {
                return "error[E2S31]: concrete enum cannot shadow built-in type `" +
                name + "` at byte " + to_text(cursor)
            }
            types = types + 1
            if types > 32 {
                return "error[E2S31]: concrete enum limit is 32 types at byte " +
                to_text(cursor)
            }
            if contains(declared_types, "|" + name + "|") {
                return "error[E2S31]: duplicate concrete enum type `" + name +
                "` at byte " + to_text(cursor)
            }
            if contains(declared_constructors, "|" + name + "|") {
                return "error[E2S31]: concrete enum type `" + name +
                "` conflicts with a constructor at byte " + to_text(cursor)
            }
            declared_types = declared_types + name + "|"
            let count = enum_constructor_count(source, name)
            if count < 1 {
                return "error[E2S31]: concrete enum must declare a constructor at byte " +
                to_text(cursor)
            }
            if count > 64 {
                return "error[E2S31]: concrete enum constructor limit is 64 at byte " +
                to_text(cursor)
            }
            ir = ir + "type|" + name + "|" + to_text(count) + "|" +
            to_text(type_start) + "|" + to_text(end) + "|" +
            visibility_level(source, declaration_start) + "|" + origin + "|" +
            to_text(modifier_start) + "|" + to_text(modifier_end) + "\n"
            let name_cursor = skip_trivia(source, token_end(source, type_start))
            let equals = skip_trivia(source, token_end(source, name_cursor))
            let mut pipe = skip_trivia(source, token_end(source, equals))
            let mut tag = 0
            while pipe < end && token_text(source, pipe) == "|" {
                let constructor = skip_trivia(source, token_end(source, pipe))
                let constructor_name = token_text(source, constructor)
                if constructor_name == "_" {
                    return "error[E2S31]: `_` is reserved for enum catch-all patterns at byte " +
                    to_text(constructor)
                }
                if contains(
                    declared_constructors,
                    "|" + constructor_name + "|"
                ) {
                    return "error[E2S31]: duplicate concrete enum constructor `" +
                    constructor_name + "` at byte " + to_text(constructor)
                }
                if contains(declared_types, "|" + constructor_name + "|") {
                    return "error[E2S31]: concrete enum constructor `" +
                    constructor_name + "` conflicts with an enum type at byte " +
                    to_text(constructor)
                }
                declared_constructors = declared_constructors +
                constructor_name + "|"
                let payload_open = skip_trivia(
                    source,
                    token_end(source, constructor)
                )
                let mut payload_count = 0
                let mut payload_type = ""
                if payload_open < end &&
                   token_text(source, payload_open) == "(" {
                    payload_count = 1
                    let payload_name = skip_trivia(
                        source,
                        token_end(source, payload_open)
                    )
                    let payload_colon = skip_trivia(
                        source,
                        token_end(source, payload_name)
                    )
                    let payload_type_start = skip_trivia(
                        source,
                        token_end(source, payload_colon)
                    )
                    if payload_type_start < end {
                        payload_type = token_text(source, payload_type_start)
                    }
                }
                ir = ir + "constructor|" + constructor_name + "|" +
                name + "|" + to_text(tag) + "|" +
                to_text(constructor) + "|" +
                to_text(token_end(source, constructor)) + "|" +
                to_text(payload_count) + "|" + payload_type + "\n"
                tag = tag + 1
                pipe = skip_trivia(
                    source,
                    enum_constructor_token_end(source, constructor)
                )
            }
            cursor = skip_trivia(source, end)
            }
        } else if token_text(source, cursor) == "let" {
            let constant_close = constant_declaration_end(source, cursor)
            if constant_close < 0 {
                let after_let = skip_trivia(source, token_end(source, cursor))
                if token_text(source, after_let) == "mut" {
                    return "error[E2S161]: module constant `" +
                    token_text(
                        source,
                        skip_trivia(source, token_end(source, after_let))
                    ) +
                    "` cannot be `mut`; a top-level `let` is immutable at byte " +
                    to_text(cursor)
                }
                return "error[E2S159]: module constant must be `let NAME = " +
                "<integer literal>` at byte " + to_text(cursor)
            }
            let constant = constant_name(source, cursor)
            if constant_declaration_count(source, constant) > 1 {
                return "error[E2S160]: duplicate module constant `" +
                constant + "` at byte " + to_text(cursor)
            }
            if contains(declared_types, "|" + constant + "|") ||
               contains(declared_constructors, "|" + constant + "|") ||
               function_arity(source, constant) >= 0 {
                return "error[E2S159]: module constant `" + constant +
                "` conflicts with a declaration of the same name at byte " +
                to_text(cursor)
            }
            constants = constants + 1
            ir = ir + "constant|" + constant + "|" +
            constant_value_text(source, cursor) + "|" +
            to_text(cursor) + "|" + to_text(constant_close) + "\n"
            cursor = skip_trivia(source, constant_close)
        } else if function_declaration_start(source, cursor) < 0 {
            return "error[E2S02]: expected top-level `fn`, `type`, or `let` " +
            "at byte " + to_text(cursor)
        } else {
            let declaration_start = cursor
            let function_start = function_declaration_start(
                source,
                declaration_start
            )
            let name = function_name(source, function_start)
            let arity = parameter_count(source, function_start)
            let end = function_end(source, function_start)
            if len(name) == 0 || arity < 0 || end < 0 {
                return "error[E2S03]: malformed function at byte " +
                to_text(function_start)
            }
            let local_error = local_visibility_error(
                source,
                function_start,
                end
            )
            if len(local_error) > 0 {
                return local_error
            }
            let explicit_visibility = declaration_start != function_start
            let mut origin = "implicit"
            let mut modifier_start = -1
            let mut modifier_end = -1
            if explicit_visibility {
                origin = "explicit"
                modifier_start = declaration_start
                modifier_end = token_end(source, declaration_start)
            }
            ir = ir + "function|" + name + "|" + to_text(arity) + "|" +
            to_text(function_start) + "|" + to_text(end) + "|" +
            visibility_level(source, declaration_start) + "|" + origin + "|" +
            to_text(modifier_start) + "|" + to_text(modifier_end) + "|" +
            to_text(declaration_start) + "|" + to_text(end) +
            "|file:0|symbol:" + to_text(functions) + "\n"
            functions = functions + 1
            cursor = skip_trivia(source, end)
        }
    }
    if functions == 0 {
        return "error[E2S04]: compilation unit has no functions"
    }
    ir = ir + "function-count|" + to_text(functions) + "\n"
    ir = ir + "constant-count|" + to_text(constants) + "\n"
    let patterns = parse_pattern_trees(source)
    let pattern_error = pattern_first_error(patterns)
    if len(pattern_error) > 0 {
        return pattern_error
    }
    return ir + patterns
}

fn copy_type(type_name: Text) -> Bool {
    return type_name == "Int" || type_name == "Float" ||
    type_name == "Bool" || type_name == "Unit"
}

fn return_move_at(
    source: Text,
    body_open: Int,
    body_end: Int,
    element_name: Text
) -> Int {
    let mut cursor = skip_trivia(source, token_end(source, body_open))
    while cursor < body_end {
        if token_text(source, cursor) == "return" {
            let return_line = line_at(source, cursor)
            let mut value_cursor = skip_trivia(
                source,
                token_end(source, cursor)
            )
            while value_cursor < body_end &&
                  line_at(source, value_cursor) == return_line {
                if token_text(source, value_cursor) == element_name {
                    return value_cursor
                }
                value_cursor = skip_trivia(
                    source,
                    token_end(source, value_cursor)
                )
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return -1
}

fn borrowed_collection_check(source: Text) -> Text {
    let mut function_cursor = next_function_start(source, 0)
    let mut recognized_loops = 0
    while function_cursor < len(source) {
        let parameters_open = parameter_open(source, function_cursor)
        if parameters_open < 0 {
            return "error[E2S03]: malformed function"
        }
        let parameters_end = balanced_end(
            source,
            parameters_open,
            "(",
            ")"
        )
        if parameters_end < 0 {
            return "error[E2S03]: malformed parameters"
        }

        let mut borrowed_name = ""
        let mut element_type = ""
        let mut borrowed_lists = 0
        let mut parameter_cursor = skip_trivia(
            source,
            token_end(source, parameters_open)
        )
        while parameter_cursor < parameters_end &&
              token_text(source, parameter_cursor) != ")" {
            if token_text(source, parameter_cursor) == "read" {
                let name_cursor = parameter_internal_start(
                    source,
                    parameter_cursor,
                    parameters_end
                )
                let list_cursor = parameter_type_start(
                    source,
                    parameter_cursor,
                    parameters_end
                )
                let mut bracket_cursor = -1
                let mut element_cursor = -1
                if list_cursor >= 0 {
                    bracket_cursor = skip_trivia(
                        source,
                        token_end(source, list_cursor)
                    )
                }
                if bracket_cursor >= 0 {
                    element_cursor = skip_trivia(
                        source,
                        token_end(source, bracket_cursor)
                    )
                }
                if name_cursor >= 0 && list_cursor >= 0 &&
                   bracket_cursor >= 0 && element_cursor >= 0 &&
                   token_kind(source, name_cursor) == "identifier" &&
                   token_text(source, list_cursor) == "List" &&
                   token_text(source, bracket_cursor) == "[" &&
                   token_kind(source, element_cursor) == "identifier" {
                    borrowed_lists = borrowed_lists + 1
                    if borrowed_lists > 1 {
                        return "error[E2S21]: ownership slice supports one borrowed List parameter per function"
                    }
                    borrowed_name = token_text(source, name_cursor)
                    element_type = token_text(source, element_cursor)
                }
            }
            parameter_cursor = skip_trivia(
                source,
                token_end(source, parameter_cursor)
            )
        }

        let function_end_cursor = function_end(source, function_cursor)
        let mut body_open = skip_trivia(source, parameters_end)
        while body_open < function_end_cursor &&
              token_text(source, body_open) != "{" {
            body_open = skip_trivia(source, token_end(source, body_open))
        }
        if function_end_cursor < 0 || body_open >= function_end_cursor {
            return "error[E2S03]: malformed function body"
        }

        let mut cursor = skip_trivia(source, token_end(source, body_open))
        while cursor < function_end_cursor {
            if token_text(source, cursor) == "for" {
                let element_cursor = skip_trivia(
                    source,
                    token_end(source, cursor)
                )
                let in_cursor = skip_trivia(
                    source,
                    token_end(source, element_cursor)
                )
                let collection_cursor = skip_trivia(
                    source,
                    token_end(source, in_cursor)
                )
                let loop_open = skip_trivia(
                    source,
                    token_end(source, collection_cursor)
                )
                if token_kind(source, element_cursor) == "identifier" &&
                   token_text(source, in_cursor) == "in" &&
                   token_kind(source, collection_cursor) == "identifier" &&
                   token_text(source, loop_open) == "{" {
                    let loop_end = balanced_end(source, loop_open, "{", "}")
                    if loop_end < 0 {
                        return "error[E2S03]: malformed for body"
                    }
                    if len(borrowed_name) > 0 &&
                       token_text(source, collection_cursor) == borrowed_name {
                        recognized_loops = recognized_loops + 1
                        let element_name = token_text(source, element_cursor)
                        let move_at = return_move_at(
                            source,
                            loop_open,
                            loop_end,
                            element_name
                        )
                        if move_at >= 0 && !copy_type(element_type) {
                            return "error[E007]: cannot move non-Copy element `" +
                            element_name + ": " + element_type +
                            "` out of borrowed collection `" + borrowed_name +
                            "` at line " + to_text(line_at(source, move_at)) +
                            "; return a Copy scalar or clone the element"
                        }
                    }
                }
            }
            cursor = skip_trivia(source, token_end(source, cursor))
        }
        function_cursor = next_function_start(source, function_end_cursor)
    }
    if recognized_loops == 0 {
        return "error[E2S20]: Stage 2 ownership slice requires `for element in read_list`"
    }
    return "ok"
}

# RFC-0013. The eight bit operations are members of an `Int` receiver, not
# reserved words: `and` stays an ordinary identifier everywhere else, exactly as
# `join` does, so `fn and()` still declares and `type P = { xor: Int }` still
# has a field. A name is meaningful only in `<Int>.name(...)` position, which is
# why this table is consulted from the postfix reader rather than the lexer.
#
# The arity is returned rather than a `Bool` because it is the one fact both
# readers need — the parser to know a call follows, the lowerer to refuse a call
# that supplies the wrong number of arguments — and keeping one table means the
# two cannot disagree about what the set is.
fn int_bit_method_arity(name: Text) -> Int {
    if name == "not" {
        return 0
    }
    if name == "and" || name == "or" || name == "xor" ||
       name == "shl" || name == "shr" {
        return 1
    }
    if name == "rotr" || name == "wrapping_add" {
        return 2
    }
    return -1
}

# The same table read at a position. Both readers below hold a cursor rather
# than a name, and one place that turns a cursor into an arity keeps them from
# disagreeing about what counts as a table name.
fn int_bit_method_arity_at(source: Text, cursor: Int) -> Int {
    if cursor >= len(source) || token_kind(source, cursor) != "identifier" {
        return -1
    }
    return int_bit_method_arity(token_text(source, cursor))
}

# Zero or more `.name(arguments)` calls drawn from that table, left to right.
# A name outside the table, or a table name with no call after it, is left
# unconsumed, so the record-field reader below keeps its existing answer for
# `p.and` and for every member this slice does not own.
fn int_bit_postfix_end(source: Text, primary: Int) -> Int {
    let mut cursor = primary
    while cursor < len(source) {
        let dot = skip_trivia(source, cursor)
        if dot >= len(source) || token_text(source, dot) != "." {
            return cursor
        }
        # Any member call is consumed, not only a table name. An unknown member
        # left the `(` behind, and the argument counter then read the enclosing
        # call as malformed: `to_text(x.frobnicate(2))` was refused as `to_text`
        # expecting 1 argument and getting -1. The lowerer decides what the
        # member means; this only decides where the expression ends.
        let name = skip_trivia(source, token_end(source, dot))
        if name >= len(source) || token_kind(source, name) != "identifier" {
            return cursor
        }
        let open = skip_trivia(source, token_end(source, name))
        if open >= len(source) || token_text(source, open) != "(" {
            return cursor
        }
        let close = balanced_end(source, open, "(", ")")
        if close < 0 {
            return cursor
        }
        # A trailing lambda binds to the call it follows, so it has to be inside
        # this span even though no bit operation has a functional final slot.
        # Leaving it here made the argument counter read the *enclosing* call as
        # malformed: `to_text(x.and(2) fn(y) => y)` was refused as `to_text`
        # expecting 1 argument and getting -1, blaming a call the author did not
        # get wrong. The refusal that names the lambda is in the lowerer.
        #
        # A block body spans to -1 and is already refused as `E2S158` at its own
        # `fn`, so it is left where that rule reports it.
        let lambda_open = trailing_lambda_open(source, close)
        if lambda_open >= 0 {
            let lambda_close = lambda_parameters_end(source, -1, lambda_open)
            if lambda_close < 0 {
                return close
            }
            cursor = lambda_close
        } else {
            cursor = close
        }
    }
    return cursor
}

fn field_postfix_end(source: Text, primary: Int) -> Int {
    # A bit-operation chain is tried first because the record-field reader
    # consumes `.and` on its own and would leave the `(` behind — the argument
    # counter then read the call as a malformed one and the program was refused
    # for an arity it never had.
    let leading_bits = int_bit_postfix_end(source, primary)
    if leading_bits > primary {
        return leading_bits
    }
    let field_read = field_read_postfix_end(source, primary)
    if field_read <= primary {
        return field_read
    }
    # A field read may carry a chain of its own: `state.h0.xor(mask)` is one
    # `Int` receiver like any other.
    return int_bit_postfix_end(source, field_read)
}

fn field_read_postfix_end(source: Text, primary: Int) -> Int {
    let dot = skip_trivia(source, primary)
    if dot < len(source) && token_text(source, dot) == "[" &&
       source_has_list_int_local(source) {
        return balanced_end(source, dot, "[", "]")
    }
    if dot >= len(source) || token_text(source, dot) != "." {
        return primary
    }
    let field = skip_trivia(source, token_end(source, dot))
    if field >= len(source) || token_kind(source, field) != "identifier" {
        return -1
    }
    # A `List[Int]` record field read is a value this slice indexes (#1197),
    # so one subscript may follow the field exactly as it may follow a bound
    # local. Only one: a chain past it is not in this slice, and leaving the
    # rest unconsumed keeps the existing refusal rather than inventing a
    # shape for it.
    #
    # The guard is the same whole-source one the bound-local case uses, and
    # it is sufficient here rather than needing a record-field variant: a
    # literal must be bound before it can be passed, so every program that
    # populates a `List[Int]` field has a `List[Int]` local somewhere in the
    # file to have built the value from.
    let index_open = skip_trivia(source, token_end(source, field))
    if index_open < len(source) &&
       token_text(source, index_open) == "[" &&
       source_has_list_int_local(source) {
        return balanced_end(source, index_open, "[", "]")
    }
    return token_end(source, field)
}

# `List[Int]` is one binding type, never the three unrelated tokens that the
# historical single-token reader exposed to lexical resolution.
fn list_int_type_end(source: Text, type_start: Int) -> Int {
    if type_start >= len(source) ||
       token_text(source, type_start) != "List" {
        return -1
    }
    let open = skip_trivia(source, token_end(source, type_start))
    let element = skip_trivia(source, token_end(source, open))
    let close = skip_trivia(source, token_end(source, element))
    if open >= len(source) || token_text(source, open) != "[" ||
       element >= len(source) || token_text(source, element) != "Int" ||
       close >= len(source) || token_text(source, close) != "]" {
        return -1
    }
    return token_end(source, close)
}

fn source_has_list_int_local(source: Text) -> Bool {
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        if token_text(source, cursor) == "let" {
            let mut name = skip_trivia(source, token_end(source, cursor))
            if token_text(source, name) == "mut" {
                name = skip_trivia(source, token_end(source, name))
            }
            let mut after = skip_trivia(source, token_end(source, name))
            if after < len(source) && token_text(source, after) == ":" {
                let type_start = skip_trivia(source, token_end(source, after))
                let type_finish = list_int_type_end(source, type_start)
                if type_finish >= 0 {
                    return true
                }
                after = skip_trivia(source, token_end(source, type_start))
            }
            if after < len(source) && token_text(source, after) == "=" {
                let value = skip_trivia(source, token_end(source, after))
                if value < len(source) && token_text(source, value) == "[" {
                    return true
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

# Count the elements in one bracketed literal. Each element is one bounded
# expression; semantic element typing is checked after the scope HIR exists.
fn list_int_literal_count(source: Text, open: Int) -> Int {
    if open >= len(source) || token_text(source, open) != "[" {
        return -1
    }
    let mut element = skip_trivia(source, token_end(source, open))
    if element < len(source) && token_text(source, element) == "]" {
        return 0
    }
    let mut count = 0
    while element < len(source) {
        let bound = expression_end(source, element)
        if bound < 0 {
            return -1
        }
        count = count + 1
        let separator = skip_trivia(source, bound)
        if separator >= len(source) {
            return -1
        }
        if token_text(source, separator) == "]" {
            return count
        }
        if token_text(source, separator) != "," {
            return -1
        }
        element = skip_trivia(source, token_end(source, separator))
    }
    return -1
}

# Every identifier inside a constructed local List annotation is declaration
# syntax, not a lexical read. Keeping this local-only preserves #919's
# boundary: parameters and results still reach their lowering diagnostics.
fn list_int_local_type_token(source: Text, target: Int) -> Bool {
    let mut cursor = skip_trivia(source, 0)
    while cursor <= target && cursor < len(source) {
        if token_text(source, cursor) == "let" {
            let mut name = skip_trivia(source, token_end(source, cursor))
            if token_text(source, name) == "mut" {
                name = skip_trivia(source, token_end(source, name))
            }
            let colon = skip_trivia(source, token_end(source, name))
            if colon < len(source) && token_text(source, colon) == ":" {
                let type_start = skip_trivia(
                    source,
                    token_end(source, colon)
                )
                let type_finish = constructed_list_type_end(
                    source,
                    type_start,
                    len(source)
                )
                if type_finish >= 0 {
                    if target >= type_start && target < type_finish {
                        return true
                    }
                    cursor = skip_trivia(source, type_finish)
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

fn validate_list_int_annotations(source: Text) -> Text {
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let parameters = parameter_open(source, function_start)
        let parameters_close = balanced_end(source, parameters, "(", ")")
        let mut parameter = skip_trivia(
            source,
            token_end(source, parameters)
        )
        while parameter < parameters_close &&
              token_text(source, parameter) != ")" {
            let type_start = parameter_type_start(
                source,
                parameter,
                parameters_close
            )
            if type_start < 0 {
                parameter = parameters_close
                continue
            }
            if ownership_mode_token(source, parameter) &&
               list_int_type_end(source, type_start) >= 0 {
                return "error[E2S157]: List[Int] function parameters support only the immutable copy mode at byte " +
                to_text(parameter)
            }
            if type_start >= 0 && token_text(source, type_start) == "List" &&
               list_int_type_end(source, type_start) < 0 {
                return "error[E2S157]: Stage 2 function list signatures require exactly List[Int] at byte " +
                to_text(type_start)
            }
            let mut type_end = parameter_list_type_end(
                source,
                type_start,
                parameters_close
            )
            if type_end < 0 {
                type_end = annotation_type_end(source, type_start)
            }
            let separator = skip_trivia(source, type_end)
            if separator < parameters_close &&
               token_text(source, separator) == "," {
                parameter = skip_trivia(
                    source,
                    token_end(source, separator)
                )
            } else {
                parameter = separator
            }
        }
        let after = skip_trivia(source, parameters_close)
        if after < len(source) && token_text(source, after) == "->" {
            let result = skip_trivia(source, token_end(source, after))
            if token_text(source, result) == "List" &&
               list_int_type_end(source, result) < 0 {
                return "error[E2S157]: Stage 2 function list signatures require exactly List[Int] at byte " +
                to_text(result)
            }
        }
        function_start = next_function_start(
            source,
            function_end(source, function_start)
        )
    }
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        if token_text(source, cursor) == "let" {
            let mut name = skip_trivia(source, token_end(source, cursor))
            if token_text(source, name) == "mut" {
                name = skip_trivia(source, token_end(source, name))
            }
            let colon = skip_trivia(source, token_end(source, name))
            if colon < len(source) && token_text(source, colon) == ":" {
                let type_start = skip_trivia(
                    source,
                    token_end(source, colon)
                )
                if token_text(source, type_start) == "List" &&
                   list_int_type_end(source, type_start) < 0 {
                    return "error[E2S157]: Stage 2 local lists require exactly List[Int] at byte " +
                    to_text(type_start)
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return "ok"
}

# The end of a call whose `)` is at `close`, including any trailing lambda.
#
# The trailing lambda is an argument of that call, so it belongs inside the
# call's span. Stopping at `)` would leave `fn (` to be re-read as the start of
# the next expression or declaration.
fn call_postfix_end(source: Text, close: Int) -> Int {
    let after_close = token_end(source, close)
    let lambda_open = trailing_lambda_open(source, after_close)
    if lambda_open >= 0 {
        return lambda_parameters_end(source, -1, lambda_open)
    }
    return field_postfix_end(source, after_close)
}

fn primary_end(source: Text, start: Int) -> Int {
    let cursor = skip_trivia(source, start)
    if cursor >= len(source) {
        return -1
    }
    if token_text(source, cursor) == "[" {
        let mut element = skip_trivia(source, token_end(source, cursor))
        if element < len(source) && token_text(source, element) == "]" {
            return field_postfix_end(source, token_end(source, element))
        }
        while element < len(source) {
            let bound = expression_end(source, element)
            if bound < 0 {
                return -1
            }
            let separator = skip_trivia(source, bound)
            if separator >= len(source) {
                return -1
            }
            if token_text(source, separator) == "]" {
                return field_postfix_end(
                    source,
                    token_end(source, separator)
                )
            }
            if token_text(source, separator) != "," {
                return -1
            }
            element = skip_trivia(source, token_end(source, separator))
        }
        return -1
    }
    let kind = token_kind(source, cursor)
    if kind == "integer" || kind == "decimal" || kind == "float" ||
       kind == "string" {
        return field_postfix_end(source, token_end(source, cursor))
    }
    # Bool expressions remain outside this bounded arithmetic reader. The one
    # owned exception is a Bool written as the receiver of a known bit method:
    # measuring that primary lets the Int-only rule report E2S168, without
    # broadening unrelated Bool value-position grammar.
    if token_text(source, cursor) == "true" ||
       token_text(source, cursor) == "false" {
        let primary = token_end(source, cursor)
        let dot = skip_trivia(source, primary)
        let mut name = -1
        if dot < len(source) && token_text(source, dot) == "." {
            name = skip_trivia(source, token_end(source, dot))
        }
        let mut open = -1
        if name >= 0 {
            open = skip_trivia(source, token_end(source, name))
        }
        if name >= 0 && int_bit_method_arity_at(source, name) >= 0 &&
           open < len(source) && token_text(source, open) == "(" {
            return int_bit_postfix_end(source, primary)
        }
        return -1
    }
    if kind == "identifier" {
        if len(numeric_conversion_at(source, cursor)) > 0 {
            let dot = skip_trivia(source, token_end(source, cursor))
            let member = skip_trivia(source, token_end(source, dot))
            let open = skip_trivia(source, token_end(source, member))
            let mut argument = skip_trivia(source, token_end(source, open))
            if argument < len(source) && token_text(source, argument) == ")" {
                return field_postfix_end(source, token_end(source, argument))
            }
            while argument < len(source) {
                let bound = argument_end(source, argument)
                if bound < 0 {
                    return -1
                }
                let separator = skip_trivia(source, bound)
                if separator < len(source) &&
                   token_text(source, separator) == ")" {
                    return field_postfix_end(
                        source,
                        token_end(source, separator)
                    )
                }
                if separator >= len(source) ||
                   token_text(source, separator) != "," {
                    return -1
                }
                argument = skip_trivia(source, token_end(source, separator))
            }
            return -1
        }
        let open = skip_trivia(source, token_end(source, cursor))
        if open >= len(source) || token_text(source, open) != "(" {
            return field_postfix_end(source, token_end(source, cursor))
        }
        let mut argument = skip_trivia(source, token_end(source, open))
        if argument < len(source) && token_text(source, argument) == ")" {
            return call_postfix_end(source, argument)
        }
        while argument < len(source) {
            let bound = argument_end(source, argument)
            if bound < 0 {
                return -1
            }
            let separator = skip_trivia(source, bound)
            if separator < len(source) &&
               token_text(source, separator) == ")" {
                return call_postfix_end(source, separator)
            }
            if separator >= len(source) ||
               token_text(source, separator) != "," {
                return -1
            }
            argument = skip_trivia(source, token_end(source, separator))
        }
        return -1
    }
    if token_text(source, cursor) == "(" {
        let value_start = skip_trivia(source, token_end(source, cursor))
        let value_end = expression_end(source, value_start)
        if value_end < 0 {
            return -1
        }
        let close = skip_trivia(source, value_end)
        if close >= len(source) || token_text(source, close) != ")" {
            return -1
        }
        return field_postfix_end(source, token_end(source, close))
    }
    return -1
}

fn unary_end(source: Text, start: Int) -> Int {
    let cursor = skip_trivia(source, start)
    let token = token_text(source, cursor)
    if token == "+" || token == "-" {
        return unary_end(source, skip_trivia(source, token_end(source, cursor)))
    }
    return primary_end(source, cursor)
}

fn product_end(source: Text, start: Int) -> Int {
    let mut cursor = unary_end(source, start)
    if cursor < 0 {
        return -1
    }
    let mut operator_start = skip_trivia(source, cursor)
    while operator_start < len(source) &&
          (token_text(source, operator_start) == "*" ||
           token_text(source, operator_start) == "/" ||
           token_text(source, operator_start) == "//" ||
           token_text(source, operator_start) == "%") {
        let right_start = skip_trivia(
            source,
            token_end(source, operator_start)
        )
        cursor = unary_end(source, right_start)
        if cursor < 0 {
            return -1
        }
        operator_start = skip_trivia(source, cursor)
    }
    return cursor
}

fn arithmetic_expression_end(source: Text, start: Int) -> Int {
    let mut cursor = product_end(source, start)
    if cursor < 0 {
        return -1
    }
    let mut operator_start = skip_trivia(source, cursor)
    while operator_start < len(source) &&
          (token_text(source, operator_start) == "+" ||
           token_text(source, operator_start) == "-") {
        let right_start = skip_trivia(
            source,
            token_end(source, operator_start)
        )
        cursor = product_end(source, right_start)
        if cursor < 0 {
            return -1
        }
        operator_start = skip_trivia(source, cursor)
    }
    return cursor
}

# The one bounded coalescing operator has lower precedence than arithmetic.
# Returning the operator byte separately keeps typing and lowering keyed to the
# same source site, which is also the deterministic identity of its C local.
fn optional_int_coalescing_operator(
    source: Text,
    start: Int,
    end: Int
) -> Int {
    let left_end = arithmetic_expression_end(source, start)
    if left_end < 0 {
        return -1
    }
    let operator_start = skip_trivia(source, left_end)
    if operator_start < end && token_text(source, operator_start) == "??" {
        return operator_start
    }
    return -1
}

# Everything `|>` binds looser than. Split out of `expression_end` so the
# pipeline sits strictly outside the coalescing operator: `a ?? b |> f(c)` is
# `(a ?? b) |> f(c)`, and a `??` written inside the subject or inside an
# argument still binds first.
fn coalescing_expression_end(source: Text, start: Int) -> Int {
    let left_end = arithmetic_expression_end(source, start)
    if left_end < 0 {
        return -1
    }
    let operator_start = skip_trivia(source, left_end)
    if operator_start >= len(source) ||
       token_text(source, operator_start) != "??" {
        return left_end
    }
    let right_start = skip_trivia(
        source,
        token_end(source, operator_start)
    )
    return arithmetic_expression_end(source, right_start)
}

# The end of the call on the right of `|>`, or -1 when what follows is not a
# direct parenthesised call.
#
# This is the whole of the production #1190 recognizes: one stage, a bare
# top-level callee, one parenthesised argument list. A member, indirect, or
# lexical target is deliberately not measured here — those are named refusals,
# and measuring them would be the first step toward accepting them.
fn pipeline_call_end(source: Text, pipe: Int) -> Int {
    let callee = skip_trivia(source, token_end(source, pipe))
    if callee >= len(source) {
        return -1
    }
    # `token_kind` already reports a keyword as "keyword", so requiring
    # "identifier" excludes `fn`, `let` and the rest without a second test.
    if token_kind(source, callee) != "identifier" {
        return -1
    }
    let open = skip_trivia(source, token_end(source, callee))
    if open >= len(source) || token_text(source, open) != "(" {
        return -1
    }
    return balanced_end(source, open, "(", ")")
}

# `|>` is the lowest-precedence boundary in the expression grammar, so the
# whole pipeline is one expression rather than two unrelated ones separated by
# an operator.
#
# When the right side is not the recognized production the span deliberately
# stops at the subject, exactly as it did before this production existed. That
# keeps every shape outside the slice — bare callee, member or indirect target,
# chain, trailing lambda — parsing as it always did, so
# `validate_pipeline_shapes` can name each one instead of a truncated span
# turning it into a parse failure that blames a later token.
fn expression_end(source: Text, start: Int) -> Int {
    let subject_end = coalescing_expression_end(source, start)
    if subject_end < 0 {
        return -1
    }
    let pipe = skip_trivia(source, subject_end)
    if pipe >= len(source) || token_text(source, pipe) != "|>" {
        return subject_end
    }
    let call_end = pipeline_call_end(source, pipe)
    if call_end < 0 {
        return subject_end
    }
    return call_end
}

# Strip only parentheses that enclose the complete left expression. A caller
# asks for either the inner start or inner end; keeping both calculations in
# one helper makes `(binding)`, `(call())`, and `(null)` transparent without
# accepting arithmetic or another Optional shape as a coalescing left.
fn optional_int_coalescing_transparent_bound(
    source: Text,
    start: Int,
    end: Int,
    want_start: Bool
) -> Int {
    let mut cursor = skip_trivia(source, start)
    let mut bound = end
    let mut scanning = true
    while scanning && cursor < bound && token_text(source, cursor) == "(" {
        let inner_start = skip_trivia(source, token_end(source, cursor))
        let inner_end = expression_end(source, inner_start)
        let mut close = -1
        if inner_end >= 0 {
            close = skip_trivia(source, inner_end)
        }
        if inner_end < 0 || close >= bound ||
           token_text(source, close) != ")" ||
           skip_trivia(source, token_end(source, close)) < bound {
            scanning = false
        } else {
            cursor = inner_start
            bound = inner_end
        }
    }
    if want_start {
        return cursor
    }
    return bound
}

# The lifted name of an arrow lambda written directly in argument position.
#
# A `let`-bound lambda is keyed by its binding id, which an anonymous argument
# does not have. Its keying token's byte offset is the identity that is already
# unique and already stable across the two walks that must agree — the one that
# emits the definition and the one that emits the reference.
fn argument_lambda_name(open: Int) -> Text {
    return "kofun_lambda_at" + to_text(open)
}

# Lower one value of the bounded concrete-enum representation. Every enum in
# this internal C11 slice uses a declaration-order tag and one Int payload
# slot; static types keep distinct enum declarations from crossing boundaries.
fn emit_enum_value(
    source: Text,
    hir: Text,
    start: Int,
    end: Int,
    enum_type: Text
) -> Text {
    let cursor = skip_trivia(source, start)
    if cursor >= len(source) || token_kind(source, cursor) != "identifier" {
        return "error[E2S32]: concrete enum value must be a constructor, binding, or call at byte " +
        to_text(cursor)
    }
    let name = token_text(source, cursor)
    let open = skip_trivia(source, token_end(source, cursor))
    # Same whole-value rule as `emit_record_value`: a bare binding may not be
    # a prefix of a larger expression.
    if open < end && token_text(source, open) != "(" {
        return "error[E2S32]: concrete enum value must be a whole binding, constructor, or call at byte " +
        to_text(cursor)
    }
    if open >= end {
        let binding_id = hir_use_binding_id(hir, cursor)
        if len(binding_id) == 0 ||
           hir_binding_field(hir, binding_id, 5) != enum_type {
            return "error[E2S32]: concrete enum binding has the wrong type at byte " +
            to_text(cursor)
        }
        return "k_b" + binding_id
    }

    let constructor_owner = enum_constructor_owner(source, name)
    if len(constructor_owner) > 0 {
        if constructor_owner != enum_type {
            return "error[E2S32]: constructor belongs to a different concrete enum at byte " +
            to_text(cursor)
        }
        let tag = enum_constructor_index(source, enum_type, name)
        let arity = enum_constructor_payload_arity(
            source,
            enum_type,
            name
        )
        if arity < 0 {
            return "error[E2S32]: constructor payload is outside the one-Int slice at byte " +
            to_text(cursor)
        }
        let payload_start = skip_trivia(
            source,
            token_end(source, open)
        )
        let empty =
            payload_start < len(source) &&
            token_text(source, payload_start) == ")"
        if (arity == 0) != empty {
            if arity == 1 {
                return "error[E2S32]: constructor takes one Int payload at byte " +
                to_text(cursor)
            }
            return "error[E2S32]: constructor takes no payload at byte " +
            to_text(cursor)
        }
        let mut payload = "INT64_C(0)"
        if arity == 1 {
            let payload_end = expression_end(source, payload_start)
            let mut close = -1
            if payload_end >= 0 {
                close = skip_trivia(source, payload_end)
            }
            if payload_end < 0 || close >= len(source) ||
               token_text(source, close) != ")" {
                return "error[E2S32]: concrete enum payload must be one Int expression at byte " +
                to_text(payload_start)
            }
            payload = emit_expression(
                source,
                hir,
                payload_start,
                payload_end
            )
        }
        return "((KofunEnumValue){INT64_C(" + to_text(tag) + "), " +
        payload + "})"
    }
    if function_return_type(source, name) == enum_type {
        return emit_primary(source, hir, cursor, end)
    }
    return "error[E2S32]: call does not return the expected concrete enum at byte " +
    to_text(cursor)
}

# The const argument of a type identity, or "" when it has none.
fn const_argument_of(identity: Text) -> Text {
    let open = find(identity, "[")
    if open < 0 {
        return ""
    }
    return text_slice(identity, open + 1, len(identity) - 1)
}

# The single funnel from a type identity to a C struct name, and the place
# per-literal monomorphization actually happens: one emitted struct per
# distinct literal, so `Fixed[2]` and `Fixed[3]` are two C types.
#
# An earlier revision dropped the argument here and justified it in a comment —
# a const parameter contributes no storage, so one struct was said to be safe.
# That was a true statement about miscompiles standing in for an untrue one
# about the backend's capability: it made the C type system stop separating
# what the Kofun type system had already separated, while
# `tests/conformance/capabilities.tsv` claimed the backend did not support the
# construct at all. `validate_struct_identity` now refuses that collapse
# instead of a comment asserting it is fine.
fn record_c_type_name(record_type: Text) -> Text {
    let argument = const_argument_of(record_type)
    if len(argument) == 0 {
        return "KofunRecord_" + record_type
    }
    return "KofunRecord_" + const_type_base(record_type) + "__" + argument
}

# The `index`-th distinct instantiation of `wanted`, in first-use order, or
# "". This is the monomorphization set the emitter walks.
fn const_instantiation_at(
    source: Text,
    wanted: Text,
    wanted_index: Int
) -> Text {
    let mut seen = "|"
    let mut count = 0
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        if token_kind(source, cursor) == "identifier" &&
           token_text(source, cursor) == wanted &&
           !const_generic_declaration_head(source, cursor) {
            let identity = annotation_type_text(source, cursor)
            if identity != wanted && !contains(seen, "|" + identity + "|") {
                if count == wanted_index {
                    return identity
                }
                seen = seen + identity + "|"
                count = count + 1
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return ""
}

fn const_instantiation_count(source: Text, wanted: Text) -> Int {
    let mut count = 0
    while len(const_instantiation_at(source, wanted, count)) > 0 {
        count = count + 1
    }
    return count
}

fn record_c_field_name(field: Text) -> Text {
    return "f_" + field
}

fn record_field_type_named(
    source: Text,
    record_type: Text,
    field: Text
) -> Text {
    let index = record_field_index(source, record_type, field)
    if index < 0 {
        return ""
    }
    return record_field_text(source, record_type, index, true)
}

fn emit_record_value(
    source: Text,
    hir: Text,
    start: Int,
    end: Int,
    record_type: Text
) -> Text {
    let cursor = skip_trivia(source, start)
    if token_kind(source, cursor) != "identifier" {
        return "error[E2S32]: nominal record value must be a binding or function call at byte " +
        to_text(cursor)
    }
    let name = token_text(source, cursor)
    let open = skip_trivia(source, token_end(source, cursor))
    # A bare binding has to be the *whole* value. Accepting a prefix silently
    # dropped the rest: `takes_record(value.field)` lowered to `value`, so an
    # `Int` field read compiled and ran as the record it was read from, with
    # no diagnostic anywhere. Anything left unconsumed that is not a call is
    # not a record value in this slice.
    if open < end && token_text(source, open) != "(" {
        return "error[E2S32]: nominal record value must be a whole binding or function call at byte " +
        to_text(cursor)
    }
    if open >= end {
        let binding_id = hir_use_binding_id(hir, cursor)
        if len(binding_id) == 0 ||
           hir_binding_field(hir, binding_id, 5) != record_type {
            # Two instantiations of one const generic declaration are not a
            # generic record mismatch, they are a mismatch *in the const
            # argument*, so they say which scales disagreed.
            let actual = hir_binding_field(hir, binding_id, 5)
            if len(binding_id) > 0 &&
               const_type_base(actual) == const_type_base(record_type) {
                return "error[E2S151]: `" + actual + "` is not `" +
                record_type +
                "`; instantiations differing only in their const argument are different types at byte " +
                to_text(cursor)
            }
            return "error[E2S32]: nominal record binding has the wrong type at byte " +
            to_text(cursor)
        }
        return "k_b" + binding_id
    }
    if record_declaration_start(source, name) >= 0 {
        return "error[E2S32]: bind record construction before passing or returning it at byte " +
        to_text(cursor)
    }
    if function_return_type(source, name) == record_type {
        return emit_primary(source, hir, cursor, end)
    }
    return "error[E2S32]: call does not return the expected nominal record at byte " +
    to_text(cursor)
}

# One argument's C expression.
#
# The three function-value forms are lowered here rather than in
# `emit_primary`, because only argument position accepts them and only this
# caller knows it is in argument position. Everything else lowers through the
# ordinary expression emitter unchanged.
fn emit_argument(
    source: Text,
    hir: Text,
    start: Int,
    end: Int,
    callee: Text,
    argument_index: Int
) -> Text {
    let cursor = skip_trivia(source, start)
    let expected_type = function_parameter_type(
        source,
        callee,
        argument_index
    )
    if expected_type == "Int?" {
        return optional_int_value(source, hir, cursor, end)
    }
    if enum_constructor_count(source, expected_type) >= 0 {
        return emit_enum_value(
            source,
            hir,
            cursor,
            end,
            expected_type
        )
    }
    if record_declaration_start(source, expected_type) >= 0 {
        return emit_record_value(
            source,
            hir,
            cursor,
            end,
            expected_type
        )
    }
    let actual_type = initializer_type(
        source,
        hir,
        enclosing_function_open(source, start),
        start
    )
    if actual_type == "List[Int]" && expected_type != "List[Int]" {
        return "error[E2S15]: Core function `" + callee + "` expects " +
        expected_type + " for argument " + to_text(argument_index + 1) +
        ", got List[Int] at byte " + to_text(start)
    }
    if expected_type == "List[Int]" {
        if actual_type != "List[Int]" {
            return "error[E2S15]: Core function `" + callee + "` expects " +
            "List[Int] for argument " + to_text(argument_index + 1) +
            ", got " + actual_type + " at byte " + to_text(start)
        }
        return emit_list_int_value(source, hir, start, end, false)
    }
    # An arrow lambda argument is the address of the function it was lifted to.
    if lambda_parameters_end(source, -1, cursor) >= 0 {
        return argument_lambda_name(cursor)
    }
    # `call_argument_position` scans from the start of the source, so it is
    # tested last in each arm: the cheap HIR lookup rejects the ordinary
    # identifier argument first, and the scan then runs only for the two rare
    # shapes that can actually be function values.
    if token_kind(source, cursor) == "identifier" {
        let value_binding = hir_use_binding_id(hir, cursor)
        if len(value_binding) > 0 {
            # A lambda binding used as a value is the address of its lifted
            # function: lifting never declares a C variable for the binding
            # itself, so `k_b<id>` would name nothing.
            if lambda_binding_open(source, hir, value_binding) >= 0 &&
               call_argument_position(source, cursor) {
                return "kofun_lambda_" + value_binding
            }
        } else {
            # A bare name the scope HIR left unresolved that is a declared Core
            # function is that function used as a value. Its lowered form is
            # already an ordinary C function, so its address is the callable.
            let name = token_text(source, cursor)
            if len(enum_constructor_owner(source, name)) == 0 &&
               function_arity(source, name) >= 0 &&
               call_argument_position(source, cursor) {
                return "kofun_fn_" + name
            }
            # A module constant lowers to its own file-scope C constant.
            if constant_is_declared(source, name) {
                return constant_c_name(name)
            }
        }
    }
    return emit_expression(source, hir, start, end)
}

# Whether a fixed call slot can carry this type. One vocabulary serves the
# labelled (#1097/#1107) and direct List[Int] (#1103) slot paths, so a
# widened carrier cannot become executable in one and silently stay unknown
# in the other.
fn call_slot_carried(source: Text, carrier: Text) -> Bool {
    return carrier == "Int" || carrier == "Text" ||
    carrier == "List[Int]" || carrier == "Int?" ||
    enum_constructor_count(source, carrier) >= 0 ||
    record_declaration_start(source, carrier) >= 0
}

# Everything before the slot's name in its C declaration, so pointer spacing
# is decided here instead of at each emitter: a pointer carrier already ends
# in `*`, which is how the rest of the emitted surface spells
# `const char *name`.
fn call_slot_declaration_prefix(source: Text, carrier: Text) -> Text {
    if carrier == "Text" {
        return "const char *"
    }
    if carrier == "List[Int]" {
        return "KofunIntListValue "
    }
    if carrier == "Int?" {
        return "KofunOptionalInt "
    }
    if enum_constructor_count(source, carrier) >= 0 {
        return "KofunEnumValue "
    }
    if record_declaration_start(source, carrier) >= 0 {
        return record_c_type_name(carrier) + " "
    }
    return "int64_t "
}

# The declared zero for that carrier. A slot is assigned before the call in
# every path that declares it, so this only has to be a valid value of the
# type — never a null the emitted C could dereference.
fn call_slot_zero(source: Text, carrier: Text) -> Text {
    if carrier == "Text" {
        return "\"\""
    }
    if carrier == "List[Int]" {
        return "KOFUN_LIST_INT_ZERO"
    }
    if carrier == "Int?" {
        return "KOFUN_OPTIONAL_INT_NONE"
    }
    if enum_constructor_count(source, carrier) >= 0 {
        return "KOFUN_ENUM_ZERO"
    }
    if record_declaration_start(source, carrier) >= 0 {
        return "((" + record_c_type_name(carrier) + "){0})"
    }
    return "INT64_C(0)"
}

# One shape predicate owns both fixed-slot call paths. The `labelled` mode is
# load-bearing: #1113 consolidates their mechanism without changing either
# accepted boundary. Labelled calls use the full call-slot carrier vocabulary
# and require a carried result; direct calls remain Int/List[Int]-only,
# require a List, and deliberately keep their unrestricted result.
fn fixed_slot_call_shape(
    source: Text,
    hir: Text,
    call_start: Int,
    callee: Text,
    open: Int,
    labelled: Bool
) -> Bool {
    if call_has_labelled_argument(source, open) != labelled {
        return false
    }
    # A lexical callable may shadow a top-level declaration with the same
    # spelling. Only an unresolved callee name denotes the direct top-level
    # function this bounded ABI slice can lower.
    if len(hir_use_binding_id(hir, call_start)) > 0 {
        return false
    }
    let declaration = function_start_named(source, callee)
    if declaration < 0 {
        return false
    }
    let count = parameter_count(source, declaration)
    if count < 1 || count > 8 {
        return false
    }
    # A pipeline always needs fixed slots, whatever it carries. Its subject is
    # written outside the parentheses and must be assigned before any explicit
    # argument, which the ordinary unsequenced call cannot express — so it joins
    # the labelled mode in using the full carrier matrix and in not needing a
    # `List[Int]` to justify the slots.
    let piped = call_is_pipeline_target(source, call_start)
    if (labelled || piped) &&
       !call_slot_carried(source, function_return_type(source, callee)) {
        return false
    }
    let mut has_list = false
    let mut index = 0
    while index < count {
        let parameter_type = function_parameter_type(source, callee, index)
        let mut carried = parameter_type == "Int" ||
            parameter_type == "List[Int]"
        if labelled || piped {
            carried = call_slot_carried(source, parameter_type)
        }
        if parameter_type == "List[Int]" {
            has_list = true
        }
        if !carried {
            return false
        }
        index = index + 1
    }
    return labelled || piped || has_list
}

fn fixed_slot_call_supported(
    source: Text,
    hir: Text,
    call_start: Int,
    callee: Text,
    open: Int,
    labelled: Bool
) -> Bool {
    if !fixed_slot_call_shape(
        source,
        hir,
        call_start,
        callee,
        open,
        labelled
    ) {
        return false
    }
    # Lifted lambdas are emitted as separate C functions. Their call-site
    # temporaries therefore cannot live in the enclosing source function.
    let function_open = enclosing_function_open(source, call_start)
    return function_open < 0 ||
        lambda_scope_open(source, function_open, call_start) < 0
}

# Thin wrappers keep the existing diagnostic routing and make each mode's
# dispatch load-bearing in the pair harness. All policy stays above.
fn labelled_call_supported(
    source: Text,
    hir: Text,
    call_start: Int,
    callee: Text,
    open: Int
) -> Bool {
    return fixed_slot_call_supported(
        source,
        hir,
        call_start,
        callee,
        open,
        true
    )
}

fn direct_list_int_call_shape(
    source: Text,
    hir: Text,
    call_start: Int,
    callee: Text,
    open: Int
) -> Bool {
    return fixed_slot_call_shape(
        source,
        hir,
        call_start,
        callee,
        open,
        false
    )
}

fn direct_list_int_call_supported(
    source: Text,
    hir: Text,
    call_start: Int,
    callee: Text,
    open: Int
) -> Bool {
    return fixed_slot_call_supported(
        source,
        hir,
        call_start,
        callee,
        open,
        false
    )
}

# Map a source-order argument back to the declaration/ABI slot that #881
# validated. Positional arguments form a prefix, so their source index is
# already their slot; labelled arguments compare against external names.
fn labelled_argument_slot(
    source: Text,
    callee: Text,
    argument: Int,
    source_index: Int
) -> Int {
    let colon = skip_trivia(source, token_end(source, argument))
    if token_kind(source, argument) != "identifier" &&
       token_kind(source, argument) != "keyword" ||
       token_text(source, colon) != ":" {
        return source_index
    }
    let declaration = function_start_named(source, callee)
    let parameters = parameter_open(source, declaration)
    let close = balanced_end(source, parameters, "(", ")")
    let mut parameter = skip_trivia(
        source,
        token_end(source, parameters)
    )
    let mut slot = 0
    while parameter < close && token_text(source, parameter) != ")" {
        let external = parameter_external_start(
            source,
            parameter,
            close
        )
        if external >= 0 &&
           token_text(source, external) == token_text(source, argument) {
            return slot
        }
        let type_start = parameter_type_start(source, parameter, close)
        let mut type_end = callable_type_end(source, type_start)
        let optional_end = optional_int_type_end(source, type_start)
        let list_end = parameter_list_type_end(
            source,
            type_start,
            close
        )
        if type_end < 0 {
            if optional_end >= 0 {
                type_end = optional_end
            } else if list_end >= 0 {
                type_end = list_end
            } else {
                type_end = annotation_type_end(source, type_start)
            }
        }
        let separator = skip_trivia(source, type_end)
        if separator < close && token_text(source, separator) == "," {
            parameter = skip_trivia(source, token_end(source, separator))
        } else {
            parameter = separator
        }
        slot = slot + 1
    }
    return -1
}

fn labelled_argument_value(source: Text, argument: Int) -> Int {
    let colon = skip_trivia(source, token_end(source, argument))
    if (token_kind(source, argument) == "identifier" ||
        token_kind(source, argument) == "keyword") &&
       token_text(source, colon) == ":" {
        return skip_trivia(source, token_end(source, colon))
    }
    return argument
}

# C11 leaves ordinary function-argument evaluation order unspecified. A
# comma expression is sequenced, so assign source-order values first and only
# then invoke the declaration-order ABI vector. The direct loop bound is
# retained deliberately: arity diagnostics precede this emitter, and #1113
# does not change which malformed input reaches a lowering diagnostic.
fn emit_fixed_slot_call(
    source: Text,
    hir: Text,
    call_start: Int,
    open: Int,
    end: Int,
    callee: Text,
    labelled: Bool
) -> Text {
    let declaration = function_start_named(source, callee)
    let parameter_count_value = parameter_count(source, declaration)
    let mut emitted = "("
    let mut argument = skip_trivia(source, token_end(source, open))
    let mut source_index = 0
    # The subject is assigned before anything inside the parentheses, because
    # that is where it is written. Doing it here rather than in a pipeline-only
    # emitter is what keeps one temporary family and one ABI vector: after this
    # assignment the loop below is unchanged, and slot 0 is simply already
    # taken, so a positional rest continues at slot 1 exactly as #1226 bound it.
    let pipeline_subject = pipeline_subject_for_call(source, call_start)
    if pipeline_subject >= 0 && parameter_count_value > 0 {
        let subject_value = emit_argument(
            source,
            hir,
            pipeline_subject,
            coalescing_expression_end(source, pipeline_subject),
            callee,
            0
        )
        if starts_with(subject_value, "error[") {
            return subject_value
        }
        emitted = emitted + "(kofun_call_arg_" + to_text(call_start) +
            "_0 = " + subject_value + "), "
        source_index = 1
    }
    while (labelled || source_index < parameter_count_value) &&
          argument < end && token_text(source, argument) != ")" {
        let bound = argument_end(source, argument)
        let mut slot = source_index
        let mut value_start = argument
        if labelled {
            slot = labelled_argument_slot(
                source,
                callee,
                argument,
                source_index
            )
            value_start = labelled_argument_value(source, argument)
        }
        if labelled && (slot < 0 || slot >= parameter_count_value) {
            return lower_error(
                "E2S158",
                "labelled-call fixed-slot projection failed",
                argument
            )
        }
        let value = emit_argument(
            source,
            hir,
            value_start,
            bound,
            callee,
            slot
        )
        if starts_with(value, "error[") {
            return value
        }
        emitted = emitted + "(kofun_call_arg_" +
            to_text(call_start) + "_" + to_text(slot) + " = " + value +
            "), "
        source_index = source_index + 1
        let separator = skip_trivia(source, bound)
        if separator < end && token_text(source, separator) == "," {
            argument = skip_trivia(source, token_end(source, separator))
        } else {
            argument = separator
        }
    }
    emitted = emitted + "kofun_fn_" + callee + "("
    # The trailing lambda occupies the final slot as a lifted function's
    # address. It reserves no carrier: there is no evaluation to sequence ahead
    # of the ABI vector, and its C type is a function pointer rather than the
    # `int64_t` a carrier declares.
    let trailing_slot = trailing_lambda_slot(source, open, parameter_count_value)
    let mut slot = 0
    while slot < parameter_count_value {
        if slot > 0 {
            emitted = emitted + ", "
        }
        if slot == trailing_slot {
            emitted = emitted +
                argument_lambda_name(call_trailing_lambda_open(source, open))
        } else {
            emitted = emitted + "kofun_call_arg_" +
                to_text(call_start) + "_" + to_text(slot)
        }
        slot = slot + 1
    }
    return emitted + "))"
}

# Reserve the fixed carrier slots before any statement in the containing
# function. The call-start byte makes nested and repeated call sites distinct
# without carrying an external label into generated artifacts.
fn emit_fixed_slot_call_temporaries(
    source: Text,
    hir: Text,
    function_open: Int
) -> Text {
    let close = balanced_end(source, function_open, "{", "}")
    if close < 0 {
        return ""
    }
    let mut emitted = ""
    let mut cursor = skip_trivia(source, token_end(source, function_open))
    while cursor < close {
        if token_kind(source, cursor) == "identifier" {
            let open = skip_trivia(source, token_end(source, cursor))
            if open < close && token_text(source, open) == "(" {
                let callee = token_text(source, cursor)
                let labelled = call_has_labelled_argument(source, open)
                if fixed_slot_call_supported(
                    source,
                    hir,
                    cursor,
                    callee,
                    open,
                    labelled
                ) {
                    let declaration = function_start_named(source, callee)
                    let count = parameter_count(source, declaration)
                    # The trailing lambda's slot carries a function pointer
                    # placed directly in the ABI vector, so reserving an
                    # `int64_t` carrier for it would both mistype the slot and
                    # leave it unassigned at the call.
                    let trailing_slot = trailing_lambda_slot(source, open, count)
                    let mut slot = 0
                    while slot < count {
                        if slot != trailing_slot {
                            let carrier = function_parameter_type(
                                source,
                                callee,
                                slot
                            )
                            emitted = emitted + "    " +
                                call_slot_declaration_prefix(source, carrier) +
                                "kofun_call_arg_" + to_text(cursor) + "_" +
                                to_text(slot) +
                                " = " + call_slot_zero(source, carrier) + ";\n"
                        }
                        slot = slot + 1
                    }
                }
            }
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            break
        }
        cursor = skip_trivia(source, next)
    }
    return emitted
}

fn list_int_binding_literal_count(
    source: Text,
    hir: Text,
    use_start: Int
) -> Int {
    let binding_id = hir_use_binding_id(hir, use_start)
    if len(binding_id) == 0 {
        return -1
    }
    let declaration = hir_binding_declaration_start(hir, binding_id)
    if declaration < 0 {
        return -1
    }
    let mut cursor = skip_trivia(source, token_end(source, declaration))
    if cursor < len(source) && token_text(source, cursor) == ":" {
        let type_start = skip_trivia(source, token_end(source, cursor))
        let type_finish = list_int_type_end(source, type_start)
        if type_finish < 0 {
            return -1
        }
        cursor = skip_trivia(source, type_finish)
    }
    if cursor >= len(source) || token_text(source, cursor) != "=" {
        return -1
    }
    let literal = skip_trivia(source, token_end(source, cursor))
    return list_int_literal_count(source, literal)
}

# Return a decimal constant spelling, or empty text when the index is a
# runtime expression. Underscores are removed before range comparison.
fn list_int_constant_index(
    source: Text,
    start: Int,
    end: Int
) -> Text {
    let mut cursor = skip_trivia(source, start)
    let mut sign = ""
    if token_text(source, cursor) == "-" ||
       token_text(source, cursor) == "+" {
        if token_text(source, cursor) == "-" {
            sign = "-"
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    if token_kind(source, cursor) != "integer" ||
       token_end(source, cursor) != end {
        return ""
    }
    return sign + replace(
        text_slice(source, cursor, token_end(source, cursor)),
        "_",
        ""
    )
}

fn emit_list_int_literal(
    source: Text,
    hir: Text,
    open: Int
) -> Text {
    let count = list_int_literal_count(source, open)
    if count < 0 {
        return "error[E2S157]: malformed List[Int] literal at byte " +
        to_text(open)
    }
    if count > 64 {
        return "error[E2S157]: List[Int] literal capacity is 64 elements at byte " +
        to_text(open)
    }
    if count == 0 {
        return "((KofunIntList)(const void *)&(const struct { " +
        "uint64_t length; }){UINT64_C(0)})"
    }
    let mut emitted = "((KofunIntList)(const void *)&(const struct { " +
    "uint64_t length; int64_t elements[" + to_text(count) +
    "]; }){UINT64_C(" + to_text(count) + "), {"
    let mut element = skip_trivia(source, token_end(source, open))
    let mut index = 0
    while index < count {
        let bound = expression_end(source, element)
        let actual = initializer_type(
            source,
            hir,
            enclosing_function_open(source, element),
            element
        )
        if actual != "Int" {
            return "error[E2S157]: List[Int] element must have type Int, got " +
            actual + " at byte " + to_text(element)
        }
        let value = emit_expression(source, hir, element, bound)
        if starts_with(value, "error[") {
            return value
        }
        if index > 0 {
            emitted = emitted + ", "
        }
        emitted = emitted + value
        index = index + 1
        let separator = skip_trivia(source, bound)
        element = skip_trivia(source, token_end(source, separator))
    }
    return emitted + "}})"
}

# A whole List[Int] value crosses function boundaries in one fixed-capacity
# by-value carrier. Literals remain the compact AggregateLayout view emitted
# above and are copied into the carrier at a local binding; direct literal
# arguments and returns stay outside this bounded slice.
fn emit_list_int_value(
    source: Text,
    hir: Text,
    start: Int,
    end: Int,
    allow_literal: Bool
) -> Text {
    let cursor = skip_trivia(source, start)
    let function_open = enclosing_function_open(source, cursor)
    if function_open >= 0 &&
       lambda_scope_open(source, function_open, cursor) >= 0 {
        return "error[E2S157]: List[Int] values inside lambdas are outside this lowering slice at byte " +
        to_text(cursor)
    }
    if token_text(source, cursor) == "[" {
        if !allow_literal {
            return "error[E2S157]: bind a List[Int] literal before passing or returning it at byte " +
            to_text(cursor)
        }
        let literal = emit_list_int_literal(source, hir, cursor)
        if starts_with(literal, "error[") {
            return literal
        }
        return "kofun_list_int_value(" + literal + ")"
    }
    if token_kind(source, cursor) != "identifier" {
        return "error[E2S157]: List[Int] value must be a whole binding or same-typed direct call at byte " +
        to_text(cursor)
    }
    let after = skip_trivia(source, token_end(source, cursor))
    # A record field declared `List[Int]` is the third admissible form
    # (#1197). #1183 admitted the field's declaration and construction and
    # stopped there, so reading one back was refused by the two-form rule
    # below even though the field's own carrier is already exactly the
    # `List[Int]` carrier this slice passes.
    #
    # The read names the field's storage, and C copies a struct on
    # assignment and on an argument, so what the caller receives is a copy
    # of the 520-byte carrier rather than a view into the record. Mutating
    # the source binding afterwards cannot change what was read.
    #
    # Exactly one `.` is consumed and the field must end the value. A nested
    # path leaves a token before `end` and falls through to the refusal, so
    # `a.b.samples` is still outside this slice rather than silently reading
    # its prefix.
    if after < end && token_text(source, after) == "." {
        let field_cursor = skip_trivia(source, token_end(source, after))
        let field_binding = hir_use_binding_id(hir, cursor)
        if len(field_binding) > 0 &&
           skip_trivia(source, token_end(source, field_cursor)) >= end &&
           record_field_type_named(
               source,
               hir_binding_field(hir, field_binding, 5),
               token_text(source, field_cursor)
           ) == "List[Int]" {
            return "k_b" + field_binding + "." +
            record_c_field_name(token_text(source, field_cursor))
        }
    }
    if after >= end || token_text(source, after) != "(" {
        let binding_id = hir_use_binding_id(hir, cursor)
        if len(binding_id) == 0 ||
           hir_binding_field(hir, binding_id, 5) != "List[Int]" ||
           after < end {
            return "error[E2S157]: List[Int] value must be a whole binding or same-typed direct call at byte " +
            to_text(cursor)
        }
        return "k_b" + binding_id
    }
    let name = token_text(source, cursor)
    if function_return_type(source, name) != "List[Int]" ||
       call_has_labelled_argument(source, after) ||
       len(hir_use_binding_id(hir, cursor)) > 0 {
        return "error[E2S157]: List[Int] value must be a whole binding or same-typed direct call at byte " +
        to_text(cursor)
    }
    return emit_primary(source, hir, cursor, end)
}

# Validate one List[Int] subscript once for both reads and writes, then return
# the emitted Int index. The caller owns the operation-specific C wrapper.
# The index half of a subscript, shared by both subjects that can carry one
# (#1197). Only the subject check differs between them — a bound local carries
# its type in HIR, a record field carries it in the record declaration — so
# the caller does that and this does the rest. `literal_count` is the
# subject's known literal length for the constant-bounds check, or -1 when
# there is none to check against, which is the case for a field read.
fn emit_list_int_subscript(
    source: Text,
    hir: Text,
    open: Int,
    literal_count: Int
) -> Text {
    let index_start = skip_trivia(source, token_end(source, open))
    let index_end = expression_end(source, index_start)
    let mut close = -1
    if index_end >= 0 {
        close = skip_trivia(source, index_end)
    }
    if index_end < 0 || close >= len(source) ||
       token_text(source, close) != "]" {
        return "error[E2S157]: malformed List[Int] index at byte " +
        to_text(open)
    }
    # Bounded at the `]` (#1158). Unbounded, the classification runs past the
    # subscript and swallows whatever follows it, so `values[i] == target`
    # typed the whole `i] == target` span and reported the index as Bool. This
    # is the defect `initializer_type_bounded` already exists for.
    let index_type = initializer_type_bounded(
        source,
        hir,
        enclosing_function_open(source, index_start),
        index_start,
        index_end
    )
    if index_type != "Int" {
        return "error[E2S157]: List[Int] index must have type Int, got " +
        index_type + " at byte " + to_text(index_start)
    }
    let constant = list_int_constant_index(source, index_start, index_end)
    if len(constant) > 0 && literal_count >= 0 {
        let numeric = decimal_value(constant)
        if numeric < 0 - literal_count || numeric >= literal_count {
            return "error[E2S157]: List[Int] index " + constant +
            " is out of range for length " + to_text(literal_count) +
            " at byte " + to_text(index_start)
        }
    }
    return emit_expression(source, hir, index_start, index_end)
}

fn emit_list_int_index_value(
    source: Text,
    hir: Text,
    binding_start: Int,
    open: Int
) -> Text {
    let binding_id = hir_use_binding_id(hir, binding_start)
    let binding_type = hir_binding_field(hir, binding_id, 5)
    if binding_type != "List[Int]" {
        return "error[E2S157]: indexing requires List[Int], got " +
        binding_type + " at byte " + to_text(binding_start)
    }
    return emit_list_int_subscript(
        source,
        hir,
        open,
        list_int_binding_literal_count(source, hir, binding_start)
    )
}

fn list_int_index_close(source: Text, open: Int) -> Int {
    let index_start = skip_trivia(source, token_end(source, open))
    let index_end = expression_end(source, index_start)
    if index_end < 0 {
        return -1
    }
    let close = skip_trivia(source, index_end)
    if close >= len(source) || token_text(source, close) != "]" {
        return -1
    }
    return close
}

# Where a bit-operation chain begins inside one primary's span, or -1.
#
# The search is at bracket depth zero, so the receiver is everything the chain
# is applied to and nothing else: in `a.and(b.or(c))` the answer is the dot
# before `and`, and the inner chain is found again when its own argument is
# lowered. A field read on the way — `state.h0.xor(mask)` — is stepped over
# rather than claimed, because `h0` is not in the table.
fn int_bit_chain_dot(source: Text, start: Int, end: Int) -> Int {
    let mut cursor = skip_trivia(source, start)
    let mut depth = 0
    while cursor < end {
        let token = token_text(source, cursor)
        if token == "(" || token == "[" {
            depth = depth + 1
        } else if token == ")" || token == "]" {
            depth = depth - 1
        } else if depth == 0 && token == "." {
            let name = skip_trivia(source, token_end(source, cursor))
            if name < end && int_bit_method_arity_at(source, name) >= 0 {
                let open = skip_trivia(source, token_end(source, name))
                if open < end && token_text(source, open) == "(" {
                    return cursor
                }
            }
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            return -1
        }
        cursor = skip_trivia(source, next)
    }
    return -1
}

# Whether `target` belongs to a primary that contains a depth-zero Int bit
# call. Enum validation normally owns every enum use before lowering, but a
# bit call has the more specific A01 rule: its receiver and every argument
# must be `Int`, with E2S168 and the bit-call precedence. Deferring only this
# bounded primary lets that rule diagnose enum receivers/arguments without
# weakening the match-only rule anywhere else (including nested calls that
# merely contain a bit expression).
fn int_bit_expression_contains(source: Text, target: Int) -> Bool {
    let mut cursor = skip_trivia(source, 0)
    while cursor <= target && cursor < len(source) {
        let end = primary_end(source, cursor)
        if end > target && int_bit_chain_dot(source, cursor, end) >= 0 {
            return true
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            return false
        }
        cursor = skip_trivia(source, next)
    }
    return false
}

# RFC-0013's eight operations, applied left to right to one receiver.
#
# Each becomes one call on a checked helper emitted by this Stage 2 C11
# backend rather than a bare C operator. These are not a cross-backend runtime
# authority: C leaves a shift by 64 undefined and leaves a signed right shift
# implementation-defined, so this backend must spell the language's answers
# explicitly instead of inheriting its host compiler's answers.
fn emit_int_bit_chain(
    source: Text,
    hir: Text,
    start: Int,
    first_dot: Int,
    end: Int
) -> Text {
    let function_open = enclosing_function_open(source, start)
    let receiver_type = initializer_type_bounded(
        source,
        hir,
        function_open,
        start,
        first_dot
    )
    if receiver_type != "Int" {
        return lower_error(
            "E2S168",
            "bit operations are defined on `Int`, and this receiver is `" +
            receiver_type + "`",
            first_dot
        )
    }
    let mut emitted = emit_primary(source, hir, start, first_dot)
    if starts_with(emitted, "error[") {
        return emitted
    }
    let mut cursor = first_dot
    while cursor < end {
        let dot = skip_trivia(source, cursor)
        if dot >= end || token_text(source, dot) != "." {
            return emitted
        }
        let name_at = skip_trivia(source, token_end(source, dot))
        let name = token_text(source, name_at)
        let arity = int_bit_method_arity(name)
        if arity < 0 {
            return lower_error(
                "E2S168",
                "unknown `Int` member `" + name + "`",
                name_at
            )
        }
        let open = skip_trivia(source, token_end(source, name_at))
        if open >= end || token_text(source, open) != "(" {
            return emitted
        }
        let close = balanced_end(source, open, "(", ")")
        if close < 0 {
            return lower_error(
                "E2S169",
                "`" + name + "` is missing its closing parenthesis",
                open
            )
        }
        let mut argument = skip_trivia(source, token_end(source, open))
        let mut arguments = 0
        let mut rendered = ""
        while argument < close && token_text(source, argument) != ")" {
            let bound = argument_end(source, argument)
            if bound < 0 {
                return lower_error(
                    "E2S169",
                    "`" + name +
                    "` was given an argument this slice cannot read",
                    argument
                )
            }
            # A01 binds and checks each ordinary argument left to right: its
            # label first, then that argument's type.
            let label = skip_trivia(source, argument)
            let mut colon = -1
            if parameter_word_token(source, label) {
                colon = skip_trivia(source, token_end(source, label))
            }
            if colon >= 0 && colon < close &&
               token_text(source, colon) == ":" {
                return lower_error(
                    "E2S169",
                    "`" + name + "` takes positional arguments; the bit " +
                    "operations have no parameter names",
                    label
                )
            }
            let argument_type = initializer_type_bounded(
                source,
                hir,
                function_open,
                argument,
                bound
            )
            if argument_type != "Int" {
                return lower_error(
                    "E2S168",
                    "`" + name + "` takes `Int` arguments",
                    argument
                )
            }
            let value = emit_expression(source, hir, argument, bound)
            if starts_with(value, "error[") {
                return value
            }
            rendered = rendered + ", " + value
            arguments = arguments + 1
            let separator = skip_trivia(source, bound)
            if separator < close && token_text(source, separator) == "," {
                argument = skip_trivia(source, token_end(source, separator))
            } else {
                argument = separator
            }
        }
        # ABI consumers key an expression lambda on its parameter `(`. This
        # diagnostic instead names the preceding `fn`, as A01 requires.
        let trailing_parameters = trailing_lambda_open(source, close)
        if trailing_parameters >= 0 {
            let trailing = skip_trivia(source, close)
            return lower_error(
                "E2S169",
                "`" + name + "` takes no trailing lambda; the bit " +
                "operations have no functional parameter",
                trailing
            )
        }
        if arguments != arity {
            return lower_error(
                "E2S169",
                "`" + name + "` expects " + to_text(arity) +
                " arguments, got " + to_text(arguments),
                name_at
            )
        }
        emitted = "kofun_bit_" + name + "(" + emitted + rendered + ")"
        cursor = close
    }
    return emitted
}

fn emit_primary(source: Text, hir: Text, start: Int, end: Int) -> Text {
    let cursor = skip_trivia(source, start)
    # A bit-operation chain owns the whole span, so it is dispatched before any
    # receiver form is examined: the receiver may be a literal, a binding, a
    # record field, a call result, or a parenthesised expression, and none of
    # them has to know that a chain can follow it.
    let bit_dot = int_bit_chain_dot(source, cursor, end)
    if bit_dot >= 0 {
        return emit_int_bit_chain(source, hir, cursor, bit_dot, end)
    }
    let kind = token_kind(source, cursor)
    if token_text(source, cursor) == "[" {
        return emit_list_int_literal(source, hir, cursor)
    }
    if kind == "decimal" {
        let literal = text_slice(source, cursor, token_end(source, cursor))
        return "kofun_decimal_value_literal(\"" + literal + "\", " +
        to_text(len(literal)) + ")"
    }
    if kind == "float" {
        let literal = text_slice(
            source,
            cursor,
            token_end(source, cursor) - 3
        )
        return "kofun_float_value_literal(\"" + literal + "\", " +
        to_text(len(literal)) + ")"
    }
    if kind == "integer" {
        return "INT64_C(" +
        replace(text_slice(source, cursor, end), "_", "") + ")"
    }
    if kind == "string" {
        return text_literal_c_form(source, cursor)
    }
    if kind == "identifier" {
        let numeric_member = numeric_conversion_at(source, cursor)
        if len(numeric_member) > 0 {
            let dot = skip_trivia(source, token_end(source, cursor))
            let member = skip_trivia(source, token_end(source, dot))
            let open = skip_trivia(source, token_end(source, member))
            let first = numeric_member_argument(source, open, 0)
            let first_end = argument_end(source, first)
            if numeric_member == "Decimal.from_int" {
                return "kofun_decimal_value_from_int(" + emit_expression(
                    source, hir, first, first_end) + ")"
            }
            if numeric_member == "Decimal.round" {
                let scale = numeric_member_argument(source, open, 1)
                let mode = numeric_member_argument(source, open, 2)
                return "kofun_decimal_value_round(" + emit_expression(
                    source, hir, first, first_end) + ", " + emit_expression(
                    source, hir, scale, argument_end(source, scale)) + ", " +
                    decimal_rounding_c_name(token_text(source, mode)) + ")"
            }
            if numeric_member == "Decimal.divide" {
                let right = numeric_member_argument(source, open, 1)
                let scale = numeric_member_argument(source, open, 2)
                let mode = numeric_member_argument(source, open, 3)
                return "kofun_decimal_value_divide_rounded(" +
                emit_expression(source, hir, first, first_end) + ", " +
                emit_expression(
                    source, hir, right, argument_end(source, right)) + ", " +
                emit_expression(
                    source, hir, scale, argument_end(source, scale)) + ", " +
                decimal_rounding_c_name(token_text(source, mode)) + ")"
            }
            if numeric_member == "Decimal.format" {
                let scale = numeric_member_argument(source, open, 1)
                return "kofun_decimal_value_format(" + emit_expression(
                    source, hir, first, first_end) + ", " + emit_expression(
                    source, hir, scale, argument_end(source, scale)) + ")"
            }
            if numeric_member == "Decimal.parse" {
                let text = emit_expression(source, hir, first, first_end)
                return "kofun_decimal_value_parse(" + text +
                ", strlen(" + text + "))"
            }
        }
        let name = token_text(source, cursor)
        let open = skip_trivia(source, token_end(source, cursor))
        if open < end && token_text(source, open) == "(" && name == "len" {
            let value = skip_trivia(source, token_end(source, open))
            let value_end = argument_end(source, value)
            if initializer_type(
                source,
                hir,
                enclosing_function_open(source, value),
                value
            ) == "List[Int]" {
                if token_text(source, value) == "[" {
                    return "((int64_t)kofun_list_int_length(" +
                    emit_list_int_literal(source, hir, value) + "))"
                }
                let list_value = emit_list_int_value(
                    source,
                    hir,
                    value,
                    value_end,
                    false
                )
                if starts_with(list_value, "error[") {
                    return list_value
                }
                return "((int64_t)kofun_list_int_value_length(" +
                list_value + "))"
            }
            # `len`, `to_text` and `text_slice` each appended their argument
            # without inspecting it, so a refused argument became C source: the
            # diagnostic was emitted inside the call, the compiler still exited
            # 0, and only `cc` reported the failure. That is the same defect
            # the general call path below already names; these three direct
            # branches never had the check. Reached first by RFC-0013, whose
            # refusals are the first ones an argument of `to_text` can raise.
            let measured = emit_expression(source, hir, value, value_end)
            if starts_with(measured, "error[") {
                return measured
            }
            return "((int64_t)strlen(" + measured + "))"
        }
        # `to_text(Int)` lowers beside `len`, the other one-argument builtin
        # the ordinary Core path emits directly.
        if open < end && token_text(source, open) == "(" &&
           name == "to_text" {
            let value = skip_trivia(source, token_end(source, open))
            let rendered = emit_expression(
                source, hir, value, argument_end(source, value))
            if starts_with(rendered, "error[") {
                return rendered
            }
            return "kofun_to_text(" + rendered + ")"
        }
        if open < end && token_text(source, open) == "(" &&
           name == "text_slice" {
            let value = skip_trivia(source, token_end(source, open))
            let value_end = argument_end(source, value)
            let first_separator = skip_trivia(source, value_end)
            let first = skip_trivia(
                source,
                token_end(source, first_separator)
            )
            let first_end = argument_end(source, first)
            let second_separator = skip_trivia(source, first_end)
            let second = skip_trivia(
                source,
                token_end(source, second_separator)
            )
            let subject = emit_expression(source, hir, value, value_end)
            if starts_with(subject, "error[") {
                return subject
            }
            let from = emit_expression(source, hir, first, first_end)
            if starts_with(from, "error[") {
                return from
            }
            let to = emit_expression(
                source, hir, second, argument_end(source, second))
            if starts_with(to, "error[") {
                return to
            }
            return "kofun_text_slice(" + subject + ", " + from + ", " + to +
            ")"
        }
        if open >= end || token_text(source, open) != "(" {
            let binding_id = hir_use_binding_id(hir, cursor)
            if open < end && token_text(source, open) == "[" {
                let index_value = emit_list_int_index_value(
                    source, hir, cursor, open
                )
                if starts_with(index_value, "error[") {
                    return index_value
                }
                return "kofun_list_int_index(kofun_list_int_view(&k_b" +
                binding_id + ")" +
                ", " + index_value + ")"
            }
            if open < end && token_text(source, open) == "." {
                let field_cursor = skip_trivia(
                    source,
                    token_end(source, open)
                )
                let binding_type = hir_binding_field(
                    hir,
                    binding_id,
                    5
                )
                let field = token_text(source, field_cursor)
                if len(binding_id) == 0 ||
                   len(record_field_type_named(
                       source,
                       binding_type,
                       field
                   )) == 0 {
                    # Scoped parallelism v1 (#1160). `scope.spawn(...)` and
                    # `handle.join()` are RFC-0003 postfix forms, and reaching
                    # here means the member is not a record field, so the
                    # generic answer was `E2S32: unknown nominal record field
                    # read` — sending the reader to a record they never wrote.
                    # The construct stays refused; it is now refused as itself.
                    #
                    # Only `spawn` and `join` are named, and only when called:
                    # neither is a reserved word, so `type P = { spawn: Int }`
                    # is legal and `p.spawn` on such a record must still read
                    # the field. That case never reaches this branch, because
                    # the field lookup above succeeds.
                    let member_call = skip_trivia(
                        source,
                        token_end(source, field_cursor)
                    )
                    if (field == "spawn" || field == "join") &&
                       member_call < len(source) &&
                       token_text(source, member_call) == "(" {
                        return "error[E2S154]: scoped parallelism `" + field +
                        "` is specified but not implemented at byte " +
                        to_text(field_cursor)
                    }
                    # RFC-0013/A01. A member call on an `Int` receiver is a
                    # member of `Int`, and the eight are the whole set. Falling
                    # through to the record rule below sent the reader to a
                    # record they never wrote, exactly as the scoped-parallelism
                    # case above says.
                    if member_call < len(source) &&
                       token_text(source, member_call) == "(" &&
                       numeric_primary_type(
                           source,
                           hir,
                           enclosing_function_open(source, cursor),
                           cursor
                       ) == "Int" {
                        return "error[E2S168]: unknown `Int` member `" + field +
                        "` at byte " + to_text(field_cursor)
                    }
                    return "error[E2S32]: unknown nominal record field read at byte " +
                    to_text(field_cursor)
                }
                # A `List[Int]` field read may carry one subscript, so it
                # indexes exactly as a bound local does (#1197). The view is
                # taken of the field's own storage, so the bounds check reads
                # the length stored in that carrier rather than the record's.
                let field_index_open = skip_trivia(
                    source,
                    token_end(source, field_cursor)
                )
                if field_index_open < end &&
                   token_text(source, field_index_open) == "[" &&
                   record_field_type_named(
                       source,
                       binding_type,
                       field
                   ) == "List[Int]" {
                    let field_index = emit_list_int_subscript(
                        source,
                        hir,
                        field_index_open,
                        0 - 1
                    )
                    if starts_with(field_index, "error[") {
                        return field_index
                    }
                    return "kofun_list_int_index(kofun_list_int_view(&k_b" +
                    binding_id + "." + record_c_field_name(field) + ")" +
                    ", " + field_index + ")"
                }
                return "k_b" + binding_id + "." +
                record_c_field_name(field)
            }
            # A module constant has no lexical binding of its own, so it
            # lowers to the file-scope C constant instead of `k_b`.
            if len(binding_id) == 0 && constant_is_declared(source, name) {
                return constant_c_name(name)
            }
            if optional_int_binding(source, cursor, name) &&
               !optional_int_carrier_position(source, cursor) {
                return "k_b" + binding_id + ".payload"
            }
            return "k_b" + binding_id
        }
        # A callee the scope HIR resolved to a binding is either a lifted
        # lambda or a callable-typed parameter; anything else is a top-level
        # function looked up by name.
        if direct_list_int_call_shape(
            source,
            hir,
            cursor,
            name,
            open
        ) && !direct_list_int_call_supported(
            source,
            hir,
            cursor,
            name,
            open
        ) {
            return "error[E2S157]: List[Int] carrier calls inside lambdas are outside this lowering slice at byte " +
            to_text(cursor)
        }
        if direct_list_int_call_supported(
            source,
            hir,
            cursor,
            name,
            open
        ) {
            return emit_fixed_slot_call(
                source,
                hir,
                cursor,
                open,
                end,
                name,
                false
            )
        }
        if labelled_call_supported(
            source,
            hir,
            cursor,
            name,
            open
        ) {
            return emit_fixed_slot_call(
                source,
                hir,
                cursor,
                open,
                end,
                name,
                true
            )
        }
        if call_has_labelled_argument(source, open) {
            return lower_error(
                "E2S158",
                "labelled-call ABI lowering is owned by #882; fixed-slot " +
                "checked HIR is available",
                cursor
            )
        }
        let callee_binding = hir_use_binding_id(hir, cursor)
        let mut lambda_open = -1
        let mut indirect = false
        if len(callee_binding) > 0 {
            lambda_open = lambda_binding_open(source, hir, callee_binding)
            indirect =
                callable_parameter_type_start(source, hir, callee_binding) >= 0
        }
        let mut emitted = "kofun_fn_" + name + "("
        if lambda_open >= 0 {
            emitted = "kofun_lambda_" + callee_binding + "("
        } else if indirect {
            emitted = "k_b" + callee_binding + "("
        }
        let mut argument = skip_trivia(source, token_end(source, open))
        let mut arguments = 0
        while argument < end && token_text(source, argument) != ")" {
            let bound = argument_end(source, argument)
            let argument_value = emit_argument(
                source,
                hir,
                argument,
                bound,
                name,
                arguments
            )
            # Every other lowering site propagates an `error[` result. This one
            # appended it, so a rejected argument became C source: the
            # diagnostic text was emitted inside the call, the compiler still
            # exited 0, and only `cc` reported the failure.
            if starts_with(argument_value, "error[") {
                return argument_value
            }
            if arguments > 0 {
                emitted = emitted + ", "
            }
            emitted = emitted + argument_value
            arguments = arguments + 1
            let separator = skip_trivia(source, bound)
            if separator < end && token_text(source, separator) == "," {
                argument = skip_trivia(source, token_end(source, separator))
            } else {
                argument = separator
            }
        }
        # The trailing lambda is the call's last argument. It is a lifted
        # function's address, so there is nothing to sequence: placing it after
        # every parenthesised argument is exactly the source order the contract
        # asks for.
        let trailing_open = call_trailing_lambda_open(source, open)
        if trailing_open >= 0 {
            if arguments > 0 {
                emitted = emitted + ", "
            }
            emitted = emitted + argument_lambda_name(trailing_open)
            arguments = arguments + 1
        }
        if lambda_open >= 0 {
            emitted = emitted +
            append_captures(
                lambda_captures(source, hir, lambda_open), arguments, "")
        }
        return emitted + ")"
    }
    if token_text(source, cursor) == "(" {
        let value_start = skip_trivia(source, token_end(source, cursor))
        let close = skip_trivia(source, expression_end(source, value_start))
        return "(" + emit_expression(source, hir, value_start, close) + ")"
    }
    return ""
}

fn emit_unary(source: Text, hir: Text, start: Int, end: Int) -> Text {
    let cursor = skip_trivia(source, start)
    let token = token_text(source, cursor)
    if token == "+" {
        let value_start = skip_trivia(source, token_end(source, cursor))
        return emit_unary(source, hir, value_start, end)
    }
    if token == "-" {
        let value_start = skip_trivia(source, token_end(source, cursor))
        let value = emit_unary(source, hir, value_start, end)
        let function_open = enclosing_function_open(source, cursor)
        let value_type = numeric_primary_type(
            source,
            hir,
            function_open,
            value_start
        )
        if value_type == "Decimal" {
            return "kofun_decimal_value_negate(" + value + ")"
        }
        if value_type == "Float" {
            return "(-(" + value + "))"
        }
        return "kofun_neg(" + value + ")"
    }
    return emit_primary(source, hir, cursor, end)
}

fn emit_product(source: Text, hir: Text, start: Int, end: Int) -> Text {
    let mut cursor = unary_end(source, start)
    let mut emitted = emit_unary(source, hir, start, cursor)
    let value_type = numeric_primary_type(
        source,
        hir,
        enclosing_function_open(source, start),
        start
    )
    let mut operator_start = skip_trivia(source, cursor)
    while operator_start < end {
        let operator = token_text(source, operator_start)
        let right_start = skip_trivia(
            source,
            token_end(source, operator_start)
        )
        let right_end = unary_end(source, right_start)
        let right = emit_unary(source, hir, right_start, right_end)
        # Combining a rejected operand hid it: `kofun_add(error[...], x)` no
        # longer starts with `error[`, so every caller above this loop saw a
        # well-formed expression. Refuse before wrapping.
        if starts_with(emitted, "error[") {
            return emitted
        }
        if starts_with(right, "error[") {
            return right
        }
        if operator == "*" {
            if value_type == "Decimal" {
                emitted = "kofun_decimal_value_multiply(" + emitted +
                ", " + right + ")"
            } else if value_type == "Float" {
                emitted = "kofun_float_multiply(" + emitted +
                ", " + right + ")"
            } else {
                emitted = "kofun_mul(" + emitted + ", " + right + ")"
            }
        } else if operator == "/" {
            if value_type == "Decimal" {
                emitted = "kofun_decimal_value_divide_exact(" + emitted +
                ", " + right + ")"
            } else if value_type == "Float" {
                emitted = "kofun_float_divide(" + emitted +
                ", " + right + ")"
            }
        } else if operator == "//" {
            emitted = "kofun_floor_div(" + emitted + ", " + right + ")"
        } else if operator == "%" {
            emitted = "kofun_floor_mod(" + emitted + ", " + right + ")"
        }
        cursor = right_end
        operator_start = skip_trivia(source, cursor)
    }
    return emitted
}

fn emit_arithmetic_expression(
    source: Text,
    hir: Text,
    start: Int,
    end: Int
) -> Text {
    let mut cursor = product_end(source, start)
    let mut emitted = emit_product(source, hir, start, cursor)
    let value_type = numeric_primary_type(
        source,
        hir,
        enclosing_function_open(source, start),
        start
    )
    let mut left_is_text = text_operand(
        source,
        hir,
        enclosing_function_open(source, start),
        start
    )
    let mut operator_start = skip_trivia(source, cursor)
    while operator_start < end {
        let operator = token_text(source, operator_start)
        let right_start = skip_trivia(
            source,
            token_end(source, operator_start)
        )
        let right_end = product_end(source, right_start)
        let right = emit_product(source, hir, right_start, right_end)
        let right_is_text = text_operand(
            source,
            hir,
            enclosing_function_open(source, start),
            right_start
        )
        # Same rule as `emit_product`: a rejected operand must not be wrapped
        # into a call that looks like a valid expression.
        if starts_with(emitted, "error[") {
            return emitted
        }
        if starts_with(right, "error[") {
            return right
        }
        if operator == "+" {
            if left_is_text || right_is_text {
                if !left_is_text || !right_is_text {
                    return "error[E2S155]: operator `+` requires Text + Text " +
                    "or matching numeric operands at byte " +
                    to_text(operator_start)
                }
                emitted = "kofun_text_concat(" + emitted + ", " + right + ")"
            } else if value_type == "Decimal" {
                emitted = "kofun_decimal_value_add(" + emitted +
                ", " + right + ")"
            } else if value_type == "Float" {
                emitted = "kofun_float_add(" + emitted +
                ", " + right + ")"
            } else {
                emitted = "kofun_add(" + emitted + ", " + right + ")"
            }
        } else if operator == "-" {
            if left_is_text || right_is_text {
                return "error[E2S155]: only operator `+` is defined on Text " +
                "at byte " + to_text(operator_start)
            } else if value_type == "Decimal" {
                emitted = "kofun_decimal_value_subtract(" + emitted +
                ", " + right + ")"
            } else if value_type == "Float" {
                emitted = "kofun_float_subtract(" + emitted +
                ", " + right + ")"
            } else {
                emitted = "kofun_sub(" + emitted + ", " + right + ")"
            }
        }
        left_is_text = left_is_text && right_is_text
        cursor = right_end
        operator_start = skip_trivia(source, cursor)
    }
    return emitted
}

# A coalescing expression is still one C expression, so it works unchanged in
# let, print, return, and argument position. The function-local carrier named
# by the operator byte stores the left exactly once. C11's conditional operator
# then selects the payload or evaluates the fallback, while a failed left
# suppresses both branches until the surrounding statement observes
# `kofun_failed`.
fn emit_expression(source: Text, hir: Text, start: Int, end: Int) -> Text {
    # `|>` is the lowest-precedence boundary, so it is dispatched before the
    # coalescing operator here, mirroring `expression_end` exactly. Putting it
    # any deeper would let `??` or arithmetic claim the subject and leave the
    # call behind as a separate expression — which is what happened before the
    # pipeline was a production.
    let subject_end = coalescing_expression_end(source, start)
    if subject_end >= 0 {
        let pipe = skip_trivia(source, subject_end)
        if pipe < end && token_text(source, pipe) == "|>" {
            let callee_at = skip_trivia(source, token_end(source, pipe))
            let call_open = skip_trivia(source, token_end(source, callee_at))
            let piped_name = token_text(source, callee_at)
            let piped_labelled = call_has_labelled_argument(source, call_open)
            if fixed_slot_call_supported(
                source,
                hir,
                callee_at,
                piped_name,
                call_open,
                piped_labelled
            ) {
                return emit_fixed_slot_call(
                    source,
                    hir,
                    callee_at,
                    call_open,
                    end,
                    piped_name,
                    piped_labelled
                )
            }
        }
    }
    let operator_start = optional_int_coalescing_operator(
        source,
        start,
        end
    )
    if operator_start < 0 {
        return emit_arithmetic_expression(source, hir, start, end)
    }
    let right_start = skip_trivia(
        source,
        token_end(source, operator_start)
    )
    let left = optional_int_value(source, hir, start, operator_start)
    if starts_with(left, "error[") {
        return left
    }
    let right = emit_arithmetic_expression(source, hir, right_start, end)
    if starts_with(right, "error[") {
        return right
    }
    let temporary = "kofun_optional_int_coalesce_" +
        to_text(operator_start)
    return "((" + temporary + " = " + left + "), " +
        "(kofun_failed ? INT64_C(0) : (" + temporary +
        ".tag != KOFUN_OPTIONAL_INT_NONE_TAG ? " + temporary +
        ".payload : " + right + ")))"
}

fn function_arity(source: Text, wanted: Text) -> Int {
    let mut cursor = next_function_start(source, 0)
    let mut found = -1
    while cursor < len(source) {
        if function_name(source, cursor) == wanted {
            if found >= 0 {
                return -2
            }
            found = parameter_count(source, cursor)
        }
        cursor = next_function_start(source, function_end(source, cursor))
    }
    return found
}

# A trailing lambda is one argument of the call it follows, so every arity
# check counts it. Without this the author is blamed for an arity they did not
# get wrong — `apply(1) fn(x) => x` reports "expects 2 arguments, got 1" while
# naming the one argument it declined to see.
fn call_arity_trailing(source: Text, close: Int) -> Int {
    if trailing_lambda_open(source, token_end(source, close)) >= 0 {
        return 1
    }
    return 0
}

fn call_arity(source: Text, open: Int) -> Int {
    let mut cursor = skip_trivia(source, token_end(source, open))
    if cursor < len(source) && token_text(source, cursor) == ")" {
        return call_arity_trailing(source, cursor)
    }
    let mut arity = 0
    while cursor < len(source) {
        let mut bound = argument_end(source, cursor)
        if bound < 0 {
            # Text-literal arguments are single tokens outside the bounded
            # arithmetic expression grammar.
            bound = token_end(source, cursor)
        }
        arity = arity + 1
        let separator = skip_trivia(source, bound)
        if separator < len(source) && token_text(source, separator) == ")" {
            return arity + call_arity_trailing(source, separator)
        }
        if separator >= len(source) || token_text(source, separator) != "," {
            return -1
        }
        cursor = skip_trivia(source, token_end(source, separator))
    }
    return -1
}

# The 16 host builtins of the frozen self-host profile (#618/#619), keyed by
# arity. `print` stays a statement-level special case. `len` is one name here;
# its Text/List[Text] overload is resolved by type, not arity. Builtin calls
# are known and arity-checked. The bounded date/time slice lowers `len(Text)`
# and `text_slice`; the remaining accepted uses classify as unsupported
# lowering, never as an unknown-function source error.
fn builtin_arity(name: Text) -> Int {
    if name == "args" || name == "fail" {
        return 0
    }
    if name == "chars" || name == "is_digit" || name == "is_space" ||
       name == "is_xid_continue" || name == "len" || name == "read_text" ||
       name == "to_text" || name == "trim" ||
       name == "validate_unicode_source" {
        return 1
    }
    if name == "contains" || name == "find" || name == "starts_with" ||
       name == "write_text" {
        return 2
    }
    if name == "replace" || name == "text_slice" {
        return 3
    }
    return 0 - 1
}

# Parameter types of the profile builtins, `|`-separated in order.
# `len` accepts either Text or List (its only overload); every other
# signature is exact.
fn builtin_parameter_types(name: Text) -> Text {
    if name == "args" || name == "fail" {
        return ""
    }
    if name == "chars" || name == "is_digit" || name == "is_space" ||
       name == "is_xid_continue" || name == "read_text" || name == "trim" ||
       name == "validate_unicode_source" {
        return "Text"
    }
    if name == "len" {
        return "TextOrList"
    }
    if name == "contains" || name == "find" || name == "starts_with" ||
       name == "write_text" {
        return "Text|Text"
    }
    if name == "replace" {
        return "Text|Text|Text"
    }
    if name == "text_slice" {
        return "Text|Int|Int"
    }
    if name == "to_text" {
        return "Int"
    }
    return "none"
}

# Body `{` of the function declaration that contains `position`.
fn enclosing_function_open(source: Text, position: Int) -> Int {
    let mut cursor = next_function_start(source, 0)
    while cursor < len(source) {
        let close = function_end(source, cursor)
        if cursor <= position && position < close {
            let parameters = parameter_open(source, cursor)
            if parameters < 0 {
                return 0 - 1
            }
            let parameters_close = balanced_end(source, parameters, "(", ")")
            if parameters_close < 0 {
                return 0 - 1
            }
            let mut open = skip_trivia(source, parameters_close)
            while open < close && token_text(source, open) != "{" {
                open = skip_trivia(source, token_end(source, open))
            }
            if open < close {
                return open
            }
            return 0 - 1
        }
        cursor = next_function_start(source, close)
    }
    return 0 - 1
}

fn expected_parameter_head(parameters: Text) -> Text {
    let separator = find(parameters, "|")
    if separator < 0 {
        return parameters
    }
    return text_slice(parameters, 0, separator)
}

fn expected_parameter_tail(parameters: Text) -> Text {
    let separator = find(parameters, "|")
    if separator < 0 {
        return ""
    }
    return text_slice(parameters, separator + 1, len(parameters))
}

# Check one builtin call's argument types against its frozen signature.
# Arguments whose bounded type cannot be established (value-control
# initializers) are skipped rather than rejected. Returns an error string
# or empty text.
fn builtin_argument_check(
    source: Text,
    hir: Text,
    name: Text,
    call_name: Int,
    open: Int
) -> Text {
    let mut parameters = builtin_parameter_types(name)
    if parameters == "none" {
        return ""
    }
    let function_open = enclosing_function_open(source, call_name)
    if function_open < 0 {
        return ""
    }
    let mut argument = skip_trivia(source, token_end(source, open))
    let mut index = 1
    let mut checking = true
    while checking && argument < len(source) &&
          token_text(source, argument) != ")" && len(parameters) > 0 {
        let expected = expected_parameter_head(parameters)
        if !value_control(token_text(source, argument)) {
            let actual = initializer_type(
                source,
                hir,
                function_open,
                argument
            )
            let mut matches = actual == expected
            if expected == "TextOrList" {
                matches = actual == "Text" || actual == "List" ||
                actual == "List[Int]"
            }
            if !matches {
                return "error[E2S15]: builtin `" + name + "` expects " +
                expected + " for argument " + to_text(index) + ", got " +
                actual + " at byte " + to_text(argument)
            }
        }
        let mut argument_end = expression_end(source, argument)
        if argument_end < 0 {
            # Text-literal arguments are single tokens outside the bounded
            # arithmetic expression grammar.
            argument_end = token_end(source, argument)
        }
        let separator = skip_trivia(source, argument_end)
        if separator >= len(source) ||
           token_text(source, separator) != "," {
            checking = false
        } else {
            argument = skip_trivia(source, token_end(source, separator))
            parameters = expected_parameter_tail(parameters)
            index = index + 1
        }
    }
    return ""
}

fn newline_between(source: Text, start: Int, finish: Int) -> Bool {
    return contains(text_slice(source, start, finish), "\n")
}

# Bounded condition and return typing for the whole profile surface,
# ordered before the unsupported-lowering classification so the frozen
# self-host source is fully checked. Statement `if`/`while` conditions
# must not be confidently non-Bool (the E2S23 message shape is reused
# byte for byte for `if`); value returns must not confidently mismatch
# the declared result type. Match guards, value-position `if`, and
# value-control operands are skipped rather than guessed.
fn validate_core_types(source: Text, hir: Text) -> Text {
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let name = function_name(source, function_start)
        let declared = function_return_type(source, name)
        let mut probe = function_start
        if function_start < function_close {
            probe = function_close - 1
        }
        let function_open = enclosing_function_open(source, probe)
        if function_open >= 0 {
            let mut previous_start = function_open
            let mut cursor = skip_trivia(
                source,
                token_end(source, function_open)
            )
            while cursor < function_close {
                let statement_context =
                    token_text(source, previous_start) == "{" ||
                    token_text(source, previous_start) == "}" ||
                    token_text(source, previous_start) == "else" ||
                    newline_between(
                        source,
                        token_end(source, previous_start),
                        cursor
                    )
                let keyword = token_text(source, cursor)
                if (keyword == "if" || keyword == "while") &&
                   statement_context {
                    let condition = skip_trivia(
                        source,
                        token_end(source, cursor)
                    )
                    if condition < function_close {
                        let condition_type = initializer_type(
                            source,
                            hir,
                            function_open,
                            condition
                        )
                        if condition_type == "Int" ||
                           condition_type == "Text" ||
                           condition_type == "List" ||
                           condition_type == "List[Int]" {
                            if keyword == "if" {
                                return "error[E2S23]: if condition must be Bool or an Int comparison at byte " +
                                to_text(condition)
                            }
                            return "error[E2S23]: while condition must be Bool at byte " +
                            to_text(condition)
                        }
                    }
                }
                if keyword == "return" && statement_context &&
                   len(declared) > 0 && declared != "Void" {
                    let value = skip_trivia(
                        source,
                        token_end(source, cursor)
                    )
                    let bare =
                        value >= function_close ||
                        token_text(source, value) == "}" ||
                        newline_between(
                            source,
                            token_end(source, cursor),
                            value
                        )
                    if !bare && !value_control(token_text(source, value)) {
                        let value_type = initializer_type(
                            source,
                            hir,
                            function_open,
                            value
                        )
                        let known =
                            value_type == "Int" || value_type == "Bool" ||
                            value_type == "Text" || value_type == "List" ||
                            value_type == "List[Int]"
                        if known && value_type != declared {
                            return "error[E2S15]: Core function `" + name +
                            "` returns " + value_type + ", expected " +
                            declared + " at byte " + to_text(value)
                        }
                    }
                }
                previous_start = cursor
                cursor = skip_trivia(source, token_end(source, cursor))
            }
        }
        function_start = next_function_start(source, function_close)
    }
    return "ok"
}

fn function_start_named(source: Text, wanted: Text) -> Int {
    let mut cursor = next_function_start(source, 0)
    while cursor < len(source) {
        if function_name(source, cursor) == wanted {
            return cursor
        }
        cursor = next_function_start(source, function_end(source, cursor))
    }
    return 0 - 1
}

# Start of the declaration-order parameter at `wanted_index`.
fn function_parameter_start_at(
    source: Text,
    function_start: Int,
    wanted_index: Int
) -> Int {
    let parameters = parameter_open(source, function_start)
    if parameters < 0 {
        return 0 - 1
    }
    let parameters_end = balanced_end(source, parameters, "(", ")")
    if parameters_end < 0 {
        return 0 - 1
    }
    let mut parameter = skip_trivia(source, token_end(source, parameters))
    let mut index = 0
    while parameter < parameters_end &&
          token_text(source, parameter) != ")" {
        if index == wanted_index {
            return parameter
        }
        let type_start = parameter_type_start(
            source,
            parameter,
            parameters_end
        )
        if type_start < 0 {
            return 0 - 1
        }
        let mut type_end = callable_type_end(source, type_start)
        if type_end < 0 {
            let list_end = parameter_list_type_end(
                source,
                type_start,
                parameters_end
            )
            if list_end >= 0 {
                type_end = list_end
            } else {
                type_end = annotation_type_end(source, type_start)
            }
        }
        let separator = skip_trivia(source, type_end)
        if separator < parameters_end && token_text(source, separator) == "," {
            parameter = skip_trivia(source, token_end(source, separator))
        } else {
            parameter = separator
        }
        index = index + 1
    }
    return 0 - 1
}

fn call_binding_failure(
    code: Text,
    message: Text,
    primary: Int
) -> Text {
    return "error[" + code + "]: " + message + " at byte " +
    to_text(primary)
}

# Bind one selected named call to fixed declaration-order slots. The C seed
# publishes the corresponding source-order observations for semantic tooling;
# this canonical implementation enforces the same slot and diagnostic rules.
# Whether the call whose callee token is at `call_start` is a pipeline target.
#
# Binding needs the reverse of what recognition needed. `validate_pipeline_calls`
# walks forward from a `|>` to its call; here the call is what we hold and the
# `|>` is what we must find. Scanning left token by token is not available, so
# this re-walks the enclosing body and matches on the callee offset, which is
# exactly the identity the recognizer used.
#
# The C authority resolves the subject's start as well, because it publishes
# spans. This checkpoint records slots as markers rather than offsets, so
# whether a subject exists is all it needs.
# The start of the expression whose coalescing end is exactly `pipe`.
#
# The subject's extent cannot be found by scanning left: `|>` binds looser than
# everything, so the subject may be an arithmetic or coalescing expression, and
# the token before `|>` is only its last token. This asks the grammar the same
# question the parser asks — which start position produces a coalescing
# expression ending exactly here — and takes the earliest, outermost answer.
#
# #1190 left this out of the checkpoint because nothing there published spans.
# #1228 needs it for a different reason: lowering has to emit the subject's
# value, so the checkpoint now resolves it too.
fn pipeline_subject_start(source: Text, body_open: Int, pipe: Int) -> Int {
    let mut candidate = skip_trivia(source, token_end(source, body_open))
    while candidate < pipe {
        let bound = coalescing_expression_end(source, candidate)
        if bound >= 0 && skip_trivia(source, bound) == pipe {
            return candidate
        }
        candidate = skip_trivia(source, token_end(source, candidate))
    }
    return -1
}

# The subject of the pipeline whose callee token is at `call_start`, or -1 when
# that call is not a pipeline target.
fn pipeline_subject_for_call(source: Text, call_start: Int) -> Int {
    if !contains(source, "|>") {
        return -1
    }
    let body_open = enclosing_function_open(source, call_start)
    if body_open < 0 {
        return -1
    }
    let mut cursor = skip_trivia(source, token_end(source, body_open))
    while cursor < call_start {
        if token_text(source, cursor) == "|>" {
            let callee_at = skip_trivia(source, token_end(source, cursor))
            if callee_at == call_start {
                return pipeline_subject_start(source, body_open, cursor)
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return -1
}

fn call_is_pipeline_target(source: Text, call_start: Int) -> Bool {
    if !contains(source, "|>") {
        return false
    }
    let body_open = enclosing_function_open(source, call_start)
    if body_open < 0 {
        return false
    }
    let mut cursor = skip_trivia(source, token_end(source, body_open))
    while cursor < call_start {
        if token_text(source, cursor) == "|>" {
            let callee_at = skip_trivia(source, token_end(source, cursor))
            if callee_at == call_start {
                return true
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

fn validate_declared_call_arguments(
    source: Text,
    callee: Text,
    call_start: Int,
    open: Int
) -> Text {
    let declaration = function_start_named(source, callee)
    if declaration < 0 {
        return ""
    }
    let parameters = parameter_open(source, declaration)
    let parameters_end = balanced_end(source, parameters, "(", ")")
    let close = balanced_end(source, open, "(", ")")
    if parameters < 0 || parameters_end < 0 || close < 0 {
        return ""
    }
    let count = parameter_count(source, declaration)
    let mut has_external_parameter = false
    let mut parameter_index = 0
    while parameter_index < count {
        let parameter = function_parameter_start_at(
            source,
            declaration,
            parameter_index
        )
        has_external_parameter = has_external_parameter ||
        parameter_external_start(source, parameter, parameters_end) >= 0
        parameter_index = parameter_index + 1
    }
    # A pipeline supplies slot 0 from outside the parentheses, so it needs this
    # binder even when nothing in the call is labelled. Without the extra term
    # `start |> add(2)` would take the ordinary positional path, which binds the
    # written `2` to slot 0 and never learns the subject exists.
    let piped = call_is_pipeline_target(source, call_start)
    if !has_external_parameter && !call_has_labelled_argument(source, open) &&
       !piped {
        return ""
    }
    let mut bound = "|"
    let mut saw_label = false
    let mut next_positional = 0
    # The subject claims slot 0 before any explicit argument is read, which is
    # what makes the rest of this loop correct without further special cases:
    # positional binding starts at slot 1 because slot 0 is taken, and a label
    # naming slot 0 lands on the existing duplicate path.
    #
    # The C authority also publishes a `call-argument|` observation for the
    # subject here. This frontend checkpoint emits none, so it records the
    # binding and nothing else.
    if piped && count > 0 {
        bound = bound + "0|"
        next_positional = 1
    }
    let mut argument = skip_trivia(source, token_end(source, open))
    let mut scanning = true
    while scanning && argument < close && token_text(source, argument) != ")" {
        let mut label = 0 - 1
        if parameter_word_token(source, argument) {
            let colon = skip_trivia(source, token_end(source, argument))
            if colon < close && token_text(source, colon) == ":" {
                label = argument
            }
        }
        let mut slot = 0 - 1
        if label >= 0 {
            saw_label = true
            let mut index = 0
            while index < count && slot < 0 {
                let parameter = function_parameter_start_at(
                    source,
                    declaration,
                    index
                )
                let external = parameter_external_start(
                    source,
                    parameter,
                    parameters_end
                )
                if external >= 0 &&
                   token_text(source, external) == token_text(source, label) {
                    slot = index
                }
                index = index + 1
            }
            if slot < 0 {
                let mut internal_match = false
                let mut index = 0
                while index < count && !internal_match {
                    let parameter = function_parameter_start_at(
                        source,
                        declaration,
                        index
                    )
                    let internal = parameter_internal_start(
                        source,
                        parameter,
                        parameters_end
                    )
                    internal_match = internal >= 0 &&
                    token_text(source, internal) == token_text(source, label)
                    index = index + 1
                }
                if internal_match {
                    return call_binding_failure(
                        "E2S166",
                        "label `" + token_text(source, label) +
                        "` names an internal or unlabelled parameter",
                        label
                    )
                }
                return call_binding_failure(
                    "E2S162",
                    "unknown call label `" + token_text(source, label) + "`",
                    label
                )
            }
            if contains(bound, "|" + to_text(slot) + "|") {
                return call_binding_failure(
                    "E2S163",
                    "duplicate call label `" + token_text(source, label) + "`",
                    label
                )
            }
        } else {
            if saw_label {
                return call_binding_failure(
                    "E2S165",
                    "positional argument follows a labelled argument",
                    argument
                )
            }
            while next_positional < count &&
                  contains(bound, "|" + to_text(next_positional) + "|") {
                next_positional = next_positional + 1
            }
            if next_positional >= count {
                scanning = false
            } else {
                slot = next_positional
                next_positional = next_positional + 1
                let parameter = function_parameter_start_at(
                    source,
                    declaration,
                    slot
                )
                let external = parameter_external_start(
                    source,
                    parameter,
                    parameters_end
                )
                if external >= 0 {
                    return call_binding_failure(
                        "E2S164",
                        "labelled parameter requires its external label",
                        argument
                    )
                }
            }
        }
        if slot >= 0 {
            bound = bound + to_text(slot) + "|"
        }
        let end = argument_end(source, argument)
        if end < 0 {
            scanning = false
        } else {
            let separator = skip_trivia(source, end)
            if separator < close && token_text(source, separator) == "," {
                argument = skip_trivia(source, token_end(source, separator))
            } else {
                scanning = false
            }
        }
    }
    # Rule 6 of call-arguments v1: a trailing lambda binds only the final
    # parameter, and it is an error if that parameter was already supplied.
    #
    # Binding it here, before the missing-argument sweep, is what stops a
    # well-formed trailing call from being reported as `missing argument` for
    # the very parameter the author did supply — just not between the
    # parentheses.
    let trailing_open = call_trailing_lambda_open(source, open)
    if trailing_open >= 0 && count > 0 {
        let trailing_slot = count - 1
        let trailing_parameter = function_parameter_start_at(
            source,
            declaration,
            trailing_slot
        )
        let trailing_external = parameter_external_start(
            source,
            trailing_parameter,
            parameters_end
        )
        let trailing_internal = parameter_internal_start(
            source,
            trailing_parameter,
            parameters_end
        )
        let mut trailing_declared = trailing_internal
        if trailing_external >= 0 {
            trailing_declared = trailing_external
        }
        if contains(bound, "|" + to_text(trailing_slot) + "|") {
            return call_binding_failure(
                "E2S167",
                "trailing lambda binds `" +
                token_text(source, trailing_declared) +
                "`, which is already supplied",
                trailing_open
            )
        }
        bound = bound + to_text(trailing_slot) + "|"
    }
    let mut slot = 0
    while slot < count {
        if !contains(bound, "|" + to_text(slot) + "|") {
            let parameter = function_parameter_start_at(
                source,
                declaration,
                slot
            )
            let external = parameter_external_start(
                source,
                parameter,
                parameters_end
            )
            let internal = parameter_internal_start(
                source,
                parameter,
                parameters_end
            )
            let mut declared = internal
            if external >= 0 {
                declared = external
            }
            return call_binding_failure(
                "E2S164",
                "missing argument `" + token_text(source, declared) + "`",
                call_start
            )
        }
        slot = slot + 1
    }
    return ""
}

fn call_has_labelled_argument(source: Text, open: Int) -> Bool {
    let close = balanced_end(source, open, "(", ")")
    if close < 0 {
        return false
    }
    let mut argument = skip_trivia(source, token_end(source, open))
    let mut scanning = true
    while scanning && argument < close &&
          token_text(source, argument) != ")" {
        if parameter_word_token(source, argument) {
            let colon = skip_trivia(source, token_end(source, argument))
            if colon < close && token_text(source, colon) == ":" {
                return true
            }
        }
        let end = argument_end(source, argument)
        if end < 0 {
            scanning = false
        } else {
            let separator = skip_trivia(source, end)
            if separator < close && token_text(source, separator) == "," {
                argument = skip_trivia(source, token_end(source, separator))
            } else {
                scanning = false
            }
        }
    }
    return false
}

fn validate_record_uses(source: Text) -> Text {
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let parameters = parameter_open(source, function_start)
        let parameters_close = balanced_end(
            source,
            parameters,
            "(",
            ")"
        )
        let mut function_open = skip_trivia(source, parameters_close)
        while function_open < function_close &&
              token_text(source, function_open) != "{" {
            function_open = skip_trivia(
                source,
                token_end(source, function_open)
            )
        }
        let mut cursor = skip_trivia(
            source,
            token_end(source, function_open)
        )
        while cursor < function_close {
            if token_kind(source, cursor) == "identifier" {
                let name = token_text(source, cursor)
                let open = skip_trivia(source, token_end(source, cursor))
                if open < function_close &&
                   token_text(source, open) == "(" &&
                   record_declaration_start(source, name) >= 0 &&
                   !record_initializer_constructor_token(
                       source,
                       function_open,
                       cursor
                   ) {
                    return "error[E2S32]: bind record construction to an explicitly typed immutable record before using it at byte " +
                    to_text(cursor)
                }
            }
            cursor = skip_trivia(source, token_end(source, cursor))
        }
        function_start = next_function_start(source, function_close)
    }
    return "ok"
}

# Recognize the pipeline production and refuse it by name, before the ordinary
# call validators can report the subject's absence as the author's mistake.
#
# Without this the four canonical shapes reach `E2S164 missing argument` or
# `E2S17 expects N, got N-1` — diagnostics that describe an argument list the
# author did not get wrong, and that say nothing about the pipeline they did
# write.
# Effective arity and the slot-0 carrier check for a pipeline whose subject has
# already bound slot 0.
#
# Everything here checks against the *bound slot*, never the source position:
# the subject is slot 0 wherever it is written. Checking by position is what the
# pre-#1226 code did, and it is why the four canonical shapes used to report a
# missing or miscounted argument.
#
# The C authority also type-checks the subject's value against slot 0's carrier
# and reports E2S15 at the subject's span. This frontend checkpoint has no
# `initializer_type` reaching pipeline subjects, so it carries the arity and
# carrier-matrix halves and leaves the value typing to the authority.
fn validate_pipeline_checked(
    source: Text,
    callee: Text,
    call_start: Int,
    open: Int
) -> Text {
    let declaration = function_start_named(source, callee)
    if declaration < 0 {
        return "ok"
    }
    let expected = parameter_count(source, declaration)
    # One subject plus everything inside the parentheses. `call_arity` already
    # counts a trailing lambda, and a pipeline with one is refused before this
    # point, so the sum needs no further term.
    let written = call_arity(source, open)
    if written < 0 {
        return "ok"
    }
    let effective = written + 1
    if effective != expected {
        return "error[E2S17]: Core function `" + callee + "` expects " +
        to_text(expected) + " arguments, got " + to_text(effective) +
        " at byte " + to_text(call_start)
    }
    if expected > 0 {
        let carrier = function_parameter_type(source, callee, 0)
        if !call_slot_carried(source, carrier) {
            return pipeline_refusal(
                "a pipeline subject whose slot 0 carrier is outside the " +
                "call-arguments v1 matrix is not checked",
                call_start
            )
        }
    }
    return "ok"
}

fn validate_pipeline_calls(source: Text) -> Text {
    if !contains(source, "|>") {
        return "ok"
    }
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let parameters = parameter_open(source, function_start)
        let mut body_open = -1
        if parameters >= 0 {
            body_open = balanced_end(source, parameters, "(", ")")
        }
        if body_open >= 0 {
            let mut cursor = skip_trivia(source, body_open)
            while cursor < function_close {
                if token_text(source, cursor) == "|>" {
                    let call_end = pipeline_call_end(source, cursor)
                    # Shapes outside the production were already refused by
                    # `validate_pipeline_shapes`, which has to run before scope
                    # construction. Reaching here means the production parsed
                    # and bound its subject as an ordinary expression.
                    if call_end < 0 {
                        return "ok"
                    }
                    # The C authority publishes the `pipeline|...` span
                    # observation here, which is why it also carries
                    # `pipeline_subject_start`. This frontend checkpoint emits
                    # no semantic observations at all — it has no
                    # `stage2_semantic_observe` and no `call-argument|` line
                    # either — so the two halves agree on the refusal and on
                    # what the production is, and the checkpoint carries no
                    # span helper it would never use.
                    #
                    # #1226 binds before the boundary holds. The binder runs
                    # from here rather than from `validate_core_calls`, because
                    # this pass returns first and that one would never see the
                    # call — and it cannot simply be moved after, since the
                    # arity check would then count the parenthesised arguments
                    # alone and report the subject as a missing one. Counting
                    # the subject is #1227's effective arity.
                    #
                    # A binding failure is the author's error and outranks the
                    # boundary, so E2S162-E2S166 are returned as-is.
                    let callee_at = skip_trivia(source, token_end(source, cursor))
                    let open_at = skip_trivia(source, token_end(source, callee_at))
                    let binding = validate_declared_call_arguments(
                        source,
                        token_text(source, callee_at),
                        callee_at,
                        open_at
                    )
                    if starts_with(binding, "error[") {
                        return binding
                    }
                    let checked = validate_pipeline_checked(
                        source,
                        token_text(source, callee_at),
                        callee_at,
                        open_at
                    )
                    if starts_with(checked, "error[") {
                        return checked
                    }
                    # #1228 admits the checked shape. There is no refusal left
                    # here: the call reaches the shared fixed-slot emitter,
                    # which assigns slot 0 from the subject before anything in
                    # the parentheses. A carrier this slice cannot lower was
                    # already refused by the carrier-matrix check above.
                    return "ok"
                }
                cursor = skip_trivia(source, token_end(source, cursor))
            }
        }
        function_start = next_function_start(source, function_close)
    }
    return "ok"
}

fn validate_core_calls(source: Text, hir: Text) -> Text {
    let mut cursor = next_function_start(source, 0)
    let mut previous = ""
    while cursor < len(source) {
        if token_kind(source, cursor) == "identifier" {
            let name = token_text(source, cursor)
            let open = skip_trivia(source, token_end(source, cursor))
            # `C(x)` on a declared enum constructor applies a constructor; it is
            # not a call.  Where such an application may appear is decided by
            # the enum guard in the scope HIR, whose diagnostic names the
            # constructor and its enum, so reporting an unknown callee here
            # would replace that with a misleading one.
            let constructor_application =
            (len(enum_constructor_owner(source, name)) > 0 ||
             record_declaration_start(source, name) >= 0) &&
            function_arity(source, name) < 0
            if previous != "fn" && previous != "." && name != "print" &&
               !constructor_application &&
               open < len(source) && token_text(source, open) == "(" {
                let mut expected = function_arity(source, name)
                if expected >= 0 {
                    let binding_error = validate_declared_call_arguments(
                        source,
                        name,
                        cursor,
                        open
                    )
                    if len(binding_error) > 0 {
                        return binding_error
                    }
                }
                if expected == -2 {
                    return "error[E2S16]: duplicate Core function `" + name +
                    "` at byte " + to_text(cursor)
                }
                if expected < 0 {
                    # A callee the scope HIR bound to a lambda is lifted to a
                    # top-level function, so it is a known callee even though
                    # it is absent from the source's function table. Feeding
                    # its arity back into `expected` gives a lambda call the
                    # same arity diagnostic a named call already gets.
                    expected = lambda_call_arity(source, hir, cursor)
                }
                if expected < 0 {
                    # A callee bound to a callable-typed parameter is called
                    # through the pointer it holds. Its arity is declared by
                    # the type, so the same arity diagnostic applies.
                    expected = callable_call_arity(source, hir, cursor)
                }
                if expected < 0 {
                    let builtin_expected = builtin_arity(name)
                    if builtin_expected < 0 {
                        return "error[E2S16]: unknown Core function `" +
                        name + "` at byte " + to_text(cursor)
                    }
                    let builtin_actual = call_arity(source, open)
                    if builtin_actual != builtin_expected {
                        return "error[E2S17]: Core function `" + name +
                        "` expects " + to_text(builtin_expected) +
                        " arguments, got " + to_text(builtin_actual) +
                        " at byte " + to_text(cursor)
                    }
                    let argument_error = builtin_argument_check(
                        source,
                        hir,
                        name,
                        cursor,
                        open
                    )
                    if len(argument_error) > 0 {
                        return argument_error
                    }
                    if name == "len" || name == "text_slice" ||
                       name == "to_text" {
                        expected = builtin_expected
                    } else {
                        return "error[E2S10]: unsupported Core builtin call `" +
                        name + "` at byte " + to_text(cursor)
                    }
                }
                # A pipeline supplies slot 0 from outside the parentheses, so
                # its subject is one of the call's arguments. Counting only what
                # is written between them is what made every pipeline report
                # `expects N, got N-1` before #1190.
                let mut actual = call_arity(source, open)
                if call_is_pipeline_target(source, cursor) {
                    actual = actual + 1
                }
                if actual != expected {
                    return "error[E2S17]: Core function `" + name +
                    "` expects " + to_text(expected) + " arguments, got " +
                    to_text(actual) + " at byte " + to_text(cursor)
                }
            }
        }
        previous = token_text(source, cursor)
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return "ok"
}

fn core_parameters(
    source: Text,
    hir: Text,
    function_start: Int
) -> Text {
    let parameters = parameter_open(source, function_start)
    if parameters < 0 {
        return "error[E2S15]: malformed Core parameter list"
    }
    let parameters_end = balanced_end(source, parameters, "(", ")")
    if parameters_end < 0 {
        return "error[E2S15]: malformed Core parameter list"
    }
    let mut cursor = skip_trivia(source, token_end(source, parameters))
    let mut emitted = ""
    let mut count = 0
    while cursor < parameters_end && token_text(source, cursor) != ")" {
        let name_at = parameter_internal_start(
            source,
            cursor,
            parameters_end
        )
        let type_cursor = parameter_type_start(
            source,
            cursor,
            parameters_end
        )
        if name_at < 0 || type_cursor < 0 ||
           token_kind(source, name_at) != "identifier" {
            return "error[E2S15]: expected Core parameter name at byte " +
            to_text(cursor)
        }
        let name = token_text(source, name_at)
        if type_cursor >= parameters_end {
            return "error[E2S15]: Core parameters must have type Int, Text, a concrete enum, or a nominal record at byte " +
            to_text(cursor)
        }
        # A callable parameter type is checked before `Int` because its own
        # domain may be the single token `Int`: `f: Int -> Int` starts exactly
        # like `f: Int` and only the `->` after it tells them apart.
        let callable_end = callable_type_end(source, type_cursor)
        let mut type_end = -1
        let mut declarator = ""
        if callable_end >= 0 && callable_end <= parameters_end {
            type_end = callable_end
            declarator = callable_c_declarator(
                source,
                type_cursor,
                "k_b" + hir_definition_id_at(hir, name_at)
            )
        } else if optional_int_type_end(source, type_cursor) >= 0 {
            type_end = optional_int_type_end(source, type_cursor)
            declarator = "KofunOptionalInt k_b" +
                hir_definition_id_at(hir, name_at)
        } else if token_text(source, type_cursor) == "Int" {
            type_end = token_end(source, type_cursor)
            declarator = "int64_t k_b" + hir_definition_id_at(hir, name_at)
        } else if token_text(source, type_cursor) == "Text" {
            type_end = token_end(source, type_cursor)
            declarator = "const char *k_b" +
            hir_definition_id_at(hir, name_at)
        } else if list_int_type_end(source, type_cursor) >= 0 {
            type_end = list_int_type_end(source, type_cursor)
            declarator = "KofunIntListValue k_b" +
            hir_definition_id_at(hir, name_at)
        } else if ownership_mode_token(source, cursor) &&
            parameter_list_type_end(
            source,
            type_cursor,
            parameters_end
        ) >= 0 {
            return "error[E2S10]: unsupported Core parameter type " +
                parameter_list_type_text(
                    source,
                    type_cursor,
                    parameters_end
                ) + " at byte " + to_text(type_cursor)
        } else if enum_constructor_count(
            source,
            token_text(source, type_cursor)
        ) >= 0 {
            type_end = token_end(source, type_cursor)
            declarator =
                "KofunEnumValue k_b" + hir_definition_id_at(hir, name_at)
        } else if record_declaration_start(
            source,
            token_text(source, type_cursor)
        ) >= 0 {
            type_end = annotation_type_end(source, type_cursor)
            declarator = record_c_type_name(
                annotation_type_text(source, type_cursor)
            ) + " k_b" + hir_definition_id_at(hir, name_at)
        }
        if type_end < 0 {
            return "error[E2S15]: Core parameters must have type Int, Text, a concrete enum, or a nominal record at byte " +
            to_text(cursor)
        }
        if count > 0 {
            emitted = emitted + ", "
        }
        emitted = emitted + declarator
        count = count + 1
        let separator = skip_trivia(source, type_end)
        if separator < parameters_end &&
           token_text(source, separator) == "," {
            cursor = skip_trivia(source, token_end(source, separator))
        } else {
            cursor = separator
        }
    }
    return emitted
}

# The callable type of the parameter a call site's callee binding declares, as
# the byte offset of its type, or -1 when the callee is not a callable-typed
# parameter. This is how an indirect call reaches its arity and its C
# declarator without repeating name resolution: the scope HIR has already
# resolved the callee to a binding, shadowing included.
fn callable_parameter_type_start(
    source: Text,
    hir: Text,
    binding_id: Text
) -> Int {
    let declaration_start = hir_binding_declaration_start(hir, binding_id)
    if declaration_start < 0 {
        return -1
    }
    let colon = skip_trivia(source, token_end(source, declaration_start))
    if colon >= len(source) || token_text(source, colon) != ":" {
        return -1
    }
    let type_cursor = skip_trivia(source, token_end(source, colon))
    if callable_type_end(source, type_cursor) < 0 {
        return -1
    }
    return type_cursor
}

# The declared arity of the callable-typed parameter a call site resolves to,
# or -1 when the callee is not one.
fn callable_call_arity(source: Text, hir: Text, use_start: Int) -> Int {
    let callee_binding = hir_use_binding_id(hir, use_start)
    if len(callee_binding) == 0 {
        return -1
    }
    let type_start = callable_parameter_type_start(source, hir, callee_binding)
    if type_start < 0 {
        return -1
    }
    return callable_type_arity(source, type_start)
}

# The byte after a callable type beginning at `start`, or -1 when the tokens
# there are not one.
#
# #552 settled the notation and this Core implements exactly it: `A -> R` for
# one argument, `(A, B) -> R` for a fixed arity of two or more, and `() -> R`
# for none. There is no implicit currying, so `A -> B -> R` is not a two-
# argument callable; it is a one-argument callable returning another, which
# this Core has no value to represent and therefore does not accept.
#
# `Int` is the only type in every domain and result position, because `Int` is
# the whole type vocabulary a Core parameter has. A callable naming any other
# type is not a callable type here, so the caller reports it as an ordinary
# unsupported parameter type rather than as a malformed callable.
fn callable_type_end(source: Text, start: Int) -> Int {
    let cursor = skip_trivia(source, start)
    if cursor >= len(source) {
        return -1
    }
    let mut after_domain = -1
    if token_text(source, cursor) == "(" {
        let close = balanced_end(source, cursor, "(", ")")
        if close < 0 {
            return -1
        }
        let mut element = skip_trivia(source, token_end(source, cursor))
        while element < close && token_text(source, element) != ")" {
            if token_text(source, element) != "Int" {
                return -1
            }
            let separator = skip_trivia(source, token_end(source, element))
            if separator < close && token_text(source, separator) == "," {
                element = skip_trivia(source, token_end(source, separator))
            } else {
                element = separator
            }
        }
        after_domain = close
    } else if token_text(source, cursor) == "Int" {
        after_domain = token_end(source, cursor)
    } else {
        return -1
    }
    let arrow = skip_trivia(source, after_domain)
    if arrow >= len(source) || token_text(source, arrow) != "->" {
        return -1
    }
    let result = skip_trivia(source, token_end(source, arrow))
    if result >= len(source) || token_text(source, result) != "Int" {
        return -1
    }
    return token_end(source, result)
}

# The argument count of the callable type at `start`, or -1 when there is not
# one there. The bare domain `A -> R` is one argument by construction; a
# parenthesised domain counts its elements, so `() -> R` is zero.
fn callable_type_arity(source: Text, start: Int) -> Int {
    if callable_type_end(source, start) < 0 {
        return -1
    }
    let cursor = skip_trivia(source, start)
    if token_text(source, cursor) != "(" {
        return 1
    }
    let close = balanced_end(source, cursor, "(", ")")
    if close < 0 {
        return -1
    }
    let mut count = 0
    let mut element = skip_trivia(source, token_end(source, cursor))
    while element < close && token_text(source, element) != ")" {
        count = count + 1
        let separator = skip_trivia(source, token_end(source, element))
        if separator < close && token_text(source, separator) == "," {
            element = skip_trivia(source, token_end(source, separator))
        } else {
            element = separator
        }
    }
    return count
}

# `int64_t (*NAME)(int64_t, ...)` for the callable type at `start`. Every value
# this Core lowers is an `int64_t`, so a callable is a plain C function pointer
# and needs no environment; that is exactly why a capturing lambda cannot be
# one, and `capturing_lambda_argument` refuses those at the call site.
fn callable_c_declarator(source: Text, start: Int, name: Text) -> Text {
    let arity = callable_type_arity(source, start)
    if arity < 0 {
        return ""
    }
    let mut domain = ""
    let mut written = 0
    while written < arity {
        if written > 0 {
            domain = domain + ", "
        }
        domain = domain + "int64_t"
        written = written + 1
    }
    if arity == 0 {
        domain = "void"
    }
    return "int64_t (*" + name + ")(" + domain + ")"
}

# The arrow spelling of the removed `Fn[...]` notation whose `[` is at `open`,
# or "" when the brackets do not close.
#
# #552 settled one spelling for both positions, and every normative document
# requires a *targeted* rewrite rather than a bare rejection. The last bracket
# element is the result and the rest are the domain, so `Fn[R]` is `() -> R`,
# `Fn[A, R]` is `A -> R`, and a historical multi-argument `Fn[A, B, R]` is
# `(A, B) -> R`. Nested brackets are skipped whole, which is what keeps
# `Fn[Int, List[Int]]` from splitting inside `List[Int]`.
fn removed_callable_rewrite(source: Text, open: Int) -> Text {
    let close = balanced_end(source, open, "[", "]")
    if close < 0 {
        return ""
    }
    let mut domain = ""
    let mut result = ""
    let mut count = 0
    let mut element = skip_trivia(source, token_end(source, open))
    while element < close && token_text(source, element) != "]" {
        let element_start = element
        let mut element_end = element
        while element < close && token_text(source, element) != "," &&
              token_text(source, element) != "]" {
            if token_text(source, element) == "[" {
                let nested = balanced_end(source, element, "[", "]")
                if nested < 0 {
                    return ""
                }
                element_end = nested
            } else {
                element_end = token_end(source, element)
            }
            element = skip_trivia(source, element_end)
        }
        if count > 0 {
            if len(domain) > 0 {
                domain = domain + ", "
            }
            domain = domain + result
        }
        result = text_slice(source, element_start, element_end)
        count = count + 1
        if element < close && token_text(source, element) == "," {
            element = skip_trivia(source, token_end(source, element))
        }
    }
    if count == 0 {
        return ""
    }
    if count == 1 {
        return "() -> " + result
    }
    if count == 2 {
        return domain + " -> " + result
    }
    return "(" + domain + ") -> " + result
}

# The leading-zero-stripped digits of a const argument. Normalization is by
# value, not by digits, so `Fixed[02]` and `Fixed[2]` are one type.
fn const_argument_digits(literal: Text) -> Text {
    let mut index = 0
    while index + 1 < len(literal) &&
          text_slice(literal, index, index + 1) == "0" {
        index = index + 1
    }
    return text_slice(literal, index, len(literal))
}

fn const_digit_greater(actual: Text, allowed: Text) -> Bool {
    let digits = "0123456789"
    return find(digits, actual) > find(digits, allowed)
}

# A const parameter is a type-level integer, not a machine integer, so its
# budget is a declared ceiling rather than a host width. Exceeding it is
# refused and never wrapped, clamped, or truncated. Comparing equal-width
# digit strings position by position is exactly numeric comparison, which is
# why no integer parse is needed here.
fn const_argument_over_budget(digits: Text) -> Bool {
    let limit = "65535"
    let width = len(digits)
    if width > len(limit) {
        return true
    }
    if width < len(limit) {
        return false
    }
    let mut index = 0
    while index < width {
        let actual = text_slice(digits, index, index + 1)
        let allowed = text_slice(limit, index, index + 1)
        if actual != allowed {
            return const_digit_greater(actual, allowed)
        }
        index = index + 1
    }
    return false
}

# The text of a type annotation, carrying its normalized const argument when
# the head names a const-parameterized type.
#
# Returning only the head token here is what would erase `Fixed[2]` into
# `Fixed`, making every scale one type. This is the single place an
# instantiation becomes a type identity, so every comparison downstream
# distinguishes the scales without knowing they exist.
fn annotation_type_text(source: Text, type_start: Int) -> Text {
    let head = token_text(source, type_start)
    if len(const_parameter_of_type(source, head)) == 0 {
        return head
    }
    let bracket = skip_trivia(source, token_end(source, type_start))
    if bracket >= len(source) || token_text(source, bracket) != "[" {
        return head
    }
    let argument = skip_trivia(source, token_end(source, bracket))
    if argument >= len(source) ||
       token_kind(source, argument) != "integer" {
        return head
    }
    return head + "[" +
    const_argument_digits(token_text(source, argument)) + "]"
}

# The end offset of a type annotation, including its const argument. Walking
# past only the head token here is what would leave `[2]` in the stream for
# the next parser step to trip over.
fn annotation_type_end(source: Text, type_start: Int) -> Int {
    let head = token_text(source, type_start)
    if len(const_parameter_of_type(source, head)) == 0 {
        return token_end(source, type_start)
    }
    let bracket = skip_trivia(source, token_end(source, type_start))
    if bracket >= len(source) || token_text(source, bracket) != "[" {
        return token_end(source, type_start)
    }
    let close = balanced_end(source, bracket, "[", "]")
    if close < 0 {
        return token_end(source, type_start)
    }
    return close
}

# The declaration a type identity names, with any const argument removed.
fn const_type_base(annotation: Text) -> Text {
    let bracket = find(annotation, "[")
    if bracket < 0 {
        return annotation
    }
    return text_slice(annotation, 0, bracket)
}

# Every `NAME[...]` whose head is a const-parameterized type must supply one
# non-negative integer literal inside the declared budget. Const expressions,
# const inference, and arithmetic on a type-level value are out of scope, so a
# non-literal argument is refused here rather than partially resolved.
fn validate_const_arguments(source: Text) -> Text {
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        if token_kind(source, cursor) == "identifier" {
            let head = token_text(source, cursor)
            let parameter = const_parameter_of_type(source, head)
            let bracket = skip_trivia(source, token_end(source, cursor))
            if len(parameter) > 0 &&
               const_generic_declaration_head(source, cursor) {
                # The declaration's own parameter list is a binder, not an
                # argument; `type_parameter_list_error` owns its shape.
                cursor = skip_trivia(source, token_end(source, cursor))
                continue
            }
            if len(parameter) > 0 && bracket < len(source) &&
               token_text(source, bracket) == "[" {
                let close = balanced_end(source, bracket, "[", "]")
                if close < 0 {
                    return "error[E2S150]: unterminated const argument list for `" +
                    head + "` at byte " + to_text(bracket)
                }
                let argument = skip_trivia(source, token_end(source, bracket))
                if token_text(source, argument) == "-" {
                    return "error[E2S149]: const argument to `" + head +
                    "` is negative; `" + parameter +
                    ": Int` admits `0`..`65535` only at byte " +
                    to_text(argument)
                }
                if token_kind(source, argument) != "integer" {
                    return "error[E2S149]: const argument to `" + head +
                    "` is not an integer literal; const expressions are out of scope at byte " +
                    to_text(argument)
                }
                let digits = const_argument_digits(
                    token_text(source, argument)
                )
                if const_argument_over_budget(digits) {
                    return "error[E2S149]: const argument to `" + head +
                    "` exceeds the budget `0`..`65535`; it is refused, not wrapped at byte " +
                    to_text(argument)
                }
                let after = skip_trivia(source, token_end(source, argument))
                if token_text(source, after) != "]" {
                    return "error[E2S150]: `" + head +
                    "` declares one const parameter and accepts exactly one argument at byte " +
                    to_text(after)
                }
                cursor = skip_trivia(source, close)
                continue
            }
            if len(parameter) > 0 &&
               !const_generic_declaration_head(source, cursor) {
                return "error[E2S150]: `" + head +
                "` expects one const argument; write `" + head +
                "[...]` at byte " + to_text(cursor)
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return "ok"
}

# True at the type name of the declaration itself, which is the one position
# where a const-parameterized name legitimately carries no argument.
fn const_generic_declaration_head(source: Text, position: Int) -> Bool {
    let mut cursor = after_optional_module_header(source, 0)
    while cursor < len(source) {
        let type_start = type_declaration_start(source, cursor)
        if type_start >= 0 &&
           skip_trivia(source, token_end(source, type_start)) == position {
            return true
        }
        let end = top_level_end(source, cursor)
        if end <= cursor {
            return false
        }
        cursor = skip_trivia(source, end)
    }
    return false
}

# The executable form of the premise that lets every instantiation of one
# declaration share a single lowering: a const argument contributes no
# storage, so it must never reach layout or code generation.
#
# A record field typed by an instantiation is the route that would break it —
# the field would put the argument inside a struct, and one shared struct
# would then be a miscompile across two types the checker has already made
# distinct. Refusing it here means the premise fails loudly the day it stops
# holding, instead of a struct being quietly shared.
fn validate_const_erasure(source: Text) -> Text {
    let mut cursor = after_optional_module_header(source, 0)
    while cursor < len(source) {
        let type_start = type_declaration_start(source, cursor)
        if type_start >= 0 && record_declaration_at(source, type_start) {
            let equals = type_equals_token(source, type_start)
            let open = skip_trivia(source, token_end(source, equals))
            let close = balanced_end(source, open, "{", "}")
            if close < 0 {
                return "ok"
            }
            let mut field = skip_trivia(source, token_end(source, open))
            while field < close && token_text(source, field) != "}" {
                let colon = skip_trivia(source, token_end(source, field))
                let field_type = skip_trivia(source, token_end(source, colon))
                if field_type < close &&
                   len(const_parameter_of_type(
                       source,
                       token_text(source, field_type)
                   )) > 0 {
                    return "error[E2S148]: field `" +
                    token_text(source, field) + "` of `" +
                    type_name(source, type_start) +
                    "` is a const generic instantiation; a const argument must not reach layout at byte " +
                    to_text(field_type)
                }
                let separator = skip_trivia(
                    source,
                    token_end(source, field_type)
                )
                if separator < close && token_text(source, separator) == "," {
                    field = skip_trivia(source, token_end(source, separator))
                } else {
                    field = separator
                }
            }
        }
        let end = top_level_end(source, cursor)
        if end <= cursor {
            return "ok"
        }
        cursor = skip_trivia(source, end)
    }
    return "ok"
}

# `Fn[...]` is the callable notation #552 removed. `Fn` stays an ordinary
# identifier, so only `Fn` immediately followed by `[` is the removed type.
fn validate_removed_callable_notation(source: Text) -> Text {
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        if token_text(source, cursor) == "Fn" &&
           token_kind(source, cursor) == "identifier" {
            let bracket = skip_trivia(source, token_end(source, cursor))
            if bracket < len(source) && token_text(source, bracket) == "[" {
                let rewrite = removed_callable_rewrite(source, bracket)
                if len(rewrite) > 0 {
                    return "error[E2S97]: `Fn[...]` is not a callable type at byte " +
                    to_text(cursor) + "; write `" + rewrite + "`"
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return "ok"
}

# Whether `target` is a whole argument of a call.
#
# A bare function name is a value only here. Restricting it to argument
# position is what keeps `double + 1` an ordinary unknown-binding error: a
# function name that reached the Int expression grammar would lower to a
# function address inside integer arithmetic and surface as a C type error
# instead of a Kofun diagnostic.
#
# Two conditions, and both are needed. The token before `target` opens or
# continues an argument list — a `(` that itself follows an identifier, so a
# parenthesised group does not qualify, or a `,`. And the token after `target`
# closes or continues it, so `double` in `print(double + 1)` is excluded while
# `double` in `apply(double, 21)` is not.
fn call_argument_position(source: Text, target: Int) -> Bool {
    let mut cursor = skip_trivia(source, 0)
    let mut previous = -1
    let mut before_previous = -1
    while cursor < target && cursor < len(source) {
        before_previous = previous
        previous = cursor
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    if cursor != target || previous < 0 {
        return false
    }
    let after = skip_trivia(source, token_end(source, target))
    if after >= len(source) {
        return false
    }
    if token_text(source, after) != "," && token_text(source, after) != ")" {
        return false
    }
    if token_text(source, previous) == "(" {
        return before_previous >= 0 &&
        token_kind(source, before_previous) == "identifier"
    }
    return token_text(source, previous) == ","
}

# The byte after an argument, which is either an ordinary bounded expression or
# an arrow lambda passed directly.
#
# Only argument position needs this. An argument's preceding token is `(` or
# `,`, never an identifier, so the constructor-pattern ambiguity that
# `lambda_parameters_end` guards with its `previous` parameter cannot arise
# here and -1 is the correct `previous` to pass.
fn argument_end(source: Text, start: Int) -> Int {
    let lambda_end = lambda_parameters_end(source, -1, start)
    if lambda_end >= 0 {
        return lambda_end
    }
    let label = skip_trivia(source, start)
    if token_text(source, label) == "true" ||
       token_text(source, label) == "false" {
        let primary = token_end(source, label)
        let dot = skip_trivia(source, primary)
        let mut name = -1
        if dot < len(source) && token_text(source, dot) == "." {
            name = skip_trivia(source, token_end(source, dot))
        }
        let mut open = -1
        if name >= 0 {
            open = skip_trivia(source, token_end(source, name))
        }
        if name >= 0 && int_bit_method_arity_at(source, name) >= 0 &&
           open < len(source) && token_text(source, open) == "(" {
            return int_bit_postfix_end(source, primary)
        }
        return primary
    }
    if parameter_word_token(source, label) {
        let colon = skip_trivia(source, token_end(source, label))
        if token_text(source, colon) == ":" {
            let value = skip_trivia(source, token_end(source, colon))
            if token_text(source, value) == "true" ||
               token_text(source, value) == "false" {
                return token_end(source, value)
            }
            return expression_end(source, value)
        }
    }
    return expression_end(source, start)
}

# Expected type or ownership mode of the call argument beginning exactly at
# `target`. Enum constructors are calls themselves, so this walks the enclosing
# named call instead of relying on the single-token function-value predicate
# above. One slot lookup serves both properties so labelled binding cannot
# disagree between lowering and semantic `take` validation.
fn call_argument_parameter_property(
    source: Text,
    target: Int,
    property: Text
) -> Text {
    let mut cursor = skip_trivia(source, 0)
    while cursor < target && cursor < len(source) {
        if token_kind(source, cursor) == "identifier" {
            let open = skip_trivia(source, token_end(source, cursor))
            if open < target && token_text(source, open) == "(" {
                let close = balanced_end(source, open, "(", ")")
                if close > target {
                    let mut argument = skip_trivia(
                        source,
                        token_end(source, open)
                    )
                    let mut positional_index = 0
                    let mut scanning = true
                    while scanning && argument < close &&
                          token_text(source, argument) != ")" {
                        let mut label = 0 - 1
                        let mut value = argument
                        if parameter_word_token(source, argument) {
                            let colon = skip_trivia(
                                source,
                                token_end(source, argument)
                            )
                            if colon < close &&
                               token_text(source, colon) == ":" {
                                label = argument
                                value = skip_trivia(
                                    source,
                                    token_end(source, colon)
                                )
                            }
                        }
                        if argument == target || value == target {
                            # Whether this argument was written with a label is
                            # decided by the same walk that resolves its slot,
                            # so the ownership rule and the slot it names can
                            # never disagree about which argument matched.
                            if property == "labelled" {
                                if label >= 0 {
                                    return "yes"
                                }
                                return "no"
                            }
                            let callee = token_text(source, cursor)
                            let mut slot = positional_index
                            if label >= 0 {
                                let declaration = function_start_named(
                                    source,
                                    callee
                                )
                                let parameters = parameter_open(
                                    source,
                                    declaration
                                )
                                let parameters_end = balanced_end(
                                    source,
                                    parameters,
                                    "(",
                                    ")"
                                )
                                let count = parameter_count(
                                    source,
                                    declaration
                                )
                                slot = 0
                                let mut matching = true
                                while matching && slot < count {
                                    let parameter = function_parameter_start_at(
                                        source,
                                        declaration,
                                        slot
                                    )
                                    let external = parameter_external_start(
                                        source,
                                        parameter,
                                        parameters_end
                                    )
                                    if external >= 0 &&
                                       token_text(source, external) ==
                                       token_text(source, label) {
                                        matching = false
                                    } else {
                                        slot = slot + 1
                                    }
                                }
                            }
                            if property == "mode" {
                                return function_parameter_mode(
                                    source,
                                    callee,
                                    slot
                                )
                            }
                            return function_parameter_type(
                                source,
                                callee,
                                slot
                            )
                        }
                        let argument_close = argument_end(
                            source,
                            argument
                        )
                        if argument_close < 0 {
                            scanning = false
                        } else {
                            let separator = skip_trivia(
                                source,
                                argument_close
                            )
                            if separator < close &&
                               token_text(source, separator) == "," {
                                argument = skip_trivia(
                                    source,
                                    token_end(source, separator)
                                )
                                if label < 0 {
                                    positional_index = positional_index + 1
                                }
                            } else {
                                scanning = false
                            }
                        }
                    }
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return ""
}

fn call_argument_expected_type(source: Text, target: Int) -> Text {
    return call_argument_parameter_property(source, target, "type")
}

fn call_argument_expected_mode(source: Text, target: Int) -> Text {
    return call_argument_parameter_property(source, target, "mode")
}

fn call_argument_labelled(source: Text, target: Int) -> Text {
    return call_argument_parameter_property(source, target, "labelled")
}

# #924 Optional(Int) source judgements. The C seed memoizes the annotation
# scan by source address; canonical Kofun has no process-global cache, so it
# performs the same bounded token walk directly.
fn optional_int_type_end(source: Text, type_start: Int) -> Int {
    if type_start >= len(source) || token_text(source, type_start) != "Int" {
        return -1
    }
    let suffix = skip_trivia(source, token_end(source, type_start))
    if suffix >= len(source) || token_text(source, suffix) != "?" {
        return -1
    }
    return token_end(source, suffix)
}

fn scan_optional_int_annotation(source: Text) -> Bool {
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        if token_text(source, cursor) == "??" {
            return true
        }
        if token_text(source, cursor) == ":" ||
           token_text(source, cursor) == "->" {
            let type_start = skip_trivia(source, token_end(source, cursor))
            if token_text(source, type_start) == "Int" {
                let suffix = skip_trivia(source, token_end(source, type_start))
                if token_text(source, suffix) == "?" ||
                   token_text(source, suffix) == "??" {
                    return true
                }
            }
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            break
        }
        cursor = skip_trivia(source, next)
    }
    return false
}

fn source_uses_optional_int(source: Text) -> Bool {
    return scan_optional_int_annotation(source)
}

fn optional_int_function_start(source: Text, position: Int) -> Int {
    let mut cursor = next_function_start(source, 0)
    while cursor < len(source) {
        let end = function_end(source, cursor)
        if position >= cursor && position < end {
            return cursor
        }
        if end <= cursor {
            break
        }
        cursor = next_function_start(source, end)
    }
    return -1
}

fn optional_int_result_at(source: Text, function_start: Int) -> Bool {
    let open = parameter_open(source, function_start)
    if open < 0 {
        return false
    }
    let close = balanced_end(source, open, "(", ")")
    if close < 0 {
        return false
    }
    let arrow = skip_trivia(source, close)
    if arrow >= len(source) || token_text(source, arrow) != "->" {
        return false
    }
    return optional_int_type_end(
        source,
        skip_trivia(source, token_end(source, arrow))
    ) >= 0
}

fn optional_int_result(source: Text, wanted: Text) -> Bool {
    let mut cursor = next_function_start(source, 0)
    while cursor < len(source) {
        if function_name(source, cursor) == wanted {
            return optional_int_result_at(source, cursor)
        }
        let end = function_end(source, cursor)
        if end <= cursor {
            break
        }
        cursor = next_function_start(source, end)
    }
    return false
}

fn optional_int_result_containing(source: Text, position: Int) -> Bool {
    let function_start = optional_int_function_start(source, position)
    return function_start >= 0 &&
           optional_int_result_at(source, function_start)
}

fn optional_int_binding(source: Text, position: Int, name: Text) -> Bool {
    if !source_uses_optional_int(source) {
        return false
    }
    let function_start = optional_int_function_start(source, position)
    if function_start < 0 {
        return false
    }
    let open = parameter_open(source, function_start)
    if open < 0 {
        return false
    }
    let close = balanced_end(source, open, "(", ")")
    if close < 0 {
        return false
    }
    let mut parameter = skip_trivia(source, token_end(source, open))
    while parameter < close && token_text(source, parameter) != ")" {
        let internal = parameter_internal_start(source, parameter, close)
        let type_start = parameter_type_start(source, parameter, close)
        if internal < 0 || type_start < 0 {
            break
        }
        let mut type_end = optional_int_type_end(source, type_start)
        if type_end >= 0 && token_text(source, internal) == name {
            return true
        }
        if type_end < 0 {
            type_end = token_end(source, type_start)
        }
        let separator = skip_trivia(source, type_end)
        if separator >= close || token_text(source, separator) != "," {
            break
        }
        parameter = skip_trivia(source, token_end(source, separator))
    }
    let function_close = function_end(source, function_start)
    let mut cursor = skip_trivia(source, close)
    while cursor < function_close {
        if token_text(source, cursor) == "let" {
            let mut binding = skip_trivia(source, token_end(source, cursor))
            if token_text(source, binding) == "mut" {
                binding = skip_trivia(source, token_end(source, binding))
            }
            let colon = skip_trivia(source, token_end(source, binding))
            if token_text(source, colon) == ":" &&
               optional_int_type_end(
                   source,
                   skip_trivia(source, token_end(source, colon))
               ) >= 0 && token_text(source, binding) == name {
                return true
            }
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            break
        }
        cursor = skip_trivia(source, next)
    }
    return false
}

fn optional_int_carrier_position(source: Text, at: Int) -> Bool {
    if !source_uses_optional_int(source) {
        return false
    }
    return call_argument_expected_type(source, at) == "Int?"
}

# Kofun returns the binding position separately because this source profile
# has no out-parameters. The C transliteration's OptionalCondition values map
# to 0 (none), 1 (present on the true edge), and 2 (absent on the true edge).
fn optional_int_condition_binding(source: Text, start: Int, end: Int) -> Int {
    let left = skip_trivia(source, start)
    if left >= end {
        return -1
    }
    let operator_start = skip_trivia(source, token_end(source, left))
    if operator_start >= end ||
       (token_text(source, operator_start) != "!=" &&
        token_text(source, operator_start) != "==") {
        return -1
    }
    let right = skip_trivia(source, token_end(source, operator_start))
    if right >= end || skip_trivia(source, token_end(source, right)) < end {
        return -1
    }
    let mut name_at = -1
    if token_text(source, left) == "null" {
        name_at = right
    } else {
        if token_text(source, right) == "null" {
            name_at = left
        }
    }
    if name_at < 0 || token_text(source, name_at) == "null" ||
       token_kind(source, name_at) != "identifier" {
        return -1
    }
    let name = token_text(source, name_at)
    if !optional_int_binding(source, name_at, name) {
        return -1
    }
    return name_at
}

fn optional_int_condition(source: Text, start: Int, end: Int) -> Int {
    if optional_int_condition_binding(source, start, end) < 0 {
        return 0
    }
    let left = skip_trivia(source, start)
    let operator_start = skip_trivia(source, token_end(source, left))
    if token_text(source, operator_start) == "!=" {
        return 1
    }
    return 2
}

fn optional_int_block_returns(source: Text, block_open: Int) -> Bool {
    let close = balanced_end(source, block_open, "{", "}")
    if close < 0 {
        return false
    }
    let mut depth = 0
    let mut cursor = skip_trivia(source, token_end(source, block_open))
    while cursor < close {
        if token_text(source, cursor) == "{" {
            depth = depth + 1
        } else {
            if token_text(source, cursor) == "}" {
                depth = depth - 1
            } else {
                if depth == 0 && token_text(source, cursor) == "return" {
                    return true
                }
            }
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            break
        }
        cursor = skip_trivia(source, next)
    }
    return false
}

fn optional_int_refined(source: Text, name: Text, at: Int) -> Bool {
    let function_start = optional_int_function_start(source, at)
    if function_start < 0 {
        return false
    }
    let function_close = function_end(source, function_start)
    let mut cursor = skip_trivia(source, function_start)
    while cursor < function_close {
        if token_text(source, cursor) == "if" {
            let condition_start = skip_trivia(
                source,
                token_end(source, cursor)
            )
            let condition_close = condition_end(source, condition_start)
            let mut kind = 0
            let mut name_at = -1
            if condition_close >= 0 {
                kind = optional_int_condition(
                    source,
                    condition_start,
                    condition_close
                )
                name_at = optional_int_condition_binding(
                    source,
                    condition_start,
                    condition_close
                )
            }
            if kind != 0 && token_text(source, name_at) == name {
                let branch_open = skip_trivia(source, condition_close)
                let mut branch_close = -1
                if branch_open < function_close &&
                   token_text(source, branch_open) == "{" {
                    branch_close = balanced_end(
                        source,
                        branch_open,
                        "{",
                        "}"
                    )
                }
                if branch_close > 0 {
                    let after = skip_trivia(source, token_end(source, branch_close))
                    let has_else = after < function_close &&
                                   token_text(source, after) == "else"
                    let mut else_open = -1
                    if has_else {
                        else_open = skip_trivia(source, token_end(source, after))
                    }
                    let mut else_close = -1
                    if else_open >= 0 && else_open < function_close &&
                       token_text(source, else_open) == "{" {
                        else_close = balanced_end(source, else_open, "{", "}")
                    }
                    if kind == 1 {
                        if at > branch_open && at < branch_close {
                            return true
                        }
                    } else {
                        if else_close > 0 && at > else_open && at < else_close {
                            return true
                        }
                        if !has_else &&
                           optional_int_block_returns(source, branch_open) &&
                           at >= token_end(source, branch_close) {
                            return true
                        }
                    }
                }
            }
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            break
        }
        cursor = skip_trivia(source, next)
    }
    return false
}

fn optional_int_coalescing_left_site(source: Text, at: Int) -> Bool {
    let mut cursor = skip_trivia(source, 0)
    while cursor <= at && cursor < len(source) {
        let left_end = arithmetic_expression_end(source, cursor)
        if left_end >= 0 {
            let operator_start = skip_trivia(source, left_end)
            if operator_start < len(source) &&
               token_text(source, operator_start) == "??" {
                let inner_start = optional_int_coalescing_transparent_bound(
                    source,
                    cursor,
                    left_end,
                    true
                )
                if inner_start == at {
                    return true
                }
            }
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            break
        }
        cursor = skip_trivia(source, next)
    }
    return false
}

fn optional_int_coalescing_null_context(source: Text, at: Int) -> Bool {
    return token_text(source, at) == "null" &&
        optional_int_coalescing_left_site(source, at)
}

fn optional_int_null_context(source: Text, at: Int) -> Bool {
    if token_text(source, at) != "null" {
        return false
    }
    if optional_int_coalescing_null_context(source, at) {
        return true
    }
    let function_start = optional_int_function_start(source, at)
    if function_start < 0 {
        return false
    }
    let function_close = function_end(source, function_start)
    let optional_result = optional_int_result_at(source, function_start)
    let mut cursor = skip_trivia(source, function_start)
    while cursor < function_close {
        if token_text(source, cursor) == "let" {
            let mut binding = skip_trivia(source, token_end(source, cursor))
            if token_text(source, binding) == "mut" {
                binding = skip_trivia(source, token_end(source, binding))
            }
            let colon = skip_trivia(source, token_end(source, binding))
            let mut annotation_end = -1
            if token_text(source, colon) == ":" {
                annotation_end = optional_int_type_end(
                    source,
                    skip_trivia(source, token_end(source, colon))
                )
            }
            let mut assign = -1
            if annotation_end >= 0 {
                assign = skip_trivia(source, annotation_end)
            }
            if assign >= 0 && token_text(source, assign) == "=" {
                let value = skip_trivia(source, token_end(source, assign))
                if value == at &&
                   skip_trivia(source, token_end(source, at)) >=
                       expression_end(source, value) {
                    return true
                }
            }
        } else {
            if token_text(source, cursor) == "if" ||
               token_text(source, cursor) == "while" {
                let condition_start = skip_trivia(
                    source,
                    token_end(source, cursor)
                )
                let condition_close = condition_end(source, condition_start)
                let name_at = optional_int_condition_binding(
                    source,
                    condition_start,
                    condition_close
                )
                if condition_close >= 0 && name_at >= 0 &&
                   at >= condition_start && at < condition_close &&
                   at != name_at {
                    return true
                }
            } else {
                if optional_result && token_text(source, cursor) == "return" {
                    let value = skip_trivia(source, token_end(source, cursor))
                    if value == at &&
                       skip_trivia(source, token_end(source, at)) >=
                           expression_end(source, value) {
                        return true
                    }
                }
            }
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            break
        }
        cursor = skip_trivia(source, next)
    }
    return false
}

fn emit_optional_int_c_declarations() -> Text {
    return "typedef struct {\n" +
        "    uint8_t tag;\n" +
        "    int64_t payload;\n" +
        "} KofunOptionalInt;\n" +
        "_Static_assert(offsetof(KofunOptionalInt, tag) == 0,\n" +
        "    \"AggregateLayout Optional[Int] tag offset\");\n" +
        "_Static_assert(sizeof(((KofunOptionalInt *)0)->tag) == 1,\n" +
        "    \"AggregateLayout Optional[Int] tag width\");\n" +
        "_Static_assert(offsetof(KofunOptionalInt, payload) == 8,\n" +
        "    \"AggregateLayout Optional[Int] payload offset\");\n" +
        "_Static_assert(sizeof(((KofunOptionalInt *)0)->payload) == 8,\n" +
        "    \"AggregateLayout Optional[Int] payload size\");\n" +
        "_Static_assert(sizeof(KofunOptionalInt) == 16,\n" +
        "    \"AggregateLayout Optional[Int] size\");\n" +
        "_Static_assert(_Alignof(KofunOptionalInt) == 8,\n" +
        "    \"AggregateLayout Optional[Int] alignment\");\n" +
        "#define KOFUN_OPTIONAL_INT_NONE_TAG UINT8_C(0)\n" +
        "#define KOFUN_OPTIONAL_INT_SOME_TAG UINT8_C(1)\n" +
        "#define KOFUN_OPTIONAL_INT_NONE " +
        "((KofunOptionalInt){KOFUN_OPTIONAL_INT_NONE_TAG, INT64_C(0)})\n" +
        "#define KOFUN_OPTIONAL_INT_SOME(value) " +
        "((KofunOptionalInt){KOFUN_OPTIONAL_INT_SOME_TAG, (value)})\n\n"
}

fn optional_int_declaration_count(
    source: Text,
    position: Int,
    name: Text
) -> Int {
    let function_start = optional_int_function_start(source, position)
    if function_start < 0 {
        return 0
    }
    let open = parameter_open(source, function_start)
    if open < 0 {
        return 0
    }
    let close = balanced_end(source, open, "(", ")")
    if close < 0 {
        return 0
    }
    let mut count = 0
    let mut parameter = skip_trivia(source, token_end(source, open))
    while parameter < close && token_text(source, parameter) != ")" {
        if token_text(source, parameter) == name {
            count = count + 1
        }
        let colon = skip_trivia(source, token_end(source, parameter))
        if colon >= close || token_text(source, colon) != ":" {
            break
        }
        let type_start = skip_trivia(source, token_end(source, colon))
        let mut type_end = optional_int_type_end(source, type_start)
        if type_end < 0 {
            type_end = token_end(source, type_start)
        }
        let separator = skip_trivia(source, type_end)
        if separator >= close || token_text(source, separator) != "," {
            break
        }
        parameter = skip_trivia(source, token_end(source, separator))
    }
    let function_close = function_end(source, function_start)
    let mut cursor = skip_trivia(source, close)
    while cursor < function_close {
        if token_text(source, cursor) == "let" {
            let mut binding = skip_trivia(source, token_end(source, cursor))
            if token_text(source, binding) == "mut" {
                binding = skip_trivia(source, token_end(source, binding))
            }
            if token_text(source, binding) == name {
                count = count + 1
            }
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            break
        }
        cursor = skip_trivia(source, next)
    }
    return count
}

fn validate_optional_uses(source: Text) -> Text {
    if !source_uses_optional_int(source) {
        return "ok"
    }
    let mut scan = skip_trivia(source, 0)
    while scan < len(source) {
        if token_text(source, scan) == ":" ||
           token_text(source, scan) == "->" {
            let type_start = skip_trivia(source, token_end(source, scan))
            let type_end = optional_int_type_end(source, type_start)
            let mut after_type = -1
            if type_end >= 0 {
                after_type = skip_trivia(source, type_end)
            } else {
                if token_text(source, type_start) == "Int" {
                    after_type = skip_trivia(
                        source,
                        token_end(source, type_start)
                    )
                }
            }
            if after_type >= 0 &&
               (token_text(source, after_type) == "?" ||
                token_text(source, after_type) == "??") {
                return lower_error(
                    "E2S147",
                    "one optional layer is supported; `Int??` is not a " +
                    "type in this contract",
                    type_start
                )
            }
        }
        let step = token_end(source, scan)
        if step <= scan {
            break
        }
        scan = skip_trivia(source, step)
    }
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let parameters = parameter_open(source, function_start)
        let mut parameters_close = -1
        if parameters >= 0 {
            parameters_close = balanced_end(source, parameters, "(", ")")
        }
        if parameters_close < 0 {
            if function_close <= function_start {
                break
            }
            function_start = next_function_start(source, function_close)
            continue
        }
        let mut body_open = skip_trivia(source, parameters_close)
        while body_open < function_close &&
              token_text(source, body_open) != "{" {
            let step = token_end(source, body_open)
            if step <= body_open {
                break
            }
            body_open = skip_trivia(source, step)
        }
        let mut carrier = -1
        let mut cursor = function_close
        if body_open < function_close {
            cursor = skip_trivia(source, token_end(source, body_open))
        }
        while cursor < function_close {
            if token_text(source, cursor) == "let" {
                let mut binding = skip_trivia(source, token_end(source, cursor))
                let mutable = token_text(source, binding) == "mut"
                if mutable {
                    binding = skip_trivia(source, token_end(source, binding))
                }
                let colon = skip_trivia(source, token_end(source, binding))
                let mut annotation = -1
                if token_text(source, colon) == ":" {
                    annotation = skip_trivia(source, token_end(source, colon))
                }
                let mut annotation_end = -1
                if annotation >= 0 {
                    annotation_end = optional_int_type_end(source, annotation)
                }
                if annotation_end >= 0 {
                    if mutable {
                        return lower_error(
                            "E2S147",
                            "mutable `Int?` bindings are outside this " +
                            "lowering slice; declare `let` and construct a " +
                            "new value instead",
                            binding
                        )
                    }
                    let declared = token_text(source, binding)
                    if optional_int_declaration_count(
                        source,
                        binding,
                        declared
                    ) > 1 {
                        return lower_error(
                            "E2S147",
                            "an `Int?` binding may not be declared twice " +
                            "in one function in this lowering slice",
                            binding
                        )
                    }
                    let assign = skip_trivia(source, annotation_end)
                    let mut value = -1
                    if token_text(source, assign) == "=" {
                        value = skip_trivia(source, token_end(source, assign))
                    }
                    if value >= 0 &&
                       token_kind(source, value) == "identifier" {
                        carrier = value
                    }
                    if value >= 0 {
                        cursor = value
                    } else {
                        cursor = skip_trivia(source, colon)
                    }
                    continue
                }
            }
            if token_text(source, cursor) == "if" ||
               token_text(source, cursor) == "while" {
                let condition_start = skip_trivia(
                    source,
                    token_end(source, cursor)
                )
                let condition_close = condition_end(source, condition_start)
                if condition_close >= 0 && optional_int_condition(
                    source,
                    condition_start,
                    condition_close
                ) != 0 {
                    carrier = optional_int_condition_binding(
                        source,
                        condition_start,
                        condition_close
                    )
                }
            } else {
                if token_text(source, cursor) == "return" &&
                   optional_int_result_containing(source, function_start) {
                    let value = skip_trivia(source, token_end(source, cursor))
                    if value < function_close &&
                       token_kind(source, value) == "identifier" {
                        carrier = value
                    }
                } else {
                    if token_kind(source, cursor) == "identifier" {
                        let name = token_text(source, cursor)
                        let after = skip_trivia(source, token_end(source, cursor))
                        let call = after < function_close &&
                                   token_text(source, after) == "("
                        let optional = !call &&
                            optional_int_binding(source, cursor, name)
                        let bit_expression = int_bit_expression_contains(
                            source,
                            cursor
                        )
                        if call && optional_int_result(source, name) {
                            if !bit_expression && cursor != carrier &&
                               !optional_int_coalescing_left_site(
                                   source,
                                   cursor
                               ) {
                                return lower_error(
                                    "E2S147",
                                    "an `Int?` result is used whole; bind " +
                                    "it with `let ...: Int?` or return it " +
                                    "from a function declared `Int?`",
                                    cursor
                                )
                            }
                        } else {
                            if optional && !bit_expression {
                                if optional_int_declaration_count(
                                    source,
                                    cursor,
                                    name
                                ) > 1 {
                                    return lower_error(
                                        "E2S147",
                                        "an `Int?` binding may not be " +
                                        "declared twice in one function in " +
                                        "this lowering slice",
                                        cursor
                                    )
                                }
                                if after < function_close &&
                                   token_text(source, after) == "=" {
                                    return lower_error(
                                        "E2S147",
                                        "an `Int?` binding is immutable in " +
                                        "this lowering slice and cannot be " +
                                        "assigned",
                                        cursor
                                    )
                                }
                                if after < function_close &&
                                   (token_text(source, after) == "." ||
                                    token_text(source, after) == "[") {
                                    return lower_error(
                                        "E2S147",
                                        "property and index paths on an " +
                                        "`Int?` binding are not narrowed; " +
                                        "only a direct `null` comparison " +
                                        "is recognized",
                                        cursor
                                    )
                                }
                                if cursor != carrier &&
                                   !optional_int_coalescing_left_site(
                                       source,
                                       cursor
                                   ) &&
                                   !optional_int_carrier_position(
                                       source,
                                       cursor
                                   ) &&
                                   !optional_int_refined(source, name, cursor) {
                                    return lower_error(
                                        "E2S147",
                                        "`" + name + "` is `Int?`; narrow " +
                                        "it with a `null` comparison before " +
                                        "using it as `Int`",
                                        cursor
                                    )
                                }
                            }
                        }
                    }
                }
            }
            let next = token_end(source, cursor)
            if next <= cursor {
                break
            }
            cursor = skip_trivia(source, next)
        }
        if function_close <= function_start {
            break
        }
        function_start = next_function_start(source, function_close)
    }
    return "ok"
}

fn optional_int_value(
    source: Text,
    hir: Text,
    start: Int,
    end: Int
) -> Text {
    let cursor = optional_int_coalescing_transparent_bound(
        source,
        start,
        end,
        true
    )
    let value_end = optional_int_coalescing_transparent_bound(
        source,
        start,
        end,
        false
    )
    let single = skip_trivia(source, token_end(source, cursor)) >= value_end
    if single && token_text(source, cursor) == "null" {
        return "KOFUN_OPTIONAL_INT_NONE"
    }
    if token_kind(source, cursor) == "identifier" {
        let name = token_text(source, cursor)
        if single && optional_int_binding(source, cursor, name) {
            return "k_b" + hir_use_binding_id(hir, cursor)
        }
        let open = skip_trivia(source, token_end(source, cursor))
        if open < value_end && token_text(source, open) == "(" &&
           optional_int_result(source, name) {
            let close = balanced_end(source, open, "(", ")")
            if close < 0 || skip_trivia(source, close) < value_end {
                return lower_error(
                    "E2S147",
                    "an `Int?` call result is used whole; it takes part in " +
                    "no arithmetic in this lowering slice",
                    cursor
                )
            }
            return emit_expression(source, hir, cursor, value_end)
        }
    }
    let function_open = enclosing_function_open(source, cursor)
    let value_type = initializer_type(source, hir, function_open, cursor)
    let present = value_type == "Int" || (!single && value_type == "Int?")
    if !present {
        return lower_error(
            "E2S147",
            "an `Int?` value is `null`, an `Int`, another `Int?` binding, " +
            "or a call returning `Int?`",
            cursor
        )
    }
    let inner = emit_expression(source, hir, cursor, value_end)
    if starts_with(inner, "error[") {
        return inner
    }
    return "KOFUN_OPTIONAL_INT_SOME(" + inner + ")"
}

fn optional_int_coalescing_left(
    source: Text,
    start: Int,
    end: Int
) -> Bool {
    let cursor = optional_int_coalescing_transparent_bound(
        source,
        start,
        end,
        true
    )
    let value_end = optional_int_coalescing_transparent_bound(
        source,
        start,
        end,
        false
    )
    let single = skip_trivia(source, token_end(source, cursor)) >= value_end
    if single && token_text(source, cursor) == "null" {
        return true
    }
    if token_kind(source, cursor) != "identifier" {
        return false
    }
    let name = token_text(source, cursor)
    if single && optional_int_binding(source, cursor, name) {
        return true
    }
    let open = skip_trivia(source, token_end(source, cursor))
    if open >= value_end || token_text(source, open) != "(" ||
       !optional_int_result(source, name) {
        return false
    }
    let close = balanced_end(source, open, "(", ")")
    return close >= 0 && skip_trivia(source, close) >= value_end
}

fn validate_optional_int_coalescing(source: Text, hir: Text) -> Text {
    let mut last_operator = -1
    let mut cursor = skip_trivia(source, 0)
    let mut previous = -1
    while cursor < len(source) {
        let left_end = arithmetic_expression_end(source, cursor)
        let mut operator_start = -1
        if left_end >= 0 {
            operator_start = skip_trivia(source, left_end)
        }
        let type_position = previous >= 0 &&
            (token_text(source, previous) == ":" ||
             token_text(source, previous) == "->")
        if !type_position &&
           operator_start >= 0 && operator_start < len(source) &&
           operator_start != last_operator &&
           token_text(source, operator_start) == "??" {
            last_operator = operator_start
            if !optional_int_coalescing_left(source, cursor, left_end) {
                return lower_error(
                    "E2S147",
                    "left operand of `??` must be `Int?`; this slice " +
                    "accepts `null`, a direct `Int?` binding, or a call " +
                    "returning `Int?`",
                    cursor
                )
            }
            let right_start = skip_trivia(
                source,
                token_end(source, operator_start)
            )
            let right_end = arithmetic_expression_end(source, right_start)
            if right_end < 0 {
                return lower_error(
                    "E2S147",
                    "`??` requires one `Int` fallback expression",
                    operator_start
                )
            }
            let after = skip_trivia(source, right_end)
            if after < len(source) && token_text(source, after) == "??" {
                return lower_error(
                    "E2S147",
                    "chained `??` is outside the Optional(Int) coalescing " +
                    "slice; bind the first result before coalescing again",
                    after
                )
            }
            let right_type = initializer_type_bounded(
                source,
                hir,
                enclosing_function_open(source, right_start),
                right_start,
                right_end
            )
            if right_type != "Int" {
                return lower_error(
                    "E2S147",
                    "right operand of `??` must be `Int`, got `" +
                    right_type + "`",
                    right_start
                )
            }
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            break
        }
        previous = cursor
        cursor = skip_trivia(source, next)
    }
    return "ok"
}

fn emit_optional_int_coalescing_temporaries(
    source: Text,
    function_open: Int
) -> Text {
    let close = balanced_end(source, function_open, "{", "}")
    if close < 0 {
        return ""
    }
    let mut emitted = ""
    let mut cursor = skip_trivia(source, token_end(source, function_open))
    while cursor < close {
        if token_text(source, cursor) == "??" {
            emitted = emitted + "    KofunOptionalInt " +
                "kofun_optional_int_coalesce_" + to_text(cursor) +
                " = KOFUN_OPTIONAL_INT_NONE;\n"
        }
        let next = token_end(source, cursor)
        if next <= cursor {
            break
        }
        cursor = skip_trivia(source, next)
    }
    return emitted
}

# `initializer_type` deliberately types an entire condition as Bool. Text
# comparison lowering needs only the left primary's type.
fn primary_is_text(source: Text, hir: Text, start: Int) -> Bool {
    return text_operand(
        source,
        hir,
        enclosing_function_open(source, start),
        start
    )
}

fn comparison_operator(token: Text) -> Bool {
    return token == "==" || token == "!=" || token == "<" ||
    token == "<=" || token == ">" || token == ">="
}

fn condition_end(source: Text, start: Int) -> Int {
    let cursor = skip_trivia(source, start)
    let first = token_text(source, cursor)
    if first == "true" || first == "false" {
        return token_end(source, cursor)
    }
    let left_end = expression_end(source, cursor)
    if left_end < 0 {
        return -1
    }
    let operator_start = skip_trivia(source, left_end)
    if operator_start >= len(source) ||
       !comparison_operator(token_text(source, operator_start)) {
        let member = skip_trivia(source, token_end(source, cursor))
        if member < left_end && token_text(source, member) == "." {
            return left_end
        }
        return -1
    }
    let right_start = skip_trivia(
        source,
        token_end(source, operator_start)
    )
    return expression_end(source, right_start)
}

fn emit_condition_into(
    source: Text,
    hir: Text,
    start: Int,
    end: Int,
    target: Text,
    failure_result: Text,
    indent: Text
) -> Text {
    let cursor = skip_trivia(source, start)
    let first = token_text(source, cursor)
    if first == "true" || first == "false" {
        return indent + "bool " + target + " = " + first + ";\n"
    }
    let optional = optional_int_condition(source, cursor, end)
    if optional != 0 {
        let binding_at = optional_int_condition_binding(source, cursor, end)
        let mut operator = "=="
        if optional == 1 {
            operator = "!="
        }
        return indent + "bool " + target + " = (k_b" +
        hir_use_binding_id(hir, binding_at) + ".tag " + operator +
        " KOFUN_OPTIONAL_INT_NONE_TAG);\n"
    }
    let left_end = expression_end(source, cursor)
    let operator_start = skip_trivia(source, left_end)
    if operator_start >= end ||
       !comparison_operator(token_text(source, operator_start)) {
        let bare = emit_expression(source, hir, cursor, left_end)
        # A rejected bare condition became the condition's C text.
        if starts_with(bare, "error[") {
            return bare
        }
        return indent + "bool " + target + " = " + bare + ";\n"
    }
    let right_start = skip_trivia(
        source,
        token_end(source, operator_start)
    )
    let left = emit_expression(source, hir, cursor, left_end)
    let right = emit_expression(source, hir, right_start, end)
    # A rejected comparison operand became the condition's C text.
    if starts_with(left, "error[") {
        return left
    }
    if starts_with(right, "error[") {
        return right
    }
    let operator = token_text(source, operator_start)
    let value_type = numeric_primary_type(
        source,
        hir,
        enclosing_function_open(source, cursor),
        cursor
    )
    if primary_is_text(source, hir, cursor) {
        let mut comparison = "== 0"
        if operator == "!=" {
            comparison = "!= 0"
        } else if operator == "<" {
            comparison = "< 0"
        } else if operator == "<=" {
            comparison = "<= 0"
        } else if operator == ">" {
            comparison = "> 0"
        } else if operator == ">=" {
            comparison = ">= 0"
        }
        return indent + "const char *kofun_condition_left = " + left +
        ";\n" + indent + "const char *kofun_condition_right = " + right +
        ";\n" + indent + "bool " + target + " = strcmp(" +
        "kofun_condition_left, kofun_condition_right) " + comparison +
        ";\n"
    }
    if value_type == "Decimal" {
        let mut comparison = "== 0"
        if operator == "!=" {
            comparison = "!= 0"
        } else if operator == "<" {
            comparison = "< 0"
        } else if operator == "<=" {
            comparison = "<= 0"
        } else if operator == ">" {
            comparison = "> 0"
        } else if operator == ">=" {
            comparison = ">= 0"
        }
        return indent + "KofunDecimal *kofun_condition_left = " + left +
        ";\n" + indent + "KofunDecimal *kofun_condition_right = " +
        right + ";\n" + indent + "bool " + target +
        " = kofun_decimal_compare(kofun_condition_left, " +
        "kofun_condition_right) " + comparison + ";\n"
    }
    if value_type == "Float" {
        return indent + "double kofun_condition_left = " + left + ";\n" +
        indent + "double kofun_condition_right = " + right + ";\n" +
        indent + "bool " + target + " = kofun_condition_left " +
        operator + " kofun_condition_right;\n"
    }
    return indent + "int64_t kofun_condition_left = " +
    left + ";\n" +
    indent + "if (kofun_failed) return " + failure_result + ";\n" +
    indent + "int64_t kofun_condition_right = " +
    right + ";\n" +
    indent + "if (kofun_failed) return " + failure_result + ";\n" +
    indent + "bool " + target + " = kofun_condition_left " +
    operator +
    " kofun_condition_right;\n"
}

fn value_if_branch_end(source: Text, start: Int) -> Int {
    return value_end(source, start)
}

fn value_if_end(source: Text, start: Int) -> Int {
    let condition_start = skip_trivia(source, token_end(source, start))
    let condition_close = condition_end(source, condition_start)
    let then_open = skip_trivia(source, condition_close)
    let then_start = skip_trivia(source, token_end(source, then_open))
    let then_end = value_if_branch_end(source, then_start)
    let then_close = skip_trivia(source, then_end)
    let else_keyword = skip_trivia(source, token_end(source, then_close))
    let else_open = skip_trivia(source, token_end(source, else_keyword))
    let else_start = skip_trivia(source, token_end(source, else_open))
    let else_end = value_if_branch_end(source, else_start)
    let else_close = skip_trivia(source, else_end)
    return token_end(source, else_close)
}

# The byte after the `{ ... }` that follows an `if` condition, or -1 when the
# shape is not a statement `if` at all. This is the walk the statement lowering
# performs; it exists separately so the lowering can ask where the construct
# ends *before* committing to lower it, which is what deciding whether an `if`
# is a body's last statement requires.
fn if_then_branch_end(source: Text, start: Int) -> Int {
    let condition_start = skip_trivia(source, token_end(source, start))
    let condition_close = condition_end(source, condition_start)
    if condition_close < 0 {
        return -1
    }
    let branch_open = skip_trivia(source, condition_close)
    if branch_open >= len(source) || token_text(source, branch_open) != "{" {
        return -1
    }
    return balanced_end(source, branch_open, "{", "}")
}

# Whether the `if` at `start` carries an `else` block. An `if` in final position
# without one cannot be the result: its false path produces nothing.
fn if_has_else(source: Text, start: Int) -> Bool {
    let branch_close = if_then_branch_end(source, start)
    if branch_close < 0 {
        return false
    }
    let else_keyword = skip_trivia(source, branch_close)
    return else_keyword < len(source) &&
    token_text(source, else_keyword) == "else"
}

# The byte after a statement-position `if`, counting its `else` block when one
# follows, or -1 when the shape is not a statement `if` at all.
fn if_statement_end(source: Text, start: Int) -> Int {
    let branch_close = if_then_branch_end(source, start)
    if branch_close < 0 {
        return -1
    }
    if !if_has_else(source, start) {
        return branch_close
    }
    let else_keyword = skip_trivia(source, branch_close)
    let else_open = skip_trivia(source, token_end(source, else_keyword))
    if else_open >= len(source) || token_text(source, else_open) != "{" {
        return -1
    }
    return balanced_end(source, else_open, "{", "}")
}

# Whether the `if` at `start` is the last statement of a body that owes its
# caller an Int result — the position where #550 makes it the function's value
# rather than a discarded statement. `main`, enum-returning, and
# record-returning functions are excluded: `main` appends its own status
# return, and an enum or record result needs its own C shape rather than the
# `int64_t` this position emits. A nested body (`append_default` false) is not
# a result position either; its own enclosing function decides that.
fn final_result_if(
    source: Text,
    start: Int,
    is_main: Bool,
    append_default: Bool,
    returns_enum: Bool,
    returns_record: Bool
) -> Bool {
    if is_main || !append_default || returns_enum || returns_record {
        return false
    }
    let close = if_statement_end(source, start)
    if close < 0 {
        return false
    }
    let after = skip_trivia(source, close)
    return after < len(source) && token_text(source, after) == "}"
}

fn value_match_end(source: Text, start: Int) -> Int {
    let cursor = skip_trivia(source, start)
    let value_start = skip_trivia(source, token_end(source, cursor))
    let value_close = condition_end(source, value_start)
    if value_close < 0 {
        # A concrete-enum scrutinee is one identifier, which is not a Bool
        # condition, so `condition_end` cannot find its end. The arms still
        # open at the `{` directly after it, which is the walk statement
        # position already uses; `enum_match_end` still answers -1 when no
        # `{` follows, so a genuinely malformed match is unchanged.
        return enum_match_end(source, cursor)
    }
    let arms_open = skip_trivia(source, value_close)
    if arms_open >= len(source) || token_text(source, arms_open) != "{" {
        return -1
    }
    return balanced_end(source, arms_open, "{", "}")
}

fn value_end(source: Text, start: Int) -> Int {
    let cursor = skip_trivia(source, start)
    let first = token_text(source, cursor)
    if first == "if" {
        return value_if_end(source, cursor)
    }
    if first == "match" {
        return value_match_end(source, cursor)
    }
    return expression_end(source, cursor)
}

fn validate_value_if(source: Text, hir: Text, start: Int) -> Text {
    let cursor = skip_trivia(source, start)
    if cursor >= len(source) || token_text(source, cursor) != "if" {
        return "error[E2S28]: expected value-position `if` at byte " +
        to_text(cursor)
    }
    let condition_start = skip_trivia(source, token_end(source, cursor))
    let condition_close = condition_end(source, condition_start)
    if condition_close < 0 {
        return "error[E2S23]: if condition must be Bool or an Int comparison at byte " +
        to_text(condition_start)
    }
    let then_open = skip_trivia(source, condition_close)
    if then_open >= len(source) || token_text(source, then_open) != "{" {
        return "error[E2S18]: expected `{` after if condition at byte " +
        to_text(then_open)
    }
    let then_start = skip_trivia(source, token_end(source, then_open))
    let mut then_end = -1
    if token_text(source, then_start) == "if" {
        let nested_result = validate_value_if(source, hir, then_start)
        if starts_with(nested_result, "error[") {
            return nested_result
        }
        then_end = value_if_end(source, then_start)
    } else if token_text(source, then_start) == "match" {
        let nested_result = validate_value_match(source, hir, then_start)
        if starts_with(nested_result, "error[") {
            return nested_result
        }
        then_end = value_match_end(source, then_start)
    } else {
        if token_text(source, then_start) == "print" {
            return "error[E2S28]: value-position if branch must produce Int, not Void at byte " +
            to_text(then_start)
        }
        then_end = expression_end(source, then_start)
        if then_end < 0 {
            return "error[E2S28]: value-position if branch must produce Int at byte " +
            to_text(then_start)
        }
    }
    let then_close = skip_trivia(source, then_end)
    if then_close >= len(source) || token_text(source, then_close) != "}" {
        return "error[E2S28]: value-position if branch must contain one final Int expression at byte " +
        to_text(then_close)
    }
    let else_keyword = skip_trivia(source, token_end(source, then_close))
    if else_keyword >= len(source) ||
       token_text(source, else_keyword) != "else" {
        return "error[E2S27]: value-position if requires `else` at byte " +
        to_text(else_keyword)
    }
    let else_open = skip_trivia(source, token_end(source, else_keyword))
    if else_open >= len(source) || token_text(source, else_open) != "{" {
        return "error[E2S18]: expected `{` after `else` at byte " +
        to_text(else_open)
    }
    let else_start = skip_trivia(source, token_end(source, else_open))
    let mut else_end = -1
    if token_text(source, else_start) == "if" {
        let nested_result = validate_value_if(source, hir, else_start)
        if starts_with(nested_result, "error[") {
            return nested_result
        }
        else_end = value_if_end(source, else_start)
    } else if token_text(source, else_start) == "match" {
        let nested_result = validate_value_match(source, hir, else_start)
        if starts_with(nested_result, "error[") {
            return nested_result
        }
        else_end = value_match_end(source, else_start)
    } else {
        if token_text(source, else_start) == "print" {
            return "error[E2S28]: value-position if branch must produce Int, not Void at byte " +
            to_text(else_start)
        }
        else_end = expression_end(source, else_start)
        if else_end < 0 {
            return "error[E2S28]: value-position if branch must produce Int at byte " +
            to_text(else_start)
        }
    }
    let else_close = skip_trivia(source, else_end)
    if else_close >= len(source) || token_text(source, else_close) != "}" {
        return "error[E2S28]: value-position if branch must contain one final Int expression at byte " +
        to_text(else_close)
    }
    return "ok"
}

# The enum a value-position `match` scrutinises, or "" when it does not
# scrutinise one. The shape is the one statement position already recognises —
# a single identifier directly followed by the arms `{` — and the type comes
# from resolution rather than spelling, so a Bool or Int binding still falls
# through to the Bool rules and earns exactly the diagnostic it earned before.
fn value_match_enum_type(source: Text, hir: Text, start: Int) -> Text {
    let value_start = skip_trivia(source, token_end(source, start))
    if value_start >= len(source) ||
       token_kind(source, value_start) != "identifier" {
        return ""
    }
    let arms_open = skip_trivia(source, token_end(source, value_start))
    if arms_open >= len(source) || token_text(source, arms_open) != "{" {
        return ""
    }
    let binding_id = hir_use_binding_id(hir, value_start)
    let binding_type = hir_binding_field(hir, binding_id, 5)
    if len(binding_type) == 0 || binding_type == "Int" ||
       enum_constructor_count(source, binding_type) < 0 {
        return ""
    }
    return binding_type
}

# One arm block of a value-position `match` must hold exactly one final Int
# expression, the same rule a value `if` branch follows. `E2S30` is the whole
# vocabulary, so a Bool scrutinee and an enum scrutinee refuse identically.
fn validate_value_arm(source: Text, hir: Text, arm_open: Int) -> Text {
    let arm_start = skip_trivia(source, token_end(source, arm_open))
    let mut arm_end = -1
    if token_text(source, arm_start) == "if" {
        let arm_result = validate_value_if(source, hir, arm_start)
        if starts_with(arm_result, "error[") {
            return arm_result
        }
        arm_end = value_if_end(source, arm_start)
    } else if token_text(source, arm_start) == "match" {
        let arm_result = validate_value_match(source, hir, arm_start)
        if starts_with(arm_result, "error[") {
            return arm_result
        }
        arm_end = value_match_end(source, arm_start)
    } else {
        if token_text(source, arm_start) == "print" {
            return "error[E2S30]: value-position match arm must produce Int, not Void at byte " +
            to_text(arm_start)
        }
        arm_end = expression_end(source, arm_start)
        if arm_end < 0 {
            return "error[E2S30]: value-position match arm must produce Int at byte " +
            to_text(arm_start)
        }
    }
    let arm_close = skip_trivia(source, arm_end)
    if arm_close >= len(source) || token_text(source, arm_close) != "}" {
        return "error[E2S30]: value-position match arm must contain one final Int expression at byte " +
        to_text(arm_close)
    }
    return "ok"
}

# Value position for a concrete-enum scrutinee. The coverage rules are the ones
# statement position already applies to the same declared constructor set —
# `E2S25` for a missing constructor, `E2S26` for a duplicate or unreachable arm,
# `E2S32` for a constructor that is not the scrutinee's, and a guarded arm
# proving no coverage — and the arm rule is the value rule, `E2S30`. Nothing
# here widens payloads or adds a pattern form.
fn validate_value_enum_match(
    source: Text,
    hir: Text,
    start: Int,
    enum_type: Text
) -> Text {
    let value_start = skip_trivia(source, token_end(source, start))
    let arms_open = skip_trivia(source, token_end(source, value_start))
    if arms_open >= len(source) || token_text(source, arms_open) != "{" {
        return "error[E2S24]: expected `{` after enum match scrutinee at byte " +
        to_text(arms_open)
    }
    let mut arm_cursor = skip_trivia(source, token_end(source, arms_open))
    let mut covered = "|"
    let mut seen_catchall = false
    while arm_cursor < len(source) && token_text(source, arm_cursor) != "}" {
        let pattern_start = arm_cursor
        let pattern_info = pattern_summary(source, pattern_start)
        let pattern_kind = pattern_summary_kind(pattern_info)
        let pattern = token_text(source, pattern_start)
        let mut tag = -1
        if pattern_kind == "NamePattern" ||
           pattern_kind == "ConstructorPattern" {
            tag = enum_constructor_index(source, enum_type, pattern)
        }
        let binding_catchall =
            pattern_kind == "NamePattern" && tag < 0 &&
            enum_binding_catchall_name(pattern)
        let catchall =
            pattern_kind == "WildcardPattern" || binding_catchall
        if seen_catchall {
            return "error[E2S26]: pattern after catch-all is unreachable at byte " +
            to_text(pattern_start)
        }
        if catchall {
            if enum_constructors_covered(source, enum_type, covered) {
                return "error[E2S26]: catch-all pattern is unreachable at byte " +
                to_text(pattern_start)
            }
        } else {
            if pattern_kind != "NamePattern" &&
               pattern_kind != "ConstructorPattern" {
                return "error[E2S32]: enum pattern must name a constructor or `_` at byte " +
                to_text(pattern_start)
            }
            if tag < 0 {
                return "error[E2S32]: constructor `" + pattern +
                "` does not belong to enum `" + enum_type + "` at byte " +
                to_text(pattern_start)
            }
            if contains(covered, "|" + pattern + "|") {
                return "error[E2S26]: duplicate enum constructor pattern `" +
                pattern + "` is unreachable at byte " +
                to_text(pattern_start)
            }
            let arity = enum_constructor_payload_arity(
                source,
                enum_type,
                pattern
            )
            let applied = pattern_kind == "ConstructorPattern"
            if arity < 0 {
                return "error[E2S32]: constructor `" + pattern +
                "` of enum `" + enum_type +
                "` declares a payload outside this Core slice; one `Int` " +
                "field is supported at byte " + to_text(pattern_start)
            }
            if applied != (arity == 1) {
                let mut arity_message = "constructor pattern `" + pattern +
                "` takes no payload"
                if arity == 1 {
                    arity_message = "constructor pattern `" + pattern +
                    "` must bind its one `Int` payload or use `_`"
                }
                return "error[E2S32]: " + arity_message + " at byte " +
                to_text(pattern_start)
            }
            if applied {
                let open = skip_trivia(
                    source,
                    token_end(source, pattern_start)
                )
                let field = skip_trivia(source, token_end(source, open))
                let mut close = len(source)
                if field < len(source) {
                    close = skip_trivia(source, token_end(source, field))
                }
                let wildcard = token_text(source, field) == "_"
                let named = field < len(source) &&
                token_kind(source, field) == "identifier" && !wildcard
                if (!wildcard && !named) || close >= len(source) ||
                   token_text(source, close) != ")" {
                    return "error[E2S32]: constructor payload pattern must be one name or `_` at byte " +
                    to_text(field)
                }
            }
        }
        let after_pattern = skip_trivia(
            source,
            pattern_summary_end(pattern_info)
        )
        let mut guarded = false
        let mut arrow = after_pattern
        if arrow < len(source) && token_text(source, arrow) == "if" {
            guarded = true
            let guard_start = skip_trivia(source, token_end(source, arrow))
            let guard_end = condition_end(source, guard_start)
            if guard_end < 0 {
                return "error[E2S29]: match guard must be Bool or an Int comparison at byte " +
                to_text(guard_start)
            }
            arrow = skip_trivia(source, guard_end)
        }
        if arrow >= len(source) || token_text(source, arrow) != "=>" {
            return "error[E2S24]: expected `=>` after enum pattern at byte " +
            to_text(arrow)
        }
        let arm_open = skip_trivia(source, token_end(source, arrow))
        if arm_open >= len(source) || token_text(source, arm_open) != "{" {
            return "error[E2S24]: bounded enum match arm must use a block at byte " +
            to_text(arm_open)
        }
        let arm_result = validate_value_arm(source, hir, arm_open)
        if starts_with(arm_result, "error[") {
            return arm_result
        }
        let arm_start = skip_trivia(source, token_end(source, arm_open))
        let arm_close = skip_trivia(source, value_end(source, arm_start))
        if !guarded {
            if catchall {
                seen_catchall = true
            } else {
                covered = covered + pattern + "|"
            }
        }
        arm_cursor = skip_trivia(source, token_end(source, arm_close))
        if arm_cursor < len(source) && token_text(source, arm_cursor) == "," {
            arm_cursor = skip_trivia(source, token_end(source, arm_cursor))
        } else if arm_cursor >= len(source) ||
                  token_text(source, arm_cursor) != "}" {
            return "error[E2S24]: expected `,` between enum match arms at byte " +
            to_text(arm_cursor)
        }
    }
    if arm_cursor >= len(source) || token_text(source, arm_cursor) != "}" {
        return "error[E2S24]: missing `}` after enum match arms at byte " +
        to_text(arms_open)
    }
    if !seen_catchall &&
       !enum_constructors_covered(source, enum_type, covered) {
        return "error[E2S25]: non-exhaustive enum `" + enum_type +
        "` match; missing constructors " +
        enum_missing_constructors(source, enum_type, covered) +
        " at byte " + to_text(start)
    }
    return "ok"
}

fn validate_value_match(source: Text, hir: Text, start: Int) -> Text {
    let cursor = skip_trivia(source, start)
    if cursor >= len(source) || token_text(source, cursor) != "match" {
        return "error[E2S30]: expected value-position `match` at byte " +
        to_text(cursor)
    }
    let enum_type = value_match_enum_type(source, hir, cursor)
    if len(enum_type) > 0 {
        return validate_value_enum_match(source, hir, cursor, enum_type)
    }
    let value_start = skip_trivia(source, token_end(source, cursor))
    let value_close = condition_end(source, value_start)
    if value_close < 0 {
        return "error[E2S24]: bounded match scrutinee must be Bool at byte " +
        to_text(value_start)
    }
    let arms_open = skip_trivia(source, value_close)
    if arms_open >= len(source) || token_text(source, arms_open) != "{" {
        return "error[E2S24]: expected `{` after match scrutinee at byte " +
        to_text(arms_open)
    }
    let mut arm_cursor = skip_trivia(source, token_end(source, arms_open))
    let mut covered_true = false
    let mut covered_false = false
    let mut seen_catchall = false
    while arm_cursor < len(source) && token_text(source, arm_cursor) != "}" {
        let pattern_start = arm_cursor
        let pattern_info = pattern_summary(source, pattern_start)
        let pattern_kind = pattern_summary_kind(pattern_info)
        let pattern = token_text(source, pattern_start)
        let pattern_true = pattern_kind == "LiteralPattern" &&
        pattern == "true"
        let pattern_false = pattern_kind == "LiteralPattern" &&
        pattern == "false"
        let pattern_catchall = pattern_kind == "WildcardPattern"
        if seen_catchall {
            return "error[E2S26]: pattern after catch-all is unreachable at byte " +
            to_text(pattern_start)
        }
        if pattern_true && covered_true {
            return "error[E2S26]: duplicate `true` pattern is unreachable at byte " +
            to_text(pattern_start)
        }
        if pattern_false && covered_false {
            return "error[E2S26]: duplicate `false` pattern is unreachable at byte " +
            to_text(pattern_start)
        }
        if pattern_catchall && covered_true && covered_false {
            return "error[E2S26]: catch-all pattern is unreachable at byte " +
            to_text(pattern_start)
        }
        if !pattern_true && !pattern_false && !pattern_catchall {
            return "error[E2S24]: bounded Bool pattern must be `true`, `false`, or `_` at byte " +
            to_text(pattern_start)
        }
        let after_pattern = skip_trivia(
            source,
            pattern_summary_end(pattern_info)
        )
        let mut guarded = false
        let mut arrow = after_pattern
        if arrow < len(source) && token_text(source, arrow) == "if" {
            guarded = true
            let guard_start = skip_trivia(source, token_end(source, arrow))
            let guard_end = condition_end(source, guard_start)
            if guard_end < 0 {
                return "error[E2S29]: match guard must be Bool or an Int comparison at byte " +
                to_text(guard_start)
            }
            arrow = skip_trivia(source, guard_end)
        }
        if arrow >= len(source) || token_text(source, arrow) != "=>" {
            return "error[E2S24]: expected `=>` after Bool pattern at byte " +
            to_text(arrow)
        }
        let arm_open = skip_trivia(source, token_end(source, arrow))
        if arm_open >= len(source) || token_text(source, arm_open) != "{" {
            return "error[E2S24]: bounded Bool match arm must use a block at byte " +
            to_text(arm_open)
        }
        let arm_result = validate_value_arm(source, hir, arm_open)
        if starts_with(arm_result, "error[") {
            return arm_result
        }
        let arm_start = skip_trivia(source, token_end(source, arm_open))
        let arm_close = skip_trivia(source, value_end(source, arm_start))
        if !guarded {
            if pattern_true {
                covered_true = true
            } else if pattern_false {
                covered_false = true
            } else {
                covered_true = true
                covered_false = true
                seen_catchall = true
            }
        }
        arm_cursor = skip_trivia(source, token_end(source, arm_close))
        if arm_cursor < len(source) && token_text(source, arm_cursor) == "," {
            arm_cursor = skip_trivia(source, token_end(source, arm_cursor))
        } else if arm_cursor >= len(source) ||
                  token_text(source, arm_cursor) != "}" {
            return "error[E2S24]: expected `,` between match arms at byte " +
            to_text(arm_cursor)
        }
    }
    if arm_cursor >= len(source) || token_text(source, arm_cursor) != "}" {
        return "error[E2S24]: missing `}` after match arms at byte " +
        to_text(arms_open)
    }
    if !covered_true && !covered_false {
        return "error[E2S25]: non-exhaustive Bool match; missing patterns `true`, `false` at byte " +
        to_text(cursor)
    }
    if !covered_true {
        return "error[E2S25]: non-exhaustive Bool match; missing pattern `true` at byte " +
        to_text(cursor)
    }
    if !covered_false {
        return "error[E2S25]: non-exhaustive Bool match; missing pattern `false` at byte " +
        to_text(cursor)
    }
    return "ok"
}

fn value_control(token: Text) -> Bool {
    return token == "if" || token == "match"
}

fn validate_value_control(source: Text, hir: Text, start: Int) -> Text {
    let cursor = skip_trivia(source, start)
    if token_text(source, cursor) == "if" {
        return validate_value_if(source, hir, cursor)
    }
    return validate_value_match(source, hir, cursor)
}

fn emit_value_into(
    source: Text,
    hir: Text,
    start: Int,
    end: Int,
    target: Text,
    failure_result: Text
) -> Text {
    let cursor = skip_trivia(source, start)
    if token_text(source, cursor) == "match" {
        return emit_value_match_into(
            source,
            hir,
            cursor,
            end,
            target,
            failure_result
        )
    }
    if token_text(source, cursor) != "if" {
        return "    " + target + " = " +
        emit_expression(source, hir, cursor, end) + ";\n" +
        "    if (kofun_failed) return " + failure_result + ";\n"
    }
    let condition_start = skip_trivia(source, token_end(source, cursor))
    let condition_close = condition_end(source, condition_start)
    let then_open = skip_trivia(source, condition_close)
    let then_start = skip_trivia(source, token_end(source, then_open))
    let then_end = value_if_branch_end(source, then_start)
    let then_close = skip_trivia(source, then_end)
    let else_keyword = skip_trivia(source, token_end(source, then_close))
    let else_open = skip_trivia(source, token_end(source, else_keyword))
    let else_start = skip_trivia(source, token_end(source, else_open))
    let else_end = value_if_branch_end(source, else_start)
    return "    {\n" +
    emit_condition_into(
        source,
        hir,
        condition_start,
        condition_close,
        "kofun_value_condition",
        failure_result,
        "        "
    ) +
    "        if (kofun_value_condition) {\n" +
    emit_value_into(
        source,
        hir,
        then_start,
        then_end,
        target,
        failure_result
    ) +
    "        } else {\n" +
    emit_value_into(
        source,
        hir,
        else_start,
        else_end,
        target,
        failure_result
    ) +
    "        }\n" +
    "    }\n"
}

# The dispatch statement position emits for a concrete enum, with the arm
# bodies replaced by the value each arm produces. The scrutinee is read once
# into `kofun_match_value` before any arm is tested, arms are tested in source
# order, and `kofun_match_selected` stops the walk at the first arm that takes,
# so only that arm's result expression runs and only it assigns `target`.
fn emit_value_enum_match_into(
    source: Text,
    hir: Text,
    start: Int,
    end: Int,
    target: Text,
    failure_result: Text,
    enum_type: Text
) -> Text {
    let value_start = skip_trivia(source, token_end(source, start))
    let arms_open = skip_trivia(source, token_end(source, value_start))
    let mut arm_cursor = skip_trivia(source, token_end(source, arms_open))
    let mut dispatch = ""
    while arm_cursor < end && token_text(source, arm_cursor) != "}" {
        let pattern_start = arm_cursor
        let pattern_info = pattern_summary(source, pattern_start)
        let pattern_kind = pattern_summary_kind(pattern_info)
        let pattern = token_text(source, pattern_start)
        let mut tag = -1
        if pattern_kind == "NamePattern" ||
           pattern_kind == "ConstructorPattern" {
            tag = enum_constructor_index(source, enum_type, pattern)
        }
        let binding_catchall =
            pattern_kind == "NamePattern" && tag < 0 &&
            enum_binding_catchall_name(pattern)
        let catchall =
            pattern_kind == "WildcardPattern" || binding_catchall
        # `-1` means the arm binds no payload name.
        let mut payload_name_start = -1
        let mut catchall_name_start = -1
        if binding_catchall {
            catchall_name_start = pattern_start
        }
        if !catchall && pattern_kind == "ConstructorPattern" {
            let open = skip_trivia(source, token_end(source, pattern_start))
            let field = skip_trivia(source, token_end(source, open))
            if token_text(source, field) != "_" {
                payload_name_start = field
            }
        }
        let mut arrow = skip_trivia(
            source,
            pattern_summary_end(pattern_info)
        )
        let mut guarded = false
        let mut guard_start = -1
        let mut guard_end = -1
        if arrow < end && token_text(source, arrow) == "if" {
            guarded = true
            guard_start = skip_trivia(source, token_end(source, arrow))
            guard_end = condition_end(source, guard_start)
            arrow = skip_trivia(source, guard_end)
        }
        let arm_open = skip_trivia(source, token_end(source, arrow))
        let arm_start = skip_trivia(source, token_end(source, arm_open))
        let arm_end = value_end(source, arm_start)
        let arm_close = skip_trivia(source, arm_end)
        let mut pattern_condition = "true"
        if !catchall {
            pattern_condition = "kofun_match_value.tag == INT64_C(" +
            to_text(tag) + ")"
        }
        # Declared before the guard, exactly as statement position declares it,
        # so `Ready(value) if value > 5 => { value }` reads one local in the
        # guard and in the result expression. It is a copy of the matched
        # payload, so producing it duplicates no owned value.
        let mut payload_declaration = ""
        if payload_name_start >= 0 {
            let payload_id = hir_definition_id_at(hir, payload_name_start)
            if len(payload_id) == 0 {
                return "error[E2S32]: constructor payload binding is unresolved at byte " +
                to_text(payload_name_start)
            }
            payload_declaration = "            int64_t k_b" + payload_id +
            " = kofun_match_value.payload;\n" +
            "            (void)k_b" + payload_id + ";\n"
        } else if catchall_name_start >= 0 {
            let catchall_id = hir_definition_id_at(
                hir,
                catchall_name_start
            )
            if len(catchall_id) == 0 {
                return "error[E2S32]: enum catch-all binding is unresolved at byte " +
                to_text(catchall_name_start)
            }
            payload_declaration =
            "            KofunEnumValue k_b" + catchall_id +
            " = kofun_match_value;\n" +
            "            (void)k_b" + catchall_id + ";\n"
        }
        let arm_body = emit_value_into(
            source,
            hir,
            arm_start,
            arm_end,
            target,
            failure_result
        )
        if starts_with(arm_body, "error[") {
            return arm_body
        }
        if guarded {
            dispatch = dispatch +
            "        if (!kofun_match_selected && " +
            pattern_condition + ") {\n" +
            payload_declaration +
            emit_condition_into(
                source,
                hir,
                guard_start,
                guard_end,
                "kofun_match_guard",
                failure_result,
                "            "
            ) +
            "            if (kofun_match_guard) {\n" +
            arm_body +
            "                kofun_match_selected = true;\n" +
            "            }\n" +
            "        }\n"
        } else {
            dispatch = dispatch +
            "        if (!kofun_match_selected && " +
            pattern_condition + ") {\n" +
            payload_declaration +
            arm_body +
            "            kofun_match_selected = true;\n" +
            "        }\n"
        }
        arm_cursor = skip_trivia(source, token_end(source, arm_close))
        if arm_cursor < end && token_text(source, arm_cursor) == "," {
            arm_cursor = skip_trivia(source, token_end(source, arm_cursor))
        }
    }
    let scrutinee_id = hir_use_binding_id(hir, value_start)
    return "    {\n" +
    "        KofunEnumValue kofun_match_value = k_b" + scrutinee_id +
    ";\n" +
    "        (void)kofun_match_value;\n" +
    "        bool kofun_match_selected = false;\n" +
    dispatch +
    "    }\n"
}

fn emit_value_match_into(
    source: Text,
    hir: Text,
    start: Int,
    end: Int,
    target: Text,
    failure_result: Text
) -> Text {
    let cursor = skip_trivia(source, start)
    let enum_type = value_match_enum_type(source, hir, cursor)
    if len(enum_type) > 0 {
        return emit_value_enum_match_into(
            source,
            hir,
            cursor,
            end,
            target,
            failure_result,
            enum_type
        )
    }
    let value_start = skip_trivia(source, token_end(source, cursor))
    let value_close = condition_end(source, value_start)
    let arms_open = skip_trivia(source, value_close)
    let mut arm_cursor = skip_trivia(source, token_end(source, arms_open))
    let mut dispatch = ""
    while arm_cursor < end && token_text(source, arm_cursor) != "}" {
        let pattern_info = pattern_summary(source, arm_cursor)
        let pattern_kind = pattern_summary_kind(pattern_info)
        let pattern = token_text(source, arm_cursor)
        let pattern_true = pattern_kind == "LiteralPattern" &&
        pattern == "true"
        let pattern_false = pattern_kind == "LiteralPattern" &&
        pattern == "false"
        let mut arrow = skip_trivia(
            source,
            pattern_summary_end(pattern_info)
        )
        let mut guarded = false
        let mut guard_start = -1
        let mut guard_end = -1
        if arrow < end && token_text(source, arrow) == "if" {
            guarded = true
            guard_start = skip_trivia(source, token_end(source, arrow))
            guard_end = condition_end(source, guard_start)
            arrow = skip_trivia(source, guard_end)
        }
        let arm_open = skip_trivia(source, token_end(source, arrow))
        let arm_start = skip_trivia(source, token_end(source, arm_open))
        let arm_end = value_end(source, arm_start)
        let arm_close = skip_trivia(source, arm_end)
        let mut pattern_condition = "true"
        if pattern_true {
            pattern_condition = "kofun_match_value"
        } else if pattern_false {
            pattern_condition = "!kofun_match_value"
        }
        let arm_body = emit_value_into(
            source,
            hir,
            arm_start,
            arm_end,
            target,
            failure_result
        )
        if guarded {
            dispatch = dispatch +
            "        if (!kofun_match_selected && " +
            pattern_condition + ") {\n" +
            emit_condition_into(
                source,
                hir,
                guard_start,
                guard_end,
                "kofun_match_guard",
                failure_result,
                "            "
            ) +
            "            if (kofun_match_guard) {\n" +
            arm_body +
            "                kofun_match_selected = true;\n" +
            "            }\n" +
            "        }\n"
        } else {
            dispatch = dispatch +
            "        if (!kofun_match_selected && " +
            pattern_condition + ") {\n" +
            arm_body +
            "            kofun_match_selected = true;\n" +
            "        }\n"
        }
        arm_cursor = skip_trivia(source, token_end(source, arm_close))
        if arm_cursor < end && token_text(source, arm_cursor) == "," {
            arm_cursor = skip_trivia(source, token_end(source, arm_cursor))
        }
    }
    return "    {\n" +
    emit_condition_into(
        source,
        hir,
        value_start,
        value_close,
        "kofun_match_value",
        failure_result,
        "        "
    ) +
    "        (void)kofun_match_value;\n" +
    "        bool kofun_match_selected = false;\n" +
    dispatch +
    "    }\n"
}

fn core_body_open(
    source: Text,
    hir: Text,
    function_start: Int,
    is_main: Bool
) -> Int {
    let parameters = parameter_open(source, function_start)
    if parameters < 0 {
        return -1
    }
    let parameters_end = balanced_end(source, parameters, "(", ")")
    if parameters_end < 0 ||
       starts_with(core_parameters(source, hir, function_start), "error[") {
        return -1
    }
    let mut cursor = skip_trivia(source, parameters_end)
    if cursor < len(source) && token_text(source, cursor) == "->" {
        cursor = skip_trivia(source, token_end(source, cursor))
        let optional_end = optional_int_type_end(source, cursor)
        if optional_end >= 0 {
            cursor = skip_trivia(source, optional_end)
            if cursor >= len(source) || token_text(source, cursor) != "{" {
                return -1
            }
            return cursor
        }
        let list_end = list_int_type_end(source, cursor)
        if list_end >= 0 {
            cursor = skip_trivia(source, list_end)
            if cursor >= len(source) || token_text(source, cursor) != "{" {
                return -1
            }
            return cursor
        }
        if cursor >= len(source) ||
           (token_text(source, cursor) != "Int" &&
            token_text(source, cursor) != "Text" &&
            enum_constructor_count(
                source,
                token_text(source, cursor)
            ) < 0 &&
            record_declaration_start(
                source,
                token_text(source, cursor)
            ) < 0) {
            return -1
        }
        cursor = skip_trivia(source, annotation_type_end(source, cursor))
    } else if !is_main {
        return -1
    }
    if cursor >= len(source) || token_text(source, cursor) != "{" {
        return -1
    }
    return cursor
}

# One diagnostic spelling for the lowering surface: `error[CODE]: MESSAGE`,
# with ` at byte N` appended when a position is known. The C seed's
# counterpart additionally records the diagnostic in the structured event
# stream; that sink is a seed-only capability with no Kofun surface yet, so
# this authority owns the observable text and nothing else.
fn lower_error(code: Text, message: Text, cursor: Int) -> Text {
    if cursor >= 0 {
        return "error[" + code + "]: " + message + " at byte " +
            to_text(cursor)
    }
    return "error[" + code + "]: " + message
}

fn parent_block_open(
    source: Text,
    function_open: Int,
    child_open: Int
) -> Int {
    let mut cursor = function_open
    let mut parent = -1
    while cursor < child_open {
        if token_text(source, cursor) == "{" {
            let candidate_end = balanced_end(source, cursor, "{", "}")
            if candidate_end > child_open {
                parent = cursor
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return parent
}

# A match arm's guard is written outside the arm body braces but belongs to the
# arm: `Ready(value) if value == 3` must read the binding the body reads.  This
# maps a token inside a guard to that arm's body `{`, so a guard use resolves in
# the scope the payload binding was declared in.  The emitted C agrees: the
# payload local is declared before the guard, inside the arm's `if`.  Returns -1
# for every token that is not inside a guard.
fn match_guard_scope_open(
    source: Text,
    function_open: Int,
    target: Int
) -> Int {
    let mut cursor = skip_trivia(source, token_end(source, function_open))
    while cursor <= target {
        if token_text(source, cursor) == "match" {
            let open = pattern_match_open(source, cursor)
            let mut match_end = -1
            if open >= 0 {
                match_end = balanced_end(source, open, "{", "}")
            }
            if open >= 0 && match_end >= 0 {
                let close = match_end - 1
                let mut arm = skip_trivia(source, token_end(source, open))
                let mut scanning = true
                while scanning && arm < close &&
                      token_text(source, arm) != "}" {
                    let summary = pattern_summary(source, arm)
                    let pattern_end = pattern_summary_end(summary)
                    let arrow = pattern_arm_arrow(source, pattern_end, close)
                    if arrow < 0 {
                        scanning = false
                    } else {
                        let body = skip_trivia(
                            source,
                            token_end(source, arrow)
                        )
                        if body >= close || token_text(source, body) != "{" {
                            scanning = false
                        } else {
                            let body_end = balanced_end(source, body, "{", "}")
                            if body_end < 0 {
                                scanning = false
                            } else if target >= pattern_end && target < arrow {
                                # Only the payload name is redirected.  Every
                                # other guard use keeps the scope it already
                                # reported, so this widening cannot move a use
                                # that resolves without it.
                                let open = skip_trivia(
                                    source,
                                    token_end(source, arm)
                                )
                                let field = skip_trivia(
                                    source,
                                    token_end(source, open)
                                )
                                if pattern_summary_kind(summary) ==
                                   "ConstructorPattern" &&
                                   field < close &&
                                   token_kind(source, field) == "identifier" &&
                                   token_text(source, field) != "_" &&
                                   token_text(source, target) ==
                                   token_text(source, field) {
                                    return body
                                }
                                return -1
                            } else {
                                arm = skip_trivia(source, body_end)
                                if arm < close && token_text(source, arm) == "," {
                                    arm = skip_trivia(
                                        source,
                                        token_end(source, arm)
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return -1
}

# Brace depth at `target`. `scope_depth_for_open` reports the depth of a `{`
# token; a lambda scope opens on `(`, so it needs the running depth instead.
fn block_depth_at(source: Text, function_open: Int, target: Int) -> Int {
    let mut cursor = function_open
    let mut depth = 0
    while cursor < target {
        if token_text(source, cursor) == "{" {
            depth = depth + 1
        } else if token_text(source, cursor) == "}" {
            depth = depth - 1
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return depth
}

# The byte after an arrow lambda's body, or -1 when `open` is not its parameter
# list. A lambda is keyed by the `(`, not by `fn`, which makes `fn(x) => e` and
# the parenthesised forms decided in #547 — `(x, y) => e` and `(x: Int) => e` —
# one code path.
#
# Two conditions identify the parameter list, and both are needed:
#
# 1. its `)` is immediately followed by `=>`, and
# 2. its `(` is NOT immediately preceded by an identifier.
#
# Condition 2 is not decoration. A constructor pattern ends in `)` and is
# followed by `=>` — `Ok(value) => value` and `Err(error) => Err(error)` are all
# over the shipped stdlib — so condition 1 alone matches every one of them. What
# separates them is what comes before the `(`: a constructor pattern is preceded
# by its variant name, a lambda's parameter list by `fn`, `=`, `,` or `(`.
#
# The bare `x => e` form is deliberately absent. `IDENT => expr` is already enum
# match-arm syntax — 176 arms in the shipped stdlib, e.g. `Trace => 0` — so one
# token of lookahead cannot separate the two. See #547.
#
# The body is delimited by the same expression grammar the Core lowers, so a
# body this Core cannot parse yields -1 and the lambda contributes no scope —
# the identifiers inside it are then reported by whichever pass would have
# reported them before.
# Whether `target` begins a match arm's pattern.
#
# `IDENT => expr` is both an arm and a bare lambda, and arms are comma-separated,
# so the token before it cannot separate them: `,` precedes both `Debug => 1,`
# and the lambda in `map(xs, x => x * 2)`. Neither can one token of lookahead,
# which is what #547 assumed. What separates them is position — an arm pattern
# begins directly inside a match block's braces at an arm boundary.
#
# Walking arms is what makes this exact rather than approximate. A lambda may
# appear inside an arm body, so "inside a match block" would be wrong; only the
# arm's own first token is a pattern. The C seed caches this per source because
# every identifier resolution asks it.
fn match_arm_pattern_start(source: Text, target: Int) -> Bool {
    let length = len(source)
    let mut cursor = 0
    while cursor < length && cursor <= target {
        if token_text(source, cursor) == "match" {
            let open = pattern_match_open(source, cursor)
            let mut match_end = -1
            if open >= 0 {
                match_end = balanced_end(source, open, "{", "}")
            }
            if open >= 0 && match_end >= 0 &&
               target > open && target < match_end {
                let close = match_end - 1
                let mut arm = skip_trivia(source, token_end(source, open))
                while arm < close && token_text(source, arm) != "}" {
                    if arm == target {
                        return true
                    }
                    if arm > target {
                        break
                    }
                    let arrow = pattern_arm_arrow(source, arm, close)
                    if arrow < 0 {
                        break
                    }
                    let body = skip_trivia(source, token_end(source, arrow))
                    let body_end = expression_end(source, body)
                    if body_end < 0 {
                        break
                    }
                    let mut next = skip_trivia(source, body_end)
                    if next < close && token_text(source, next) == "," {
                        next = skip_trivia(source, token_end(source, next))
                    }
                    if next <= arm {
                        break
                    }
                    arm = next
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

fn lambda_parameters_end(source: Text, previous: Int, open: Int) -> Int {
    if token_text(source, open) != "(" {
        # The bare single-parameter form `x => e` decided in #547. It is a
        # lambda everywhere an arm pattern is not, which is why the arm check
        # carries the whole decision.
        if token_kind(source, open) != "identifier" {
            return -1
        }
        if keyword(token_text(source, open)) {
            return -1
        }
        let bare_arrow = skip_trivia(source, token_end(source, open))
        if bare_arrow >= len(source) ||
           token_text(source, bare_arrow) != "=>" {
            return -1
        }
        if match_arm_pattern_start(source, open) {
            return -1
        }
        return expression_end(
            source,
            skip_trivia(source, token_end(source, bare_arrow))
        )
    }
    if previous >= 0 && token_kind(source, previous) == "identifier" {
        return -1
    }
    let close = balanced_end(source, open, "(", ")")
    if close < 0 {
        return -1
    }
    let arrow = skip_trivia(source, close)
    if arrow >= len(source) || token_text(source, arrow) != "=>" {
        return -1
    }
    return expression_end(source, skip_trivia(source, token_end(source, arrow)))
}

# The innermost arrow lambda whose parameters are in scope at `target`, keyed by
# its `(` so `hir_scope_id_for_open` finds the scope record. -1 when `target` is
# not inside one.
fn lambda_scope_open(source: Text, function_open: Int, target: Int) -> Int {
    let mut cursor = function_open
    let mut previous = -1
    let mut found = -1
    while cursor < target {
        if lambda_parameters_end(source, previous, cursor) > target {
            found = cursor
        }
        previous = cursor
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return found
}

# Lifted lambdas still use the scalar capture ABI. Fail before C publication
# when a lambda reads any List[Int]-typed binding; this covers whole carriers,
# len, and indexing without pretending the scalar capture can transport one.
fn validate_list_int_lambda_uses(source: Text, hir: Text) -> Text {
    let mut cursor = skip_trivia(source, 0)
    let mut previous = -1
    while cursor < len(source) {
        let function_open = enclosing_function_open(source, cursor)
        let inside_lambda = function_open >= 0 &&
            lambda_scope_open(source, function_open, cursor) >= 0
        let mut follows_primary = false
        if previous >= 0 {
            let previous_kind = token_kind(source, previous)
            follows_primary = previous_kind == "identifier" ||
                previous_kind == "integer" || previous_kind == "float" ||
                previous_kind == "decimal" || previous_kind == "string" ||
                token_text(source, previous) == ")" ||
                token_text(source, previous) == "]"
        }
        if inside_lambda && token_text(source, cursor) == "[" &&
           !follows_primary {
            return "error[E2S157]: List[Int] literals inside lambdas are outside this lowering slice at byte " +
            to_text(cursor)
        }
        if token_kind(source, cursor) == "identifier" {
            let binding_id = hir_use_binding_id(hir, cursor)
            if inside_lambda && token_text(source, cursor) == "List" &&
               previous >= 0 && token_text(source, previous) == ":" &&
               lambda_declaration_syntax_token(
                   source,
                   function_open,
                   cursor
               ) {
                return "error[E2S157]: List annotations inside lambdas are outside this lowering slice at byte " +
                to_text(cursor)
            }
            if len(binding_id) > 0 &&
               hir_binding_field(hir, binding_id, 5) == "List[Int]" {
                if inside_lambda {
                    return "error[E2S157]: List[Int] binding uses inside lambdas are outside this lowering slice at byte " +
                    to_text(cursor)
                }
            }
            let open = skip_trivia(source, token_end(source, cursor))
            if inside_lambda && len(binding_id) == 0 &&
               open < len(source) && token_text(source, open) == "(" &&
               function_return_type(source, token_text(source, cursor)) ==
               "List[Int]" {
                return "error[E2S157]: List[Int] direct results inside lambdas are outside this lowering slice at byte " +
                to_text(cursor)
            }
        }
        previous = cursor
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return "ok"
}

# `target` is a parameter name or a parameter type inside an arrow lambda's
# parameter list. The identifier pass must resolve neither: the name is a
# declaration, and the type names no binding.
fn lambda_declaration_syntax_token(
    source: Text,
    function_open: Int,
    target: Int
) -> Bool {
    let mut cursor = function_open
    let mut previous = -1
    while cursor <= target {
        if lambda_parameters_end(source, previous, cursor) >= 0 {
            if token_text(source, cursor) != "(" {
                # The bare form has no parameter list: the keying token is
                # itself the parameter, so it is the only declaration.
                if target == cursor {
                    return true
                }
            } else if target > cursor &&
                      target < balanced_end(source, cursor, "(", ")") {
                return true
            }
        }
        previous = cursor
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

# `x: Int => e` annotates a lambda parameter without parentheses. #547 rejects
# it: `:` is the type-annotation position everywhere else, so the bare form
# reads as a binding whose type is `Int => e`, and accepting it would foreclose
# writing function types with an arrow before #552 has decided whether to.
# Detected forward as IDENT `:` TYPE `=>`; every other annotation position is
# followed by `=`, `)` or `{`, never by `=>`.
fn lambda_unparenthesised_annotation(source: Text, start: Int) -> Bool {
    if token_kind(source, start) != "identifier" {
        return false
    }
    let colon = skip_trivia(source, token_end(source, start))
    if colon >= len(source) || token_text(source, colon) != ":" {
        return false
    }
    let annotation = skip_trivia(source, token_end(source, colon))
    if annotation >= len(source) {
        return false
    }
    let arrow = skip_trivia(source, token_end(source, annotation))
    return arrow < len(source) && token_text(source, arrow) == "=>"
}

fn scope_kind_for_open(
    source: Text,
    function_open: Int,
    wanted_open: Int
) -> Text {
    let mut cursor = function_open
    let mut previous = ""
    while cursor < wanted_open {
        if token_text(source, cursor) == "if" {
            let condition_start = skip_trivia(
                source,
                token_end(source, cursor)
            )
            let condition_close = condition_end(source, condition_start)
            if condition_close >= 0 &&
               skip_trivia(source, condition_close) == wanted_open {
                return "if-then"
            }
        }
        previous = token_text(source, cursor)
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    if previous == "else" {
        return "if-else"
    }
    if previous == "=>" {
        return "match-arm"
    }
    return "block"
}

fn enum_declaration_syntax_token(
    source: Text,
    function_open: Int,
    target: Int
) -> Bool {
    let mut cursor = skip_trivia(source, token_end(source, function_open))
    while cursor <= target {
        if token_text(source, cursor) == "let" {
            let mut name = skip_trivia(source, token_end(source, cursor))
            if token_text(source, name) == "mut" {
                name = skip_trivia(source, token_end(source, name))
            }
            if name == target {
                return true
            }
            let colon = skip_trivia(source, token_end(source, name))
            if token_text(source, colon) == ":" {
                let type_cursor = skip_trivia(
                    source,
                    token_end(source, colon)
                )
                if type_cursor == target {
                    return true
                }
                let equals = skip_trivia(
                    source,
                    token_end(source, type_cursor)
                )
                let initializer = skip_trivia(
                    source,
                    token_end(source, equals)
                )
                if initializer == target &&
                   token_text(source, equals) == "=" {
                    let enum_type = token_text(source, type_cursor)
                    if enum_constructor_count(source, enum_type) >= 0 {
                        return true
                    }
                }
            }
        }
        if token_text(source, cursor) == "for" {
            let name = skip_trivia(source, token_end(source, cursor))
            if name == target {
                return true
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

fn record_syntax_token(
    source: Text,
    function_open: Int,
    target: Int
) -> Bool {
    let mut cursor = skip_trivia(source, token_end(source, function_open))
    let mut previous = function_open
    while cursor <= target {
        if cursor == target {
            if token_text(source, previous) == "." {
                return true
            }
            let after = skip_trivia(source, token_end(source, cursor))
            if token_text(source, after) == ":" {
                return true
            }
            if token_text(source, after) == "(" &&
               record_declaration_start(
                   source,
                   token_text(source, cursor)
               ) >= 0 {
                return true
            }
            return false
        }
        previous = cursor
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

fn record_initializer_constructor_token(
    source: Text,
    function_open: Int,
    target: Int
) -> Bool {
    let mut cursor = skip_trivia(source, token_end(source, function_open))
    while cursor <= target {
        if token_text(source, cursor) == "let" {
            let mut name = skip_trivia(source, token_end(source, cursor))
            if token_text(source, name) == "mut" {
                name = skip_trivia(source, token_end(source, name))
            }
            let colon = skip_trivia(source, token_end(source, name))
            if token_text(source, colon) == ":" {
                let type_cursor = skip_trivia(
                    source,
                    token_end(source, colon)
                )
                let equals = skip_trivia(
                    source,
                    token_end(source, type_cursor)
                )
                let initializer = skip_trivia(
                    source,
                    token_end(source, equals)
                )
                if initializer == target &&
                   token_text(source, equals) == "=" {
                    let record_type = token_text(source, type_cursor)
                    return record_type ==
                    token_text(source, initializer) &&
                    record_declaration_start(source, record_type) >= 0
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

fn enum_initializer_constructor_token(
    source: Text,
    function_open: Int,
    target: Int
) -> Bool {
    let mut cursor = skip_trivia(source, token_end(source, function_open))
    while cursor <= target {
        if token_text(source, cursor) == "let" {
            let mut name = skip_trivia(source, token_end(source, cursor))
            if token_text(source, name) == "mut" {
                name = skip_trivia(source, token_end(source, name))
            }
            let colon = skip_trivia(source, token_end(source, name))
            if token_text(source, colon) == ":" {
                let type_cursor = skip_trivia(
                    source,
                    token_end(source, colon)
                )
                let equals = skip_trivia(
                    source,
                    token_end(source, type_cursor)
                )
                let initializer = skip_trivia(
                    source,
                    token_end(source, equals)
                )
                if initializer == target && token_text(source, equals) == "=" {
                    let enum_type = token_text(source, type_cursor)
                    let constructor = token_text(source, initializer)
                    return enum_constructor_count(source, enum_type) >= 0 &&
                    len(enum_constructor_owner(source, constructor)) > 0
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

fn enum_match_pattern_token(
    source: Text,
    function_open: Int,
    target: Int
) -> Bool {
    let mut cursor = skip_trivia(source, token_end(source, function_open))
    while cursor < target {
        if token_text(source, cursor) == "match" {
            let arms_open = pattern_match_open(source, cursor)
            if arms_open >= 0 && arms_open < target &&
               token_text(source, arms_open) == "{" {
                let match_end = balanced_end(source, arms_open, "{", "}")
                let match_close = match_end - 1
                let mut arm_cursor = skip_trivia(
                    source,
                    token_end(source, arms_open)
                )
                while match_end >= 0 && arm_cursor <= target &&
                      arm_cursor < match_close &&
                      token_text(source, arm_cursor) != "}" {
                    let pattern = pattern_summary(source, arm_cursor)
                    let pattern_end = pattern_summary_end(pattern)
                    if target >= arm_cursor && target < pattern_end {
                        return true
                    }
                    let arrow = pattern_arm_arrow(
                        source,
                        pattern_end,
                        match_close
                    )
                    if arm_cursor <= target &&
                       arrow >= 0 &&
                       token_text(source, arrow) == "=>" {
                        let arm_open = skip_trivia(
                            source,
                            token_end(source, arrow)
                        )
                        let arm_end = balanced_end(
                            source,
                            arm_open,
                            "{",
                            "}"
                        )
                        if arm_end < 0 {
                            arm_cursor = target + 1
                        } else if arm_end <= target {
                            arm_cursor = skip_trivia(source, arm_end)
                            if token_text(source, arm_cursor) == "," {
                                arm_cursor = skip_trivia(
                                    source,
                                    token_end(source, arm_cursor)
                                )
                            }
                        } else {
                            arm_cursor = target + 1
                        }
                    } else {
                        arm_cursor = target + 1
                    }
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

fn text_find_from(value: Text, wanted: Text, start: Int) -> Int {
    if len(wanted) == 0 {
        return start
    }
    let mut cursor = start
    while cursor + len(wanted) <= len(value) {
        if text_slice(value, cursor, cursor + len(wanted)) == wanted {
            return cursor
        }
        cursor = cursor + 1
    }
    return -1
}

fn decimal_value(value: Text) -> Int {
    let symbols = chars(value)
    let mut cursor = 0
    let mut sign = 1
    if len(symbols) > 0 && symbols[0] == "-" {
        sign = -1
        cursor = 1
    }
    let mut result = 0
    while cursor < len(symbols) {
        if !is_digit(symbols[cursor]) {
            return -1
        }
        result = result * 10 +
        text_find_from("0123456789", symbols[cursor], 0)
        cursor = cursor + 1
    }
    return result * sign
}

fn hir_record_start(
    hir: Text,
    kind: Text,
    start: Int
) -> Int {
    let found = text_find_from(hir, "\n" + kind + "|", start)
    if found < 0 {
        return -1
    }
    return found + 1
}

fn hir_field(hir: Text, line_start: Int, wanted: Int) -> Text {
    let symbols = chars(hir)
    let mut cursor = line_start
    let mut field = 0
    let mut field_start = line_start
    while cursor < len(symbols) {
        if symbols[cursor] == "|" || symbols[cursor] == "\n" {
            if field == wanted {
                return text_slice(hir, field_start, cursor)
            }
            if symbols[cursor] == "\n" {
                return ""
            }
            field = field + 1
            field_start = cursor + 1
        }
        cursor = cursor + 1
    }
    if field == wanted {
        return text_slice(hir, field_start, cursor)
    }
    return ""
}

fn hir_scope_id_for_open(hir: Text, open: Int) -> Text {
    let mut line = hir_record_start(hir, "scope", 0)
    while line >= 0 {
        if decimal_value(hir_field(hir, line, 4)) == open {
            return hir_field(hir, line, 1)
        }
        line = hir_record_start(hir, "scope", line + 1)
    }
    return ""
}

# The scope a binding was declared in, or "" when the id names no binding.
fn hir_binding_scope(hir: Text, binding_id: Text) -> Text {
    let mut line = hir_record_start(hir, "binding", 0)
    while line >= 0 {
        if hir_field(hir, line, 1) == binding_id {
            return hir_field(hir, line, 2)
        }
        line = hir_record_start(hir, "binding", line + 1)
    }
    return ""
}

# The byte the binding's declaration starts at, or -1 for an unknown id.
fn hir_binding_declaration_start(hir: Text, binding_id: Text) -> Int {
    let mut line = hir_record_start(hir, "binding", 0)
    while line >= 0 {
        if hir_field(hir, line, 1) == binding_id {
            return decimal_value(hir_field(hir, line, 8))
        }
        line = hir_record_start(hir, "binding", line + 1)
    }
    return -1
}

# The `(` of the arrow lambda a `let` initializer is, or -1 when the
# initializer is something else. `value_start` is the first byte after `=`, so
# what precedes the parameter list is `=` or `fn` — never an identifier, which
# is why -1 is the right `previous` for `lambda_parameters_end`: the
# constructor-pattern ambiguity that argument guards against cannot arise here.
fn lambda_initializer_open(source: Text, value_start: Int) -> Int {
    let mut cursor = skip_trivia(source, value_start)
    if token_text(source, cursor) == "fn" {
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    if lambda_parameters_end(source, -1, cursor) < 0 {
        return -1
    }
    return cursor
}

# The `(` of the lambda a binding holds, or -1 when that binding is not a
# lambda. This is how a call site reaches the lifted function: the scope HIR
# has already resolved the callee name to a binding, shadowing included, so the
# lowering never repeats that resolution by name.
fn lambda_binding_open(source: Text, hir: Text, binding_id: Text) -> Int {
    let declaration_start = hir_binding_declaration_start(hir, binding_id)
    if declaration_start < 0 {
        return -1
    }
    let equals = skip_trivia(source, token_end(source, declaration_start))
    if token_text(source, equals) != "=" {
        return -1
    }
    return lambda_initializer_open(
        source, skip_trivia(source, token_end(source, equals)))
}

# The binding ids a lambda body reads from outside its own parameter list, in
# HIR order, separated by `|`, or "" when the lambda captures nothing.
#
# A capture is exactly a use inside the lambda whose binding lives in another
# scope. Lifting passes each one as a trailing parameter, so a lifted lambda
# stays a plain `int64_t` function and the frozen profile gains no function
# type. The call site appends the same ids in the same order, and a captured
# binding is a C local of the enclosing function, so it is in scope wherever
# the lambda binding itself is.
fn lambda_captures(source: Text, hir: Text, lambda_open: Int) -> Text {
    let body_end = lambda_parameters_end(source, -1, lambda_open)
    let scope_id = hir_scope_id_for_open(hir, lambda_open)
    let mut captured = ""
    let mut line = hir_record_start(hir, "use", 0)
    while line >= 0 {
        let use_start = decimal_value(hir_field(hir, line, 1))
        if use_start > lambda_open && use_start < body_end {
            let binding_id = hir_field(hir, line, 4)
            # A lambda binding in an enclosing scope is not a capture: it has
            # no `int64_t` to pass, and the call reaches its lifted function by
            # name. Counting it would emit a parameter for a C variable that a
            # lambda binding never declares.
            if hir_binding_scope(hir, binding_id) != scope_id &&
               lambda_binding_open(source, hir, binding_id) < 0 {
                # A body may read the same capture more than once; the
                # parameter list must name it once.
                if !contains("|" + captured + "|", "|" + binding_id + "|") {
                    if len(captured) > 0 {
                        captured = captured + "|"
                    }
                    captured = captured + binding_id
                }
            }
        }
        line = hir_record_start(hir, "use", line + 1)
    }
    return captured
}

# The declared parameter count of the lambda whose parameter list opens at
# `open`. Captures are invisible to a caller, so they are not counted.
fn lambda_parameter_count(source: Text, open: Int) -> Int {
    # The bare form `x => e` is keyed by its single parameter, so it has no
    # list to count and its arity is always one.
    if token_text(source, open) != "(" {
        return 1
    }
    let close = balanced_end(source, open, "(", ")")
    if close < 0 {
        return -1
    }
    let mut count = 0
    let mut parameter = skip_trivia(source, token_end(source, open))
    while parameter < close && token_kind(source, parameter) == "identifier" {
        count = count + 1
        let mut after = skip_trivia(source, token_end(source, parameter))
        if after < close && token_text(source, after) == ":" {
            let annotation = skip_trivia(source, token_end(source, after))
            after = skip_trivia(source, token_end(source, annotation))
        }
        if after < close && token_text(source, after) == "," {
            after = skip_trivia(source, token_end(source, after))
        }
        parameter = after
    }
    return count
}

# The declared arity of the lambda a call site resolves to, or -1 when the
# callee is not a lambda binding.
fn lambda_call_arity(source: Text, hir: Text, use_start: Int) -> Int {
    let callee_binding = hir_use_binding_id(hir, use_start)
    if len(callee_binding) == 0 {
        return -1
    }
    let open = lambda_binding_open(source, hir, callee_binding)
    if open < 0 {
        return -1
    }
    return lambda_parameter_count(source, open)
}

# One `k_b<id>` per capture, prefixed by `declaration` for a parameter list and
# by nothing for an argument list, separated with `, ` when `written` items
# already precede them. The lifted signature and every call to it go through
# this one function so their orders cannot drift.
fn append_captures(captures: Text, written: Int, declaration: Text) -> Text {
    let mut emitted = ""
    let mut count = 0
    let mut cursor = 0
    while cursor < len(captures) {
        let mut stop = cursor
        while stop < len(captures) && text_slice(captures, stop, stop + 1) != "|" {
            stop = stop + 1
        }
        if written > 0 || count > 0 {
            emitted = emitted + ", "
        }
        emitted = emitted + declaration + "k_b" +
        text_slice(captures, cursor, stop)
        count = count + 1
        cursor = stop + 1
    }
    return emitted
}

fn hir_scope_field(hir: Text, scope_id: Text, field: Int) -> Text {
    let mut line = hir_record_start(hir, "scope", 0)
    while line >= 0 {
        if hir_field(hir, line, 1) == scope_id {
            return hir_field(hir, line, field)
        }
        line = hir_record_start(hir, "scope", line + 1)
    }
    return ""
}

fn hir_binding_field(hir: Text, binding_id: Text, field: Int) -> Text {
    let mut line = hir_record_start(hir, "binding", 0)
    while line >= 0 {
        if hir_field(hir, line, 1) == binding_id {
            return hir_field(hir, line, field)
        }
        line = hir_record_start(hir, "binding", line + 1)
    }
    return ""
}

fn hir_same_scope_declaration(
    hir: Text,
    scope_id: Text,
    name: Text
) -> Text {
    let mut line = hir_record_start(hir, "binding", 0)
    while line >= 0 {
        if hir_field(hir, line, 2) == scope_id &&
           hir_field(hir, line, 3) == name {
            return hir_field(hir, line, 8)
        }
        line = hir_record_start(hir, "binding", line + 1)
    }
    return ""
}

fn hir_definition_id_at(hir: Text, declaration_start: Int) -> Text {
    let mut line = hir_record_start(hir, "binding", 0)
    while line >= 0 {
        if decimal_value(hir_field(hir, line, 8)) == declaration_start {
            return hir_field(hir, line, 1)
        }
        line = hir_record_start(hir, "binding", line + 1)
    }
    return ""
}

fn hir_use_binding_id(hir: Text, use_start: Int) -> Text {
    let mut line = hir_record_start(hir, "use", 0)
    while line >= 0 {
        if decimal_value(hir_field(hir, line, 1)) == use_start {
            return hir_field(hir, line, 4)
        }
        line = hir_record_start(hir, "use", line + 1)
    }
    return ""
}

fn hir_resolve_binding(
    hir: Text,
    current_scope: Text,
    use_start: Int,
    name: Text
) -> Text {
    let mut scope_id = current_scope
    while len(scope_id) > 0 && scope_id != "-1" {
        let mut resolved = ""
        let mut line = hir_record_start(hir, "binding", 0)
        while line >= 0 {
            if hir_field(hir, line, 2) == scope_id &&
               hir_field(hir, line, 3) == name &&
               decimal_value(hir_field(hir, line, 10)) <= use_start {
                resolved = hir_field(hir, line, 1)
            }
            line = hir_record_start(hir, "binding", line + 1)
        }
        if len(resolved) > 0 {
            return resolved
        }
        scope_id = hir_scope_field(hir, scope_id, 2)
    }
    return ""
}

fn hir_pending_declaration(
    hir: Text,
    current_scope: Text,
    use_start: Int,
    name: Text
) -> Text {
    let mut scope_id = current_scope
    while len(scope_id) > 0 && scope_id != "-1" {
        let mut line = hir_record_start(hir, "binding", 0)
        while line >= 0 {
            let declaration = decimal_value(hir_field(hir, line, 8))
            let visible = decimal_value(hir_field(hir, line, 10))
            if hir_field(hir, line, 2) == scope_id &&
               hir_field(hir, line, 3) == name &&
               declaration < use_start && use_start < visible {
                return to_text(declaration)
            }
            line = hir_record_start(hir, "binding", line + 1)
        }
        scope_id = hir_scope_field(hir, scope_id, 2)
    }
    return ""
}

fn hir_scope_root(hir: Text, start_scope: Text) -> Text {
    let mut scope_id = start_scope
    let mut parent = hir_scope_field(hir, scope_id, 2)
    while len(parent) > 0 && parent != "-1" {
        scope_id = parent
        parent = hir_scope_field(hir, scope_id, 2)
    }
    return scope_id
}

fn hir_any_declaration(
    hir: Text,
    current_scope: Text,
    use_start: Int,
    name: Text
) -> Text {
    let current_root = hir_scope_root(hir, current_scope)
    let mut line = hir_record_start(hir, "binding", 0)
    while line >= 0 {
        let binding_scope = hir_field(hir, line, 2)
        let declaration = decimal_value(hir_field(hir, line, 8))
        if hir_field(hir, line, 3) == name &&
           declaration < use_start &&
           hir_scope_root(hir, binding_scope) == current_root {
            return to_text(declaration)
        }
        line = hir_record_start(hir, "binding", line + 1)
    }
    return ""
}

fn scope_depth_for_open(
    source: Text,
    function_open: Int,
    wanted_open: Int
) -> Int {
    let mut cursor = function_open
    let mut depth = 0
    while cursor <= wanted_open {
        if token_text(source, cursor) == "{" {
            depth = depth + 1
            if cursor == wanted_open {
                return depth
            }
        } else if token_text(source, cursor) == "}" {
            depth = depth - 1
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return -1
}

# Result types of the 16 profile builtins for `let` initializer typing.
# The scope-HIR type vocabulary stays the existing single tokens
# (Int/Bool/Text/List/Void); List[Text] element typing belongs to the
# selfhost-HIR emitter. Returns "" for a non-builtin name.
fn builtin_return_type(name: Text) -> Text {
    if name == "args" || name == "chars" {
        return "List"
    }
    if name == "contains" || name == "is_digit" || name == "is_space" ||
       name == "is_xid_continue" || name == "starts_with" {
        return "Bool"
    }
    if name == "find" || name == "len" {
        return "Int"
    }
    if name == "read_text" || name == "replace" || name == "text_slice" ||
       name == "to_text" || name == "trim" ||
       name == "validate_unicode_source" {
        return "Text"
    }
    if name == "fail" || name == "write_text" {
        return "Void"
    }
    return ""
}

# Declared result type of a user function: the token after `->`, `Void`
# when there is no arrow, empty when the function is not declared.
fn function_return_type(source: Text, wanted: Text) -> Text {
    let mut cursor = next_function_start(source, 0)
    while cursor < len(source) {
        if function_name(source, cursor) == wanted {
            let parameters = parameter_open(source, cursor)
            if parameters < 0 {
                return ""
            }
            let parameters_end = balanced_end(source, parameters, "(", ")")
            if parameters_end < 0 {
                return ""
            }
            let after = skip_trivia(source, parameters_end)
            if after < len(source) && token_text(source, after) == "->" {
                let type_cursor = skip_trivia(
                    source,
                    token_end(source, after)
                )
                if type_cursor < len(source) {
                    if list_int_type_end(source, type_cursor) >= 0 {
                        return "List[Int]"
                    }
                    return annotation_type_text(source, type_cursor)
                }
                return ""
            }
            return "Void"
        }
        cursor = next_function_start(source, function_end(source, cursor))
    }
    return ""
}

# Declared type of one named function parameter. Full annotation spans are
# skipped while walking, including callable, optional, and bracketed types.
fn function_parameter_type(
    source: Text,
    wanted: Text,
    wanted_index: Int
) -> Text {
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        if function_name(source, function_start) == wanted {
            let parameters = parameter_open(source, function_start)
            if parameters < 0 {
                return ""
            }
            let parameters_end = balanced_end(
                source,
                parameters,
                "(",
                ")"
            )
            if parameters_end < 0 {
                return ""
            }
            let mut cursor = skip_trivia(
                source,
                token_end(source, parameters)
            )
            let mut index = 0
            while cursor < parameters_end &&
                  token_text(source, cursor) != ")" {
                let type_start = parameter_type_start(
                    source,
                    cursor,
                    parameters_end
                )
                if type_start < 0 || type_start >= parameters_end {
                    return ""
                }
                let optional_end = optional_int_type_end(source, type_start)
                let list_end = parameter_list_type_end(
                    source,
                    type_start,
                    parameters_end
                )
                if index == wanted_index {
                    if optional_end >= 0 {
                        return "Int?"
                    }
                    if list_end >= 0 {
                        return parameter_list_type_text(
                            source,
                            type_start,
                            parameters_end
                        )
                    }
                    return annotation_type_text(source, type_start)
                }
                let mut type_end = callable_type_end(source, type_start)
                if type_end < 0 {
                    if optional_end >= 0 {
                        type_end = optional_end
                    } else if list_end >= 0 {
                        type_end = list_end
                    } else {
                        type_end = annotation_type_end(source, type_start)
                    }
                }
                let separator = skip_trivia(source, type_end)
                if separator < parameters_end &&
                   token_text(source, separator) == "," {
                    cursor = skip_trivia(
                        source,
                        token_end(source, separator)
                    )
                } else {
                    cursor = separator
                }
                index = index + 1
            }
            return ""
        }
        function_start = next_function_start(
            source,
            function_end(source, function_start)
        )
    }
    return ""
}

# Declared ownership mode of one named function parameter. An omitted mode is
# the ordinary copy mode; `take` remains semantic even when the current C
# carrier is copied into a fixed slot.
fn function_parameter_mode(
    source: Text,
    wanted: Text,
    wanted_index: Int
) -> Text {
    let declaration = function_start_named(source, wanted)
    if declaration < 0 {
        return ""
    }
    let parameter = function_parameter_start_at(
        source,
        declaration,
        wanted_index
    )
    if parameter < 0 {
        return ""
    }
    if ownership_mode_token(source, parameter) {
        return token_text(source, parameter)
    }
    return "copy"
}

fn function_return_type_containing(
    source: Text,
    position: Int
) -> Text {
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        if position >= function_start && position < function_close {
            return function_return_type(
                source,
                function_name(source, function_start)
            )
        }
        function_start = next_function_start(source, function_close)
    }
    return ""
}

fn function_result_is_enum(source: Text, name: Text) -> Bool {
    return enum_constructor_count(
        source,
        function_return_type(source, name)
    ) >= 0
}

fn function_result_is_record(source: Text, name: Text) -> Bool {
    return record_declaration_start(
        source,
        function_return_type(source, name)
    ) >= 0
}

# A declared `-> Text` result. Text values are borrowed `const char *` in the
# bounded profile, so this is what selects the C result type and the
# `return` lowering rather than the Int path.
fn function_result_is_text(source: Text, name: Text) -> Bool {
    return function_return_type(source, name) == "Text"
}

fn function_result_is_list_int(source: Text, name: Text) -> Bool {
    return function_return_type(source, name) == "List[Int]"
}

# Bounded initializer typing for unannotated `let` bindings. Top-level
# comparison and boolean operators make the value Bool; otherwise the
# profile's operands are homogeneous, so the first primary decides:
# literals by token kind, calls by declared or builtin result type, names
# by their resolved binding, bare enum constructors by their owner. The
# conservative fallback is the historical Int default, never an error.
fn initializer_type(
    source: Text,
    hir: Text,
    function_open: Int,
    initializer: Int
) -> Text {
    return initializer_type_bounded(
        source,
        hir,
        function_open,
        initializer,
        -1
    )
}

# The same initializer classification with an explicit token bound. This is
# what keeps a comparison after `Optional(Int) ?? Int` from being mistaken for
# part of the fallback's type.
fn initializer_type_bounded(
    source: Text,
    hir: Text,
    function_open: Int,
    initializer: Int,
    bounded_end: Int
) -> Text {
    let mut end = expression_end(source, initializer)
    if bounded_end >= 0 {
        end = bounded_end
    } else if end < 0 {
        end = token_end(source, initializer)
    }
    let lambda_end = lambda_parameters_end(source, -1, initializer)
    if lambda_end >= 0 && lambda_end <= end {
        return "Fn"
    }
    # A `let` whose whole initializer is a bit-operation chain binds `Int`,
    # whatever the receiver is, because the eight operations return `Int`.
    # Without this, `let y = f.and(1)` bound `y` as `Float` and the reader was
    # sent to `to_text` for a mistake that is in the receiver. The chain has to
    # cover the whole initializer: `"a" + b.and(1)` is still classified by the
    # rules below.
    let chain_bound = primary_end(source, initializer)
    if chain_bound == end &&
       int_bit_chain_dot(source, initializer, chain_bound) >= 0 {
        return "Int"
    }
    let optional_coalescing = optional_int_coalescing_operator(
        source,
        initializer,
        end
    ) >= 0
    # The operator scan covers the whole initializer line: it ends at the
    # first newline outside parentheses, not at the bounded arithmetic
    # expression end, so `1 < 2` and multi-line parenthesized calls are
    # both seen completely.
    let mut depth = 0
    let mut walk = initializer
    let mut previous_end = initializer
    let mut scanning = true
    let mut exact_decimal_division = false
    while scanning && walk < len(source) &&
          (bounded_end < 0 || walk < bounded_end) {
        if depth == 0 &&
           contains(text_slice(source, previous_end, walk), "\n") {
            scanning = false
        } else if token_text(source, walk) == "{" {
            scanning = false
        } else {
            let walk_text = token_text(source, walk)
            if walk_text == "(" {
                depth = depth + 1
            } else if walk_text == ")" {
                depth = depth - 1
            } else if depth == 0 &&
                      (walk_text == "==" || walk_text == "!=" ||
                       walk_text == "<" || walk_text == "<=" ||
                       walk_text == ">" || walk_text == ">=" ||
                       walk_text == "&&" || walk_text == "||" ||
                       walk_text == "!") {
                return "Bool"
            } else if depth == 0 && walk_text == "/" {
                exact_decimal_division = true
            }
            previous_end = token_end(source, walk)
            walk = skip_trivia(source, previous_end)
        }
    }
    if optional_coalescing {
        return "Int"
    }
    let mut cursor = skip_trivia(source, initializer)
    while cursor < end &&
          (token_text(source, cursor) == "(" ||
           token_text(source, cursor) == "-" ||
           token_text(source, cursor) == "+") {
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    if cursor >= end {
        return "Int"
    }
    if token_text(source, cursor) == "[" {
        return "List[Int]"
    }
    let conversion_type = numeric_conversion_result(
        numeric_conversion_at(source, cursor)
    )
    if len(conversion_type) > 0 {
        if exact_decimal_division && conversion_type == "Decimal" {
            return "DecimalResult"
        }
        return conversion_type
    }
    let kind = token_kind(source, cursor)
    if kind == "integer" {
        return "Int"
    }
    # #710 frozen decision 2: an unsuffixed fractional or scientific literal
    # denotes Decimal, and the `f64` suffix selects binary64 Float. Recording
    # them here is what puts the type in the scope HIR, so an unannotated
    # `let x = 1.5` is a Decimal binding rather than the historical Int default.
    if kind == "decimal" {
        if exact_decimal_division {
            return "DecimalResult"
        }
        return "Decimal"
    }
    if kind == "float" {
        return "Float"
    }
    let cursor_text = token_text(source, cursor)
    if cursor_text == "true" || cursor_text == "false" {
        return "Bool"
    }
    if kind == "identifier" {
        # Call and index detection must not stop at the bounded expression
        # end: profile initializers may continue across lines, and `[`
        # follows the resolved primary directly.
        let open = skip_trivia(source, token_end(source, cursor))
        if open < len(source) && token_text(source, open) == "(" {
            let declared = function_return_type(source, cursor_text)
            if len(declared) > 0 {
                return declared
            }
            if record_declaration_start(source, cursor_text) >= 0 {
                return cursor_text
            }
            let constructor_type = enum_constructor_owner(
                source,
                cursor_text
            )
            if len(constructor_type) > 0 {
                return constructor_type
            }
            let builtin = builtin_return_type(cursor_text)
            if len(builtin) > 0 {
                return builtin
            }
            return "Int"
        }
        let scope_open = parent_block_open(source, function_open, cursor)
        let scope_id = hir_scope_id_for_open(hir, scope_open)
        let binding_id = hir_resolve_binding(
            hir,
            scope_id,
            cursor,
            cursor_text
        )
        if len(binding_id) > 0 {
            let callable = lambda_binding_open(source, hir, binding_id) >= 0 ||
                callable_parameter_type_start(source, hir, binding_id) >= 0
            if callable && call_argument_position(source, cursor) {
                return "Fn"
            }
            let binding_type = hir_binding_field(hir, binding_id, 5)
            if len(binding_type) > 0 {
                if open < len(source) && token_text(source, open) == "." {
                    let field_cursor = skip_trivia(
                        source,
                        token_end(source, open)
                    )
                    let field_type = record_field_type_named(
                        source,
                        binding_type,
                        token_text(source, field_cursor)
                    )
                    if len(field_type) > 0 {
                        return field_type
                    }
                }
                if binding_type == "List[Int]" && open < len(source) &&
                   token_text(source, open) == "[" {
                    return "Int"
                }
                # Indexing the profile's List[Text] yields its Text element.
                if binding_type == "List" && open < len(source) &&
                   token_text(source, open) == "[" {
                    return "Text"
                }
                if exact_decimal_division && binding_type == "Decimal" {
                    return "DecimalResult"
                }
                return binding_type
            }
            return "Int"
        }
        if function_arity(source, cursor_text) >= 0 &&
           call_argument_position(source, cursor) {
            return "Fn"
        }
        let owner = enum_constructor_owner(source, cursor_text)
        if len(owner) > 0 {
            return owner
        }
    }
    return "Int"
}

# Scope construction normally owns E2S35. Inside one Int-bit call, however,
# A01 fixes the order as receiver, then each argument's label and type. This
# preflight is called only when the use pass is about to reject an unresolved
# name. It returns an earlier bit-call error, or empty text when that unresolved
# use itself is the first failure and E2S35 must remain authoritative.
fn int_bit_error_before_unresolved_in(
    source: Text,
    hir: Text,
    target: Int,
    range_start: Int,
    range_end: Int
) -> Text {
    let mut start = skip_trivia(source, range_start)
    let mut end = -1
    let mut first_dot = -1
    while start <= target && start < range_end && first_dot < 0 {
        let candidate_end = primary_end(source, start)
        if candidate_end > target && candidate_end <= range_end {
            let candidate_dot = int_bit_chain_dot(
                source,
                start,
                candidate_end
            )
            if candidate_dot >= 0 {
                end = candidate_end
                first_dot = candidate_dot
            }
        }
        if first_dot < 0 {
            let next = token_end(source, start)
            if next <= start {
                return ""
            }
            start = skip_trivia(source, next)
        }
    }
    if first_dot < 0 || end < 0 || target < first_dot {
        return ""
    }

    let function_open = enclosing_function_open(source, start)
    let receiver_type = initializer_type_bounded(
        source,
        hir,
        function_open,
        start,
        first_dot
    )
    if receiver_type != "Int" {
        return lower_error(
            "E2S168",
            "bit operations are defined on `Int`, and this receiver is `" +
            receiver_type + "`",
            first_dot
        )
    }

    let mut cursor = first_dot
    while cursor < end && cursor < target {
        let dot = skip_trivia(source, cursor)
        if dot >= end || token_text(source, dot) != "." {
            return ""
        }
        let name_at = skip_trivia(source, token_end(source, dot))
        let name = token_text(source, name_at)
        let arity = int_bit_method_arity(name)
        if arity < 0 {
            return lower_error(
                "E2S168",
                "unknown `Int` member `" + name + "`",
                name_at
            )
        }
        let open = skip_trivia(source, token_end(source, name_at))
        if open >= end || token_text(source, open) != "(" {
            return ""
        }
        let close = balanced_end(source, open, "(", ")")
        if close < 0 {
            return lower_error(
                "E2S169",
                "`" + name + "` is missing its closing parenthesis",
                open
            )
        }
        let mut argument = skip_trivia(source, token_end(source, open))
        let mut arguments = 0
        while argument < close && token_text(source, argument) != ")" {
            let bound = argument_end(source, argument)
            if bound < 0 {
                return lower_error(
                    "E2S169",
                    "`" + name +
                    "` was given an argument this slice cannot read",
                    argument
                )
            }
            let label = skip_trivia(source, argument)
            let mut colon = -1
            if parameter_word_token(source, label) {
                colon = skip_trivia(source, token_end(source, label))
            }
            if colon >= 0 && colon < close &&
               token_text(source, colon) == ":" {
                return lower_error(
                    "E2S169",
                    "`" + name + "` takes positional arguments; the bit " +
                    "operations have no parameter names",
                    label
                )
            }
            if target >= argument && target < bound {
                return int_bit_error_before_unresolved_in(
                    source,
                    hir,
                    target,
                    argument,
                    bound
                )
            }
            if bound <= target {
                let argument_type = initializer_type_bounded(
                    source,
                    hir,
                    function_open,
                    argument,
                    bound
                )
                if argument_type != "Int" {
                    return lower_error(
                        "E2S168",
                        "`" + name + "` takes `Int` arguments",
                        argument
                    )
                }
            }
            arguments = arguments + 1
            let separator = skip_trivia(source, bound)
            if separator < close && token_text(source, separator) == "," {
                argument = skip_trivia(source, token_end(source, separator))
            } else {
                argument = separator
            }
        }
        if target <= close {
            return ""
        }
        let trailing_parameters = trailing_lambda_open(source, close)
        if trailing_parameters >= 0 {
            return lower_error(
                "E2S169",
                "`" + name + "` takes no trailing lambda; the bit " +
                "operations have no functional parameter",
                skip_trivia(source, close)
            )
        }
        if arguments != arity {
            return lower_error(
                "E2S169",
                "`" + name + "` expects " + to_text(arity) +
                " arguments, got " + to_text(arguments),
                name_at
            )
        }
        cursor = close
    }
    return ""
}

fn int_bit_error_before_unresolved(
    source: Text,
    hir: Text,
    target: Int
) -> Text {
    return int_bit_error_before_unresolved_in(
        source,
        hir,
        target,
        0,
        len(source)
    )
}

fn build_scope_hir_mode(
    source: Text,
    preserve_pattern_candidates: Bool
) -> Text {
    # The removed callable notation is rejected before any binding is
    # collected, so a source written in it gets the migration diagnostic
    # rather than whatever its multi-token type happens to desynchronise.
    let notation_check = validate_removed_callable_notation(source)
    if starts_with(notation_check, "error[") {
        return notation_check
    }
    let mut hir = "kofun-scope-hir/v1\n"
    let mut next_scope_id = 0
    let mut next_binding_id = 0
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let parameters = parameter_open(source, function_start)
        let parameters_close = balanced_end(source, parameters, "(", ")")
        let mut function_open = skip_trivia(source, parameters_close)
        while function_open < function_close &&
              token_text(source, function_open) != "{" {
            function_open = skip_trivia(
                source,
                token_end(source, function_open)
            )
        }
        let parameter_scope = next_scope_id
        next_scope_id = next_scope_id + 1
        let body_scope = next_scope_id
        next_scope_id = next_scope_id + 1
        let mut scope_count = 2
        hir = hir + "hir-function|" + to_text(function_start) + "|" +
        to_text(parameter_scope) + "|" + to_text(body_scope) + "\n" +
        "scope|" + to_text(parameter_scope) + "|-1|parameters|" +
        to_text(parameters) + "|" + to_text(parameters_close) + "|0\n" +
        "scope|" + to_text(body_scope) + "|" +
        to_text(parameter_scope) + "|function-body|" +
        to_text(function_open) + "|" + to_text(function_close) + "|1\n"

        let mut cursor = skip_trivia(
            source,
            token_end(source, function_open)
        )
        let mut previous = -1
        while cursor < function_close {
            if token_text(source, cursor) == "{" {
                let depth = scope_depth_for_open(
                    source,
                    function_open,
                    cursor
                )
                if depth > 32 {
                    return "error[E2S35]: lexical scope depth limit is 32 at byte " +
                    to_text(cursor)
                }
                scope_count = scope_count + 1
                if scope_count > 256 {
                    return "error[E2S35]: lexical scope limit is 256 per function at byte " +
                    to_text(cursor)
                }
                let parent_open = parent_block_open(
                    source,
                    function_open,
                    cursor
                )
                let parent_scope = hir_scope_id_for_open(hir, parent_open)
                let close = balanced_end(source, cursor, "{", "}")
                let scope_kind = scope_kind_for_open(
                    source,
                    function_open,
                    cursor
                )
                hir = hir + "scope|" + to_text(next_scope_id) + "|" +
                parent_scope + "|" + scope_kind + "|" +
                to_text(cursor) + "|" +
                to_text(close) + "|" + to_text(depth) + "\n"
                next_scope_id = next_scope_id + 1
            } else if lambda_unparenthesised_annotation(source, cursor) {
                let colon = skip_trivia(source, token_end(source, cursor))
                let annotation = skip_trivia(source, token_end(source, colon))
                return "error[E2S95]: annotated lambda parameter `" +
                token_text(source, cursor) +
                "` needs parentheses at byte " + to_text(cursor) +
                "; write `(" + token_text(source, cursor) + ": " +
                token_text(source, annotation) + ") =>`"
            } else {
                let lambda_close = lambda_parameters_end(
                    source,
                    previous,
                    cursor
                )
                if lambda_close >= 0 {
                    let lambda_open = cursor
                    let lambda_depth = block_depth_at(
                        source,
                        function_open,
                        cursor
                    ) + 1
                    if lambda_depth > 32 {
                        return "error[E2S35]: lexical scope depth limit is 32 at byte " +
                        to_text(cursor)
                    }
                    scope_count = scope_count + 1
                    if scope_count > 256 {
                        return "error[E2S35]: lexical scope limit is 256 per function at byte " +
                        to_text(cursor)
                    }
                    let lambda_parent = hir_scope_id_for_open(
                        hir,
                        parent_block_open(source, function_open, lambda_open)
                    )
                    hir = hir + "scope|" + to_text(next_scope_id) + "|" +
                    lambda_parent + "|lambda-parameters|" +
                    to_text(lambda_open) + "|" +
                    to_text(lambda_close) + "|" +
                    to_text(lambda_depth) + "\n"
                    next_scope_id = next_scope_id + 1
                }
            }
            previous = cursor
            cursor = skip_trivia(source, token_end(source, cursor))
        }

        let mut binding_count = 0
        let mut parameter_cursor = skip_trivia(
            source,
            token_end(source, parameters)
        )
        while parameter_cursor < parameters_close &&
              token_text(source, parameter_cursor) != ")" {
            let name = parameter_internal_start(
                source,
                parameter_cursor,
                parameters_close
            )
            let type_cursor = parameter_type_start(
                source,
                parameter_cursor,
                parameters_close
            )
            if name < 0 || type_cursor < 0 {
                return "error[E2S35]: malformed parameter head at byte " +
                to_text(parameter_cursor)
            }
            # A callable type spans several tokens. Stepping over only the
            # first would leave this walk inside the type, so the parameters
            # after it would never be bound and their uses would be reported
            # as unknown lexical bindings.
            let callable_end = callable_type_end(source, type_cursor)
            let list_end = parameter_list_type_end(
                source,
                type_cursor,
                parameters_close
            )
            # Unsupported nested/general List annotations still need one
            # balanced span so scope HIR can retain the parameter fact before
            # lowering reports the exact E2S157 boundary.
            let mut list_shape_end = -1
            if list_end < 0 {
                list_shape_end = constructed_list_type_end(
                    source,
                    type_cursor,
                    parameters_close
                )
            }
            # A parameter binding records the annotation's full identity, so a
            # const argument reaches the scope HIR instead of being flattened
            # to its head. Recording `Fixed` here would make every scale one
            # binding type and silently accept a scale mismatch.
            let mut type_end = annotation_type_end(source, type_cursor)
            let mut binding_type = annotation_type_text(source, type_cursor)
            if callable_end >= 0 {
                type_end = callable_end
                binding_type = "Fn"
            } else if optional_int_type_end(source, type_cursor) >= 0 {
                type_end = optional_int_type_end(source, type_cursor)
                binding_type = "Int?"
            } else if list_end >= 0 {
                type_end = list_end
                binding_type = parameter_list_type_text(
                    source,
                    type_cursor,
                    parameters_close
                )
            } else if list_shape_end >= 0 {
                type_end = list_shape_end
                binding_type = constructed_list_type_text(
                    source,
                    type_cursor,
                    parameters_close
                )
            }
            let first_declaration = hir_same_scope_declaration(
                hir,
                to_text(parameter_scope),
                token_text(source, name)
            )
            if len(first_declaration) > 0 {
                return "error[E2S47]: duplicate binding `" +
                token_text(source, name) +
                "` in lexical scope at byte " + to_text(name) +
                "; first declaration at byte " + first_declaration
            }
            binding_count = binding_count + 1
            if binding_count > 256 {
                return "error[E2S35]: lexical binding limit is 256 per function at byte " +
                to_text(name)
            }
            let mut binding_ownership = "copy"
            if ownership_mode_token(source, parameter_cursor) {
                binding_ownership = token_text(source, parameter_cursor)
            }
            hir = hir + "binding|" + to_text(next_binding_id) + "|" +
            to_text(parameter_scope) + "|" + token_text(source, name) +
            "|immutable|" + binding_type +
            "|" + binding_ownership + "|initialized|" + to_text(name) + "|" +
            to_text(token_end(source, name)) + "|" +
            to_text(token_end(source, name)) + "\n"
            next_binding_id = next_binding_id + 1
            let separator = skip_trivia(source, type_end)
            if separator < parameters_close &&
               token_text(source, separator) == "," {
                parameter_cursor = skip_trivia(
                    source,
                    token_end(source, separator)
                )
            } else {
                parameter_cursor = separator
            }
        }

        cursor = skip_trivia(source, token_end(source, function_open))
        previous = -1
        while cursor < function_close {
            if lambda_parameters_end(source, previous, cursor) >= 0 {
                let lambda_open = cursor
                # The bare form has no parameter list to walk: the parameter is
                # the keying token itself, so the walk below covers exactly that
                # one identifier and then stops at the `=>`. Taking
                # `balanced_end` from a non-`(` token instead runs on to some
                # later unbalanced `)` and binds `=>` as a parameter name.
                let bare_lambda = token_text(source, lambda_open) != "("
                let mut lambda_close = balanced_end(
                    source, lambda_open, "(", ")")
                let mut lambda_cursor = skip_trivia(
                    source,
                    token_end(source, lambda_open)
                )
                if bare_lambda {
                    lambda_close = token_end(source, lambda_open)
                    lambda_cursor = lambda_open
                }
                while lambda_cursor < lambda_close &&
                      token_text(source, lambda_cursor) != ")" {
                    let name = lambda_cursor
                    let mut after = skip_trivia(source, token_end(source, name))
                    let mut binding_type = "Int"
                    if token_text(source, after) == ":" {
                        let type_cursor = skip_trivia(
                            source,
                            token_end(source, after)
                        )
                        let list_finish = constructed_list_type_end(
                            source,
                            type_cursor,
                            lambda_close
                        )
                        if list_finish >= 0 {
                            binding_type = constructed_list_type_text(
                                source,
                                type_cursor,
                                lambda_close
                            )
                            after = skip_trivia(source, list_finish)
                        } else {
                            binding_type = annotation_type_text(
                                source,
                                type_cursor
                            )
                            after = skip_trivia(
                                source,
                                annotation_type_end(source, type_cursor)
                            )
                        }
                    }
                    let first_declaration = hir_same_scope_declaration(
                        hir,
                        lambda_scope,
                        token_text(source, name)
                    )
                    if len(first_declaration) > 0 {
                        return "error[E2S47]: duplicate binding `" +
                        token_text(source, name) +
                        "` in lexical scope at byte " + to_text(name) +
                        "; first declaration at byte " + first_declaration
                    }
                    binding_count = binding_count + 1
                    if binding_count > 256 {
                        return "error[E2S35]: lexical binding limit is 256 per function at byte " +
                        to_text(name)
                    }
                    hir = hir + "binding|" + to_text(next_binding_id) + "|" +
                    lambda_scope + "|" + token_text(source, name) +
                    "|immutable|" + binding_type +
                    "|copy|initialized|" + to_text(name) + "|" +
                    to_text(token_end(source, name)) + "|" +
                    to_text(token_end(source, name)) + "\n"
                    next_binding_id = next_binding_id + 1
                    if after < lambda_close &&
                       token_text(source, after) == "," {
                        lambda_cursor = skip_trivia(
                            source,
                            token_end(source, after)
                        )
                    } else {
                        lambda_cursor = after
                    }
                }
            }
            previous = cursor
            cursor = skip_trivia(source, token_end(source, cursor))
        }

        cursor = skip_trivia(source, token_end(source, function_open))
        while cursor < function_close {
            if token_text(source, cursor) == "let" {
                let mut name = skip_trivia(source, token_end(source, cursor))
                let mut mutability = "immutable"
                if token_text(source, name) == "mut" {
                    mutability = "mutable"
                    name = skip_trivia(source, token_end(source, name))
                }
                let mut after_name = skip_trivia(
                    source,
                    token_end(source, name)
                )
                let mut binding_type = "Int"
                let mut annotated = false
                if token_text(source, after_name) == ":" {
                    annotated = true
                    let type_cursor = skip_trivia(
                        source,
                        token_end(source, after_name)
                    )
                    # An annotated local records the annotation's full
                    # identity, so `let kept: Fixed[2]` binds `Fixed[2]` and
                    # not `Fixed`.
                    let optional_end = optional_int_type_end(
                        source,
                        type_cursor
                    )
                    let mut list_end = -1
                    if optional_end < 0 {
                        list_end = list_int_type_end(source, type_cursor)
                    }
                    let mut list_shape_end = -1
                    if optional_end < 0 && list_end < 0 {
                        list_shape_end = constructed_list_type_end(
                            source,
                            type_cursor,
                            len(source)
                        )
                    }
                    if optional_end >= 0 {
                        binding_type = "Int?"
                        after_name = skip_trivia(source, optional_end)
                    } else if list_end >= 0 {
                        binding_type = "List[Int]"
                        after_name = skip_trivia(source, list_end)
                    } else if list_shape_end >= 0 {
                        binding_type = constructed_list_type_text(
                            source,
                            type_cursor,
                            len(source)
                        )
                        after_name = skip_trivia(source, list_shape_end)
                    } else {
                        binding_type = annotation_type_text(
                            source,
                            type_cursor
                        )
                        after_name = skip_trivia(
                            source,
                            annotation_type_end(source, type_cursor)
                        )
                    }
                }
                let initializer = skip_trivia(
                    source,
                    token_end(source, after_name)
                )
                let mut visible_start = value_end(source, initializer)
                if visible_start < 0 {
                    visible_start = token_end(source, initializer)
                }
                if !annotated &&
                   !value_control(token_text(source, initializer)) {
                    binding_type = initializer_type(
                        source,
                        hir,
                        function_open,
                        initializer
                    )
                }
                let scope_open = parent_block_open(
                    source,
                    function_open,
                    name
                )
                let scope_id = hir_scope_id_for_open(hir, scope_open)
                let first_declaration = hir_same_scope_declaration(
                    hir,
                    scope_id,
                    token_text(source, name)
                )
                if len(first_declaration) > 0 {
                    return "error[E2S47]: duplicate binding `" +
                    token_text(source, name) +
                    "` in lexical scope at byte " + to_text(name) +
                    "; first declaration at byte " + first_declaration
                }
                binding_count = binding_count + 1
                if binding_count > 256 {
                    return "error[E2S35]: lexical binding limit is 256 per function at byte " +
                    to_text(name)
                }
                let mut ownership = "copy"
                if binding_type == "Text" || binding_type == "List" ||
                   starts_with(binding_type, "List[") {
                    ownership = "gc"
                }
                hir = hir + "binding|" + to_text(next_binding_id) + "|" +
                scope_id + "|" + token_text(source, name) + "|" +
                mutability + "|" + binding_type + "|" + ownership +
                "|initialized|" + to_text(name) + "|" +
                to_text(token_end(source, name)) + "|" +
                to_text(visible_start) + "\n"
                next_binding_id = next_binding_id + 1
            }
            if token_text(source, cursor) == "for" {
                let name = skip_trivia(source, token_end(source, cursor))
                let mut body_open = name
                while body_open < function_close &&
                      token_text(source, body_open) != "{" {
                    body_open = skip_trivia(
                        source,
                        token_end(source, body_open)
                    )
                }
                if name < function_close &&
                   body_open < function_close &&
                   token_kind(source, name) == "identifier" {
                    let scope_id = hir_scope_id_for_open(hir, body_open)
                    let first_declaration = hir_same_scope_declaration(
                        hir,
                        scope_id,
                        token_text(source, name)
                    )
                    if len(first_declaration) > 0 {
                        return "error[E2S47]: duplicate binding `" +
                        token_text(source, name) +
                        "` in lexical scope at byte " + to_text(name) +
                        "; first declaration at byte " + first_declaration
                    }
                    binding_count = binding_count + 1
                    if binding_count > 256 {
                        return "error[E2S35]: lexical binding limit is 256 per function at byte " +
                        to_text(name)
                    }
                    hir = hir + "binding|" + to_text(next_binding_id) + "|" +
                    scope_id + "|" + token_text(source, name) +
                    "|immutable|Int|copy|initialized|" + to_text(name) + "|" +
                    to_text(token_end(source, name)) + "|" +
                    to_text(token_end(source, name)) + "\n"
                    next_binding_id = next_binding_id + 1
                }
            }
            # A constructor pattern that names its payload declares a binding in
            # the arm body's scope, exactly as a `for` name declares one in the
            # loop body.  Arm bodies are skipped whole, so a nested match is
            # reached by its own `match` token and no arm is visited twice.
            #
            # Not in candidate-preserving mode: there the resolved ADT adapter
            # owns pattern bindings and expects the payload name to arrive
            # unresolved as a `candidate-use`.  Declaring it here would resolve
            # the name first and take that input away from it.
            if !preserve_pattern_candidates &&
               token_text(source, cursor) == "match" {
                let arms_open = pattern_match_open(source, cursor)
                let mut arms_end = -1
                if arms_open >= 0 {
                    arms_end = balanced_end(source, arms_open, "{", "}")
                }
                let match_close = arms_end - 1
                let mut arm_cursor = function_close
                if arms_end >= 0 {
                    arm_cursor = skip_trivia(
                        source,
                        token_end(source, arms_open)
                    )
                }
                let mut scanning = true
                while scanning && arm_cursor < match_close &&
                      arm_cursor < function_close &&
                      token_text(source, arm_cursor) != "}" {
                    let summary = pattern_summary(source, arm_cursor)
                    let arrow = pattern_arm_arrow(
                        source,
                        pattern_summary_end(summary),
                        match_close
                    )
                    if arrow < 0 || token_text(source, arrow) != "=>" {
                        scanning = false
                    } else {
                        let body_open = skip_trivia(
                            source,
                            token_end(source, arrow)
                        )
                        let body_end = balanced_end(source, body_open, "{", "}")
                        if body_end < 0 {
                            scanning = false
                        } else {
                            let open = skip_trivia(
                                source,
                                token_end(source, arm_cursor)
                            )
                            let field = skip_trivia(
                                source,
                                token_end(source, open)
                            )
                            let mut binding_start = -1
                            let mut pattern_binding_type = ""
                            if pattern_summary_kind(summary) ==
                               "ConstructorPattern" &&
                               field < function_close &&
                               token_kind(source, field) == "identifier" &&
                               token_text(source, field) != "_" {
                                binding_start = field
                                pattern_binding_type = "Int"
                            } else if pattern_summary_kind(summary) ==
                                      "NamePattern" {
                                let pattern_name = token_text(
                                    source,
                                    arm_cursor
                                )
                                if len(enum_constructor_owner(
                                    source,
                                    pattern_name
                                )) == 0 &&
                                   enum_binding_catchall_name(pattern_name) {
                                    let scrutinee = skip_trivia(
                                        source,
                                        token_end(source, cursor)
                                    )
                                    if scrutinee < function_close &&
                                       token_kind(source, scrutinee) ==
                                       "identifier" {
                                        let scrutinee_scope_open =
                                        parent_block_open(
                                            source,
                                            function_open,
                                            scrutinee
                                        )
                                        let scrutinee_scope =
                                        hir_scope_id_for_open(
                                            hir,
                                            scrutinee_scope_open
                                        )
                                        let scrutinee_binding =
                                        hir_resolve_binding(
                                            hir,
                                            scrutinee_scope,
                                            scrutinee,
                                            token_text(source, scrutinee)
                                        )
                                        let scrutinee_type =
                                        hir_binding_field(
                                            hir,
                                            scrutinee_binding,
                                            5
                                        )
                                        if enum_constructor_count(
                                            source,
                                            scrutinee_type
                                        ) >= 0 {
                                            binding_start = arm_cursor
                                            pattern_binding_type =
                                                scrutinee_type
                                        }
                                    }
                                }
                            }
                            if binding_start >= 0 {
                                let scope_id = hir_scope_id_for_open(
                                    hir,
                                    body_open
                                )
                                let first_declaration =
                                hir_same_scope_declaration(
                                    hir,
                                    scope_id,
                                    token_text(source, binding_start)
                                )
                                if len(first_declaration) > 0 {
                                    return "error[E2S47]: duplicate binding `" +
                                    token_text(source, binding_start) +
                                    "` in lexical scope at byte " +
                                    to_text(binding_start) +
                                    "; first declaration at byte " +
                                    first_declaration
                                }
                                binding_count = binding_count + 1
                                if binding_count > 256 {
                                    return "error[E2S35]: lexical binding limit is 256 per function at byte " +
                                    to_text(binding_start)
                                }
                                hir = hir + "binding|" +
                                to_text(next_binding_id) + "|" + scope_id +
                                "|" + token_text(source, binding_start) +
                                "|immutable|" + pattern_binding_type +
                                "|copy|initialized|" +
                                to_text(binding_start) + "|" +
                                to_text(token_end(source, binding_start)) +
                                "|" +
                                to_text(token_end(source, binding_start)) +
                                "\n"
                                next_binding_id = next_binding_id + 1
                            }
                            arm_cursor = skip_trivia(source, body_end)
                            if arm_cursor < function_close &&
                               token_text(source, arm_cursor) == "," {
                                arm_cursor = skip_trivia(
                                    source,
                                    token_end(source, arm_cursor)
                                )
                            }
                        }
                    }
                }
            }
            cursor = skip_trivia(source, token_end(source, cursor))
        }

        let mut use_count = 0
        let mut unresolved_assignment = false
        cursor = skip_trivia(source, token_end(source, function_open))
        while cursor < function_close {
            # See selfhost_parse_primary: stop at `par` so the walk never
            # reaches the scope token between the bars and blames it as an
            # unknown binding. The construct is refused, so its token is never
            # a use.
            if token_text(source, cursor) == "par" {
                # Shape first, so a mistyped `par` is reported where it is
                # wrong rather than at `par` (#1160). This is the earliest site
                # that sees the construct, so it is the one that decides which
                # byte the reader is sent to.
                let par_fault = par_production_error(source, cursor)
                if len(par_fault) > 0 {
                    return par_fault
                }
                return "error[E2S154]: scoped parallelism `par` is specified " +
                "but not implemented at byte " + to_text(cursor)
            }
            if token_kind(source, cursor) == "identifier" {
                let name = token_text(source, cursor)
                let declaration_token = enum_declaration_syntax_token(
                    source,
                    function_open,
                    cursor
                )
                let record_token = record_syntax_token(
                    source,
                    function_open,
                    cursor
                )
                let initializer_token = enum_initializer_constructor_token(
                    source,
                    function_open,
                    cursor
                )
                let pattern_token = enum_match_pattern_token(
                    source,
                    function_open,
                    cursor
                )
                let lambda_token = lambda_declaration_syntax_token(
                    source,
                    function_open,
                    cursor
                )
                if !declaration_token && !record_token &&
                   !initializer_token &&
                   !pattern_token && !lambda_token &&
                   !list_int_local_type_token(source, cursor) &&
                   !numeric_conversion_head(source, cursor) &&
                   !move_statement_head(source, cursor) &&
                   !optional_int_null_context(source, cursor) &&
                   !decimal_rounding_mode_name(name) &&
                   name != "print" && name != "_" {
                    let mut scope_open = lambda_scope_open(
                        source,
                        function_open,
                        cursor
                    )
                    if scope_open < 0 {
                        scope_open = match_guard_scope_open(
                            source,
                            function_open,
                            cursor
                        )
                    }
                    if scope_open < 0 {
                        scope_open = parent_block_open(
                            source,
                            function_open,
                            cursor
                        )
                    }
                    let scope_id = hir_scope_id_for_open(hir, scope_open)
                    let binding_id = hir_resolve_binding(
                        hir,
                        scope_id,
                        cursor,
                        name
                    )
                    # A const generic construction head is `Name[N](`, so
                    # the token that decides call-versus-use is the one after
                    # the argument list. Stopping at `Name` would resolve the
                    # type as a lexical binding and report it unknown.
                    let after = skip_trivia(
                        source,
                        annotation_type_end(source, cursor)
                    )
                    let mut role = "read"
                    if token_text(source, after) == "=" {
                        role = "assign"
                    }
                    if len(binding_id) > 0 {
                        use_count = use_count + 1
                        if use_count > 256 {
                            return "error[E2S35]: lexical use limit is 256 per function at byte " +
                            to_text(cursor)
                        }
                        hir = hir + "use|" + to_text(cursor) + "|" +
                        to_text(token_end(source, cursor)) + "|" +
                        scope_id + "|" + binding_id + "|" + role + "\n"
                    } else if role == "assign" {
                        use_count = use_count + 1
                        if use_count > 256 {
                            return "error[E2S35]: lexical use limit is 256 per function at byte " +
                            to_text(cursor)
                        }
                        hir = hir + "use|" + to_text(cursor) + "|" +
                        to_text(token_end(source, cursor)) + "|" +
                        scope_id + "|-1|assign\n"
                        unresolved_assignment = true
                    } else if preserve_pattern_candidates &&
                              token_text(source, after) != "(" {
                        use_count = use_count + 1
                        if use_count > 256 {
                            return "error[E2S35]: lexical use limit is 256 per function at byte " +
                            to_text(cursor)
                        }
                        hir = hir + "candidate-use|" + to_text(cursor) + "|" +
                        to_text(token_end(source, cursor)) + "|" +
                        scope_id + "|" + name + "|" + role + "\n"
                    } else if token_text(source, after) != "(" &&
                              !unresolved_assignment {
                        let pending = hir_pending_declaration(
                            hir,
                            scope_id,
                            cursor,
                            name
                        )
                        if len(pending) > 0 {
                            return "error[E2S35]: binding `" + name +
                            "` is not initialized at byte " + to_text(cursor) +
                            "; declaration at byte " + pending
                        }
                        let escaped = hir_any_declaration(
                            hir,
                            scope_id,
                            cursor,
                            name
                        )
                        if len(escaped) > 0 {
                            return "error[E2S35]: binding `" + name +
                            "` is outside its lexical scope at byte " +
                            to_text(cursor) + "; declaration at byte " + escaped
                        }
                        # A declared Core function passed as an argument is
                        # that function used as a value. It is not a lexical
                        # binding, so nothing resolves it here, and reporting
                        # it as unknown would make the only way to pass a
                        # named function an error. Anywhere but argument
                        # position it stays unknown, so a function name in
                        # arithmetic is still this diagnostic.
                        # A module constant is not a lexical binding either: it
                        # is declared once at top level and is visible to every
                        # function, so no scope entry resolves it here.
                        if len(enum_constructor_owner(source, name)) == 0 &&
                           !constant_is_declared(source, name) &&
                           !(function_arity(source, name) >= 0 &&
                             call_argument_position(source, cursor)) {
                            let bit_error = int_bit_error_before_unresolved(
                                source,
                                hir,
                                cursor
                            )
                            if len(bit_error) > 0 {
                                return bit_error
                            }
                            return "error[E2S35]: unknown lexical binding `" +
                            name + "` at byte " + to_text(cursor)
                        }
                    }
                }
            }
            cursor = skip_trivia(source, token_end(source, cursor))
        }
        function_start = next_function_start(source, function_close)
    }
    return hir
}

fn build_scope_hir(source: Text) -> Text {
    return build_scope_hir_mode(source, false)
}

fn validate_enum_uses(source: Text, hir: Text) -> Text {
    let constructor_names = enum_declaration_names(source, true)
    if len(constructor_names) <= 1 {
        return "ok"
    }
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let parameters = parameter_open(source, function_start)
        let parameters_close = balanced_end(source, parameters, "(", ")")
        let mut function_open = skip_trivia(source, parameters_close)
        while function_open < function_close &&
              token_text(source, function_open) != "{" {
            function_open = skip_trivia(
                source,
                token_end(source, function_open)
            )
        }
        let mut related_identifiers = 0
        let mut cursor = skip_trivia(source, token_end(source, function_open))
        let mut previous = ""
        while cursor < function_close {
            if token_kind(source, cursor) == "identifier" {
                let name = token_text(source, cursor)
                let pattern_token = enum_match_pattern_token(
                    source,
                    function_open,
                    cursor
                )
                let initializer_token = enum_initializer_constructor_token(
                    source,
                    function_open,
                    cursor
                )
                let declaration_token = enum_declaration_syntax_token(
                    source,
                    function_open,
                    cursor
                )
                let binding_id = hir_use_binding_id(hir, cursor)
                let binding_type = hir_binding_field(hir, binding_id, 5)
                let binding_enum = len(binding_type) > 0 &&
                enum_constructor_count(source, binding_type) >= 0
                let constructor_named = contains(
                    constructor_names,
                    "|" + name + "|"
                )
                let related = pattern_token || initializer_token ||
                binding_enum ||
                (constructor_named && len(binding_id) == 0 &&
                 !declaration_token)
                if related {
                    related_identifiers = related_identifiers + 1
                    if related_identifiers > 256 {
                        return "error[E2S32]: enum-related identifier use limit is 256 per function at byte " +
                        to_text(cursor)
                    }
                    if !pattern_token && !initializer_token &&
                       !declaration_token {
                        if binding_enum {
                            let after = skip_trivia(
                                source,
                                token_end(source, cursor)
                            )
                            let match_scrutinee = previous == "match" &&
                            token_text(source, after) == "{"
                            let enum_argument =
                                call_argument_expected_type(
                                    source,
                                    cursor
                                ) == binding_type
                            let enum_return =
                                previous == "return" &&
                                function_return_type_containing(
                                    source,
                                    cursor
                                ) == binding_type
                            let bit_expression =
                                int_bit_expression_contains(source, cursor)
                            if !match_scrutinee && !enum_argument &&
                               !enum_return && !bit_expression {
                                return "error[E2S32]: concrete enum binding `" +
                                name +
                                "` is match-only in this Core slice at byte " +
                                to_text(cursor)
                            }
                        } else if constructor_named &&
                                  len(binding_id) == 0 {
                            let after = skip_trivia(
                                source,
                                token_end(source, cursor)
                            )
                            let resolved_function_call =
                            token_text(source, after) == "(" &&
                            function_arity(source, name) >= 0
                            if !resolved_function_call {
                                let constructor_owner = enum_constructor_owner(
                                    source,
                                    name
                                )
                                let enum_argument =
                                    len(constructor_owner) > 0 &&
                                    call_argument_expected_type(
                                        source,
                                        cursor
                                    ) == constructor_owner
                                let enum_return =
                                    len(constructor_owner) > 0 &&
                                    previous == "return" &&
                                    function_return_type_containing(
                                        source,
                                        cursor
                                    ) == constructor_owner
                                let bit_expression =
                                    int_bit_expression_contains(
                                        source,
                                        cursor
                                    )
                                if len(constructor_owner) > 0 &&
                                   !enum_argument && !enum_return &&
                                   !bit_expression {
                                    return "error[E2S32]: concrete enum constructor `" +
                                    name +
                                    "` is only valid in an explicitly typed enum initializer or match pattern at byte " +
                                    to_text(cursor)
                                }
                            }
                        }
                    }
                }
            }
            previous = token_text(source, cursor)
            cursor = skip_trivia(source, token_end(source, cursor))
        }
        function_start = next_function_start(source, function_close)
    }
    return "ok"
}

fn enum_match_end(source: Text, start: Int) -> Int {
    let value_start = skip_trivia(source, token_end(source, start))
    let arms_open = skip_trivia(source, token_end(source, value_start))
    if arms_open >= len(source) || token_text(source, arms_open) != "{" {
        return -1
    }
    return balanced_end(source, arms_open, "{", "}")
}

fn lower_enum_match(
    source: Text,
    hir: Text,
    match_start: Int,
    enum_type: Text,
    is_main: Bool,
    function_open: Int
) -> Text {
    let value_start = skip_trivia(source, token_end(source, match_start))
    let value_name = token_text(source, value_start)
    let arms_open = skip_trivia(source, token_end(source, value_start))
    if arms_open >= len(source) || token_text(source, arms_open) != "{" {
        return "error[E2S24]: expected `{` after enum match scrutinee at byte " +
        to_text(arms_open)
    }
    let mut arm_cursor = skip_trivia(source, token_end(source, arms_open))
    let mut covered = "|"
    let mut seen_catchall = false
    let mut dispatch = ""
    let mut dense_dispatch = ""
    let mut dense_eligible = true
    let mut failure_result = "0"
    if is_main {
        failure_result = "1"
    } else if enum_constructor_count(
        source,
        function_return_type_containing(source, function_open)
    ) >= 0 {
        failure_result = "KOFUN_ENUM_ZERO"
    }
    while arm_cursor < len(source) && token_text(source, arm_cursor) != "}" {
        let pattern_start = arm_cursor
        let pattern_info = pattern_summary(source, pattern_start)
        let pattern_kind = pattern_summary_kind(pattern_info)
        let pattern = token_text(source, pattern_start)
        let mut tag = -1
        if pattern_kind == "NamePattern" ||
           pattern_kind == "ConstructorPattern" {
            tag = enum_constructor_index(source, enum_type, pattern)
        }
        let binding_catchall =
            pattern_kind == "NamePattern" && tag < 0 &&
            enum_binding_catchall_name(pattern)
        let catchall =
            pattern_kind == "WildcardPattern" || binding_catchall
        if catchall {
            dense_eligible = false
        }
        if seen_catchall {
            return "error[E2S26]: pattern after catch-all is unreachable at byte " +
            to_text(pattern_start)
        }
        # `-1` means the arm binds no payload name.
        let mut payload_name_start = -1
        let mut catchall_name_start = -1
        if binding_catchall {
            catchall_name_start = pattern_start
        }
        if catchall {
            if enum_constructors_covered(source, enum_type, covered) {
                return "error[E2S26]: catch-all pattern is unreachable at byte " +
                to_text(pattern_start)
            }
        } else {
            if pattern_kind != "NamePattern" &&
               pattern_kind != "ConstructorPattern" {
                return "error[E2S32]: enum pattern must name a constructor or `_` at byte " +
                to_text(pattern_start)
            }
            if tag < 0 {
                return "error[E2S32]: constructor `" + pattern +
                "` does not belong to enum `" + enum_type + "` at byte " +
                to_text(pattern_start)
            }
            if contains(covered, "|" + pattern + "|") {
                return "error[E2S26]: duplicate enum constructor pattern `" +
                pattern + "` is unreachable at byte " +
                to_text(pattern_start)
            }
            let arity = enum_constructor_payload_arity(
                source,
                enum_type,
                pattern
            )
            let applied = pattern_kind == "ConstructorPattern"
            if arity < 0 {
                return "error[E2S32]: constructor `" + pattern +
                "` of enum `" + enum_type +
                "` declares a payload outside this Core slice; one `Int` " +
                "field is supported at byte " + to_text(pattern_start)
            }
            if arity != 0 {
                dense_eligible = false
            }
            if applied != (arity == 1) {
                let mut arity_message = "constructor pattern `" + pattern +
                "` takes no payload"
                if arity == 1 {
                    arity_message = "constructor pattern `" + pattern +
                    "` must bind its one `Int` payload or use `_`"
                }
                return "error[E2S32]: " + arity_message + " at byte " +
                to_text(pattern_start)
            }
            if applied {
                let open = skip_trivia(
                    source,
                    token_end(source, pattern_start)
                )
                let field = skip_trivia(source, token_end(source, open))
                let mut close = len(source)
                if field < len(source) {
                    close = skip_trivia(source, token_end(source, field))
                }
                let wildcard = token_text(source, field) == "_"
                let named = field < len(source) &&
                token_kind(source, field) == "identifier" && !wildcard
                if (!wildcard && !named) || close >= len(source) ||
                   token_text(source, close) != ")" {
                    return "error[E2S32]: constructor payload pattern must be one name or `_` at byte " +
                    to_text(field)
                }
                if named {
                    payload_name_start = field
                }
            }
        }
        let after_pattern = skip_trivia(
            source,
            pattern_summary_end(pattern_info)
        )
        let mut guarded = false
        let mut guard_start = -1
        let mut guard_end = -1
        let mut arrow = after_pattern
        if arrow < len(source) && token_text(source, arrow) == "if" {
            guarded = true
            dense_eligible = false
            guard_start = skip_trivia(source, token_end(source, arrow))
            guard_end = condition_end(source, guard_start)
            if guard_end < 0 {
                return "error[E2S29]: match guard must be Bool or an Int comparison at byte " +
                to_text(guard_start)
            }
            arrow = skip_trivia(source, guard_end)
        }
        if arrow >= len(source) || token_text(source, arrow) != "=>" {
            return "error[E2S24]: expected `=>` after enum pattern at byte " +
            to_text(arrow)
        }
        let arm_open = skip_trivia(source, token_end(source, arrow))
        if arm_open >= len(source) || token_text(source, arm_open) != "{" {
            return "error[E2S24]: bounded enum match arm must use a block at byte " +
            to_text(arm_open)
        }
        let arm_close = balanced_end(source, arm_open, "{", "}")
        if arm_close < 0 {
            return "error[E2S24]: missing `}` after enum match arm at byte " +
            to_text(arm_open)
        }
        let arm_body = lower_body(
            source,
            hir,
            arm_open,
            is_main,
            false,
            function_open
        )
        if starts_with(arm_body, "error[") {
            return arm_body
        }
        if !catchall && !guarded && payload_name_start < 0 {
            dense_dispatch = dense_dispatch +
            "            case INT64_C(" + to_text(tag) + "): {\n" +
            arm_body +
            "                break;\n" +
            "            }\n"
        }
        let mut pattern_condition = "true"
        if !catchall {
            pattern_condition = "kofun_match_value.tag == INT64_C(" +
            to_text(tag) + ")"
        }
        # The payload name is declared before the guard, not only before the
        # body, so `Present(value) if value > 5` reads the same local the arm
        # body reads.  The declaration is inside the arm's `if`, so it is only
        # in scope where the constructor actually matched.
        let mut payload_declaration = ""
        if payload_name_start >= 0 {
            let payload_id = hir_definition_id_at(hir, payload_name_start)
            if len(payload_id) == 0 {
                return "error[E2S32]: constructor payload binding is unresolved at byte " +
                to_text(payload_name_start)
            }
            payload_declaration = "            int64_t k_b" + payload_id +
            " = kofun_match_value.payload;\n" +
            "            (void)k_b" + payload_id + ";\n"
        } else if catchall_name_start >= 0 {
            let catchall_id = hir_definition_id_at(
                hir,
                catchall_name_start
            )
            if len(catchall_id) == 0 {
                return "error[E2S32]: enum catch-all binding is unresolved at byte " +
                to_text(catchall_name_start)
            }
            payload_declaration =
            "            KofunEnumValue k_b" + catchall_id +
            " = kofun_match_value;\n" +
            "            (void)k_b" + catchall_id + ";\n"
        }
        if guarded {
            dispatch = dispatch +
            "        if (!kofun_match_selected && " +
            pattern_condition + ") {\n" +
            payload_declaration +
            emit_condition_into(
                source,
                hir,
                guard_start,
                guard_end,
                "kofun_match_guard",
                failure_result,
                "            "
            ) +
            "            if (kofun_match_guard) {\n" +
            arm_body +
            "                kofun_match_selected = true;\n" +
            "            }\n" +
            "        }\n"
        } else {
            dispatch = dispatch +
            "        if (!kofun_match_selected && " +
            pattern_condition + ") {\n" +
            payload_declaration +
            arm_body +
            "            kofun_match_selected = true;\n" +
            "        }\n"
            if catchall {
                seen_catchall = true
            } else {
                covered = covered + pattern + "|"
            }
        }
        arm_cursor = skip_trivia(source, arm_close)
        if arm_cursor < len(source) && token_text(source, arm_cursor) == "," {
            arm_cursor = skip_trivia(source, token_end(source, arm_cursor))
        } else if arm_cursor >= len(source) ||
                  token_text(source, arm_cursor) != "}" {
            return "error[E2S24]: expected `,` between enum match arms at byte " +
            to_text(arm_cursor)
        }
    }
    if arm_cursor >= len(source) || token_text(source, arm_cursor) != "}" {
        return "error[E2S24]: missing `}` after enum match arms at byte " +
        to_text(arms_open)
    }
    if !seen_catchall &&
       !enum_constructors_covered(source, enum_type, covered) {
        return "error[E2S25]: non-exhaustive enum `" + enum_type +
        "` match; missing constructors " +
        enum_missing_constructors(source, enum_type, covered) +
        " at byte " + to_text(match_start)
    }
    let scrutinee_id = hir_use_binding_id(hir, value_start)
    if dense_eligible && !seen_catchall {
        return "    {\n" +
        "        KofunEnumValue kofun_match_value = k_b" + scrutinee_id +
        ";\n" +
        "        (void)kofun_match_value;\n" +
        "        switch (kofun_match_value.tag) {\n" +
        dense_dispatch +
        "        }\n" +
        "    }\n"
    }
    return "    {\n" +
    "        KofunEnumValue kofun_match_value = k_b" + scrutinee_id +
    ";\n" +
    "        (void)kofun_match_value;\n" +
    "        bool kofun_match_selected = false;\n" +
    dispatch +
    "    }\n"
}

# Lower a labelled construction as separate field assignments so the C output
# preserves the written evaluation order required by records-v1.
fn lower_record_binding(
    source: Text,
    hir: Text,
    function_open: Int,
    value_start: Int,
    record_type: Text,
    binding_id: Text
) -> Text {
    if value_start >= len(source) ||
       token_kind(source, value_start) != "identifier" {
        return "error[E2S32]: nominal record initializer must name its record type at byte " +
        to_text(value_start)
    }
    let constructor = annotation_type_text(source, value_start)
    if constructor != record_type {
        return "error[E2S32]: record constructor `" + constructor +
        "` does not construct `" + record_type + "` at byte " +
        to_text(value_start)
    }
    let open = skip_trivia(source, annotation_type_end(source, value_start))
    if open >= len(source) || token_text(source, open) != "(" {
        return "error[E2S32]: nominal record construction requires labelled fields at byte " +
        to_text(value_start)
    }
    let close = balanced_end(source, open, "(", ")")
    if close < 0 {
        return "error[E2S32]: unterminated nominal record construction at byte " +
        to_text(open)
    }
    let mut emitted = "    " + record_c_type_name(record_type) +
    " k_b" + binding_id + " = {0};\n"
    let mut covered = "|"
    let mut cursor = skip_trivia(source, token_end(source, open))
    while cursor < close && token_text(source, cursor) != ")" {
        if token_kind(source, cursor) != "identifier" {
            return "error[E2S32]: expected nominal record field label at byte " +
            to_text(cursor)
        }
        let field = token_text(source, cursor)
        let field_index = record_field_index(source, record_type, field)
        if field_index < 0 {
            return "error[E2S32]: record `" + record_type +
            "` has no field `" + field + "` at byte " + to_text(cursor)
        }
        if contains(covered, "|" + field + "|") {
            return "error[E2S32]: record field `" + field +
            "` is initialized more than once at byte " + to_text(cursor)
        }
        covered = covered + field + "|"
        let colon = skip_trivia(source, token_end(source, cursor))
        if token_text(source, colon) != ":" {
            return "error[E2S32]: record construction requires `field: value` at byte " +
            to_text(cursor)
        }
        let value = skip_trivia(source, token_end(source, colon))
        let expected = record_field_text(
            source,
            record_type,
            field_index,
            true
        )
        let mut end = expression_end(source, value)
        if token_text(source, value) == "true" ||
           token_text(source, value) == "false" {
            end = token_end(source, value)
        }
        if end < 0 {
            return "error[E2S32]: invalid nominal record field value at byte " +
            to_text(value)
        }
        let actual = initializer_type(
            source,
            hir,
            function_open,
            value
        )
        if actual != expected {
            return "error[E2S32]: record field `" + field +
            "` expects " + expected + ", got " + actual + " at byte " +
            to_text(value)
        }
        let mut field_value = emit_expression(source, hir, value, end)
        if token_text(source, value) == "true" ||
           token_text(source, value) == "false" {
            field_value = token_text(source, value)
        }
        emitted = emitted + "    k_b" + binding_id + "." +
        record_c_field_name(field) + " = " + field_value + ";\n"
        let separator = skip_trivia(source, end)
        if separator < close && token_text(source, separator) == "," {
            cursor = skip_trivia(source, token_end(source, separator))
        } else if separator == close ||
                  token_text(source, separator) == ")" {
            cursor = separator
        } else {
            return "error[E2S32]: expected `,` between nominal record fields at byte " +
            to_text(separator)
        }
    }
    let fields = record_field_count(source, record_type)
    let mut index = 0
    while index < fields {
        let field = record_field_text(
            source,
            record_type,
            index,
            false
        )
        if !contains(covered, "|" + field + "|") {
            return "error[E2S32]: record construction is missing field `" +
            field + "` at byte " + to_text(value_start)
        }
        index = index + 1
    }
    return emitted
}

# The RFC-0003 postfix forms, recognised as themselves rather than left to a
# generic refusal (#1160). Returns the byte of the `spawn` or `join` token when
# the statement starting at `start` is `<name>.spawn(` or `<name>.join(`, and
# -1 otherwise.
#
# Neither word is reserved, so this deliberately requires the call parenthesis:
# `type P = { join: Int }` is legal Kofun, and a bare `p.join` read is a field
# access this must not claim.
# The `par |scope| { ... }` production (#1160). Returns "" when the form is
# well shaped, and otherwise the refusal for the token that does not fit.
#
# Without this every malformed `par` reported the same sentence at the `par`
# token: a missing block, a missing scope name and a missing bar were one
# message at one byte, so the diagnostic said a construct was unimplemented
# rather than that it was mistyped. The construct is still unimplemented — that
# refusal is below, and reached only when the shape is right.
# The first `.spawn(` between `open` and `close`, or -1. Scanned rather than
# resolved: this runs before any binding exists, and the rule it serves is
# lexical by definition.
fn par_spawn_site_within(source: Text, open: Int, close: Int) -> Int {
    let mut cursor = skip_trivia(source, token_end(source, open))
    while cursor < close {
        if token_text(source, cursor) == "." {
            let member = skip_trivia(source, token_end(source, cursor))
            if member < close && token_text(source, member) == "spawn" {
                let call = skip_trivia(source, token_end(source, member))
                if call < close && token_text(source, call) == "(" {
                    return member
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return -1
}

# The block a loop header opens, or -1 when it opens none before `limit`.
fn par_loop_block_open(source: Text, at: Int, limit: Int) -> Int {
    let mut cursor = skip_trivia(source, token_end(source, at))
    while cursor < limit {
        let token = token_text(source, cursor)
        if token == "{" {
            return cursor
        }
        if token == "}" {
            return -1
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return -1
}

# Whether `name` is the binding a `spawn` produced, by finding its `let` in
# the scope block and asking what its right-hand side is. An alias binds an
# identifier rather than a call — `let alias = handle` — so it answers false
# and its `join` is refused by name instead of followed to the handle. A name
# with no `let` in the block is not a handle either, so it answers false too.
fn par_spawn_bound_handle(
    source: Text,
    name: Text,
    block_open: Int,
    block_close: Int
) -> Bool {
    let mut cursor = skip_trivia(source, token_end(source, block_open))
    while cursor < block_close {
        if token_text(source, cursor) == "let" {
            let mut bound = skip_trivia(source, token_end(source, cursor))
            if bound < block_close && token_text(source, bound) == "mut" {
                bound = skip_trivia(source, token_end(source, bound))
            }
            if bound < block_close && token_text(source, bound) == name {
                # Step over an optional annotation to the `=`. The `let` guard
                # stops a malformed binding from running into the next
                # statement and reading its value as this one's.
                let mut assign = skip_trivia(source, token_end(source, bound))
                while assign < block_close &&
                      token_text(source, assign) != "=" &&
                      token_text(source, assign) != "let" {
                    assign = skip_trivia(source, token_end(source, assign))
                }
                if assign < block_close && token_text(source, assign) == "=" {
                    let value = skip_trivia(source, token_end(source, assign))
                    let member = scoped_parallel_member(source, value)
                    if member >= 0 && token_text(source, member) == "spawn" {
                        return true
                    }
                }
                # The first binding of this name decides it; a later one
                # cannot make an alias into a handle.
                return false
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

# The v1 finite lexical spawn-site rule (RFC-0003, #1160). The four shapes the
# specification leaves unsupported rather than inferred, refused by name so a
# reader is not told they are merely unimplemented like the scope itself:
#
#   - a `par` inside a `par` block — v1 has one scope, not a tree of them;
#   - a `spawn` inside a loop — a scope's spawn sites must be finite and
#     lexically enumerable, and a loop makes the count depend on execution;
#   - a `spawn` on anything but the token `par |...|` named — selecting the
#     scope dynamically is what makes a spawn site unenumerable, and an alias
#     of the token is already that selection;
#   - a `join` on anything but the binding a `spawn` produced — following an
#     alias to its handle is the inference v1 declines to make.
#
# The walk reports the first offending construct in source order and names the
# construct's own token, not the enclosing `par`.
fn par_scope_rule_error(
    source: Text,
    scope_token: Int,
    block_open: Int,
    block_close: Int
) -> Text {
    let scope_name = token_text(source, scope_token)
    let mut cursor = skip_trivia(source, token_end(source, block_open))
    while cursor < block_close {
        let token = token_text(source, cursor)
        if token == "par" {
            return "error[E2S154]: scoped parallelism v1 has one scope; a `par` scope may not contain another at byte " +
            to_text(cursor)
        }
        let member = scoped_parallel_member(source, cursor)
        if member >= 0 {
            let member_name = token_text(source, member)
            if member_name == "spawn" && token != scope_name {
                return "error[E2S154]: scoped parallelism v1 spawns only on the scope token `" +
                scope_name + "` that `par` named; `" + token +
                "` is not it at byte " + to_text(cursor)
            }
            if member_name == "join" &&
               !par_spawn_bound_handle(
                   source,
                   token,
                   block_open,
                   block_close
               ) {
                return "error[E2S154]: scoped parallelism v1 joins only the binding a `spawn` produced; `" +
                token + "` is not one at byte " + to_text(cursor)
            }
        }
        if token == "while" || token == "for" {
            let loop_open = par_loop_block_open(source, cursor, block_close)
            if loop_open >= 0 {
                let loop_close = balanced_end(source, loop_open, "{", "}")
                if loop_close >= 0 {
                    let spawn_at = par_spawn_site_within(
                        source,
                        loop_open,
                        loop_close
                    )
                    if spawn_at >= 0 {
                        return "error[E2S154]: scoped parallelism v1 needs finite lexical spawn sites; `spawn` inside a loop is not supported at byte " +
                        to_text(spawn_at)
                    }
                }
            }
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return ""
}

fn par_production_error(source: Text, at: Int) -> Text {
    let bar_open = skip_trivia(source, token_end(source, at))
    if bar_open >= len(source) || token_text(source, bar_open) != "|" {
        return "error[E2S154]: scoped parallelism `par` expects `|scope|` at byte " +
        to_text(bar_open)
    }
    let name = skip_trivia(source, token_end(source, bar_open))
    if name >= len(source) || token_kind(source, name) != "identifier" {
        return "error[E2S154]: scoped parallelism `par` expects a scope token between `|` and `|` at byte " +
        to_text(name)
    }
    let bar_close = skip_trivia(source, token_end(source, name))
    if bar_close >= len(source) || token_text(source, bar_close) != "|" {
        return "error[E2S154]: scoped parallelism `par` expects `|` after the scope token at byte " +
        to_text(bar_close)
    }
    let block = skip_trivia(source, token_end(source, bar_close))
    if block >= len(source) || token_text(source, block) != "{" {
        return "error[E2S154]: scoped parallelism `par` expects `{` after `|scope|` at byte " +
        to_text(block)
    }
    let block_close = balanced_end(source, block, "{", "}")
    if block_close >= 0 {
        let rule_fault = par_scope_rule_error(
            source,
            name,
            block,
            block_close
        )
        if len(rule_fault) > 0 {
            return rule_fault
        }
    }
    # No check for an unbalanced block: an unclosed `{` leaves the enclosing
    # function unbalanced too, and `E2S03: malformed function` is reported
    # before this is reached. A branch here would be unreachable.
    return ""
}

fn scoped_parallel_member(source: Text, start: Int) -> Int {
    if token_kind(source, start) != "identifier" {
        return -1
    }
    let dot = skip_trivia(source, token_end(source, start))
    if dot >= len(source) || token_text(source, dot) != "." {
        return -1
    }
    let member = skip_trivia(source, token_end(source, dot))
    if member >= len(source) {
        return -1
    }
    let name = token_text(source, member)
    if name != "spawn" && name != "join" {
        return -1
    }
    let open = skip_trivia(source, token_end(source, member))
    if open >= len(source) || token_text(source, open) != "(" {
        return -1
    }
    return member
}

fn lower_body(
    source: Text,
    hir: Text,
    open: Int,
    is_main: Bool,
    append_default: Bool,
    function_open: Int
) -> Text {
    let mut emitted = ""
    if open == function_open {
        # Prologue order is part of the emitted bytes: optional coalescing,
        # then the one shared fixed-slot walker.
        emitted = emit_optional_int_coalescing_temporaries(
            source,
            function_open
        )
        emitted = emitted + emit_fixed_slot_call_temporaries(
            source,
            hir,
            function_open
        )
    }
    let mut cursor = skip_trivia(source, token_end(source, open))
    let mut returned = false
    let result_type = function_return_type_containing(
        source,
        function_open
    )
    let returns_enum = enum_constructor_count(source, result_type) >= 0
    let returns_record =
        record_declaration_start(source, result_type) >= 0
    let returns_optional_int = optional_int_result_containing(
        source,
        function_open
    )
    let returns_text = result_type == "Text"
    let returns_list_int = result_type == "List[Int]"
    let mut failure_result = "0"
    if is_main {
        failure_result = "1"
    } else if returns_enum {
        failure_result = "KOFUN_ENUM_ZERO"
    } else if returns_record {
        failure_result = "((" + record_c_type_name(result_type) + "){0})"
    } else if returns_optional_int {
        failure_result = "KOFUN_OPTIONAL_INT_NONE"
    } else if returns_text {
        # A failed Text result is the empty string rather than NULL, so every
        # consumer in the bounded profile still receives a readable value.
        failure_result = "\"\""
    } else if returns_list_int {
        failure_result = "KOFUN_LIST_INT_ZERO"
    }
    while cursor < len(source) && token_text(source, cursor) != "}" {
        if returned {
            return "error[E2S14]: statement follows `return` at byte " +
            to_text(cursor)
        }
        let statement = token_text(source, cursor)
        # See selfhost_parse_primary: refuse `par` before the dispatch below can
        # read the scope token as an ordinary binding and blame it instead.
        if statement == "par" {
            # Shape first, so a mistyped `par` is reported where it is wrong.
            let par_fault = par_production_error(source, cursor)
            if len(par_fault) > 0 {
                return par_fault
            }
            return "error[E2S154]: scoped parallelism `par` is specified " +
            "but not implemented at byte " + to_text(cursor)
        }
        # The other two RFC-0003 forms, refused here for the same reason `par`
        # is (#1160). Left to the dispatch below, `handle.join()` is partly
        # consumed as an expression and the refusal lands on the leftover `)`
        # — the reader is sent to punctuation instead of to `join`.
        let parallel_member = scoped_parallel_member(source, cursor)
        if parallel_member >= 0 {
            return "error[E2S154]: scoped parallelism `" +
            token_text(source, parallel_member) +
            "` is specified but not implemented at byte " +
            to_text(parallel_member)
        }
        if move_statement_head(source, cursor) {
            # #946: the whole-binding move statement. `validate_move_uses` has
            # already refused every use that outlives it, so nothing is left to
            # check here and nothing is left to run: this slice's values are
            # Int/Bool nominal records, which have no destructor and no drop,
            # so a move is a fact about names rather than an operation.
            #
            # The binding is still spelled once, as a cast to void. A `let`
            # that is constructed and then only moved would otherwise be set
            # and never read, and the gates build the emitted C with
            # `-Wall -Wextra -Werror`. Without this line the move statement
            # would compile the program that contains it and fail the one
            # beside it, which is not a boundary a user could predict.
            let moved = skip_trivia(source, token_end(source, cursor))
            let moved_id = hir_use_binding_id(hir, moved)
            if len(moved_id) > 0 {
                emitted = emitted + "    (void)k_b" + moved_id + ";\n"
            }
            cursor = skip_trivia(source, token_end(source, moved))
            continue
        }
        if statement == "let" {
            cursor = skip_trivia(source, token_end(source, cursor))
            let mut mutable = false
            if cursor < len(source) && token_text(source, cursor) == "mut" {
                mutable = true
                cursor = skip_trivia(source, token_end(source, cursor))
            }
            if cursor >= len(source) ||
               token_kind(source, cursor) != "identifier" {
                return "error[E2S11]: expected binding name at byte " +
                to_text(cursor)
            }
            let name = token_text(source, cursor)
            let binding_id = hir_definition_id_at(hir, cursor)
            let storage = "k_b" + binding_id
            cursor = skip_trivia(source, token_end(source, cursor))
            let mut binding_type = "Int"
            if cursor < len(source) && token_text(source, cursor) == ":" {
                cursor = skip_trivia(source, token_end(source, cursor))
                if cursor >= len(source) ||
                   token_kind(source, cursor) != "identifier" {
                    return "error[E2S11]: expected Core binding type at byte " +
                    to_text(cursor)
                }
                let optional_end = optional_int_type_end(source, cursor)
                let mut list_end = -1
                if optional_end >= 0 {
                    binding_type = "Int?"
                    cursor = skip_trivia(source, optional_end)
                } else {
                    list_end = list_int_type_end(source, cursor)
                    if list_end >= 0 {
                        binding_type = "List[Int]"
                    } else {
                        binding_type = annotation_type_text(source, cursor)
                    }
                }
                if binding_type != "Int" &&
                   binding_type != "Int?" &&
                   binding_type != "Text" &&
                   binding_type != "List[Int]" &&
                   binding_type != "Decimal" &&
                   binding_type != "Float" &&
                   binding_type != "DecimalResult" &&
                   enum_constructor_count(source, binding_type) < 0 &&
                   record_declaration_start(source, binding_type) < 0 {
                    return "error[E2S32]: unknown supported aggregate type `" +
                    binding_type + "` at byte " + to_text(cursor)
                }
                if optional_end < 0 {
                    cursor = skip_trivia(
                        source,
                        if list_end >= 0 {
                            list_end
                        } else {
                            annotation_type_end(source, cursor)
                        }
                    )
                }
            }
            if cursor >= len(source) || token_text(source, cursor) != "=" {
                return "error[E2S11]: expected `=` at byte " + to_text(cursor)
            }
            let value_start = skip_trivia(source, token_end(source, cursor))
            if binding_type == "Int?" {
                if mutable {
                    return "error[E2S147]: mutable `Int?` bindings are " +
                    "outside this lowering slice; declare `let` and " +
                    "construct a new value instead at byte " +
                    to_text(value_start)
                }
                let value_end = expression_end(source, value_start)
                if value_start >= len(source) || value_end < 0 {
                    return "error[E2S147]: an `Int?` binding is initialized " +
                    "by `null`, an `Int`, another `Int?` binding, or a call " +
                    "returning `Int?` at byte " + to_text(value_start)
                }
                let value = optional_int_value(
                    source,
                    hir,
                    value_start,
                    value_end
                )
                if starts_with(value, "error[") {
                    return value
                }
                emitted = emitted + "    KofunOptionalInt " + storage +
                " = " + value + ";\n" +
                "    if (kofun_failed) return " + failure_result + ";\n"
                cursor = skip_trivia(source, value_end)
            } else if binding_type != "Int" &&
               binding_type != "Text" &&
               binding_type != "Decimal" &&
               binding_type != "Float" &&
               binding_type != "DecimalResult" {
                if record_declaration_start(source, binding_type) >= 0 {
                    if mutable {
                        return "error[E2S32]: nominal record bindings are immutable in this slice at byte " +
                        to_text(value_start)
                    }
                    if token_kind(source, value_start) != "identifier" {
                        return "error[E2S32]: nominal record initializer must name its record type at byte " +
                        to_text(value_start)
                    }
                    let initializer = annotation_type_text(source, value_start)
                    if initializer != binding_type {
                        let value_end = expression_end(source, value_start)
                        let value = emit_record_value(
                            source,
                            hir,
                            value_start,
                            value_end,
                            binding_type
                        )
                        if starts_with(value, "error[") {
                            return value
                        }
                        emitted = emitted + "    " +
                        record_c_type_name(binding_type) + " " + storage +
                        " = " + value + ";\n" +
                        "    if (kofun_failed) return " +
                        failure_result + ";\n"
                        cursor = skip_trivia(source, value_end)
                    } else {
                        let record_body = lower_record_binding(
                            source,
                            hir,
                            function_open,
                            value_start,
                            binding_type,
                            binding_id
                        )
                        if starts_with(record_body, "error[") {
                            return record_body
                        }
                        emitted = emitted + record_body
                        let record_open = skip_trivia(
                            source,
                            annotation_type_end(source, value_start)
                        )
                        cursor = skip_trivia(
                            source,
                            balanced_end(source, record_open, "(", ")")
                        )
                    }
                } else {
                if mutable {
                    return "error[E2S32]: concrete enum bindings are immutable in this Core slice at byte " +
                    to_text(value_start)
                }
                if token_kind(source, value_start) != "identifier" {
                    return "error[E2S32]: concrete enum initializer must name a constructor at byte " +
                    to_text(value_start)
                }
                let constructor = token_text(source, value_start)
                let initializer_open = skip_trivia(
                    source,
                    token_end(source, value_start)
                )
                let enum_call =
                    initializer_open < len(source) &&
                    token_text(source, initializer_open) == "(" &&
                    function_return_type(source, constructor) == binding_type
                if enum_call {
                    let value_end = expression_end(source, value_start)
                    let value = emit_enum_value(
                        source,
                        hir,
                        value_start,
                        value_end,
                        binding_type
                    )
                    if starts_with(value, "error[") {
                        return value
                    }
                    emitted = emitted + "    KofunEnumValue " + storage +
                    " = " + value + ";\n" +
                    "    if (kofun_failed) return " + failure_result + ";\n"
                    cursor = skip_trivia(source, value_end)
                } else {
                let tag = enum_constructor_index(
                    source,
                    binding_type,
                    constructor
                )
                if tag < 0 {
                    return "error[E2S32]: constructor `" + constructor +
                    "` does not belong to enum `" + binding_type +
                    "` at byte " + to_text(value_start)
                }
                let arity = enum_constructor_payload_arity(
                    source,
                    binding_type,
                    constructor
                )
                let after_constructor = skip_trivia(
                    source,
                    token_end(source, value_start)
                )
                let applied = after_constructor < len(source) &&
                token_text(source, after_constructor) == "("
                if arity < 0 {
                    return "error[E2S32]: constructor `" + constructor +
                    "` of enum `" + binding_type +
                    "` declares a payload outside this Core slice; one `Int` " +
                    "field is supported at byte " + to_text(value_start)
                }
                if applied != (arity == 1) {
                    let mut arity_message = "constructor `" + constructor +
                    "` takes no payload"
                    let mut arity_byte = value_start
                    if arity == 1 {
                        arity_message = "constructor `" + constructor +
                        "` takes one `Int` payload"
                    } else {
                        arity_byte = after_constructor
                    }
                    return "error[E2S32]: " + arity_message + " at byte " +
                    to_text(arity_byte)
                }
                # Every concrete enum binding holds a tag and one payload slot,
                # whether or not its constructor carries a field.  A match arm
                # can then read the payload without first proving which
                # constructor produced the value, and the two locals stay in
                # step through every later assignment.
                let mut constructor_end = token_end(source, value_start)
                if arity == 1 {
                    let payload_start = skip_trivia(
                        source,
                        token_end(source, after_constructor)
                    )
                    let payload_end = expression_end(source, payload_start)
                    let mut close = -1
                    if payload_end >= 0 {
                        close = skip_trivia(source, payload_end)
                    }
                    if payload_end < 0 || close >= len(source) ||
                       token_text(source, close) != ")" {
                        return "error[E2S32]: concrete enum payload must be one Int expression at byte " +
                        to_text(payload_start)
                    }
                    emitted = emitted + "    KofunEnumValue " + storage +
                    " = {INT64_C(" + to_text(tag) + "), " +
                    emit_expression(source, hir, payload_start, payload_end) +
                    "};\n" +
                    "    if (kofun_failed) return " + failure_result + ";\n"
                    constructor_end = token_end(source, close)
                } else {
                    emitted = emitted + "    KofunEnumValue " + storage +
                    " = {INT64_C(" + to_text(tag) +
                    "), INT64_C(0)};\n"
                }
                cursor = skip_trivia(source, constructor_end)
                }
                }
            } else if lambda_initializer_open(source, value_start) >= 0 {
                # A lambda binding names a lifted top-level function rather
                # than holding an `int64_t`, so this statement emits nothing.
                # Without this the initializer reaches the Int expression
                # grammar and is rejected as `E2S12`, which is what #703
                # measured.
                cursor = skip_trivia(
                    source,
                    lambda_parameters_end(
                        source,
                        -1,
                        lambda_initializer_open(source, value_start)))
            } else if value_control(token_text(source, value_start)) {
                let value_check = validate_value_control(source, hir, value_start)
                if starts_with(value_check, "error[") {
                    return value_check
                }
                let value_end = value_end(source, value_start)
                emitted = emitted + "    int64_t " + storage +
                " = INT64_C(0);\n" +
                emit_value_into(
                    source,
                    hir,
                    value_start,
                    value_end,
                    storage,
                    failure_result
                )
                cursor = skip_trivia(source, value_end)
            } else {
                let value_end = expression_end(source, value_start)
                if value_end < 0 {
                    return "error[E2S12]: invalid Int expression at byte " +
                    to_text(value_start)
                }
                let mut initializer = emit_expression(
                    source,
                    hir,
                    value_start,
                    value_end
                )
                # A rejected initializer became the C initializer text.
                if starts_with(initializer, "error[") {
                    return initializer
                }
                let inferred_type = hir_binding_field(hir, binding_id, 5)
                let actual_type = initializer_type(
                    source,
                    hir,
                    function_open,
                    value_start
                )
                if actual_type != inferred_type {
                    return "error[E2S15]: initializer type mismatch at byte " +
                    to_text(value_start)
                }
                if inferred_type == "List[Int]" {
                    initializer = emit_list_int_value(
                        source,
                        hir,
                        value_start,
                        value_end,
                        true
                    )
                    if starts_with(initializer, "error[") {
                        return initializer
                    }
                }
                # The carrier an inferred binding gets is the carrier its type
                # already names. A nominal record was the one type with no row
                # here, so it fell through to `int64_t` and every later use of
                # the name became a member access on a scalar -- accepted by
                # the checker, rejected by `cc`, in a file the author did not
                # write.
                #
                # The record row derives its C type from
                # `record_c_type_name`, which is what the *annotated* binding
                # path uses, so the two spellings of one binding cannot
                # disagree. It is not written as a call to
                # `call_slot_declaration_prefix`, which carries the same
                # vocabulary: that helper returns a trailing space this site
                # does not want, and it does not know `Decimal`, `Float`, or
                # `DecimalResult`, so folding the two ladders together here
                # would trade this defect for those three.
                let mut c_type = "int64_t"
                if inferred_type == "Decimal" {
                    c_type = "KofunDecimal *"
                } else if inferred_type == "Float" {
                    c_type = "double"
                } else if inferred_type == "DecimalResult" {
                    c_type = "KofunDecimalResult *"
                } else if inferred_type == "Text" {
                    c_type = "const char *"
                } else if inferred_type == "List[Int]" {
                    c_type = "KofunIntListValue"
                } else if record_declaration_start(source, inferred_type) >= 0 {
                    c_type = record_c_type_name(inferred_type)
                }
                if mutable && inferred_type != "Int" &&
                   inferred_type != "List[Int]" {
                    return "error[E2S144]: mutable Decimal, DecimalResult, Float, and Text bindings are outside this lowering slice at byte " +
                    to_text(value_start)
                }
                emitted = emitted + "    " + c_type + " " + storage + " = " +
                initializer + ";\n" +
                "    if (kofun_failed) return " + failure_result + ";\n"
                cursor = skip_trivia(source, value_end)
            }
        } else if statement == "print" {
            let call_open = skip_trivia(source, token_end(source, cursor))
            if call_open >= len(source) ||
               token_text(source, call_open) != "(" {
                return "error[E2S13]: expected `print(` at byte " +
                to_text(cursor)
            }
            let value_start = skip_trivia(source, token_end(source, call_open))
            if value_control(token_text(source, value_start)) {
                let value_check = validate_value_control(source, hir, value_start)
                if starts_with(value_check, "error[") {
                    return value_check
                }
                let value_end = value_end(source, value_start)
                let call_close = skip_trivia(source, value_end)
                if call_close >= len(source) ||
                   token_text(source, call_close) != ")" {
                    return "error[E2S13]: expected `)` at byte " +
                    to_text(call_close)
                }
                emitted = emitted +
                "    {\n" +
                "        int64_t kofun_value = INT64_C(0);\n" +
                emit_value_into(
                    source,
                    hir,
                    value_start,
                    value_end,
                    "kofun_value",
                    failure_result
                ) +
                "        printf(\"%\" PRId64 \"\\n\", kofun_value);\n" +
                "    }\n"
                cursor = skip_trivia(source, token_end(source, call_close))
            } else {
                let value_end = expression_end(source, value_start)
                if value_end < 0 {
                    return "error[E2S12]: invalid Int expression at byte " +
                    to_text(value_start)
                }
                let call_close = skip_trivia(source, value_end)
                if call_close >= len(source) ||
                   token_text(source, call_close) != ")" {
                    return "error[E2S13]: expected `)` at byte " +
                    to_text(call_close)
                }
                let value = emit_expression(
                    source,
                    hir,
                    value_start,
                    value_end
                )
                # `print` formatted this straight into the emitted C without
                # the `error[` check every other statement performs, so a
                # rejected argument reached the output instead of the caller.
                if starts_with(value, "error[") {
                    return value
                }
                let value_type = initializer_type(
                    source,
                    hir,
                    function_open,
                    value_start
                )
                if value_type == "Decimal" {
                    emitted = emitted + "    {\n" +
                    "        KofunDecimal *kofun_value = " + value + ";\n" +
                    "        char *kofun_text = kofun_decimal_to_canonical_text(kofun_value);\n" +
                    "        printf(\"%s\\n\", kofun_text);\n" +
                    "        free(kofun_text);\n" + "    }\n"
                } else if value_type == "Float" {
                    emitted = emitted + "    {\n" +
                    "        double kofun_value = " + value + ";\n" +
                    "        printf(\"%.17g\\n\", kofun_value);\n" +
                    "    }\n"
                } else if value_type == "DecimalResult" {
                    emitted = emitted + "    {\n" +
                    "        KofunDecimalResult *kofun_value = " + value +
                    ";\n" + "        printf(\"%s\\n\", " +
                    "kofun_decimal_value_division_name(kofun_value));\n" +
                    "    }\n"
                } else if value_type == "Text" {
                    emitted = emitted + "    {\n" +
                    "        const char *kofun_value = " + value + ";\n" +
                    "        if (kofun_failed) return " + failure_result +
                    ";\n" +
                    "        printf(\"%s\\n\", kofun_value);\n" +
                    "    }\n"
                } else {
                    emitted = emitted + "    {\n" +
                    "        int64_t kofun_value = " + value + ";\n" +
                    "        if (kofun_failed) return " + failure_result +
                    ";\n" +
                    "        printf(\"%\" PRId64 \"\\n\", kofun_value);\n" +
                    "    }\n"
                }
                cursor = skip_trivia(source, token_end(source, call_close))
            }
        } else if statement == "if" &&
                  final_result_if(
                      source,
                      cursor,
                      is_main,
                      append_default,
                      returns_enum,
                      returns_record
                  ) {
            # The final `if` of a result-carrying function is its result, and
            # its type is the join of the two branch types (#550). The join and
            # the lowering are the ones `return if ... { } else { }` already
            # uses, so this position gains no rules of its own — it reaches the
            # same validator and the same emitter.
            #
            # Every path has to produce a value, so an `if` without `else` is
            # refused here rather than falling through to the statement form,
            # where it would have become a body that reaches its closing brace.
            if !if_has_else(source, cursor) {
                return "error[E2S27]: a final `if` needs an `else`; its false path yields no Int at byte " +
                to_text(cursor)
            }
            let value_check = validate_value_if(source, cursor)
            if starts_with(value_check, "error[") {
                return value_check
            }
            let branch_end = value_if_end(source, cursor)
            emitted = emitted +
            "    {\n" +
            "        int64_t kofun_result = INT64_C(0);\n" +
            emit_value_into(
                source,
                hir,
                cursor,
                branch_end,
                "kofun_result",
                failure_result
            ) +
            "        return kofun_result;\n" +
            "    }\n"
            returned = true
            cursor = skip_trivia(source, branch_end)
        } else if statement == "if" {
            # `else if` is two keywords, not a compound one
            # (spec/syntax/FOUNDATIONS_AND_CONTROL.md), and
            # `spec/semantics.md` already states its evaluation rule: a branch
            # that is not taken evaluates neither its body nor a later
            # `else if` condition. Emitting each link inside the previous
            # link's `else` is what makes that true here, because a later
            # condition's C prelude is then only reached when every earlier
            # condition was false.
            #
            # So the chain is emitted iteratively: each `else if` opens one
            # `else {` that stays open until the chain ends, and the opened
            # braces are closed together afterwards. `chain_depth` counts them.
            let mut chain_depth = 0
            let mut chain_open = cursor
            let mut chaining = true
            while chaining {
                chaining = false
                let condition_start = skip_trivia(
                    source,
                    token_end(source, chain_open)
                )
                let condition_close = condition_end(source, condition_start)
                if condition_close < 0 {
                    return "error[E2S23]: if condition must be Bool or an Int comparison at byte " +
                    to_text(condition_start)
                }
                let branch_open = skip_trivia(source, condition_close)
                if branch_open >= len(source) ||
                   token_text(source, branch_open) != "{" {
                    return "error[E2S18]: expected `{` after if condition at byte " +
                    to_text(branch_open)
                }
                let branch_close = balanced_end(source, branch_open, "{", "}")
                if branch_close < 0 {
                    return "error[E2S18]: missing `}` after if branch at byte " +
                    to_text(branch_open)
                }
                let branch_body = lower_body(
                    source,
                    hir,
                    branch_open,
                    is_main,
                    false,
                    function_open
                )
                if starts_with(branch_body, "error[") {
                    return branch_body
                }
                let condition = emit_condition_into(
                    source,
                    hir,
                    condition_start,
                    condition_close,
                    "kofun_condition",
                    failure_result,
                    "        "
                )
                # A rejected condition became the statement's C prelude.
                if starts_with(condition, "error[") {
                    return condition
                }
                if chain_depth == 0 {
                    emitted = emitted + "    {\n"
                }
                emitted = emitted +
                condition +
                "        if (kofun_condition) {\n" +
                branch_body +
                "        }"
                cursor = skip_trivia(source, branch_close)
                if cursor < len(source) && token_text(source, cursor) == "else" {
                    let else_open = skip_trivia(
                        source,
                        token_end(source, cursor)
                    )
                    if else_open < len(source) &&
                       token_text(source, else_open) == "if" {
                        # Another link. Its condition is lowered on the next
                        # pass, inside the `else` opened here.
                        emitted = emitted + " else {\n"
                        chain_depth = chain_depth + 1
                        chain_open = else_open
                        chaining = true
                    } else {
                        if else_open >= len(source) ||
                           token_text(source, else_open) != "{" {
                            return "error[E2S18]: expected `{` after `else` at byte " +
                            to_text(else_open)
                        }
                        let else_close = balanced_end(
                            source,
                            else_open,
                            "{",
                            "}"
                        )
                        if else_close < 0 {
                            return "error[E2S18]: missing `}` after else branch at byte " +
                            to_text(else_open)
                        }
                        let else_body = lower_body(
                            source,
                            hir,
                            else_open,
                            is_main,
                            false,
                            function_open
                        )
                        if starts_with(else_body, "error[") {
                            return else_body
                        }
                        emitted = emitted +
                        " else {\n" + else_body + "        }"
                        cursor = skip_trivia(source, else_close)
                    }
                }
            }
            let mut chain_closed = 0
            while chain_closed < chain_depth {
                emitted = emitted + "\n        }"
                chain_closed = chain_closed + 1
            }
            emitted = emitted + "\n    }\n"
        } else if statement == "while" {
            # #1128. Structurally `if` without the else, but the condition
            # belongs *inside* the emitted loop: `emit_condition_into` returns
            # a C prelude that computes into the target, so hoisting it above
            # `for` would evaluate it once and never again.
            let condition_start = skip_trivia(
                source,
                token_end(source, cursor)
            )
            let condition_close = condition_end(source, condition_start)
            if condition_close < 0 {
                return "error[E2S23]: while condition must be Bool or an Int comparison at byte " +
                to_text(condition_start)
            }
            let body_open = skip_trivia(source, condition_close)
            if body_open >= len(source) ||
               token_text(source, body_open) != "{" {
                return "error[E2S18]: expected `{` after while condition at byte " +
                to_text(body_open)
            }
            let body_close = balanced_end(source, body_open, "{", "}")
            if body_close < 0 {
                return "error[E2S18]: missing `}` after while body at byte " +
                to_text(body_open)
            }
            let loop_body = lower_body(
                source,
                hir,
                body_open,
                is_main,
                false,
                function_open
            )
            if starts_with(loop_body, "error[") {
                return loop_body
            }
            let condition = emit_condition_into(
                source,
                hir,
                condition_start,
                condition_close,
                "kofun_condition",
                failure_result,
                "        "
            )
            # A rejected condition became the statement's C prelude.
            if starts_with(condition, "error[") {
                return condition
            }
            # The trap check is what `if` does not need. A condition that traps
            # leaves `kofun_condition` unusable, and a loop that ignored that
            # would spin on it instead of failing.
            # Every Text an iteration produces is dead when the iteration ends,
            # so the arena is wound back to where the iteration found it
            # (#1359). Without this, `kofun_text_next_slot` only ever advances
            # and a loop exhausts all 4096 slots — which is why no Kofun
            # program could emit more than 4096 pieces of text, ever.
            #
            # A high-water mark rather than a walk of the bindings: the
            # temporaries an iteration creates are not all named. `let echoed =
            # echo_back(part)` allocates in `text_slice`, hands the pointer
            # through a call, and binds the result; only a mark reclaims the
            # first one.
            #
            # It is sound because nothing an iteration allocates can outlive
            # it. The emitter declares a loop binding's C storage inside the
            # generated `for` block, so it is a fresh variable each time round;
            # a mutable `Text` binding is refused (`E2S144`) so no outer name
            # can be made to point at it; lists are `Int`-only; and a `return`
            # from inside the body leaves before the restore runs, which is
            # exactly right for a Text the caller keeps.
            emitted = emitted +
            "    for (;;) {\n" +
            "        const size_t kofun_text_mark = kofun_text_next_slot;\n" +
            condition +
            "        if (kofun_failed) return " + failure_result + ";\n" +
            "        if (!kofun_condition) {\n" +
            "            break;\n" +
            "        }\n" +
            loop_body +
            "        kofun_text_next_slot = kofun_text_mark;\n" +
            "    }\n"
            cursor = skip_trivia(source, body_close)
        } else if statement == "match" {
            let match_start = cursor
            let value_start = skip_trivia(
                source,
                token_end(source, cursor)
            )
            let direct_end = skip_trivia(
                source,
                token_end(source, value_start)
            )
            if token_kind(source, value_start) == "identifier" &&
               direct_end < len(source) &&
               token_text(source, direct_end) == "{" {
                let value_name = token_text(source, value_start)
                let enum_binding = hir_use_binding_id(hir, value_start)
                let enum_type = hir_binding_field(hir, enum_binding, 5)
                if len(enum_type) == 0 || enum_type == "Int" ||
                   enum_constructor_count(source, enum_type) < 0 {
                    return "error[E2S32]: enum match scrutinee `" +
                    value_name +
                    "` must be a preceding explicitly typed enum binding at byte " +
                    to_text(value_start)
                }
                let match_body = lower_enum_match(
                    source,
                    hir,
                    match_start,
                    enum_type,
                    is_main,
                    function_open
                )
                if starts_with(match_body, "error[") {
                    return match_body
                }
                emitted = emitted + match_body
                let match_end = enum_match_end(source, match_start)
                cursor = skip_trivia(source, match_end)
            } else {
            let value_end = condition_end(source, value_start)
            if value_end < 0 {
                return "error[E2S24]: bounded match scrutinee must be Bool at byte " +
                to_text(value_start)
            }
            let arms_open = skip_trivia(source, value_end)
            if arms_open >= len(source) ||
               token_text(source, arms_open) != "{" {
                return "error[E2S24]: expected `{` after match scrutinee at byte " +
                to_text(arms_open)
            }
            let mut arm_cursor = skip_trivia(
                source,
                token_end(source, arms_open)
            )
            let mut covered_true = false
            let mut covered_false = false
            let mut seen_catchall = false
            let mut dispatch = ""
            while arm_cursor < len(source) &&
                  token_text(source, arm_cursor) != "}" {
                let pattern_start = arm_cursor
                let pattern_info = pattern_summary(source, pattern_start)
                let pattern_kind = pattern_summary_kind(pattern_info)
                let pattern = token_text(source, pattern_start)
                let pattern_true = pattern_kind == "LiteralPattern" &&
                pattern == "true"
                let pattern_false = pattern_kind == "LiteralPattern" &&
                pattern == "false"
                let pattern_catchall = pattern_kind == "WildcardPattern"
                if seen_catchall {
                    return "error[E2S26]: pattern after catch-all is unreachable at byte " +
                    to_text(pattern_start)
                }
                if pattern_true && covered_true {
                    return "error[E2S26]: duplicate `true` pattern is unreachable at byte " +
                    to_text(pattern_start)
                }
                if pattern_false && covered_false {
                    return "error[E2S26]: duplicate `false` pattern is unreachable at byte " +
                    to_text(pattern_start)
                }
                if pattern_catchall && covered_true && covered_false {
                    return "error[E2S26]: catch-all pattern is unreachable at byte " +
                    to_text(pattern_start)
                }
                if !pattern_true && !pattern_false && !pattern_catchall {
                    return "error[E2S24]: bounded Bool pattern must be `true`, `false`, or `_` at byte " +
                    to_text(pattern_start)
                }
                let after_pattern = skip_trivia(
                    source,
                    pattern_summary_end(pattern_info)
                )
                let mut guarded = false
                let mut guard_start = -1
                let mut guard_end = -1
                let mut arrow = after_pattern
                if arrow < len(source) &&
                   token_text(source, arrow) == "if" {
                    guarded = true
                    guard_start = skip_trivia(
                        source,
                        token_end(source, arrow)
                    )
                    guard_end = condition_end(source, guard_start)
                    if guard_end < 0 {
                        return "error[E2S29]: match guard must be Bool or an Int comparison at byte " +
                        to_text(guard_start)
                    }
                    arrow = skip_trivia(source, guard_end)
                }
                if arrow >= len(source) ||
                   token_text(source, arrow) != "=>" {
                    return "error[E2S24]: expected `=>` after Bool pattern at byte " +
                    to_text(arrow)
                }
                let arm_open = skip_trivia(
                    source,
                    token_end(source, arrow)
                )
                if arm_open >= len(source) ||
                   token_text(source, arm_open) != "{" {
                    return "error[E2S24]: bounded Bool match arm must use a block at byte " +
                    to_text(arm_open)
                }
                let arm_close = balanced_end(source, arm_open, "{", "}")
                if arm_close < 0 {
                    return "error[E2S24]: missing `}` after match arm at byte " +
                    to_text(arm_open)
                }
                let arm_body = lower_body(
                    source,
                    hir,
                    arm_open,
                    is_main,
                    false,
                    function_open
                )
                if starts_with(arm_body, "error[") {
                    return arm_body
                }

                let mut pattern_condition = "true"
                if pattern_true {
                    pattern_condition = "kofun_match_value"
                } else if pattern_false {
                    pattern_condition = "!kofun_match_value"
                }
                if guarded {
                    dispatch = dispatch +
                    "        if (!kofun_match_selected && " +
                    pattern_condition + ") {\n" +
                    emit_condition_into(
                        source,
                        hir,
                        guard_start,
                        guard_end,
                        "kofun_match_guard",
                        failure_result,
                        "            "
                    ) +
                    "            if (kofun_match_guard) {\n" +
                    arm_body +
                    "                kofun_match_selected = true;\n" +
                    "            }\n" +
                    "        }\n"
                } else {
                    dispatch = dispatch +
                    "        if (!kofun_match_selected && " +
                    pattern_condition + ") {\n" +
                    arm_body +
                    "            kofun_match_selected = true;\n" +
                    "        }\n"
                    if pattern_true {
                        covered_true = true
                    } else if pattern_false {
                        covered_false = true
                    } else {
                        covered_true = true
                        covered_false = true
                        seen_catchall = true
                    }
                }
                arm_cursor = skip_trivia(source, arm_close)
                if arm_cursor < len(source) &&
                   token_text(source, arm_cursor) == "," {
                    arm_cursor = skip_trivia(
                        source,
                        token_end(source, arm_cursor)
                    )
                } else if arm_cursor >= len(source) ||
                          token_text(source, arm_cursor) != "}" {
                    return "error[E2S24]: expected `,` between match arms at byte " +
                    to_text(arm_cursor)
                }
            }
            if arm_cursor >= len(source) ||
               token_text(source, arm_cursor) != "}" {
                return "error[E2S24]: missing `}` after match arms at byte " +
                to_text(arms_open)
            }
            if !covered_true && !covered_false {
                return "error[E2S25]: non-exhaustive Bool match; missing patterns `true`, `false` at byte " +
                to_text(match_start)
            }
            if !covered_true {
                return "error[E2S25]: non-exhaustive Bool match; missing pattern `true` at byte " +
                to_text(match_start)
            }
            if !covered_false {
                return "error[E2S25]: non-exhaustive Bool match; missing pattern `false` at byte " +
                to_text(match_start)
            }
            emitted = emitted +
            "    {\n" +
            emit_condition_into(
                source,
                hir,
                value_start,
                value_end,
                "kofun_match_value",
                failure_result,
                "        "
            ) +
            "        (void)kofun_match_value;\n" +
            "        bool kofun_match_selected = false;\n" +
            dispatch +
            "    }\n"
            cursor = skip_trivia(source, token_end(source, arm_cursor))
            }
        } else if statement == "return" {
            let value_start = skip_trivia(source, token_end(source, cursor))
            if returns_list_int {
                let value_end = expression_end(source, value_start)
                if value_end < 0 || value_start >= len(source) ||
                   token_text(source, value_start) == "}" {
                    return "error[E2S157]: List[Int] return requires one whole binding or same-typed direct call at byte " +
                    to_text(value_start)
                }
                let value = emit_list_int_value(
                    source,
                    hir,
                    value_start,
                    value_end,
                    false
                )
                if starts_with(value, "error[") {
                    return value
                }
                emitted = emitted +
                "    {\n" +
                "        KofunIntListValue kofun_result = " + value + ";\n" +
                "        if (kofun_failed) return KOFUN_LIST_INT_ZERO;\n" +
                "        return kofun_result;\n" +
                "    }\n"
                cursor = skip_trivia(source, value_end)
            } else if returns_optional_int {
                let value_end = expression_end(source, value_start)
                if value_end < 0 || value_start >= len(source) ||
                   token_text(source, value_start) == "}" {
                    return "error[E2S147]: an `Int?` result requires one " +
                    "value: `null`, an `Int`, an `Int?` binding, or a call " +
                    "returning `Int?` at byte " + to_text(value_start)
                }
                let value = optional_int_value(
                    source,
                    hir,
                    value_start,
                    value_end
                )
                if starts_with(value, "error[") {
                    return value
                }
                emitted = emitted +
                "    {\n" +
                "        KofunOptionalInt kofun_result = " + value + ";\n" +
                "        if (kofun_failed) return KOFUN_OPTIONAL_INT_NONE;\n" +
                "        return kofun_result;\n" +
                "    }\n"
                cursor = skip_trivia(source, value_end)
            } else if returns_enum {
                let value_end = expression_end(source, value_start)
                if value_end < 0 || value_start >= len(source) ||
                   token_text(source, value_start) == "}" {
                    return "error[E2S12]: concrete enum return requires one value at byte " +
                    to_text(value_start)
                }
                let value = emit_enum_value(
                    source,
                    hir,
                    value_start,
                    value_end,
                    function_return_type_containing(source, function_open)
                )
                if starts_with(value, "error[") {
                    return value
                }
                emitted = emitted +
                "    {\n" +
                "        KofunEnumValue kofun_result = " + value + ";\n" +
                "        if (kofun_failed) return KOFUN_ENUM_ZERO;\n" +
                "        return kofun_result;\n" +
                "    }\n"
                cursor = skip_trivia(source, value_end)
            } else if returns_record {
                let value_end = expression_end(source, value_start)
                if value_end < 0 || value_start >= len(source) ||
                   token_text(source, value_start) == "}" {
                    return "error[E2S12]: nominal record return requires one value at byte " +
                    to_text(value_start)
                }
                let value = emit_record_value(
                    source,
                    hir,
                    value_start,
                    value_end,
                    result_type
                )
                if starts_with(value, "error[") {
                    return value
                }
                emitted = emitted +
                "    {\n" +
                "        " + record_c_type_name(result_type) +
                " kofun_result = " + value + ";\n" +
                "        if (kofun_failed) return " + failure_result + ";\n" +
                "        return kofun_result;\n" +
                "    }\n"
                cursor = skip_trivia(source, value_end)
            } else if returns_text {
                let value_end = expression_end(source, value_start)
                if value_end < 0 || value_start >= len(source) ||
                   token_text(source, value_start) == "}" {
                    return "error[E2S12]: Text return requires one value at byte " +
                    to_text(value_start)
                }
                let value = emit_expression(
                    source,
                    hir,
                    value_start,
                    value_end
                )
                if starts_with(value, "error[") {
                    return value
                }
                emitted = emitted +
                "    {\n" +
                "        const char *kofun_result = " + value + ";\n" +
                "        if (kofun_failed) return " + failure_result + ";\n" +
                "        return kofun_result;\n" +
                "    }\n"
                cursor = skip_trivia(source, value_end)
            } else if value_start < len(source) &&
               token_text(source, value_start) == "}" {
                emitted = emitted + "    return 0;\n"
                cursor = value_start
            } else if value_control(token_text(source, value_start)) {
                let value_check = validate_value_control(source, hir, value_start)
                if starts_with(value_check, "error[") {
                    return value_check
                }
                let value_end = value_end(source, value_start)
                emitted = emitted +
                "    {\n" +
                "        int64_t kofun_result = INT64_C(0);\n" +
                emit_value_into(
                    source,
                    hir,
                    value_start,
                    value_end,
                    "kofun_result",
                    failure_result
                )
                if is_main {
                    emitted = emitted +
                    "        return (int)kofun_result;\n"
                } else {
                    emitted = emitted + "        return kofun_result;\n"
                }
                emitted = emitted + "    }\n"
                cursor = skip_trivia(source, value_end)
            } else {
                let value_end = expression_end(source, value_start)
                if value_end < 0 {
                    return "error[E2S12]: invalid return expression at byte " +
                    to_text(value_start)
                }
                let returned_value = emit_expression(
                    source,
                    hir,
                    value_start,
                    value_end
                )
                # A rejected return expression became the C return value.
                if starts_with(returned_value, "error[") {
                    return returned_value
                }
                emitted = emitted +
                "    {\n" +
                "        int64_t kofun_result = " +
                returned_value + ";\n" +
                "        if (kofun_failed) return " + failure_result + ";\n"
                if is_main {
                    emitted = emitted +
                    "        return (int)kofun_result;\n"
                } else {
                    emitted = emitted + "        return kofun_result;\n"
                }
                emitted = emitted +
                "    }\n"
                cursor = skip_trivia(source, value_end)
            }
            returned = true
        } else if token_kind(source, cursor) == "identifier" {
            let assignment_start = cursor
            let name = token_text(source, cursor)
            let equals = skip_trivia(source, token_end(source, cursor))
            if equals < len(source) && token_text(source, equals) == "[" {
                let binding_id = hir_use_binding_id(hir, assignment_start)
                if binding_id == "-1" || len(binding_id) == 0 {
                    return "error[E2S22]: unknown assignment target `" + name +
                    "` at byte " + to_text(assignment_start) +
                    "; declare it before assignment"
                }
                let mutability = hir_binding_field(hir, binding_id, 4)
                if mutability != "mutable" {
                    return "error[E2S22]: cannot assign through immutable List[Int] binding `" +
                    name + "` at byte " + to_text(assignment_start) +
                    "; declare it with `let mut`"
                }
                let index_value = emit_list_int_index_value(
                    source,
                    hir,
                    assignment_start,
                    equals
                )
                if starts_with(index_value, "error[") {
                    return index_value
                }
                let close = list_int_index_close(source, equals)
                if close < 0 {
                    return "error[E2S157]: malformed List[Int] index at byte " +
                    to_text(equals)
                }
                let indexed_equals = skip_trivia(source, token_end(source, close))
                if indexed_equals >= len(source) ||
                   token_text(source, indexed_equals) != "=" {
                    return "error[E2S157]: expected `=` after List[Int] index at byte " +
                    to_text(indexed_equals)
                }
                let value_start = skip_trivia(
                    source,
                    token_end(source, indexed_equals)
                )
                let value_end = expression_end(source, value_start)
                if value_end < 0 {
                    return "error[E2S157]: List[Int] element assignment requires an Int expression at byte " +
                    to_text(value_start)
                }
                let value_type = initializer_type(
                    source,
                    hir,
                    function_open,
                    value_start
                )
                if value_type != "Int" {
                    return "error[E2S157]: List[Int] element assignment requires Int, got " +
                    value_type + " at byte " + to_text(value_start)
                }
                let value = emit_expression(source, hir, value_start, value_end)
                if starts_with(value, "error[") {
                    return value
                }
                emitted = emitted +
                "    {\n" +
                "        int64_t kofun_index = " + index_value + ";\n" +
                "        if (kofun_failed) return " + failure_result + ";\n" +
                "        uint64_t kofun_position = UINT64_C(0);\n" +
                "        if (!kofun_list_int_resolve_index(k_b" +
                binding_id + ".length, kofun_index, &kofun_position)) " +
                "return " + failure_result + ";\n" +
                "        int64_t kofun_replacement = " + value + ";\n" +
                "        if (kofun_failed) return " + failure_result + ";\n" +
                "        k_b" + binding_id +
                ".elements[kofun_position] = kofun_replacement;\n" +
                "    }\n"
                cursor = skip_trivia(source, value_end)
            } else if equals < len(source) &&
                      token_text(source, equals) == "=" {
                let binding_id = hir_use_binding_id(hir, assignment_start)
                if binding_id == "-1" || len(binding_id) == 0 {
                    return "error[E2S22]: unknown assignment target `" + name +
                    "` at byte " + to_text(assignment_start) +
                    "; declare it before assignment"
                }
                let mutability = hir_binding_field(hir, binding_id, 4)
                if mutability != "mutable" {
                    return "error[E2S22]: cannot assign to immutable binding `" +
                    name + "` at byte " + to_text(assignment_start) +
                    "; declare it with `let mut`"
                }
                let value_start = skip_trivia(source, token_end(source, equals))
                if value_control(token_text(source, value_start)) {
                    let value_check = validate_value_control(source, hir, value_start)
                    if starts_with(value_check, "error[") {
                        return value_check
                    }
                    let value_end = value_end(source, value_start)
                    emitted = emitted +
                    "    {\n" +
                    "        int64_t kofun_replacement = INT64_C(0);\n" +
                    emit_value_into(
                        source,
                        hir,
                        value_start,
                        value_end,
                        "kofun_replacement",
                        failure_result
                    ) +
                    "        k_b" + binding_id + " = kofun_replacement;\n" +
                    "    }\n"
                    cursor = skip_trivia(source, value_end)
                } else {
                    let value_end = expression_end(source, value_start)
                    if value_end < 0 {
                        return "error[E2S12]: invalid Int expression at byte " +
                        to_text(value_start)
                    }
                    # The replacement carrier was `int64_t` whatever the
                    # binding was, so `cur = f(cur)` on a `List[Int]` emitted
                    # `int64_t kofun_replacement = <KofunIntListValue>` — the
                    # compiler exited 0 and only `cc` reported it. The `let`
                    # path above already derives the C type and the value
                    # emitter from the binding's type; this derives them the
                    # same way rather than a second way (#1353).
                    let binding_type = hir_binding_field(hir, binding_id, 5)
                    # Scoped to `List[Int]` on purpose. The carrier below is a
                    # struct, so a value of another type cannot go in it, and
                    # that is the whole question this change raises. Checking
                    # every assignment instead would restate rules that other
                    # slices own — narrowing makes `seen = x + 1` legal for
                    # `seen: Int` and `x: Int?`, and a general check refused it.
                    if binding_type == "List[Int]" &&
                       initializer_type(
                           source,
                           hir,
                           function_open,
                           value_start
                       ) != "List[Int]" {
                        return "error[E2S15]: assignment type mismatch at byte " +
                        to_text(value_start)
                    }
                    let mut replacement_type = "int64_t"
                    let mut replacement = emit_expression(
                        source,
                        hir,
                        value_start,
                        value_end
                    )
                    if binding_type == "List[Int]" {
                        replacement_type = "KofunIntListValue"
                        replacement = emit_list_int_value(
                            source,
                            hir,
                            value_start,
                            value_end,
                            true
                        )
                    }
                    # The rejected value became the C initializer text here too.
                    if starts_with(replacement, "error[") {
                        return replacement
                    }
                    emitted = emitted +
                    "    {\n" +
                    "        " + replacement_type + " kofun_replacement = " +
                    replacement + ";\n" +
                    "        if (kofun_failed) return " + failure_result + ";\n" +
                    "        k_b" + binding_id + " = kofun_replacement;\n" +
                    "    }\n"
                    cursor = skip_trivia(source, value_end)
                }
            } else {
                let value_end = expression_end(source, cursor)
                if value_end < 0 {
                    return "error[E2S12]: invalid expression statement at byte " +
                    to_text(cursor)
                }
                let after = skip_trivia(source, value_end)
                # The final expression of an Int-returning function is its
                # result. Only the last statement qualifies, and only when the
                # closing brace follows it, so an expression in the middle of a
                # body keeps being discarded exactly as before. `main`,
                # enum-returning, and record-returning functions are
                # deliberately excluded: `main` already appends its own status
                # return, and an enum or record result needs its own C shape
                # rather than the `int64_t` this emits.
                if !is_main && append_default && !returns_enum &&
                   !returns_record && !returns_list_int &&
                   after < len(source) && token_text(source, after) == "}" {
                    emitted = emitted +
                    "    {\n" +
                    "        int64_t kofun_result = " +
                    emit_expression(source, hir, cursor, value_end) + ";\n" +
                    "        if (kofun_failed) return " + failure_result + ";\n" +
                    "        return kofun_result;\n" +
                    "    }\n"
                    returned = true
                } else {
                    emitted = emitted + "    (void)" +
                    emit_expression(source, hir, cursor, value_end) + ";\n" +
                    "    if (kofun_failed) return " + failure_result + ";\n"
                }
                cursor = skip_trivia(source, value_end)
            }
        } else {
            return "error[E2S10]: unsupported Core statement at byte " +
            to_text(cursor)
        }
    }
    if cursor >= len(source) || token_text(source, cursor) != "}" {
        return "error[E2S03]: missing function close"
    }
    if !returned && append_default {
        if !is_main {
            if returns_enum {
                return "error[E2S19]: Core function may complete without returning its enum at byte " +
                to_text(open)
            }
            if returns_list_int {
                return "error[E2S19]: Core function may complete without returning List[Int] at byte " +
                to_text(open)
            }
            return "error[E2S19]: Core function may complete without returning Int at byte " + to_text(open)
        }
        emitted = emitted + "    return 0;\n"
    }
    return emitted
}

# The C parameter list of the lambda whose parameter list opens at `open`:
# its declared parameters followed by its captures, or "void" when it has
# neither.
fn lifted_lambda_signature(source: Text, hir: Text, open: Int) -> Text {
    # The bare form is keyed by its single parameter and has no list, so its
    # close is the end of that identifier and the walk covers exactly it.
    let mut close = token_end(source, open)
    let mut parameter = open
    if token_text(source, open) == "(" {
        close = balanced_end(source, open, "(", ")")
        parameter = skip_trivia(source, token_end(source, open))
    }
    let mut signature = ""
    let mut parameters = 0
    while parameter < close && token_kind(source, parameter) == "identifier" {
        if parameters > 0 {
            signature = signature + ", "
        }
        signature = signature + "int64_t k_b" +
        hir_definition_id_at(hir, parameter)
        parameters = parameters + 1
        let mut after = skip_trivia(source, token_end(source, parameter))
        if after < close && token_text(source, after) == ":" {
            let annotation = skip_trivia(source, token_end(source, after))
            after = skip_trivia(source, token_end(source, annotation))
        }
        if after < close && token_text(source, after) == "," {
            after = skip_trivia(source, token_end(source, after))
        }
        parameter = after
    }
    signature = signature +
    append_captures(
        lambda_captures(source, hir, open), parameters, "int64_t ")
    if len(signature) == 0 {
        return "void"
    }
    return signature
}

# Lifts every lambda binding to a top-level `kofun_lambda_<binding>`, emitting
# its prototype when `bodies` is false and its definition when true.
#
# Lifting rather than a function value is what keeps this inside the frozen
# profile: Stage 2 lowers every value to `int64_t` and has no function type, no
# function pointer and no indirect call, so a lambda that stayed a value would
# need all three. A lifted lambda is an ordinary Core function, and its body
# lowers through the same expression emitter as any other, because the scope
# HIR already binds the parameters.
fn emit_lifted_lambdas(source: Text, hir: Text, bodies: Bool) -> Text {
    let mut emitted = ""
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        if token_text(source, cursor) != "let" {
            cursor = skip_trivia(source, token_end(source, cursor))
        } else {
            let mut name_start = skip_trivia(source, token_end(source, cursor))
            if token_text(source, name_start) == "mut" {
                name_start = skip_trivia(source, token_end(source, name_start))
            }
            let mut open = -1
            if token_kind(source, name_start) == "identifier" {
                let mut equals = skip_trivia(
                    source, token_end(source, name_start))
                if equals < len(source) && token_text(source, equals) == ":" {
                    let annotation = skip_trivia(
                        source, token_end(source, equals))
                    equals = skip_trivia(source, token_end(source, annotation))
                }
                if equals < len(source) && token_text(source, equals) == "=" {
                    open = lambda_initializer_open(
                        source, skip_trivia(source, token_end(source, equals)))
                }
            }
            if open < 0 {
                cursor = skip_trivia(source, token_end(source, cursor))
            } else {
                let binding_id = hir_definition_id_at(hir, name_start)
                let signature = lifted_lambda_signature(source, hir, open)
                let mut close = token_end(source, open)
                if token_text(source, open) == "(" {
                    close = balanced_end(source, open, "(", ")")
                }
                let arrow = skip_trivia(source, close)
                let body_start = skip_trivia(source, token_end(source, arrow))
                let body_end = lambda_parameters_end(source, -1, open)
                if bodies {
                    emitted = emitted +
                    "static int64_t kofun_lambda_" + binding_id +
                    "(" + signature + ") {\n" +
                    "    {\n" +
                    "        int64_t kofun_result = " +
                    emit_expression(source, hir, body_start, body_end) + ";\n" +
                    "        if (kofun_failed) return 0;\n" +
                    "        return kofun_result;\n" +
                    "    }\n" +
                    "}\n"
                } else {
                    emitted = emitted +
                    "static int64_t kofun_lambda_" + binding_id +
                    "(" + signature + ");\n"
                }
                cursor = skip_trivia(source, body_end)
            }
        }
    }
    return emitted
}

# Whether the arrow lambda keyed at `open` is written directly in argument
# position rather than as a `let` initializer.
#
# `lambda_parameters_end` documents the four tokens that may precede a
# parameter list: `fn`, `=`, `,` and `(`. `=` is the initializer position and
# the other two are argument position, so the preceding token decides — after
# stepping over `fn`, which may sit in front of either.
fn argument_position_lambda(
    source: Text,
    previous: Int,
    before_previous: Int
) -> Bool {
    # `)` is the trailing position, and it is only argument position when the
    # `fn` was actually there: `) fn (` is the trailing form, while a bare
    # `) (` is not a lambda at all.
    let mut effective = previous
    let keyword = previous >= 0 && token_text(source, previous) == "fn"
    if keyword {
        effective = before_previous
    }
    if effective < 0 {
        return false
    }
    if keyword && token_text(source, effective) == ")" {
        return true
    }
    return token_text(source, effective) == "(" ||
    token_text(source, effective) == ","
}

# Lifts every arrow lambda written in argument position to a top-level
# `kofun_lambda_at<offset>`, emitting its prototype when `bodies` is false and
# its definition when true.
#
# This walk visits every token rather than jumping over a lambda body, so a
# lambda nested inside another lambda's argument is lifted too. The `let`
# initializer walk cannot be reused: an anonymous argument has no binding id to
# key on, and `emit_lifted_lambdas` keys on exactly that.
fn emit_lifted_argument_lambdas(
    source: Text,
    hir: Text,
    bodies: Bool
) -> Text {
    let mut emitted = ""
    let mut cursor = skip_trivia(source, 0)
    let mut previous = -1
    let mut before_previous = -1
    while cursor < len(source) {
        let close = lambda_parameters_end(source, previous, cursor)
        if close >= 0 &&
           argument_position_lambda(source, previous, before_previous) {
            let signature = lifted_lambda_signature(source, hir, cursor)
            let name = argument_lambda_name(cursor)
            if bodies {
                let mut parameters_close = token_end(source, cursor)
                if token_text(source, cursor) == "(" {
                    parameters_close = balanced_end(source, cursor, "(", ")")
                }
                let arrow = skip_trivia(source, parameters_close)
                let body_start = skip_trivia(source, token_end(source, arrow))
                emitted = emitted +
                "static int64_t " + name + "(" + signature + ") {\n" +
                "    {\n" +
                "        int64_t kofun_result = " +
                emit_expression(source, hir, body_start, close) + ";\n" +
                "        if (kofun_failed) return 0;\n" +
                "        return kofun_result;\n" +
                "    }\n" +
                "}\n"
            } else {
                emitted = emitted +
                "static int64_t " + name + "(" + signature + ");\n"
            }
        }
        before_previous = previous
        previous = cursor
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return emitted
}

# A capturing lambda cannot be a function value. Lifting passes each capture as
# a trailing `int64_t` parameter, so the lifted function's C type is wider than
# the callable type the parameter declares and its address is not that
# callable. Closure conversion — an environment travelling with the code — is
# #116 and #370, and #703 puts it out of scope, so this refuses rather than
# lowering something whose observations would not match.
fn validate_argument_lambda_captures(source: Text, hir: Text) -> Text {
    let mut cursor = skip_trivia(source, 0)
    let mut previous = -1
    let mut before_previous = -1
    while cursor < len(source) {
        let close = lambda_parameters_end(source, previous, cursor)
        if close >= 0 &&
           argument_position_lambda(source, previous, before_previous) {
            let captures = lambda_captures(source, hir, cursor)
            if len(captures) > 0 {
                return "error[E2S96]: lambda argument at byte " +
                to_text(cursor) +
                " captures an enclosing binding; pass a lambda that reads " +
                "only its parameters"
            }
        }
        before_previous = previous
        previous = cursor
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return "ok"
}

# The numeric type of the *primary* at `start`, or "" when it is not one of the
# three numeric types.
#
# Slice 3 of #710 needs the type of one operand, which `initializer_type`
# cannot give: that function scans the whole initializer line and returns `Bool`
# the moment it sees a comparison, so typing the `1` in `1 + 2 < 3` through it
# yields `Bool`. This looks at the primary and nothing else.
#
# "" rather than a default is deliberate. `Text`, `Bool` and unresolved names
# are not numeric operands, and the mixed-arithmetic check must skip them
# instead of inventing an `Int` and reporting a mismatch that is not there.
#
# A bit-operation chain reports its receiver's type, which is the answer to the
# only question asked of it about one: `emit_int_bit_chain` needs to know
# whether the receiver is an `Int`. What the whole chain evaluates to is a
# separate judgement, made in `initializer_type_bounded`.
fn numeric_primary_type(
    source: Text,
    hir: Text,
    function_open: Int,
    start: Int
) -> Text {
    let cursor = skip_trivia(source, start)
    if cursor >= len(source) {
        return ""
    }
    let token = token_text(source, cursor)
    # Unary sign and a parenthesised group both delegate to what follows.
    if token == "-" || token == "+" || token == "(" {
        return numeric_primary_type(
            source, hir, function_open,
            skip_trivia(source, token_end(source, cursor)))
    }
    # A named conversion is typed by its destination, which is what makes
    # `Decimal.from_int(n) + 1.5` a same-type expression rather than a mix.
    let conversion = numeric_conversion_result(
        numeric_conversion_at(source, cursor)
    )
    if len(conversion) > 0 {
        return conversion
    }
    let kind = token_kind(source, cursor)
    if kind == "integer" {
        return "Int"
    }
    if kind == "decimal" {
        return "Decimal"
    }
    if kind == "float" {
        return "Float"
    }
    if kind != "identifier" {
        return ""
    }
    let open = skip_trivia(source, token_end(source, cursor))
    if open < len(source) && token_text(source, open) == "(" {
        let declared = function_return_type(source, token)
        if len(declared) > 0 {
            return numeric_name(declared)
        }
        return numeric_name(builtin_return_type(token))
    }
    let scope_open = parent_block_open(source, function_open, cursor)
    let binding_id = hir_resolve_binding(
        hir,
        hir_scope_id_for_open(hir, scope_open),
        cursor,
        token
    )
    if len(binding_id) == 0 {
        return ""
    }
    return numeric_name(hir_binding_field(hir, binding_id, 5))
}

# Whether one primary is Text. This stays separate from
# `numeric_primary_type` so E2S100 continues to see only the numeric lattice.
fn text_operand(
    source: Text,
    hir: Text,
    function_open: Int,
    start: Int
) -> Bool {
    let mut cursor = skip_trivia(source, start)
    if cursor >= len(source) {
        return false
    }
    while token_text(source, cursor) == "(" {
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    if token_kind(source, cursor) == "string" {
        return true
    }
    if token_kind(source, cursor) != "identifier" {
        return false
    }
    if numeric_conversion_at(source, cursor) == "Decimal.format" {
        return true
    }
    let name = token_text(source, cursor)
    let open = skip_trivia(source, token_end(source, cursor))
    if open < len(source) && token_text(source, open) == "(" {
        return function_return_type(source, name) == "Text" ||
        builtin_return_type(name) == "Text"
    }
    let scope_open = parent_block_open(source, function_open, cursor)
    let binding_id = hir_resolve_binding(
        hir,
        hir_scope_id_for_open(hir, scope_open),
        cursor,
        name
    )
    let mut binding_type = ""
    if len(binding_id) > 0 {
        binding_type = hir_binding_field(hir, binding_id, 5)
    }
    if binding_type == "Text" {
        return true
    }
    if token_text(source, open) == "." {
        let field_cursor = skip_trivia(source, token_end(source, open))
        return record_field_type_named(
            source,
            binding_type,
            token_text(source, field_cursor)
        ) == "Text"
    }
    return false
}

fn numeric_name(name: Text) -> Text {
    if name == "Int" || name == "Decimal" || name == "Float" {
        return name
    }
    return ""
}

# True when `cursor` is the type name heading a `Type.member` path.
#
# This is the one place the scope walk must not treat a numeric type name as a
# binding use. `Decimal` in `Decimal.from_int(3)` names a type, not a value, so
# resolving it would report `E2S35: unknown lexical binding` — which is what it
# did before the conversions existed.
fn numeric_conversion_head(source: Text, cursor: Int) -> Bool {
    if len(numeric_name(token_text(source, cursor))) == 0 {
        return false
    }
    let dot = skip_trivia(source, token_end(source, cursor))
    return dot < len(source) && token_text(source, dot) == "."
}

# The `Type.member` conversion path beginning at `cursor`, or "" when there is
# not one. The member must be called: a bare `Decimal.from_int` is a value of a
# type the language does not have, so only the call form is recognised.
fn numeric_conversion_at(source: Text, cursor: Int) -> Text {
    if !numeric_conversion_head(source, cursor) {
        return ""
    }
    let dot = skip_trivia(source, token_end(source, cursor))
    let member = skip_trivia(source, token_end(source, dot))
    if member >= len(source) || token_kind(source, member) != "identifier" {
        return ""
    }
    let open = skip_trivia(source, token_end(source, member))
    if open >= len(source) || token_text(source, open) != "(" {
        return ""
    }
    return token_text(source, cursor) + "." + token_text(source, member)
}

# Start of the zero-based argument in a validated numeric member call.
fn numeric_member_argument(source: Text, open: Int, wanted: Int) -> Int {
    let mut argument = skip_trivia(source, token_end(source, open))
    let mut index = 0
    while argument < len(source) && token_text(source, argument) != ")" {
        if index == wanted {
            return argument
        }
        let bound = argument_end(source, argument)
        if bound < 0 {
            return -1
        }
        let separator = skip_trivia(source, bound)
        if token_text(source, separator) != "," {
            return -1
        }
        argument = skip_trivia(source, token_end(source, separator))
        index = index + 1
    }
    return -1
}

fn decimal_rounding_mode_name(name: Text) -> Bool {
    return name == "HalfUp" || name == "HalfEven" ||
    name == "TowardZero" || name == "Floor" || name == "Ceiling"
}

fn decimal_rounding_c_name(name: Text) -> Text {
    if name == "HalfUp" {
        return "KOFUN_DECIMAL_HALF_UP"
    }
    if name == "HalfEven" {
        return "KOFUN_DECIMAL_HALF_EVEN"
    }
    if name == "TowardZero" {
        return "KOFUN_DECIMAL_TOWARD_ZERO"
    }
    if name == "Floor" {
        return "KOFUN_DECIMAL_FLOOR"
    }
    if name == "Ceiling" {
        return "KOFUN_DECIMAL_CEILING"
    }
    return "KOFUN_DECIMAL_HALF_EVEN"
}

# The result type of a named conversion, or "" when the path is not one.
#
# `docs/DECIMAL.md` fixes these three names. `Decimal.from_int` is the only one
# that can be written today; the other two are recognised here so that
# `validate_numeric_conversions` can reject them for the right reason rather
# than calling them unknown.
fn numeric_conversion_result(conversion: Text) -> Text {
    if conversion == "Decimal.from_int" || conversion == "Decimal.from_float" ||
       conversion == "Decimal.round" || conversion == "Decimal.divide" ||
       conversion == "Decimal.parse" {
        return "Decimal"
    }
    if conversion == "Decimal.format" {
        return "Text"
    }
    if conversion == "Float.from_decimal" {
        return "Float"
    }
    return ""
}

# The conversion that brings two mixed operand types together, or "" when the
# pair has none.
#
# The pair is unordered because each name works from either side: `1 + 1.5` and
# `1.5 + 1` are both fixed by converting the Int with `Decimal.from_int`, and
# which operand it wraps is visible in the source.
#
# `Int` and `Float` return "" because `docs/DECIMAL.md` defines no conversion
# between them in either direction. That is a real gap in the conversion set,
# not an oversight here — Int to binary64 is exact only below 2^53 and so needs
# the same policy argument the other inexact conversions do. Saying so beats
# naming a function that does not exist.
fn numeric_conversion_between(left: Text, right: Text) -> Text {
    if (left == "Int" && right == "Decimal") ||
       (left == "Decimal" && right == "Int") {
        return "Decimal.from_int"
    }
    if (left == "Decimal" && right == "Float") ||
       (left == "Float" && right == "Decimal") {
        return "Float.from_decimal"
    }
    return ""
}

fn arithmetic_operator(token: Text) -> Bool {
    return token == "+" || token == "-" || token == "*" ||
    token == "/" || token == "//" || token == "%" || token == "**"
}

# `Int`, `Decimal` and `Float` never receive implicit promotion (#710 frozen
# decision 4), so an arithmetic expression mixing two of them is a type error
# rather than a conversion.
#
# Both operand orders are checked by construction: the walk types the primary
# before each operator and the primary after it, so a rule written for one side
# only cannot pass. That matters — a promotion bug usually appears on one side.
#
# The diagnostic names the conversion that fixes the pair, and says plainly when
# the pair has none — which is the case for `Int` and `Float`.
fn validate_numeric_operand_types(source: Text, hir: Text) -> Text {
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let parameters = parameter_open(source, function_start)
        let mut function_open = -1
        if parameters >= 0 {
            function_open = balanced_end(source, parameters, "(", ")")
        }
        if function_open >= 0 {
            let mut cursor = skip_trivia(source, function_open)
            let mut last_primary = -1
            while cursor < function_close {
                let token = token_text(source, cursor)
                # A conversion is one primary and its argument is not an
                # operand of the surrounding expression. Without this skip the
                # walk stops at the inner literal: `Decimal.from_int(1) + 1`
                # would read as Int + Int and be accepted, and
                # `Decimal.from_int(1) + 1.5` would read as Int + Decimal and
                # be rejected. Both are wrong, and in opposite directions.
                let mut advance = -1
                if len(numeric_conversion_at(source, cursor)) > 0 {
                    last_primary = cursor
                    let dot = skip_trivia(source, token_end(source, cursor))
                    let member = skip_trivia(source, token_end(source, dot))
                    let open = skip_trivia(source, token_end(source, member))
                    let close = balanced_end(source, open, "(", ")")
                    if close > 0 {
                        advance = skip_trivia(source, close)
                    }
                } else if arithmetic_operator(token) && last_primary >= 0 {
                    let right = skip_trivia(source, token_end(source, cursor))
                    let left_type = numeric_primary_type(
                        source, hir, function_open, last_primary)
                    let right_type = numeric_primary_type(
                        source, hir, function_open, right)
                    if len(left_type) > 0 && len(right_type) > 0 &&
                       left_type != right_type {
                        let remedy = numeric_conversion_between(
                            left_type,
                            right_type
                        )
                        let mut advice = "no conversion between them exists"
                        if len(remedy) > 0 {
                            advice = "write " + remedy + "(...)"
                        }
                        return "error[E2S100]: operator `" + token +
                        "` mixes " + left_type + " and " + right_type +
                        " at byte " + to_text(cursor) + "; " + advice
                    }
                    last_primary = right
                } else if token_kind(source, cursor) == "integer" ||
                          token_kind(source, cursor) == "decimal" ||
                          token_kind(source, cursor) == "float" ||
                          token_kind(source, cursor) == "identifier" {
                    last_primary = cursor
                }
                if advance >= 0 {
                    cursor = advance
                } else {
                    cursor = skip_trivia(source, token_end(source, cursor))
                }
            }
        }
        function_start = next_function_start(source, function_close)
    }
    return "ok"
}

# `/` is checked Decimal division or binary64 Float division, never Int.
# Fractional `//`, `%`, and `**` stay undefined so this slice cannot settle
# their signed or rounding conventions by accident.
fn validate_fractional_operators(source: Text, hir: Text) -> Text {
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let parameters = parameter_open(source, function_start)
        let mut function_open = -1
        if parameters >= 0 {
            function_open = balanced_end(source, parameters, "(", ")")
        }
        let mut cursor = skip_trivia(source, function_open)
        let mut last_primary = -1
        while cursor < function_close {
            let operator = token_text(source, cursor)
            if (operator == "/" || operator == "//" || operator == "%" ||
                operator == "**") && last_primary >= 0 {
                let right = skip_trivia(source, token_end(source, cursor))
                let left_type = numeric_primary_type(
                    source, hir, function_open, last_primary)
                let right_type = numeric_primary_type(
                    source, hir, function_open, right)
                if operator == "/" && left_type == "Int" &&
                   right_type == "Int" {
                    return "error[E2S144]: `/` is not defined on Int at byte " +
                    to_text(cursor) + "; use `//` for the integer quotient"
                }
                if operator != "/" &&
                   (left_type == "Decimal" || left_type == "Float" ||
                    right_type == "Decimal" || right_type == "Float") {
                    let mut value_type = left_type
                    if len(value_type) == 0 {
                        value_type = right_type
                    }
                    return "error[E2S144]: operator `" + operator +
                    "` is not defined on " + value_type + " at byte " +
                    to_text(cursor)
                }
                last_primary = right
            } else if token_kind(source, cursor) == "integer" ||
                      token_kind(source, cursor) == "decimal" ||
                      token_kind(source, cursor) == "float" ||
                      token_kind(source, cursor) == "identifier" {
                last_primary = cursor
            }
            cursor = skip_trivia(source, token_end(source, cursor))
        }
        function_start = next_function_start(source, function_close)
    }
    return "ok"
}

# A numeric annotation and its initializer must name the same type.
#
# #710 frozen decision 4 removes implicit promotion *in both directions*, so
# `let x: Decimal = 1` is exactly as wrong as `let x: Int = 1.5`. A checker
# that rejected only the narrowing direction would still be promoting, just
# quietly and one way — which is the failure this decision exists to prevent.
#
# The initializer is typed through `numeric_primary_type`, not
# `initializer_type`. That matters for what is *not* reported: the former
# answers "" for Text, Bool and unresolved names, while the latter falls back
# to `Int`, and an `Int` invented there would report a mismatch against every
# non-numeric annotation in the corpus.
#
# Mixed arithmetic is already rejected before this runs, so typing the first
# primary types the whole initializer: what reaches here is homogeneous.
fn validate_numeric_annotations(source: Text, hir: Text) -> Text {
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let parameters = parameter_open(source, function_start)
        let mut function_open = -1
        if parameters >= 0 {
            function_open = balanced_end(source, parameters, "(", ")")
        }
        if function_open >= 0 {
            let mut cursor = skip_trivia(source, function_open)
            while cursor < function_close {
                if token_text(source, cursor) == "let" {
                    let mut name = skip_trivia(
                        source,
                        token_end(source, cursor)
                    )
                    if token_text(source, name) == "mut" {
                        name = skip_trivia(source, token_end(source, name))
                    }
                    let colon = skip_trivia(source, token_end(source, name))
                    if token_text(source, colon) == ":" {
                        let annotation = skip_trivia(
                            source,
                            token_end(source, colon)
                        )
                        let declared = numeric_name(
                            token_text(source, annotation)
                        )
                        let assign = skip_trivia(
                            source,
                            token_end(source, annotation)
                        )
                        if len(declared) > 0 &&
                           token_text(source, assign) == "=" {
                            let initializer = skip_trivia(
                                source,
                                token_end(source, assign)
                            )
                            let mut actual = ""
                            if !value_control(
                                token_text(source, initializer)
                            ) {
                                actual = numeric_primary_type(
                                    source,
                                    hir,
                                    function_open,
                                    initializer
                                )
                            }
                            if len(actual) > 0 && actual != declared {
                                return "error[E2S101]: binding `" +
                                token_text(source, name) + "` is " +
                                declared + " but its value is " + actual +
                                " at byte " + to_text(initializer) +
                                "; convert explicitly"
                            }
                        }
                    }
                }
                cursor = skip_trivia(source, token_end(source, cursor))
            }
        }
        function_start = next_function_start(source, function_close)
    }
    return "ok"
}

# Arity and ordinary argument types for the bounded numeric member surface.
# A blank expected type marks the rounding-mode slot, validated by name below.
fn numeric_member_expected_arity(member: Text) -> Int {
    if member == "Decimal.from_int" || member == "Decimal.from_float" {
        return 1
    }
    if member == "Float.from_decimal" || member == "Decimal.format" {
        return 2
    }
    if member == "Decimal.round" {
        return 3
    }
    if member == "Decimal.divide" {
        return 4
    }
    if member == "Decimal.parse" {
        return 1
    }
    return -1
}

fn numeric_member_expected_type(member: Text, index: Int) -> Text {
    if member == "Decimal.from_int" {
        return "Int"
    }
    if member == "Decimal.round" {
        if index == 0 { return "Decimal" }
        if index == 1 { return "Int" }
        return ""
    }
    if member == "Decimal.divide" {
        if index == 0 || index == 1 { return "Decimal" }
        if index == 2 { return "Int" }
        return ""
    }
    if member == "Decimal.format" {
        if index == 0 { return "Decimal" }
        return "Int"
    }
    if member == "Decimal.parse" {
        return "Text"
    }
    return ""
}

fn numeric_member_mode_index(member: Text) -> Int {
    if member == "Decimal.round" { return 2 }
    if member == "Decimal.divide" { return 3 }
    return -1
}

# The named conversions and Decimal slice-5 operations, and what each costs.
#
# Conversions are named and explicit because there is no implicit promotion.
# But naming a conversion is not enough to make it writable: two of the three
# cross the decimal/binary boundary and cannot be exact, and `docs/DECIMAL.md`
# forbids any ambient rounding context that would let the compiler pick a mode
# on the programmer's behalf.
#
# `Decimal.from_int` is exact. `Decimal.round` and `Decimal.divide` require both
# destination scale and a pinned mode; `Decimal.format` requires display scale
# and refuses to round; `Decimal.parse` consumes explicit text. Cross-radix
# Float conversions remain refused because their complete policies are not in
# this bounded slice.
#
# The refusal for a *valid* conversion comes last, so a program with both a
# wrong conversion and a right one reports the wrong one.
fn validate_numeric_conversions(source: Text, hir: Text) -> Text {
    let mut function_start = next_function_start(source, 0)
    let mut valid_conversion = -1
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let parameters = parameter_open(source, function_start)
        let mut function_open = -1
        if parameters >= 0 {
            function_open = balanced_end(source, parameters, "(", ")")
        }
        if function_open >= 0 {
            let mut cursor = skip_trivia(source, function_open)
            while cursor < function_close {
                if numeric_conversion_head(source, cursor) {
                    let conversion = numeric_conversion_at(source, cursor)
                    # The messages stay short on purpose: the member name is
                    # unbounded and the semantic producer holds a diagnostic in
                    # 160 bytes, so a long name plus a long tail truncates on
                    # one side of the gate only.
                    if len(conversion) == 0 {
                        return "error[E2S102]: `" +
                        token_text(source, cursor) +
                        "` has only conversions at byte " + to_text(cursor) +
                        "; write `Decimal.from_int(value)`"
                    }
                    let result = numeric_conversion_result(conversion)
                    if len(result) == 0 {
                        return "error[E2S102]: unknown conversion `" +
                        conversion + "` at byte " + to_text(cursor) +
                        "; known: from_int, round, divide, format, parse"
                    }
                    if conversion == "Decimal.from_float" ||
                       conversion == "Float.from_decimal" {
                        return "error[E2S103]: `" + conversion +
                        "` cannot be exact at byte " + to_text(cursor) +
                        "; its cross-radix policy is not implemented"
                    }
                    let member = skip_trivia(
                        source,
                        token_end(source, skip_trivia(
                            source,
                            token_end(source, cursor)
                        ))
                    )
                    let open = skip_trivia(source, token_end(source, member))
                    let actual = call_arity(source, open)
                    let expected_arity = numeric_member_expected_arity(
                        conversion
                    )
                    if actual != expected_arity {
                        return "error[E2S17]: Core function `" + conversion +
                        "` expects " + to_text(expected_arity) +
                        " arguments, got " + to_text(actual) +
                        " at byte " + to_text(cursor)
                    }
                    let mode_index = numeric_member_mode_index(conversion)
                    let mut index = 0
                    while index < expected_arity {
                        let argument = numeric_member_argument(
                            source,
                            open,
                            index
                        )
                        if index == mode_index {
                            if token_kind(source, argument) != "identifier" ||
                               !decimal_rounding_mode_name(
                                   token_text(source, argument)) {
                                return "error[E2S15]: builtin `" + conversion +
                                "` expects HalfUp, HalfEven, TowardZero, " +
                                "Floor, or Ceiling for argument " +
                                to_text(index + 1) + " at byte " +
                                to_text(argument)
                            }
                        } else {
                            let expected = numeric_member_expected_type(
                                conversion,
                                index
                            )
                            let actual_type = initializer_type(
                                source,
                                hir,
                                function_open,
                                argument
                            )
                            if len(expected) > 0 && actual_type != expected {
                                return "error[E2S15]: builtin `" + conversion +
                                "` expects " + expected + " for argument " +
                                to_text(index + 1) + ", got " + actual_type +
                                " at byte " + to_text(argument)
                            }
                        }
                        index = index + 1
                    }
                    if valid_conversion < 0 {
                        valid_conversion = cursor
                    }
                }
                cursor = skip_trivia(source, token_end(source, cursor))
            }
        }
        function_start = next_function_start(source, function_close)
    }
    let ignored_valid_conversion = valid_conversion
    return "ok"
}

# The C seed constructs each literal before lowering so D001/D002 remain
# source-located compile-time facts. This canonical source cannot reproduce the
# arbitrary-precision validator in its frozen profile, but records the pass and
# emits the same runtime construction path.
fn validate_numeric_literals(source: Text) -> Text {
    let ignored_source = source
    return "ok"
}

fn source_uses_fractional_values(source: Text) -> Bool {
    let mut cursor = skip_trivia(source, 0)
    while cursor < len(source) {
        let kind = token_kind(source, cursor)
        if kind == "decimal" || kind == "float" ||
           numeric_conversion_head(source, cursor) {
            return true
        }
        cursor = skip_trivia(source, token_end(source, cursor))
    }
    return false
}

fn record_align_up(value: Int, alignment: Int) -> Int {
    let remainder = value % alignment
    if remainder == 0 {
        return value
    }
    return value + alignment - remainder
}

# One struct per emitted type. A const-parameterized declaration produces one
# per distinct literal, which is the specialization itself; every other record
# produces exactly one, as before.
fn emit_record_c_declarations(source: Text) -> Text {
    let mut declarations = ""
    let mut cursor = after_optional_module_header(source, 0)
    while cursor < len(source) {
        let type_start = type_declaration_start(source, cursor)
        if type_start >= 0 && record_declaration_at(source, type_start) {
            let record_type = type_name(source, type_start)
            if len(const_parameter_name(source, type_start)) > 0 {
                let total = const_instantiation_count(source, record_type)
                let mut instance = 0
                while instance < total {
                    declarations = declarations + emit_record_c_declaration(
                        source,
                        record_type,
                        record_c_type_name(
                            const_instantiation_at(
                                source,
                                record_type,
                                instance
                            )
                        )
                    )
                    instance = instance + 1
                }
            } else {
                declarations = declarations + emit_record_c_declaration(
                    source,
                    record_type,
                    record_c_type_name(record_type)
                )
            }
        }
        let end = top_level_end(source, cursor)
        if end <= cursor {
            return declarations
        }
        cursor = skip_trivia(source, end)
    }
    return declarations
}

# The struct, its field offsets, and its size for one emitted type. The field
# list comes from the declaration, so every instantiation of one declaration
# has the same layout — which is exactly why `validate_const_erasure` must keep
# a const argument out of a field type.
fn emit_record_c_declaration(
    source: Text,
    record_type: Text,
    c_type: Text
) -> Text {
    let mut declarations = ""
    let fields = record_field_count(source, record_type)
    let mut extent = 0
    let mut record_alignment = 1
    declarations = declarations + "typedef struct {\n"
    let mut index = 0
    while index < fields {
        let field = record_field_text(
            source,
            record_type,
            index,
            false
        )
        let field_type = record_field_text(
            source,
            record_type,
            index,
            true
        )
        # #1181: a `Text` field is one reference. On this target that is the
        # same width as `Int`, so the placement arithmetic and the emitted
        # offset assertions are unchanged; only the C spelling differs.
        #
        # Size and alignment are carried separately even though every field
        # type admitted here has size == alignment. They are different
        # quantities, and the next admitted type is the one that separates
        # them: RFC-0011's `bounded_list[Int, 64]` is 520 bytes and 8-aligned,
        # so `record_align_up(extent, field_size)` would align a record to 520.
        # Deriving alignment from size is right only by coincidence for 1- and
        # 8-byte scalars, and the coincidence ends at #1183.
        let mut c_field_type = "int64_t"
        let mut field_size = 8
        let mut field_alignment = 8
        if field_type == "Bool" {
            c_field_type = "bool"
            field_size = 1
            field_alignment = 1
        } else if field_type == "Text" {
            c_field_type = "const char *"
        } else if field_type == "List[Int]" {
            # #1183 / RFC-0011: the bounded list is stored inline, by value.
            # This is the first field whose size and alignment differ, which
            # is why they are separate quantities here.
            c_field_type = "KofunIntListValue"
            field_size = 520
        }
        let offset = record_align_up(extent, field_alignment)
        if field_alignment > record_alignment {
            record_alignment = field_alignment
        }
        extent = offset + field_size
        declarations = declarations + "    " + c_field_type +
        " " + record_c_field_name(field) + ";\n"
        index = index + 1
    }
    declarations = declarations + "} " + c_type + ";\n"
    extent = record_align_up(extent, record_alignment)
    let mut running = 0
    index = 0
    while index < fields {
        let field = record_field_text(
            source,
            record_type,
            index,
            false
        )
        let field_type = record_field_text(
            source,
            record_type,
            index,
            true
        )
        # The offset walk must place fields exactly as the struct emitter
        # above does, so it carries the same size/alignment split. Two walks
        # that agree only because both derive alignment from size would drift
        # apart the moment one of them stopped.
        let mut field_size = 8
        let mut field_alignment = 8
        if field_type == "Bool" {
            field_size = 1
            field_alignment = 1
        } else if field_type == "List[Int]" {
            field_size = 520
        }
        let offset = record_align_up(running, field_alignment)
        declarations = declarations +
        "_Static_assert(offsetof(" + c_type + ", " +
        record_c_field_name(field) + ") == " + to_text(offset) +
        ", \"AggregateLayout field offset\");\n"
        running = offset + field_size
        index = index + 1
    }
    declarations = declarations +
    "_Static_assert(sizeof(" + c_type + ") == " + to_text(extent) +
    ", \"AggregateLayout record size\");\n\n"
    return declarations
}

# The proposition that failed once, now with a gate instead of a comment.
#
# Distinct type identities must reach distinct emitted structs. `Fixed[2]` and
# `Fixed[3]` are different Kofun types, so if they lowered to one C struct the
# C type system would stop separating what the Kofun type system had already
# separated — which is exactly what an earlier revision did, under a comment
# arguing it was safe because a const parameter carries no storage. That
# argument was about miscompiles; this is about identity, and only one of the
# two was ever checked.
#
# It also catches the collision from the other direction: a declared record
# whose own name is the C name some instantiation generates.
fn validate_struct_identity(source: Text) -> Text {
    let mut names = "|"
    let mut cursor = after_optional_module_header(source, 0)
    while cursor < len(source) {
        let type_start = type_declaration_start(source, cursor)
        if type_start >= 0 && record_declaration_at(source, type_start) {
            let record_type = type_name(source, type_start)
            let mut total = 1
            if len(const_parameter_name(source, type_start)) > 0 {
                total = const_instantiation_count(source, record_type)
            }
            let mut instance = 0
            while instance < total {
                let mut identity = record_type
                if len(const_parameter_name(source, type_start)) > 0 {
                    identity = const_instantiation_at(
                        source,
                        record_type,
                        instance
                    )
                }
                let c_type = record_c_type_name(identity)
                if contains(names, "|" + c_type + "|") {
                    return "error[E2S153]: `" + identity +
                    "` lowers to `" + c_type +
                    "`, which another type already lowers to at byte " +
                    to_text(type_start)
                }
                names = names + c_type + "|"
                instance = instance + 1
            }
        }
        let end = top_level_end(source, cursor)
        if end <= cursor {
            return ""
        }
        cursor = skip_trivia(source, end)
    }
    return ""
}

# Bound syntactic Text-producing sites before writing C. Emitted C string
# literals are skipped because a helper spelling inside user data is not a
# temporary site. Dynamic executions use a separate non-wrapping arena limit.
fn count_text_sites(bodies: Text) -> Int {
    let mut count = 0
    let mut cursor = 0
    let mut quoted = false
    let mut escaped = false
    while cursor < len(bodies) {
        let symbol = text_slice(bodies, cursor, cursor + 1)
        if quoted {
            if escaped {
                escaped = false
            } else if symbol == "\\" {
                escaped = true
            } else if symbol == "\"" {
                quoted = false
            }
            cursor = cursor + 1
        } else if symbol == "\"" {
            quoted = true
            cursor = cursor + 1
        } else if cursor + 17 <= len(bodies) &&
                  text_slice(bodies, cursor, cursor + 17) ==
                  "kofun_text_slice(" {
            count = count + 1
            cursor = cursor + 17
        } else if cursor + 14 <= len(bodies) &&
                  text_slice(bodies, cursor, cursor + 14) ==
                  "kofun_to_text(" {
            count = count + 1
            cursor = cursor + 14
        } else if cursor + 18 <= len(bodies) &&
                  text_slice(bodies, cursor, cursor + 18) ==
                  "kofun_text_concat(" {
            count = count + 1
            cursor = cursor + 18
        } else {
            cursor = cursor + 1
        }
    }
    return count
}

# `take <binding>`, the whole-binding move statement (#946).
#
# `take` is a contextual word: an ownership mode inside a parameter list, a
# move statement at the head of one. The scope walk did not know that, and
# reported the statement's own keyword as a name nobody declared. Measured on
# the compiler a user runs, before this recognition existed:
#
#     $ ./bin/kofun check uam.kofun
#     error[E2S35]: unknown lexical binding `take` at byte 70
#
# So this frontend never reached the ownership rule, and E2S122 and E2S123 —
# which `bootstrap/stage2/record_frontend.c` has implemented all along — could
# not be produced by the compiler a user runs. That standalone frontend is a
# separate program; see docs/COMPILER_ARCHITECTURE.md.
#
# The colon separates the two spellings: `take name: Type` is a parameter,
# `take name` is a move. `take` remains a legal binding name, so anything else
# following it is left to the ordinary grammar.
fn move_statement_head(source: Text, cursor: Int) -> Bool {
    if token_text(source, cursor) != "take" {
        return false
    }
    let target = skip_trivia(source, token_end(source, cursor))
    if target >= len(source) {
        return false
    }
    if token_kind(source, target) != "identifier" {
        return false
    }
    let after = skip_trivia(source, token_end(source, target))
    return after >= len(source) || token_text(source, after) != ":"
}

# True when the `take` whose target begins at `target` names a field rather
# than the binding: `take value.field`, the partial move v1 refuses.
fn move_statement_partial(source: Text, target: Int) -> Bool {
    let after = skip_trivia(source, token_end(source, target))
    return after < len(source) && token_text(source, after) == "."
}

# End of the `take` statement whose target begins at `target`. The whole
# statement is what the move diagnostics underline, so a partial move
# underlines the field access it refuses rather than stopping at the record.
fn move_statement_end(source: Text, target: Int) -> Int {
    if !move_statement_partial(source, target) {
        return token_end(source, target)
    }
    let after = skip_trivia(source, token_end(source, target))
    let field = skip_trivia(source, token_end(source, after))
    if field >= len(source) {
        return token_end(source, after)
    }
    return token_end(source, field)
}

# True when the identifier at `cursor`, whose preceding token began at
# `previous`, reads the value a binding holds.
#
# Two spellings mention a name without reading it: `. name` is a field of some
# other value, and `name :` introduces one — either a `let` that declares a
# fresh binding or a labelled argument that names a field. Neither is a use, so
# neither may be blamed on a move.
fn move_use_position(source: Text, previous: Int, cursor: Int) -> Bool {
    if token_kind(source, cursor) != "identifier" {
        return false
    }
    if previous >= 0 && token_text(source, previous) == "." {
        return false
    }
    let next = skip_trivia(source, token_end(source, cursor))
    return next >= len(source) || token_text(source, next) != ":"
}

# A bare resolved binding in a parameter slot declared `take` is the same
# semantic transfer as a written whole-binding `take`. Compound expressions,
# constructors, and literals may produce a value for a take slot but do not
# name a source binding for this bounded source-order invalidation pass.
#
# The argument must also be *labelled*. That is the boundary this increment
# was scoped to, and it is load-bearing rather than cosmetic: the accepted
# RFC-0010 handle model in `tests/ownership/affine-resource-handle` calls
# `affine_transport_write(initial, 5)` positionally into a `take` slot and
# then writes `take initial` as the transfer. Treating the positional call as
# the move makes that written `take` a second one, so dropping this guard
# refuses a program the ownership gate requires the compiler to accept.
# Widening to positional calls is a change to that accepted model, not to
# this lowering slice, and is owned by #882 rather than assumed here.
# Whether `cursor` is a pipeline subject flowing into a `take` slot 0.
#
# The subject is never written with a label — it sits outside the parentheses —
# so `call_argument_labelled` and `call_argument_expected_mode` cannot see it at
# all: both look inside the argument list. The declared mode therefore has to
# come from slot 0 of the callee that follows the pipe.
#
# `coalescing_expression_end`, not `expression_end`: since the pipeline became a
# production, `expression_end` swallows the whole `subject |> callee(...)` and
# would never equal the subject's single token. Measuring the subject's own
# extent is what keeps a compound subject out — `a + b |> consume()` transfers
# nothing, because there is no binding for the move to invalidate.
fn pipeline_subject_take(source: Text, cursor: Int) -> Bool {
    if coalescing_expression_end(source, cursor) !=
       token_end(source, cursor) {
        return false
    }
    let pipe = skip_trivia(source, token_end(source, cursor))
    if pipe >= len(source) || token_text(source, pipe) != "|>" {
        return false
    }
    if pipeline_call_end(source, pipe) < 0 {
        return false
    }
    let callee_at = skip_trivia(source, token_end(source, pipe))
    let declaration = function_start_named(source, token_text(source, callee_at))
    if declaration < 0 || parameter_count(source, declaration) < 1 {
        return false
    }
    # Slot 0 is the first token after `(`, so no parameter walk is needed — and
    # an ownership mode, when present, is the head of its parameter.
    let parameters = parameter_open(source, declaration)
    if parameters < 0 {
        return false
    }
    return token_text(source, skip_trivia(source, token_end(source, parameters))) == "take"
}

fn move_call_binding(
    source: Text,
    hir: Text,
    cursor: Int
) -> Bool {
    if token_kind(source, cursor) != "identifier" ||
       len(hir_use_binding_id(hir, cursor)) == 0 {
        return false
    }
    # A pipeline subject reaches its slot without a label, so it is admitted on
    # the declared mode of slot 0 rather than on how it was written. Every other
    # shape keeps the existing rule exactly, which is what leaves the ordinary
    # positional call outside the RFC-0010 move path.
    if pipeline_subject_take(source, cursor) {
        return true
    }
    if call_argument_expected_mode(source, cursor) != "take" ||
       call_argument_labelled(source, cursor) != "yes" {
        return false
    }
    return expression_end(source, cursor) == token_end(source, cursor)
}

# Whole-binding move analysis for the compiler a user actually runs (#946).
#
# The bounded slice this issue scopes: `take <binding>` or a bare binding in a
# resolved `take` parameter slot, the move's own span recorded, and any later
# mention of that binding refused with the use site primary and the move site
# named. Loops, branches, and optimization-inferred moves stay out — this walk
# follows only source-order semantic `take` facts and never guesses control
# flow.
#
# Conservative in the other direction too: a binding moved on one path and used
# on another is not proved safe here, it is simply not this slice's subject.
# `compiler.ensure_move` remains the way to demand the guarantee, and lives in
# the C seed only.
#
# Three of the standalone record frontend's four ownership refusals are
# reproduced, with its exact wording: partial move, second move, and
# use-after-move. E2S122 for moving a `read` binding remains outside this
# bounded source-order validator; ownership-mode parameters themselves now
# bind through the production HIR and lowering path (#881).
#
# The walk visits each `take` and then scans forward for the mention that move
# invalidates, so its findings do not arrive in source order. Keeping the one
# with the lowest primary span reorders them back: primary spans of distinct
# statements cannot overlap, so the lowest is the one a statement walk would
# have reached first — which is what the standalone frontend reports.
fn validate_move_uses(source: Text, hir: Text) -> Text {
    let mut function_start = next_function_start(source, 0)
    while function_start < len(source) {
        let function_close = function_end(source, function_start)
        let parameters = parameter_open(source, function_start)
        let mut parameters_close = -1
        if parameters >= 0 {
            parameters_close = balanced_end(source, parameters, "(", ")")
        }
        if function_close < 0 || parameters_close < 0 {
            return "ok"
        }
        let mut body = skip_trivia(source, parameters_close)
        while body < function_close && token_text(source, body) != "{" {
            body = skip_trivia(source, token_end(source, body))
        }
        let mut best_message = ""
        let mut best_start = 0
        let mut scan = skip_trivia(source, token_end(source, body))
        while scan < function_close {
            let explicit_move = move_statement_head(source, scan)
            let call_move = move_call_binding(source, hir, scan)
            if explicit_move || call_move {
                let mut target = scan
                let mut move_start = scan
                let mut move_end = token_end(source, scan)
                if explicit_move {
                    target = skip_trivia(source, token_end(source, scan))
                    move_end = move_statement_end(source, target)
                }
                if explicit_move && move_statement_partial(source, target) {
                    let dot = skip_trivia(source, token_end(source, target))
                    let field = token_text(
                        source,
                        skip_trivia(source, token_end(source, dot))
                    )
                    let partial = "error[E2S122]: partial move `take value." +
                    field + "` is rejected in v1; move the whole record " +
                    "instead at bytes " + to_text(move_start) + ".." +
                    to_text(move_end)
                    if len(best_message) == 0 || move_start < best_start {
                        best_message = partial
                        best_start = move_start
                    }
                } else {
                    let moved = token_text(source, target)
                    let mut previous = -1
                    let mut use_at = skip_trivia(source, move_end)
                    while use_at < function_close {
                        let explicit_second = move_statement_head(
                            source,
                            use_at
                        )
                        let call_second = move_call_binding(
                            source,
                            hir,
                            use_at
                        )
                        if explicit_second || call_second {
                            let mut again = use_at
                            let mut again_end = token_end(source, use_at)
                            if explicit_second {
                                again = skip_trivia(
                                    source,
                                    token_end(source, use_at)
                                )
                                again_end = move_statement_end(
                                    source,
                                    again
                                )
                            }
                            # A partial move is refused for being partial
                            # before anything asks whether its record still
                            # holds a value, so this scan leaves that
                            # statement to the E2S122 branch above rather
                            # than claiming it.
                            if explicit_second &&
                               move_statement_partial(source, again) {
                                break
                            }
                            if token_text(source, again) == moved {
                                let second = "error[E2S123]: `" + moved +
                                "` was already moved by `take` at bytes " +
                                to_text(use_at) + ".." + to_text(again_end) +
                                "; first moved by `take` at bytes " +
                                to_text(move_start) + ".." + to_text(move_end)
                                if len(best_message) == 0 ||
                                   use_at < best_start {
                                    best_message = second
                                    best_start = use_at
                                }
                                break
                            }
                            previous = again
                            use_at = skip_trivia(
                                source,
                                token_end(source, again)
                            )
                        } else if move_use_position(source, previous, use_at) &&
                                  token_text(source, use_at) == moved {
                            let use_end = token_end(source, use_at)
                            let after_move = "error[E2S123]: `" + moved +
                            "` was moved by `take` and cannot be used again " +
                            "at bytes " + to_text(use_at) + ".." +
                            to_text(use_end) + "; moved by `take` at bytes " +
                            to_text(move_start) + ".." + to_text(move_end)
                            if len(best_message) == 0 || use_at < best_start {
                                best_message = after_move
                                best_start = use_at
                            }
                            break
                        } else {
                            previous = use_at
                            use_at = skip_trivia(
                                source,
                                token_end(source, use_at)
                            )
                        }
                    }
                }
                scan = skip_trivia(source, move_end)
            } else {
                scan = skip_trivia(source, token_end(source, scan))
            }
        }
        if len(best_message) > 0 {
            return best_message
        }
        function_start = next_function_start(source, function_close)
    }
    return "ok"
}

fn lower_c_body(source: Text, hir: Text) -> Text {
    let identity_check = validate_struct_identity(source)
    if len(identity_check) > 0 {
        return identity_check
    }
    # #946: the move rule runs before every other validator, so a
    # use-after-move is reported as itself rather than as whatever the
    # statement it invalidates happens to contain.
    let move_use_check = validate_move_uses(source, hir)
    if starts_with(move_use_check, "error[") {
        return move_use_check
    }
    let fractional_values = source_uses_fractional_values(source)
    # A mixed-type expression is reported before operator lowering, so
    # `1 + 1.5` names the missing explicit conversion.
    let operand_check = validate_numeric_operand_types(source, hir)
    if starts_with(operand_check, "error[") {
        return operand_check
    }
    let fractional_operator_check = validate_fractional_operators(source, hir)
    if starts_with(fractional_operator_check, "error[") {
        return fractional_operator_check
    }
    # After the operand check, so `let x: Int = 1 + 1.5` reports the mix it
    # contains rather than blaming the annotation for a value that has no
    # single type to compare against.
    let annotation_check = validate_numeric_annotations(source, hir)
    if starts_with(annotation_check, "error[") {
        return annotation_check
    }
    # After the annotation check, because a conversion is the remedy an
    # annotation mismatch asks for: `let x: Decimal = 1` should say what is
    # wrong with the value, not refuse the conversion the fix would introduce.
    let conversion_check = validate_numeric_conversions(source, hir)
    if starts_with(conversion_check, "error[") {
        return conversion_check
    }
    let numeric_kind_check = validate_numeric_literals(source)
    if starts_with(numeric_kind_check, "error[") {
        return numeric_kind_check
    }
    let enum_use_check = validate_enum_uses(source, hir)
    if starts_with(enum_use_check, "error[") {
        return enum_use_check
    }
    let record_use_check = validate_record_uses(source)
    if starts_with(record_use_check, "error[") {
        return record_use_check
    }
    let optional_coalescing_check = validate_optional_int_coalescing(
        source,
        hir
    )
    if starts_with(optional_coalescing_check, "error[") {
        return optional_coalescing_check
    }
    let optional_use_check = validate_optional_uses(source)
    if starts_with(optional_use_check, "error[") {
        return optional_use_check
    }
    # Scope HIR is already complete: unsupported list signature shapes remain
    # a lowering refusal, so semantic-event consumers can retain partial scope
    # facts before this exact E2S157 boundary.
    let list_annotation_check = validate_list_int_annotations(source)
    if starts_with(list_annotation_check, "error[") {
        return list_annotation_check
    }
    let type_check = validate_core_types(source, hir)
    if starts_with(type_check, "error[") {
        return type_check
    }
    # Immediately before the call validators, and no earlier. A pipeline that
    # also trips an earlier rule should still hear that rule first; what this
    # must beat is only the argument binding and arity checks, which would
    # otherwise describe the pipeline as a missing or miscounted argument.
    let pipeline_check = validate_pipeline_calls(source)
    if starts_with(pipeline_check, "error[") {
        return pipeline_check
    }
    let call_check = validate_core_calls(source, hir)
    if starts_with(call_check, "error[") {
        return call_check
    }
    let list_lambda_check = validate_list_int_lambda_uses(source, hir)
    if starts_with(list_lambda_check, "error[") {
        return list_lambda_check
    }
    let capture_check = validate_argument_lambda_captures(source, hir)
    if starts_with(capture_check, "error[") {
        return capture_check
    }
    # Module constants come first: every function may read them, and a C file
    # scope constant must be declared before its first use.
    let mut constant_declarations = ""
    let mut constant_cursor = next_constant_start(source, 0)
    while constant_cursor < len(source) {
        constant_declarations = constant_declarations +
        "static const int64_t " +
        constant_c_name(constant_name(source, constant_cursor)) + " = " +
        constant_value_text(source, constant_cursor) + ";\n"
        let constant_close = constant_declaration_end(source, constant_cursor)
        if constant_close < 0 {
            constant_cursor = len(source)
        } else {
            constant_cursor = next_constant_start(source, constant_close)
        }
    }
    # Lifted lambdas come first so a Core function can call one that a later
    # function binds.
    let mut prototypes = constant_declarations +
    emit_lifted_lambdas(source, hir, false) +
    emit_lifted_argument_lambdas(source, hir, false)
    let mut bodies = emit_lifted_lambdas(source, hir, true) +
    emit_lifted_argument_lambdas(source, hir, true)
    let mut cursor = next_function_start(source, 0)
    let mut main_count = 0
    while cursor < len(source) {
        let name = function_name(source, cursor)
        if function_arity(source, name) == -2 {
            return "error[E2S16]: duplicate Core function `" + name +
            "` at byte " + to_text(cursor)
        }
        let is_main = name == "main"
        let mut c_result = "int64_t"
        if optional_int_result(source, name) {
            c_result = "KofunOptionalInt"
        } else if function_result_is_enum(source, name) {
            c_result = "KofunEnumValue"
        } else if function_result_is_record(source, name) {
            c_result = record_c_type_name(
                function_return_type(source, name)
            )
        } else if function_result_is_text(source, name) {
            c_result = "const char *"
        } else if function_result_is_list_int(source, name) {
            c_result = "KofunIntListValue"
        }
        let arity = parameter_count(source, cursor)
        let parameters = core_parameters(source, hir, cursor)
        if starts_with(parameters, "error[") {
            return parameters
        }
        let mut c_parameters = parameters
        if len(c_parameters) == 0 {
            c_parameters = "void"
        }
        if is_main {
            main_count = main_count + 1
            if arity != 0 {
                return "error[E2S15]: Core main must have zero parameters"
            }
        } else {
            prototypes = prototypes + "static " + c_result +
            " kofun_fn_" + name + "(" + c_parameters + ");\n"
        }
        let open = core_body_open(source, hir, cursor, is_main)
        if open < 0 {
            return "error[E2S15]: Core function `" + name +
            "` requires Int or concrete enum parameters and return"
        }
        let body = lower_body(source, hir, open, is_main, true, open)
        if starts_with(body, "error[") {
            return body
        }
        if is_main {
            let mut decimal_cleanup = ""
            if fractional_values {
                decimal_cleanup =
                "    if (atexit(kofun_decimal_arena_release) != 0) return 1;\n"
            }
            bodies = bodies + "int main(void) {\n" +
            "    (void)kofun_failed;\n" +
            "    (void)kofun_add;\n" +
            "    (void)kofun_sub;\n" +
            "    (void)kofun_mul;\n" +
            "    (void)kofun_neg;\n" +
            "    (void)kofun_floor_div;\n" +
            "    (void)kofun_floor_mod;\n" +
            "    (void)kofun_bit_and;\n" +
            "    (void)kofun_bit_or;\n" +
            "    (void)kofun_bit_xor;\n" +
            "    (void)kofun_bit_not;\n" +
            "    (void)kofun_bit_shl;\n" +
            "    (void)kofun_bit_shr;\n" +
            "    (void)kofun_bit_rotr;\n" +
            "    (void)kofun_bit_wrapping_add;\n" +
            decimal_cleanup + body + "}\n"
        } else {
            bodies = bodies + "static " + c_result + " kofun_fn_" + name +
            "(" + c_parameters + ") {\n" + body + "}\n"
        }
        cursor = next_function_start(source, function_end(source, cursor))
    }
    if main_count != 1 {
        return "error[E2S15]: C11 Core requires exactly one `fn main()`"
    }
    let text_site_count = count_text_sites(bodies)
    if text_site_count > 256 {
        return "error[E2S156]: Text temporary site limit is 256"
    }
    let mut decimal_include = ""
    if fractional_values {
        decimal_include = "#include \"decimal_v1.c\"\n"
    }
    let mut optional_declarations = ""
    if source_uses_optional_int(source) {
        optional_declarations = emit_optional_int_c_declarations()
    }
    return "/* Generated by the Kofun-written Stage 2 Core lowerer. */\n" +
    "#include <inttypes.h>\n" +
    "#include <stdbool.h>\n" +
    "#include <stddef.h>\n" +
    "#include <stdint.h>\n" +
    "#include <stdio.h>\n" +
    "#include <string.h>\n" + decimal_include + "\n" +
    "typedef struct {\n" +
    "    int64_t tag;\n" +
    "    int64_t payload;\n" +
    "} KofunEnumValue;\n" +
    "#define KOFUN_ENUM_ZERO ((KofunEnumValue){INT64_C(0), INT64_C(0)})\n\n" +
    "typedef const unsigned char *KofunIntList;\n" +
    "typedef struct { uint64_t length; int64_t elements[64]; } KofunIntListValue;\n" +
    "#define KOFUN_LIST_INT_ZERO ((KofunIntListValue){UINT64_C(0), {INT64_C(0)}})\n" +
    "_Static_assert(sizeof(KofunIntListValue) == 520, \"bounded List[Int] value size\");\n" +
    "_Static_assert(offsetof(KofunIntListValue, length) == 0, \"bounded List[Int] value length offset\");\n" +
    "_Static_assert(offsetof(KofunIntListValue, elements) == 8, \"bounded List[Int] value payload offset\");\n" +
    "_Static_assert(_Alignof(KofunIntListValue) == 8, \"bounded List[Int] value alignment\");\n" +
    "enum {\n" +
    "    KOFUN_LIST_INT_LENGTH_OFFSET = 0,\n" +
    "    KOFUN_LIST_INT_PAYLOAD_OFFSET = 8,\n" +
    "    KOFUN_LIST_INT_ELEMENT_SIZE = 8\n" +
    "};\n" +
    "typedef struct { uint64_t length; int64_t first_element; } KofunIntListLayoutProbe;\n" +
    "_Static_assert(sizeof(KofunIntList) == 8, \"AggregateLayout List[Int] reference size\");\n" +
    "_Static_assert(sizeof(uint64_t) == 8, \"AggregateLayout List[Int] header width\");\n" +
    "_Static_assert(sizeof(int64_t) == 8, \"AggregateLayout List[Int] element width\");\n" +
    "_Static_assert(offsetof(KofunIntListLayoutProbe, length) == KOFUN_LIST_INT_LENGTH_OFFSET, \"AggregateLayout List[Int] length offset\");\n" +
    "_Static_assert(offsetof(KofunIntListLayoutProbe, first_element) == KOFUN_LIST_INT_PAYLOAD_OFFSET, \"AggregateLayout List[Int] payload offset\");\n" +
    "_Static_assert(sizeof(((KofunIntListLayoutProbe *)0)->first_element) == KOFUN_LIST_INT_ELEMENT_SIZE, \"AggregateLayout List[Int] element size\");\n" +
    "_Static_assert(_Alignof(KofunIntListLayoutProbe) == 8, \"AggregateLayout List[Int] object alignment\");\n\n" +
    "static bool kofun_failed;\n" +
    "static inline void kofun_error(const char *message) {\n" +
    "    if (!kofun_failed) { fputs(message, stderr); fputc('\\n', stderr); }\n" +
    "    kofun_failed = true;\n" +
    "}\n" +
    "static inline uint64_t kofun_list_int_length(KofunIntList list) {\n" +
    "    uint64_t length = UINT64_C(0);\n" +
    "    memcpy(&length, list + KOFUN_LIST_INT_LENGTH_OFFSET, sizeof length);\n" +
    "    return length;\n" +
    "}\n" +
    "static inline KofunIntList kofun_list_int_view(const KofunIntListValue *list) {\n" +
    "    return (KofunIntList)(const void *)list;\n" +
    "}\n" +
    "static inline KofunIntListValue kofun_list_int_value(KofunIntList list) {\n" +
    "    KofunIntListValue value = KOFUN_LIST_INT_ZERO;\n" +
    "    value.length = kofun_list_int_length(list);\n" +
    "    if (value.length > UINT64_C(64)) {\n" +
    "        kofun_error(\"error[R024]: bounded List[Int] carrier exceeds 64 elements\"); return KOFUN_LIST_INT_ZERO;\n" +
    "    }\n" +
    "    if (value.length > 0) memcpy(value.elements, list + KOFUN_LIST_INT_PAYLOAD_OFFSET, (size_t)value.length * sizeof value.elements[0]);\n" +
    "    return value;\n" +
    "}\n" +
    "static inline uint64_t kofun_list_int_value_length(KofunIntListValue list) {\n" +
    "    return list.length;\n" +
    "}\n" +
    "static inline bool kofun_list_int_resolve_index(uint64_t length, int64_t index, uint64_t *resolved) {\n" +
    "    if (index < 0) index += (int64_t)length;\n" +
    "    if (index < 0 || (uint64_t)index >= length) {\n" +
    "        kofun_error(\"error[R023]: bounded List[Int] index out of range\"); return false;\n" +
    "    }\n" +
    "    *resolved = (uint64_t)index; return true;\n" +
    "}\n" +
    "static inline int64_t kofun_list_int_index(KofunIntList list, int64_t index) {\n" +
    "    uint64_t length = kofun_list_int_length(list);\n" +
    "    uint64_t resolved = UINT64_C(0);\n" +
    "    if (!kofun_list_int_resolve_index(length, index, &resolved)) return 0;\n" +
    "    int64_t value = INT64_C(0);\n" +
    "    size_t offset = KOFUN_LIST_INT_PAYLOAD_OFFSET +\n" +
    "        (size_t)resolved * KOFUN_LIST_INT_ELEMENT_SIZE;\n" +
    "    memcpy(&value, list + offset, sizeof value); return value;\n" +
    "}\n" +
    "enum { KOFUN_TEXT_TEMPORARY_LIMIT = 4096 };\n" +
    "static char kofun_text_slots[KOFUN_TEXT_TEMPORARY_LIMIT][256];\n" +
    "static size_t kofun_text_next_slot;\n" +
    "static inline char *kofun_text_temporary(void) {\n" +
    "    if (kofun_text_next_slot >= KOFUN_TEXT_TEMPORARY_LIMIT) {\n" +
    "        kofun_error(\"error[R022]: bounded Text temporary limit is 4096\"); return NULL;\n" +
    "    }\n" +
    "    return kofun_text_slots[kofun_text_next_slot++];\n" +
    "}\n" +
    "static inline const char *kofun_text_slice(const char *text, int64_t start, int64_t end) {\n" +
    "    size_t length = strlen(text);\n" +
    "    if (start < 0 || end < start || (uint64_t)end > length || end - start > 31) {\n" +
    "        kofun_error(\"error[R020]: bounded Text slice out of range\"); return \"\";\n" +
    "    }\n" +
    "    char *slot = kofun_text_temporary(); if (slot == NULL) return \"\";\n" +
    "    size_t width = (size_t)(end - start);\n" +
    "    memcpy(slot, text + start, width); slot[width] = '\\0'; return slot;\n" +
    "}\n" +
    "static inline const char *kofun_to_text(int64_t value) {\n" +
    "    char *slot = kofun_text_temporary(); if (slot == NULL) return \"\";\n" +
    "    snprintf(slot, 256, \"%\" PRId64, value); return slot;\n" +
    "}\n" +
    "static inline const char *kofun_text_concat(const char *left, const char *right) {\n" +
    "    size_t left_width = strlen(left), right_width = strlen(right);\n" +
    "    if (left_width + right_width > 255) {\n" +
    "        kofun_error(\"error[R021]: bounded Text concatenation exceeds 255 bytes\"); return \"\";\n" +
    "    }\n" +
    "    char *slot = kofun_text_temporary(); if (slot == NULL) return \"\";\n" +
    "    memcpy(slot, left, left_width); memcpy(slot + left_width, right, right_width);\n" +
    "    slot[left_width + right_width] = '\\0'; return slot;\n" +
    "}\n" +
    "static inline int64_t kofun_add(int64_t a, int64_t b) {\n" +
    "    int64_t r; if (__builtin_add_overflow(a, b, &r)) {\n" +
    "        kofun_error(\"error[R010]: integer overflow in operator `+`\"); return 0;\n" +
    "    } return r;\n" +
    "}\n" +
    "static inline int64_t kofun_sub(int64_t a, int64_t b) {\n" +
    "    int64_t r; if (__builtin_sub_overflow(a, b, &r)) {\n" +
    "        kofun_error(\"error[R010]: integer overflow in operator `-`\"); return 0;\n" +
    "    } return r;\n" +
    "}\n" +
    "static inline int64_t kofun_mul(int64_t a, int64_t b) {\n" +
    "    int64_t r; if (__builtin_mul_overflow(a, b, &r)) {\n" +
    "        kofun_error(\"error[R010]: integer overflow in operator `*`\"); return 0;\n" +
    "    } return r;\n" +
    "}\n" +
    "static inline int64_t kofun_neg(int64_t value) {\n" +
    "    if (value == INT64_MIN) {\n" +
    "        kofun_error(\"error[R010]: integer overflow in unary operator `-`\"); return 0;\n" +
    "    } return -value;\n" +
    "}\n" +
    "static inline int64_t kofun_floor_div(int64_t a, int64_t b) {\n" +
    "    if (b == 0) {\n" +
    "        kofun_error(\"error[R010]: operator `//` failed: division by zero\"); return 0;\n" +
    "    }\n" +
    "    if (a == INT64_MIN && b == -1) {\n" +
    "        kofun_error(\"error[R010]: integer overflow in operator `//`\"); return 0;\n" +
    "    }\n" +
    "    int64_t q = a / b; int64_t r = a % b;\n" +
    "    if (r != 0 && ((r < 0) != (b < 0))) { --q; }\n" +
    "    return q;\n" +
    "}\n" +
    "static inline int64_t kofun_floor_mod(int64_t a, int64_t b) {\n" +
    "    if (b == 0) {\n" +
    "        kofun_error(\"error[R010]: operator `%` failed: division by zero\"); return 0;\n" +
    "    }\n" +
    "    if (a == INT64_MIN && b == -1) return 0;\n" +
    "    int64_t r = a % b;\n" +
    "    if (r != 0 && ((r < 0) != (b < 0))) { r += b; }\n" +
    "    return r;\n" +
    "}\n" + emit_int_bit_c_runtime() +
    "\n" + optional_declarations + emit_record_c_declarations(source) +
    prototypes + "\n" + bodies
}

# RFC-0013's runtime. Every operation is expressed on the unsigned bit pattern
# and converted back explicitly, because C is not willing to answer the
# questions these operations ask: a shift by the operand width is undefined, a
# signed right shift is implementation-defined, and a conversion of a pattern
# above `INT64_MAX` back to a signed type is implementation-defined too. The
# whole reason for naming these operations was to give them answers the language
# states, so none of the three is left to the host compiler.
fn emit_int_bit_c_runtime() -> Text {
    return "static inline int64_t kofun_from_bits(uint64_t bits) {\n" +
    "    if (bits <= (uint64_t)INT64_MAX) return (int64_t)bits;\n" +
    "    return -(int64_t)(~bits) - 1;\n" +
    "}\n" +
    "static inline bool kofun_bit_count_ok(int64_t count, const char *message) {\n" +
    "    if (count < 0 || count > 63) { kofun_error(message); return false; }\n" +
    "    return true;\n" +
    "}\n" +
    "static inline uint64_t kofun_bit_mask(int64_t width, const char *message) {\n" +
    "    if (width < 1 || width > 64) { kofun_error(message); return 0; }\n" +
    "    if (width == 64) return ~(uint64_t)0;\n" +
    "    return ((uint64_t)1 << (unsigned)width) - (uint64_t)1;\n" +
    "}\n" +
    "static inline int64_t kofun_bit_and(int64_t a, int64_t b) {\n" +
    "    return kofun_from_bits((uint64_t)a & (uint64_t)b);\n" +
    "}\n" +
    "static inline int64_t kofun_bit_or(int64_t a, int64_t b) {\n" +
    "    return kofun_from_bits((uint64_t)a | (uint64_t)b);\n" +
    "}\n" +
    "static inline int64_t kofun_bit_xor(int64_t a, int64_t b) {\n" +
    "    return kofun_from_bits((uint64_t)a ^ (uint64_t)b);\n" +
    "}\n" +
    "static inline int64_t kofun_bit_not(int64_t a) {\n" +
    "    return kofun_from_bits(~(uint64_t)a);\n" +
    "}\n" +
    "static inline int64_t kofun_bit_shr(int64_t a, int64_t n) {\n" +
    "    if (!kofun_bit_count_ok(n,\n" +
    "        \"error[R011]: shift count for `shr` is outside `0..63`\")) return 0;\n" +
    "    uint64_t bits = (uint64_t)a >> (unsigned)n;\n" +
    "    if (a < 0 && n > 0) { bits |= ~(uint64_t)0 << (unsigned)(64 - n); }\n" +
    "    return kofun_from_bits(bits);\n" +
    "}\n" +
    "static inline int64_t kofun_bit_shl(int64_t a, int64_t n) {\n" +
    "    if (!kofun_bit_count_ok(n,\n" +
    "        \"error[R011]: shift count for `shl` is outside `0..63`\")) return 0;\n" +
    "    int64_t result = kofun_from_bits((uint64_t)a << (unsigned)n);\n" +
    "    if (kofun_bit_shr(result, n) != a) {\n" +
    "        kofun_error(\"error[R010]: integer overflow in `shl`\"); return 0;\n" +
    "    }\n" +
    "    return result;\n" +
    "}\n" +
    "static inline int64_t kofun_bit_rotr(int64_t a, int64_t n, int64_t width) {\n" +
    "    uint64_t mask = kofun_bit_mask(width,\n" +
    "        \"error[R011]: bit width for `rotr` is outside `1..64`\");\n" +
    "    if (mask == 0) return 0;\n" +
    "    if (!kofun_bit_count_ok(n,\n" +
    "        \"error[R011]: rotation count for `rotr` is outside `0..63`\")) return 0;\n" +
    "    uint64_t value = (uint64_t)a & mask;\n" +
    "    unsigned places = (unsigned)(n % width);\n" +
    "    if (places == 0) return kofun_from_bits(value);\n" +
    "    uint64_t rotated = (value >> places) |\n" +
    "        (value << ((unsigned)width - places));\n" +
    "    return kofun_from_bits(rotated & mask);\n" +
    "}\n" +
    "static inline int64_t kofun_bit_wrapping_add(int64_t a, int64_t b, int64_t width) {\n" +
    "    uint64_t mask = kofun_bit_mask(width,\n" +
    "        \"error[R011]: bit width for `wrapping_add` is outside `1..64`\");\n" +
    "    if (mask == 0) return 0;\n" +
    "    return kofun_from_bits((((uint64_t)a & mask) + ((uint64_t)b & mask)) & mask);\n" +
    "}\n"
}

fn lower_c(source: Text, hir: Text) -> Text {
    return lower_c_body(source, hir)
}

fn emit_kofun(source: Text, ir: Text) -> Text {
    if starts_with(ir, "error[") {
        return ""
    }
    return source
}

fn unsupported_lowering_error(diagnostic: Text) -> Bool {
    return starts_with(
        diagnostic,
        "error[E2S10]: unsupported Core statement"
    ) || starts_with(
        diagnostic,
        "error[E2S10]: unsupported Core builtin call "
    ) || starts_with(
        diagnostic,
        "error[E2S10]: unsupported Core parameter type "
    ) || starts_with(
        diagnostic,
        "error[E2S24]: general pattern syntax is parsed "
    ) || starts_with(
        diagnostic,
        "error[E2S158]: labelled-call ABI lowering is owned by #882"
    ) || starts_with(
        diagnostic,
        "error[E2S157]: List[Int] function parameters support only the immutable copy mode"
    )
}

fn compile_file(
    input_path: Text,
    output_path: Text,
    ir_path: Text,
    tokens_path: Text
) -> Int {
    let source = read_text(input_path)
    let tokens = lex(source)
    if starts_with(tokens, "error[") {
        print(tokens)
        return 1
    }
    let ir = parse_program(source)
    if starts_with(ir, "error[") {
        print(ir)
        return 1
    }
    write_text(tokens_path, tokens)
    write_text(ir_path, ir)
    if ends_with(output_path, ".c") {
        let pattern_check = validate_executable_patterns(source)
        if starts_with(pattern_check, "error[") {
            print(pattern_check)
            if unsupported_lowering_error(pattern_check) {
                return 3
            }
            return 1
        }
        let hir = build_scope_hir(source)
        if starts_with(hir, "error[") {
            # A scope error may occur after its partial facts were observed.
            # Unsupported list annotations still own the public compile
            # diagnostic, but no longer prevent those partial facts.
            let list_fallback = validate_list_int_annotations(source)
            if starts_with(list_fallback, "error[") {
                print(list_fallback)
                return 1
            }
            print(hir)
            let ownership = borrowed_collection_check(source)
            if ownership == "ok" {
                return 3
            }
            return 1
        }
        let c_source = lower_c(source, hir)
        if starts_with(c_source, "error[") {
            print(c_source)
            if unsupported_lowering_error(c_source) {
                return 3
            }
            return 1
        }
        write_text(ir_path, ir + hir)
        write_text(output_path, c_source)
    } else {
        write_text(output_path, emit_kofun(source, ir))
    }
    print(output_path)
    return 0
}

fn parse_patterns_file(input_path: Text, output_path: Text) -> Bool {
    let source = read_text(input_path)
    let tokens = lex(source)
    if starts_with(tokens, "error[") {
        print(tokens)
        return false
    }
    let tree = parse_pattern_trees(source)
    write_text(output_path, tree)
    let pattern_error = pattern_first_error(tree)
    if len(pattern_error) > 0 {
        print(pattern_error)
        return false
    }
    return true
}

fn emit_scope_hir_file(input_path: Text, output_path: Text) -> Bool {
    if input_path == output_path {
        print("error[E2S35]: scope-HIR input and output must be distinct")
        return false
    }
    let source = read_text(input_path)
    let tokens = lex(source)
    if starts_with(tokens, "error[") {
        print(tokens)
        return false
    }
    let tree = parse_pattern_trees(source)
    let pattern_error = pattern_first_error(tree)
    if len(pattern_error) > 0 {
        print(pattern_error)
        return false
    }
    let hir = build_scope_hir_mode(source, true)
    if starts_with(hir, "error[") {
        print(hir)
        return false
    }
    write_text(output_path, hir)
    return true
}

fn check_ownership_file(input_path: Text) -> Bool {
    let source = read_text(input_path)
    let tokens = lex(source)
    if starts_with(tokens, "error[") {
        print(tokens)
        return false
    }
    let ir = parse_program(source)
    if starts_with(ir, "error[") {
        print(ir)
        return false
    }
    let result = borrowed_collection_check(source)
    if starts_with(result, "error[") {
        print(result)
        return false
    }
    return true
}

# kofun.selfhost-hir/v1 emitter (bootstrap/selfhost/hir-v1.md).
#
# One typed pre-order walk over the frozen profile surface produces the
# complete document: deduplicated type table, scope tree, symbols,
# bindings, and per-function node records. Any construct outside the
# profile rejects the whole document with diagnostics plus explicit
# `unsupported` records; a partial typed document is never written.
#
# The bootstrap subset has no tuples or mutable globals, so every pass
# returns one Text: a `|`-separated header line followed by record lines.
# Internal errors are a single `error|CODE|AT|MESSAGE` line; `AT` is -1
# when the diagnostic carries no byte position. Expressions parse into
# local `xnode` records first, then a second walk renumbers them into the
# document's pre-order node ids, exactly like the audited seed's
# parse-then-emit split.

fn selfhost_field(result: Text, wanted: Int) -> Text {
    return pattern_line_field(result, 0, wanted)
}

fn selfhost_field_int(result: Text, wanted: Int) -> Int {
    return decimal_value(selfhost_field(result, wanted))
}

fn selfhost_records(result: Text) -> Text {
    return pattern_result_records(result)
}

fn selfhost_error(code: Text, at: Int, message: Text) -> Text {
    return "error|" + code + "|" + to_text(at) + "|" + message
}

fn selfhost_failed(result: Text) -> Bool {
    return starts_with(result, "error|")
}

# hir-v1 record escaping: `\` -> `\\`, `|` -> `\p`, newline -> `\n`.
fn selfhost_escape(value: Text) -> Text {
    let symbols = chars(value)
    let mut escaped = ""
    let mut cursor = 0
    while cursor < len(symbols) {
        let symbol = symbols[cursor]
        if symbol == "\\" {
            escaped = escaped + "\\\\"
        } else if symbol == "|" {
            escaped = escaped + "\\p"
        } else if symbol == "\n" {
            escaped = escaped + "\\n"
        } else {
            escaped = escaped + symbol
        }
        cursor = cursor + 1
    }
    return escaped
}

# Surface names Int/Bool/Text/Void/List map onto the closed universe.
fn selfhost_scalar_key(surface: Text) -> Text {
    if surface == "Int" {
        return "int"
    }
    if surface == "Bool" {
        return "bool"
    }
    if surface == "Text" {
        return "text"
    }
    if surface == "Void" {
        return "void"
    }
    if surface == "List" {
        return "list-text"
    }
    return ""
}

fn selfhost_line_count(records: Text) -> Int {
    let symbols = chars(records)
    let mut cursor = 0
    let mut count = 0
    while cursor < len(symbols) {
        if symbols[cursor] == "\n" {
            count = count + 1
        }
        cursor = cursor + 1
    }
    return count
}

# The deduplicated type table is kept as its emitted `type|ID|KEY` record
# lines. Keys of function types contain `|`, so the key of a line is the
# remainder after its second separator.
fn selfhost_type_lookup(types: Text, key: Text) -> Int {
    let symbols = chars(types)
    let mut line = 0
    while line < len(symbols) {
        let mut cursor = line
        let mut bars = 0
        while cursor < len(symbols) && symbols[cursor] != "\n" && bars < 2 {
            if symbols[cursor] == "|" {
                bars = bars + 1
            }
            cursor = cursor + 1
        }
        let mut line_end = cursor
        while line_end < len(symbols) && symbols[line_end] != "\n" {
            line_end = line_end + 1
        }
        if bars == 2 && text_slice(types, cursor, line_end) == key {
            return decimal_value(pattern_line_field(types, line, 1))
        }
        line = line_end + 1
    }
    return -1
}

# Intern one type key, appending a new `type` record on first use. The
# result is the updated table or an internal error line; the id of the
# interned key is recovered with selfhost_type_lookup.
fn selfhost_type_require(types: Text, key: Text) -> Text {
    if selfhost_type_lookup(types, key) >= 0 {
        return types
    }
    let count = selfhost_line_count(types)
    if count >= 64 {
        return selfhost_error("E2S35", -1, "selfhost-HIR type limit is 64")
    }
    return types + "type|" + to_text(count) + "|" + key + "\n"
}

# Intern the scalar type named by a profile surface spelling.
fn selfhost_scalar_require(types: Text, surface: Text) -> Text {
    let key = selfhost_scalar_key(surface)
    if len(key) == 0 {
        return selfhost_error(
            "E2S15",
            -1,
            "type is outside the frozen profile"
        )
    }
    return selfhost_type_require(types, key)
}

fn selfhost_scalar_id(types: Text, surface: Text) -> Int {
    return selfhost_type_lookup(types, selfhost_scalar_key(surface))
}

# Intern a function type `fn|RESULT|PARAM*` from surface spellings; the
# parameters arrive `|`-separated as in the signature table. The result
# packs `TYPES` after a first `TYPEID` header line.
fn selfhost_fn_type_require(
    types: Text,
    result_surface: Text,
    parameters: Text
) -> Text {
    let mut table = selfhost_scalar_require(types, result_surface)
    if selfhost_failed(table) {
        return table
    }
    let mut key = "fn|" + to_text(selfhost_scalar_id(table, result_surface))
    let mut remaining = parameters
    while len(remaining) > 0 {
        let surface = expected_parameter_head(remaining)
        table = selfhost_scalar_require(table, surface)
        if selfhost_failed(table) {
            return table
        }
        key = key + "|" + to_text(selfhost_scalar_id(table, surface))
        remaining = expected_parameter_tail(remaining)
    }
    table = selfhost_type_require(table, key)
    if selfhost_failed(table) {
        return table
    }
    return to_text(selfhost_type_lookup(table, key)) + "\n" + table
}

# The declared-function signature table is one `fun|NAME|RESULT|ARITY|P*`
# line per function in source order; a function's symbol id is its index.

fn selfhost_function_count(functions: Text) -> Int {
    return selfhost_line_count(functions)
}

fn selfhost_function_line_at(functions: Text, index: Int) -> Int {
    let symbols = chars(functions)
    let mut line = 0
    let mut remaining = index
    while line < len(symbols) {
        if remaining == 0 {
            return line
        }
        while line < len(symbols) && symbols[line] != "\n" {
            line = line + 1
        }
        line = line + 1
        remaining = remaining - 1
    }
    return -1
}

fn selfhost_function_index(functions: Text, name: Text) -> Int {
    let count = selfhost_function_count(functions)
    let mut index = 0
    while index < count {
        let line = selfhost_function_line_at(functions, index)
        if pattern_line_field(functions, line, 1) == name {
            return index
        }
        index = index + 1
    }
    return -1
}

# The `|`-separated parameter tail of one signature line: the text after
# its fourth separator, empty for a zero-arity function.
fn selfhost_function_parameters(functions: Text, line: Int) -> Text {
    let symbols = chars(functions)
    let mut cursor = line
    let mut bars = 0
    while cursor < len(symbols) && symbols[cursor] != "\n" && bars < 4 {
        if symbols[cursor] == "|" {
            bars = bars + 1
        }
        cursor = cursor + 1
    }
    if bars < 4 {
        return ""
    }
    let mut line_end = cursor
    while line_end < len(symbols) && symbols[line_end] != "\n" {
        line_end = line_end + 1
    }
    return text_slice(functions, cursor, line_end)
}

# Parse one declaration's signature into a table line (no newline), or an
# internal error. Mirrors the audited seed byte for byte, including the
# `List` annotation walk that stays inside the parameter list.
fn selfhost_signature(source: Text, functions: Text, start: Int) -> Text {
    if selfhost_function_count(functions) >= 128 {
        return selfhost_error("E2S16", start, "function limit is 128")
    }
    let name = function_name(source, start)
    if selfhost_function_index(functions, name) >= 0 {
        return selfhost_error("E2S16", start, "duplicate Core function")
    }
    let parameters = parameter_open(source, start)
    let mut parameters_close = -1
    if parameters >= 0 {
        parameters_close = balanced_end(source, parameters, "(", ")")
    }
    if parameters < 0 || parameters_close < 0 {
        return selfhost_error("E2S15", start, "malformed parameter list")
    }
    let mut arity = 0
    let mut parameter_types = ""
    let mut cursor = skip_trivia(source, token_end(source, parameters))
    while cursor < parameters_close && token_text(source, cursor) != ")" {
        if arity >= 8 {
            return selfhost_error("E2S17", cursor, "parameter limit is 8")
        }
        let type_at = parameter_type_start(
            source,
            cursor,
            parameters_close
        )
        if type_at < 0 {
            return selfhost_error(
                "E2S15",
                cursor,
                "parameter needs `: TYPE`"
            )
        }
        # A callable parameter type spans several tokens and is recorded under
        # one name, so the arity stays right and the head of the type list
        # keeps naming one parameter each. The frozen self-host profile has no
        # callable values, so `Fn` matches no argument type and a call passing
        # one is rejected by the ordinary mismatch below rather than being
        # silently accepted as `Int`.
        let callable_end = callable_type_end(source, type_at)
        let mut parameter_type = token_text(source, type_at)
        if callable_end >= 0 {
            parameter_type = "Fn"
        }
        parameter_types = parameter_types + "|" + parameter_type
        cursor = skip_trivia(source, token_end(source, type_at))
        if callable_end >= 0 {
            cursor = skip_trivia(source, callable_end)
        }
        if parameter_type == "List" {
            cursor = skip_trivia(source, token_end(source, cursor))
            cursor = skip_trivia(source, token_end(source, cursor))
        }
        arity = arity + 1
        if cursor < parameters_close && token_text(source, cursor) == "," {
            cursor = skip_trivia(source, token_end(source, cursor))
        }
    }
    let mut result = "Void"
    let after = skip_trivia(source, parameters_close)
    if after < len(source) && token_text(source, after) == "->" {
        let result_at = skip_trivia(source, token_end(source, after))
        result = token_text(source, result_at)
    }
    return "fun|" + name + "|" + result + "|" + to_text(arity) +
    parameter_types
}

# Collect every declared signature in source order. The walk stops at a
# declaration whose body never closes; its body parse reports the exact
# brace diagnostic later.
fn selfhost_signatures(source: Text) -> Text {
    let mut functions = ""
    let mut function_start = next_function_start(source, 0)
    let mut scanning = function_start < len(source)
    while scanning {
        let line = selfhost_signature(source, functions, function_start)
        if selfhost_failed(line) {
            return line
        }
        functions = functions + line + "\n"
        let close = function_end(source, function_start)
        if close < 0 {
            scanning = false
        } else {
            function_start = next_function_start(source, close)
            scanning = function_start < len(source)
        }
    }
    return "ok\n" + functions
}

# The 16 builtin signatures in their frozen slot order, `NAME|RESULT|P*`.
fn selfhost_builtin_signature(slot: Int) -> Text {
    if slot == 0 {
        return "args|List"
    }
    if slot == 1 {
        return "chars|List|Text"
    }
    if slot == 2 {
        return "contains|Bool|Text|Text"
    }
    if slot == 3 {
        return "find|Int|Text|Text"
    }
    if slot == 4 {
        return "is_digit|Bool|Text"
    }
    if slot == 5 {
        return "is_space|Bool|Text"
    }
    if slot == 6 {
        return "is_xid_continue|Bool|Text"
    }
    if slot == 7 {
        return "len|Int|Text"
    }
    if slot == 8 {
        return "print|Void|Text"
    }
    if slot == 9 {
        return "read_text|Text|Text"
    }
    if slot == 10 {
        return "replace|Text|Text|Text|Text"
    }
    if slot == 11 {
        return "starts_with|Bool|Text|Text"
    }
    if slot == 12 {
        return "text_slice|Text|Text|Int|Int"
    }
    if slot == 13 {
        return "trim|Text|Text"
    }
    if slot == 14 {
        return "validate_unicode_source|Text|Text"
    }
    if slot == 15 {
        return "write_text|Void|Text|Text"
    }
    # Slot 16 is the len List[Text] overload, which has no signature row
    # here; `fail` follows it at 17 so every id above stays fixed.
    if slot == 17 {
        return "fail|Void"
    }
    return ""
}

fn selfhost_builtin_slot(name: Text) -> Int {
    let mut slot = 0
    while slot < 18 {
        let signature = selfhost_builtin_signature(slot)
        if pattern_line_field(signature, 0, 0) == name {
            return slot
        }
        slot = slot + 1
    }
    return -1
}

# The tail after `NAME|` of one builtin signature: `RESULT|P*`.
fn selfhost_builtin_tail(slot: Int) -> Text {
    return expected_parameter_tail(selfhost_builtin_signature(slot))
}

# Register the type table plus the symbol and module-binding records for
# declared functions, the 16 builtins, and the `len` List[Text] overload,
# in the exact seed order. Packs `ok` and then type, symbol, and binding
# record lines; the caller separates them by tag.
fn selfhost_register(source: Text, functions: Text) -> Text {
    let mut types = ""
    let mut symbols = ""
    let mut bindings = ""
    let count = selfhost_function_count(functions)
    let mut function_start = next_function_start(source, 0)
    let mut index = 0
    while index < count {
        let name_at = skip_trivia(
            source,
            token_end(source, function_start)
        )
        let name_end = token_end(source, name_at)
        let line = selfhost_function_line_at(functions, index)
        let required = selfhost_fn_type_require(
            types,
            pattern_line_field(functions, line, 2),
            selfhost_function_parameters(functions, line)
        )
        if selfhost_failed(required) {
            return required
        }
        let fn_type = selfhost_field_int(required, 0)
        types = selfhost_records(required)
        let name = pattern_line_field(functions, line, 1)
        symbols = symbols + "symbol|" + to_text(index) + "|function|" +
        name + "|" + to_text(fn_type) + "|" + to_text(name_at) + "|" +
        to_text(name_end) + "\n"
        bindings = bindings + "binding|" + to_text(index) + "|0|" +
        to_text(index) + "|" + name + "|imm|" + to_text(name_at) + "|" +
        to_text(name_end) + "\n"
        let close = function_end(source, function_start)
        if close >= 0 {
            function_start = next_function_start(source, close)
        } else {
            index = count
        }
        index = index + 1
    }
    let mut slot = 0
    while slot < 16 {
        let tail = selfhost_builtin_tail(slot)
        let required = selfhost_fn_type_require(
            types,
            expected_parameter_head(tail),
            expected_parameter_tail(tail)
        )
        if selfhost_failed(required) {
            return required
        }
        types = selfhost_records(required)
        symbols = symbols + "symbol|" + to_text(count + slot) +
        "|builtin|" +
        pattern_line_field(selfhost_builtin_signature(slot), 0, 0) + "|" +
        selfhost_field(required, 0) + "|0|0\n"
        slot = slot + 1
    }
    let required = selfhost_fn_type_require(types, "Int", "List")
    if selfhost_failed(required) {
        return required
    }
    types = selfhost_records(required)
    symbols = symbols + "symbol|" + to_text(count + 16) + "|builtin|len|" +
    selfhost_field(required, 0) + "|0|0\n"
    # `fail` is emitted last, after the len List[Text] overload, rather
    # than in its alphabetical place in the table above. Emission order is
    # symbol-id order and those ids are checked-in evidence: alphabetical
    # insertion would renumber thirteen builtins, and appending inside the
    # loop would still push the overload from 17 to 18. Emitting it here
    # leaves every existing id fixed, so the pinned typed-HIR fixtures only
    # gain a line.
    let fail_required = selfhost_fn_type_require(types, "Void", "")
    if selfhost_failed(fail_required) {
        return fail_required
    }
    types = selfhost_records(fail_required)
    symbols = symbols + "symbol|" + to_text(count + 17) + "|builtin|fail|" +
    selfhost_field(fail_required, 0) + "|0|0\n"
    return "ok\n" + types + symbols + bindings
}

# The lexical environment is one `env|NAME|TYPE|BINDINGID|MUT` line per
# live binding; resolution picks the innermost (last) declaration.

fn selfhost_resolve(env: Text, name: Text) -> Int {
    let symbols = chars(env)
    let mut line = 0
    let mut resolved = -1
    while line < len(symbols) {
        if pattern_line_field(env, line, 1) == name {
            resolved = line
        }
        while line < len(symbols) && symbols[line] != "\n" {
            line = line + 1
        }
        line = line + 1
    }
    return resolved
}

fn selfhost_env_count(env: Text) -> Int {
    return selfhost_line_count(env)
}

# Parsed expressions are `xnode|ID|KIND|START|END|TYPE|...` lines with
# document-local ids; the second walk renumbers them in pre-order.

fn selfhost_tree_line(tree: Text, id: Int) -> Int {
    let symbols = chars(tree)
    let wanted = to_text(id)
    let mut line = 0
    while line < len(symbols) {
        if pattern_line_field(tree, line, 1) == wanted {
            return line
        }
        while line < len(symbols) && symbols[line] != "\n" {
            line = line + 1
        }
        line = line + 1
    }
    return -1
}

fn selfhost_tree_field(tree: Text, id: Int, field: Int) -> Text {
    let line = selfhost_tree_line(tree, id)
    if line < 0 {
        return ""
    }
    return pattern_line_field(tree, line, field)
}

fn selfhost_tree_int(tree: Text, id: Int, field: Int) -> Int {
    return decimal_value(selfhost_tree_field(tree, id, field))
}

# Expression results pack `END|ROOT|NEXT|TYPE` over the xnode records.
fn selfhost_expression_result(
    end: Int,
    root: Int,
    next: Int,
    value_type: Text,
    records: Text
) -> Text {
    return to_text(end) + "|" + to_text(root) + "|" + to_text(next) +
    "|" + value_type + "\n" + records
}

fn selfhost_operator_level(level: Int, token: Text) -> Bool {
    if level == 0 {
        return token == "||"
    }
    if level == 1 {
        return token == "&&"
    }
    if level == 2 {
        return token == "==" || token == "!=" || token == "<=" ||
        token == ">=" || token == "<" || token == ">"
    }
    if level == 3 {
        return token == "+" || token == "-"
    }
    return token == "*" || token == "//" || token == "/" || token == "%"
}

# Resolve and type one call expression; `at` is the callee name token.
# Declared functions win over builtins; `len` picks its overload from the
# first argument; every arity and argument type is checked here so a
# rejected document never carries typed nodes.
fn selfhost_parse_call(
    source: Text,
    functions: Text,
    env: Text,
    at: Int,
    next: Int
) -> Text {
    let name = token_text(source, at)
    let open = skip_trivia(source, token_end(source, at))
    let mut cursor = skip_trivia(source, token_end(source, open))
    let mut argument_count = 0
    let mut argument_ids = ""
    let mut argument_starts = ""
    let mut argument_types = ""
    let mut records = ""
    let mut local_next = next
    while cursor < len(source) && token_text(source, cursor) != ")" {
        if argument_count >= 8 {
            return selfhost_error(
                "E2S17",
                at,
                "call has too many arguments"
            )
        }
        let argument = selfhost_parse_expression(
            source,
            functions,
            env,
            cursor,
            local_next
        )
        if selfhost_failed(argument) {
            return argument
        }
        cursor = selfhost_field_int(argument, 0)
        let root = selfhost_field_int(argument, 1)
        local_next = selfhost_field_int(argument, 2)
        records = records + selfhost_records(argument)
        argument_ids = argument_ids + "|" + to_text(root)
        argument_starts = argument_starts + "|" +
        selfhost_tree_field(records, root, 3)
        if argument_count > 0 {
            argument_types = argument_types + "|"
        }
        argument_types = argument_types + selfhost_field(argument, 3)
        argument_count = argument_count + 1
        if cursor < len(source) && token_text(source, cursor) == "," {
            cursor = skip_trivia(source, token_end(source, cursor))
        }
    }
    if cursor >= len(source) {
        return selfhost_error("E2S12", at, "expected `)`")
    }
    let call_end = token_end(source, cursor)
    let after = skip_trivia(source, call_end)
    let mut symbol = -1
    let mut result_type = ""
    let declared = selfhost_function_index(functions, name)
    if declared >= 0 {
        let line = selfhost_function_line_at(functions, declared)
        if argument_count !=
           decimal_value(pattern_line_field(functions, line, 3)) {
            return selfhost_error("E2S17", at, "wrong call arity")
        }
        let mut expected = selfhost_function_parameters(functions, line)
        let mut index = 0
        while index < argument_count {
            if pattern_line_field(argument_types, 0, index) !=
               expected_parameter_head(expected) {
                return selfhost_error(
                    "E2S15",
                    decimal_value(
                        pattern_line_field("x" + argument_starts, 0, index + 1)
                    ),
                    "call argument type mismatch"
                )
            }
            expected = expected_parameter_tail(expected)
            index = index + 1
        }
        symbol = declared
        result_type = pattern_line_field(functions, line, 2)
    } else {
        let mut arity = builtin_arity(name)
        if name == "print" {
            arity = 1
        }
        if arity < 0 {
            return selfhost_error("E2S16", at, "unknown function")
        }
        if argument_count != arity {
            return selfhost_error("E2S17", at, "wrong builtin arity")
        }
        result_type = "Void"
        if name != "print" {
            result_type = builtin_return_type(name)
        }
        let count = selfhost_function_count(functions)
        if name == "len" {
            let argument_type = pattern_line_field(argument_types, 0, 0)
            if argument_type != "Text" && argument_type != "List" {
                return selfhost_error(
                    "E2S15",
                    decimal_value(
                        pattern_line_field("x" + argument_starts, 0, 1)
                    ),
                    "len expects Text or List[Text]"
                )
            }
            symbol = count + 7
            if argument_type == "List" {
                symbol = count + 16
            }
        } else if name == "print" {
            if pattern_line_field(argument_types, 0, 0) != "Text" {
                return selfhost_error(
                    "E2S15",
                    decimal_value(
                        pattern_line_field("x" + argument_starts, 0, 1)
                    ),
                    "print expects Text in the profile"
                )
            }
            symbol = count + 8
        } else {
            let mut expected = builtin_parameter_types(name)
            let mut index = 0
            while index < argument_count {
                if pattern_line_field(argument_types, 0, index) !=
                   expected_parameter_head(expected) {
                    return selfhost_error(
                        "E2S15",
                        decimal_value(
                            pattern_line_field(
                                "x" + argument_starts,
                                0,
                                index + 1
                            )
                        ),
                        "builtin argument type mismatch"
                    )
                }
                expected = expected_parameter_tail(expected)
                index = index + 1
            }
            symbol = count + selfhost_builtin_slot(name)
        }
    }
    let call_record = "xnode|" + to_text(local_next) + "|call|" +
    to_text(at) + "|" + to_text(call_end) + "|" + result_type + "|" +
    to_text(symbol) + argument_ids + "\n"
    return selfhost_expression_result(
        after,
        local_next,
        local_next + 1,
        result_type,
        records + call_record
    )
}

fn selfhost_parse_primary(
    source: Text,
    functions: Text,
    env: Text,
    cursor: Int,
    next: Int
) -> Text {
    let at = cursor
    if at >= len(source) {
        return selfhost_error("E2S12", at, "expected expression")
    }
    let kind = token_kind(source, at)
    let end = token_end(source, at)
    # Scoped parallelism v1 (#555) fixes `par` as target semantics in
    # spec/concurrency/scoped-parallelism-v1.md. The lexer owns the keyword so
    # this refusal names the construct instead of surfacing as an unknown
    # binding, but ownership checking, scheduling, and lowering do not exist:
    # the honest answer here is a refusal, not a partial acceptance.
    if token_text(source, at) == "par" {
        return selfhost_error(
            "E2S154",
            at,
            "scoped parallelism `par` is specified but not implemented"
        )
    }
    if kind == "integer" {
        return selfhost_expression_result(
            skip_trivia(source, end),
            next,
            next + 1,
            "Int",
            "xnode|" + to_text(next) + "|literal-int|" + to_text(at) +
            "|" + to_text(end) + "|Int\n"
        )
    }
    if kind == "string" {
        return selfhost_expression_result(
            skip_trivia(source, end),
            next,
            next + 1,
            "Text",
            "xnode|" + to_text(next) + "|literal-text|" + to_text(at) +
            "|" + to_text(end) + "|Text\n"
        )
    }
    let token = token_text(source, at)
    if token == "true" || token == "false" {
        return selfhost_expression_result(
            skip_trivia(source, end),
            next,
            next + 1,
            "Bool",
            "xnode|" + to_text(next) + "|literal-bool|" + to_text(at) +
            "|" + to_text(end) + "|Bool\n"
        )
    }
    if token == "(" {
        let inner = selfhost_parse_expression(
            source,
            functions,
            env,
            skip_trivia(source, end),
            next
        )
        if selfhost_failed(inner) {
            return inner
        }
        let close = selfhost_field_int(inner, 0)
        if close >= len(source) || token_text(source, close) != ")" {
            return selfhost_error("E2S12", close, "expected `)`")
        }
        return selfhost_expression_result(
            skip_trivia(source, token_end(source, close)),
            selfhost_field_int(inner, 1),
            selfhost_field_int(inner, 2),
            selfhost_field(inner, 3),
            selfhost_records(inner)
        )
    }
    if kind == "identifier" {
        let after = skip_trivia(source, end)
        if after < len(source) && token_text(source, after) == "(" {
            return selfhost_parse_call(source, functions, env, at, next)
        }
        let resolved = selfhost_resolve(env, token)
        if resolved < 0 {
            return selfhost_error("E2S35", at, "unknown lexical binding")
        }
        return selfhost_expression_result(
            after,
            next,
            next + 1,
            pattern_line_field(env, resolved, 2),
            "xnode|" + to_text(next) + "|name|" + to_text(at) + "|" +
            to_text(end) + "|" + pattern_line_field(env, resolved, 2) +
            "|" + pattern_line_field(env, resolved, 3) + "\n"
        )
    }
    return selfhost_error("E2S12", at, "expected expression")
}

fn selfhost_parse_postfix(
    source: Text,
    functions: Text,
    env: Text,
    cursor: Int,
    next: Int
) -> Text {
    let mut result = selfhost_parse_primary(
        source,
        functions,
        env,
        cursor,
        next
    )
    if selfhost_failed(result) {
        return result
    }
    let mut walk = selfhost_field_int(result, 0)
    while walk < len(source) && token_text(source, walk) == "[" {
        if selfhost_field(result, 3) != "List" {
            return selfhost_error(
                "E2S15",
                walk,
                "only List[Text] can be indexed"
            )
        }
        let index = selfhost_parse_expression(
            source,
            functions,
            env,
            skip_trivia(source, token_end(source, walk)),
            selfhost_field_int(result, 2)
        )
        if selfhost_failed(index) {
            return index
        }
        let index_root = selfhost_field_int(index, 1)
        if selfhost_field(index, 3) != "Int" {
            return selfhost_error(
                "E2S15",
                selfhost_tree_int(selfhost_records(index), index_root, 3),
                "index must be Int"
            )
        }
        let close_at = selfhost_field_int(index, 0)
        if close_at >= len(source) || token_text(source, close_at) != "]" {
            return selfhost_error("E2S12", close_at, "expected `]`")
        }
        let close = token_end(source, close_at)
        let records = selfhost_records(result) + selfhost_records(index)
        let base_root = selfhost_field_int(result, 1)
        let id = selfhost_field_int(index, 2)
        result = selfhost_expression_result(
            skip_trivia(source, close),
            id,
            id + 1,
            "Text",
            records + "xnode|" + to_text(id) + "|index|" +
            selfhost_tree_field(records, base_root, 3) + "|" +
            to_text(close) + "|Text|" + to_text(base_root) + "|" +
            to_text(index_root) + "\n"
        )
        walk = selfhost_field_int(result, 0)
    }
    return result
}

fn selfhost_parse_unary(
    source: Text,
    functions: Text,
    env: Text,
    cursor: Int,
    next: Int
) -> Text {
    let at = cursor
    if at < len(source) &&
       (token_text(source, at) == "!" || token_text(source, at) == "-") {
        let negation = token_text(source, at) == "!"
        let operand = selfhost_parse_unary(
            source,
            functions,
            env,
            skip_trivia(source, token_end(source, at)),
            next
        )
        if selfhost_failed(operand) {
            return operand
        }
        let root = selfhost_field_int(operand, 1)
        let records = selfhost_records(operand)
        if negation && selfhost_field(operand, 3) != "Bool" {
            return selfhost_error(
                "E2S15",
                selfhost_tree_int(records, root, 3),
                "`!` expects Bool"
            )
        }
        if !negation && selfhost_field(operand, 3) != "Int" {
            return selfhost_error(
                "E2S15",
                selfhost_tree_int(records, root, 3),
                "unary `-` expects Int"
            )
        }
        let mut result_type = "Int"
        let mut operator = "-"
        if negation {
            result_type = "Bool"
            operator = "!"
        }
        let id = selfhost_field_int(operand, 2)
        return selfhost_expression_result(
            selfhost_field_int(operand, 0),
            id,
            id + 1,
            result_type,
            records + "xnode|" + to_text(id) + "|unary|" + to_text(at) +
            "|" + selfhost_tree_field(records, root, 4) + "|" +
            result_type + "|" + operator + "|" + to_text(root) + "\n"
        )
    }
    return selfhost_parse_postfix(source, functions, env, cursor, next)
}

# Levels: 0 `||`; 1 `&&`; 2 comparisons; 3 `+ -`; 4 `* / // %`.
fn selfhost_parse_binary(
    source: Text,
    functions: Text,
    env: Text,
    cursor: Int,
    next: Int,
    level: Int
) -> Text {
    if level > 4 {
        return selfhost_parse_unary(source, functions, env, cursor, next)
    }
    let mut result = selfhost_parse_binary(
        source,
        functions,
        env,
        cursor,
        next,
        level + 1
    )
    if selfhost_failed(result) {
        return result
    }
    let mut walk = selfhost_field_int(result, 0)
    while walk < len(source) &&
          selfhost_operator_level(level, token_text(source, walk)) {
        let operator_at = walk
        let operator = token_text(source, walk)
        let right = selfhost_parse_binary(
            source,
            functions,
            env,
            skip_trivia(source, token_end(source, walk)),
            selfhost_field_int(result, 2),
            level + 1
        )
        if selfhost_failed(right) {
            return right
        }
        let left_type = selfhost_field(result, 3)
        let right_type = selfhost_field(right, 3)
        let mut result_type = ""
        if level <= 1 {
            if left_type != "Bool" || right_type != "Bool" {
                return selfhost_error(
                    "E2S15",
                    operator_at,
                    "logical operands must be Bool"
                )
            }
            result_type = "Bool"
        } else if level == 2 {
            if left_type != right_type || left_type == "List" ||
               left_type == "Void" {
                return selfhost_error(
                    "E2S15",
                    operator_at,
                    "comparison operands must share a scalar type"
                )
            }
            result_type = "Bool"
        } else if level == 3 && operator == "+" && left_type == "Text" {
            if right_type != "Text" {
                return selfhost_error(
                    "E2S15",
                    operator_at,
                    "Text `+` expects Text"
                )
            }
            result_type = "Text"
        } else {
            if left_type != "Int" || right_type != "Int" {
                return selfhost_error(
                    "E2S15",
                    operator_at,
                    "arithmetic operands must be Int"
                )
            }
            result_type = "Int"
        }
        let records = selfhost_records(result) + selfhost_records(right)
        let left_root = selfhost_field_int(result, 1)
        let right_root = selfhost_field_int(right, 1)
        let id = selfhost_field_int(right, 2)
        result = selfhost_expression_result(
            selfhost_field_int(right, 0),
            id,
            id + 1,
            result_type,
            records + "xnode|" + to_text(id) + "|binary|" +
            selfhost_tree_field(records, left_root, 3) + "|" +
            selfhost_tree_field(records, right_root, 4) + "|" +
            result_type + "|" + selfhost_escape(operator) + "|" +
            to_text(left_root) + "|" + to_text(right_root) + "\n"
        )
        walk = selfhost_field_int(result, 0)
    }
    return result
}

fn selfhost_parse_expression(
    source: Text,
    functions: Text,
    env: Text,
    cursor: Int,
    next: Int
) -> Text {
    return selfhost_parse_binary(source, functions, env, cursor, next, 0)
}

# The second expression walk: renumber one parsed tree into pre-order
# document node records, parent before children.

fn selfhost_ownership(value_type: Text) -> Text {
    if value_type == "Text" || value_type == "List" {
        return "read"
    }
    return "copy"
}

# Decode source string escapes, then re-escape for the record format.
fn selfhost_text_literal_field(source: Text, start: Int, end: Int) -> Text {
    let symbols = chars(source)
    let mut decoded = ""
    let mut cursor = start + 1
    while cursor + 1 < end {
        let symbol = symbols[cursor]
        if symbol == "\\" {
            let following = symbols[cursor + 1]
            if following == "n" {
                decoded = decoded + "\n"
            } else {
                decoded = decoded + following
            }
            cursor = cursor + 2
        } else {
            decoded = decoded + symbol
            cursor = cursor + 1
        }
    }
    return selfhost_escape(decoded)
}

# Emit the xnode `id` as document node `node`; returns `NEXT` over the
# emitted records. Child ids follow their parent, in field order.
fn selfhost_emit_expression(
    source: Text,
    types: Text,
    tree: Text,
    id: Int,
    node: Int
) -> Text {
    let line = selfhost_tree_line(tree, id)
    let kind = pattern_line_field(tree, line, 2)
    let start = pattern_line_field(tree, line, 3)
    let end = pattern_line_field(tree, line, 4)
    let value_type = pattern_line_field(tree, line, 5)
    let type_id = selfhost_scalar_id(types, value_type)
    let mut fields = ""
    let mut children = ""
    let mut next = node + 1
    if kind == "literal-int" || kind == "literal-bool" {
        fields = text_slice(
            source,
            decimal_value(start),
            decimal_value(end)
        )
    } else if kind == "literal-text" {
        fields = selfhost_text_literal_field(
            source,
            decimal_value(start),
            decimal_value(end)
        )
    } else if kind == "name" {
        fields = pattern_line_field(tree, line, 6)
    } else if kind == "call" {
        fields = pattern_line_field(tree, line, 6)
        let mut argument_field = 7
        while len(pattern_line_field(tree, line, argument_field)) > 0 {
            let argument = decimal_value(
                pattern_line_field(tree, line, argument_field)
            )
            fields = fields + "|" + to_text(next)
            let emitted = selfhost_emit_expression(
                source,
                types,
                tree,
                argument,
                next
            )
            next = selfhost_field_int(emitted, 0)
            children = children + selfhost_records(emitted)
            argument_field = argument_field + 1
        }
    } else if kind == "unary" {
        let operand = decimal_value(pattern_line_field(tree, line, 7))
        fields = pattern_line_field(tree, line, 6) + "|" + to_text(next)
        let emitted = selfhost_emit_expression(
            source,
            types,
            tree,
            operand,
            next
        )
        next = selfhost_field_int(emitted, 0)
        children = selfhost_records(emitted)
    } else if kind == "binary" {
        let left = decimal_value(pattern_line_field(tree, line, 7))
        let right = decimal_value(pattern_line_field(tree, line, 8))
        let left_id = next
        let left_emitted = selfhost_emit_expression(
            source,
            types,
            tree,
            left,
            next
        )
        next = selfhost_field_int(left_emitted, 0)
        let right_id = next
        let right_emitted = selfhost_emit_expression(
            source,
            types,
            tree,
            right,
            next
        )
        next = selfhost_field_int(right_emitted, 0)
        fields = pattern_line_field(tree, line, 6) + "|" +
        to_text(left_id) + "|" + to_text(right_id)
        children = selfhost_records(left_emitted) +
        selfhost_records(right_emitted)
    } else {
        let left = decimal_value(pattern_line_field(tree, line, 6))
        let right = decimal_value(pattern_line_field(tree, line, 7))
        let left_id = next
        let left_emitted = selfhost_emit_expression(
            source,
            types,
            tree,
            left,
            next
        )
        next = selfhost_field_int(left_emitted, 0)
        let right_id = next
        let right_emitted = selfhost_emit_expression(
            source,
            types,
            tree,
            right,
            next
        )
        next = selfhost_field_int(right_emitted, 0)
        fields = to_text(left_id) + "|" + to_text(right_id)
        children = selfhost_records(left_emitted) +
        selfhost_records(right_emitted)
    }
    return to_text(next) + "\n" + "node|" + to_text(node) + "|" + kind +
    "|" + start + "|" + end + "|" + to_text(type_id) + "|" +
    selfhost_ownership(value_type) + "|" + fields + "\n" + children
}

# Statement results pack `END|NODE|SCOPE|SYMBOL|BINDING|STMTID` and then
# `ENVNAME|ENVTYPE|ENVBINDING|ENVMUT` when the statement declared a local,
# over the statement's scope, symbol, binding, and node records.

fn selfhost_counters(
    node: Int,
    scope: Int,
    symbol: Int,
    binding: Int
) -> Text {
    return to_text(node) + "|" + to_text(scope) + "|" + to_text(symbol) +
    "|" + to_text(binding)
}

fn selfhost_counter(counters: Text, wanted: Int) -> Int {
    return decimal_value(pattern_line_field(counters, 0, wanted))
}

fn selfhost_statement_result(
    end: Int,
    counters: Text,
    statement: Int,
    declared_env: Text,
    records: Text
) -> Text {
    let mut env_fields = "|||"
    if len(declared_env) > 0 {
        env_fields = declared_env
    }
    return to_text(end) + "|" + counters + "|" + to_text(statement) +
    "|" + env_fields + "\n" + records
}

# One symbol plus binding record pair; `ids` packs `SYMBOL|BINDING` and
# `span` packs `START|END` of the declared name.
fn selfhost_bind_records(
    types: Text,
    ids: Text,
    scope: Int,
    name: Text,
    surface: Text,
    mutability: Text,
    kind: Text,
    span: Text
) -> Text {
    return "symbol|" + pattern_line_field(ids, 0, 0) + "|" + kind + "|" +
    name + "|" + to_text(selfhost_scalar_id(types, surface)) + "|" +
    span + "\n" + "binding|" + pattern_line_field(ids, 0, 1) + "|" +
    to_text(scope) + "|" + pattern_line_field(ids, 0, 0) + "|" + name +
    "|" + mutability + "|" + span + "\n"
}

fn selfhost_let_statement(
    source: Text,
    functions: Text,
    types: Text,
    env: Text,
    cursor: Int,
    counters: Text,
    scope_context: Text
) -> Text {
    let at = cursor
    let mut name = skip_trivia(source, token_end(source, at))
    let mut mutability = "imm"
    if name < len(source) && token_text(source, name) == "mut" {
        mutability = "mut"
        name = skip_trivia(source, token_end(source, name))
    }
    if name >= len(source) || token_kind(source, name) != "identifier" {
        return selfhost_error("E2S12", name, "expected binding name")
    }
    let name_end = token_end(source, name)
    let mut after = skip_trivia(source, name_end)
    let mut annotation = ""
    if after < len(source) && token_text(source, after) == ":" {
        let type_at = skip_trivia(source, token_end(source, after))
        annotation = token_text(source, type_at)
        after = skip_trivia(source, token_end(source, type_at))
        if annotation == "List" {
            after = skip_trivia(source, token_end(source, after))
            after = skip_trivia(source, token_end(source, after))
        }
    }
    if after >= len(source) || token_text(source, after) != "=" {
        return selfhost_error("E2S12", after, "expected `=`")
    }
    let statement = selfhost_counter(counters, 0)
    let value = selfhost_parse_expression(
        source,
        functions,
        env,
        skip_trivia(source, token_end(source, after)),
        0
    )
    if selfhost_failed(value) {
        return value
    }
    let tree = selfhost_records(value)
    let root = selfhost_field_int(value, 1)
    if len(annotation) > 0 && annotation != selfhost_field(value, 3) {
        return selfhost_error(
            "E2S15",
            selfhost_tree_int(tree, root, 3),
            "initializer type mismatch"
        )
    }
    if selfhost_env_count(env) >= 512 {
        return selfhost_error(
            "E2S35",
            name,
            "lexical binding limit is 512"
        )
    }
    let emitted = selfhost_emit_expression(
        source,
        types,
        tree,
        root,
        statement + 1
    )
    let symbol = selfhost_counter(counters, 2)
    let binding = selfhost_counter(counters, 3)
    let scope = decimal_value(pattern_line_field(scope_context, 0, 0))
    let name_text = token_text(source, name)
    let value_type = selfhost_field(value, 3)
    let mut kind = "let"
    if mutability == "mut" {
        kind = "let-mut"
    }
    return selfhost_statement_result(
        selfhost_field_int(value, 0),
        selfhost_counters(
            selfhost_field_int(emitted, 0),
            selfhost_counter(counters, 1),
            symbol + 1,
            binding + 1
        ),
        statement,
        name_text + "|" + value_type + "|" + to_text(binding) + "|" +
        mutability,
        selfhost_bind_records(
            types,
            to_text(symbol) + "|" + to_text(binding),
            scope,
            name_text,
            value_type,
            mutability,
            "local",
            to_text(name) + "|" + to_text(name_end)
        ) + "node|" + to_text(statement) + "|" + kind + "|" +
        to_text(at) + "|" + selfhost_tree_field(tree, root, 4) + "|" +
        to_text(selfhost_scalar_id(types, "Void")) + "|copy|" +
        to_text(binding) + "|" + to_text(statement + 1) + "\n" +
        selfhost_records(emitted)
    )
}

fn selfhost_branch_statement(
    source: Text,
    functions: Text,
    types: Text,
    env: Text,
    declared: Text,
    cursor: Int,
    counters: Text,
    scope_context: Text
) -> Text {
    let at = cursor
    let condition_if = token_text(source, at) == "if"
    let statement = selfhost_counter(counters, 0)
    let condition = selfhost_parse_expression(
        source,
        functions,
        env,
        skip_trivia(source, token_end(source, at)),
        0
    )
    if selfhost_failed(condition) {
        return condition
    }
    let tree = selfhost_records(condition)
    let root = selfhost_field_int(condition, 1)
    if selfhost_field(condition, 3) != "Bool" {
        let mut message = "while condition must be Bool"
        if condition_if {
            message = "if condition must be Bool or an Int comparison"
        }
        return selfhost_error(
            "E2S23",
            selfhost_tree_int(tree, root, 3),
            message
        )
    }
    let emitted = selfhost_emit_expression(
        source,
        types,
        tree,
        root,
        statement + 1
    )
    let body = selfhost_block(
        source,
        functions,
        types,
        env,
        declared,
        selfhost_field_int(condition, 0),
        selfhost_counters(
            selfhost_field_int(emitted, 0),
            selfhost_counter(counters, 1),
            selfhost_counter(counters, 2),
            selfhost_counter(counters, 3)
        ),
        scope_context,
        -1
    )
    if selfhost_failed(body) {
        return body
    }
    let body_scope = selfhost_field_int(body, 5)
    let mut walk = selfhost_field_int(body, 0)
    let mut branch_counters = selfhost_counters(
        selfhost_field_int(body, 1),
        selfhost_field_int(body, 2),
        selfhost_field_int(body, 3),
        selfhost_field_int(body, 4)
    )
    let mut records = selfhost_records(emitted) + selfhost_records(body)
    let mut else_kind = "none"
    let mut else_reference = -1
    if condition_if && walk < len(source) &&
       token_text(source, walk) == "else" {
        let next_at = skip_trivia(source, token_end(source, walk))
        if next_at < len(source) && token_text(source, next_at) == "if" {
            let chained = selfhost_statement(
                source,
                functions,
                types,
                env,
                declared,
                next_at,
                branch_counters,
                scope_context
            )
            if selfhost_failed(chained) {
                return chained
            }
            else_kind = "if"
            else_reference = selfhost_field_int(chained, 5)
            walk = selfhost_field_int(chained, 0)
            branch_counters = selfhost_counters(
                selfhost_field_int(chained, 1),
                selfhost_field_int(chained, 2),
                selfhost_field_int(chained, 3),
                selfhost_field_int(chained, 4)
            )
            records = records + selfhost_records(chained)
        } else {
            let alternative = selfhost_block(
                source,
                functions,
                types,
                env,
                declared,
                next_at,
                branch_counters,
                scope_context,
                -1
            )
            if selfhost_failed(alternative) {
                return alternative
            }
            else_kind = "block"
            else_reference = selfhost_field_int(alternative, 5)
            walk = selfhost_field_int(alternative, 0)
            branch_counters = selfhost_counters(
                selfhost_field_int(alternative, 1),
                selfhost_field_int(alternative, 2),
                selfhost_field_int(alternative, 3),
                selfhost_field_int(alternative, 4)
            )
            records = records + selfhost_records(alternative)
        }
    }
    let mut kind = "while"
    let mut fields = to_text(statement + 1) + "|" + to_text(body_scope)
    if condition_if {
        kind = "if"
        fields = fields + "|" + else_kind + "|" + to_text(else_reference)
    }
    return selfhost_statement_result(
        walk,
        branch_counters,
        statement,
        "",
        "node|" + to_text(statement) + "|" + kind + "|" + to_text(at) +
        "|" + to_text(walk) + "|" +
        to_text(selfhost_scalar_id(types, "Void")) + "|copy|" + fields +
        "\n" + records
    )
}

fn selfhost_for_statement(
    source: Text,
    functions: Text,
    types: Text,
    env: Text,
    declared: Text,
    cursor: Int,
    counters: Text,
    scope_context: Text
) -> Text {
    let at = cursor
    let name = skip_trivia(source, token_end(source, at))
    if name >= len(source) || token_kind(source, name) != "identifier" {
        return selfhost_error("E2S12", name, "expected loop variable")
    }
    let in_at = skip_trivia(source, token_end(source, name))
    if in_at >= len(source) || token_text(source, in_at) != "in" {
        return selfhost_error("E2S12", in_at, "expected `in`")
    }
    let low = selfhost_parse_expression(
        source,
        functions,
        env,
        skip_trivia(source, token_end(source, in_at)),
        0
    )
    if selfhost_failed(low) {
        return low
    }
    let dots = selfhost_field_int(low, 0)
    if dots >= len(source) || token_text(source, dots) != ".." {
        return selfhost_error("E2S12", dots, "expected `..`")
    }
    let high = selfhost_parse_expression(
        source,
        functions,
        env,
        skip_trivia(source, token_end(source, dots)),
        selfhost_field_int(low, 2)
    )
    if selfhost_failed(high) {
        return high
    }
    let low_root = selfhost_field_int(low, 1)
    let high_root = selfhost_field_int(high, 1)
    let mut tree = selfhost_records(low) + selfhost_records(high)
    if selfhost_field(low, 3) != "Int" || selfhost_field(high, 3) != "Int" {
        return selfhost_error(
            "E2S15",
            selfhost_tree_int(tree, low_root, 3),
            "range bounds must be Int"
        )
    }
    let range = selfhost_field_int(high, 2)
    tree = tree + "xnode|" + to_text(range) + "|range|" +
    selfhost_tree_field(tree, low_root, 3) + "|" +
    selfhost_tree_field(tree, high_root, 4) + "|Int|" +
    to_text(low_root) + "|" + to_text(high_root) + "\n"
    let statement = selfhost_counter(counters, 0)
    let emitted = selfhost_emit_expression(
        source,
        types,
        tree,
        range,
        statement + 1
    )
    let loop_binding = selfhost_counter(counters, 3)
    let body = selfhost_block(
        source,
        functions,
        types,
        env,
        declared,
        selfhost_field_int(high, 0),
        selfhost_counters(
            selfhost_field_int(emitted, 0),
            selfhost_counter(counters, 1),
            selfhost_counter(counters, 2),
            selfhost_counter(counters, 3)
        ),
        scope_context,
        name
    )
    if selfhost_failed(body) {
        return body
    }
    let walk = selfhost_field_int(body, 0)
    return selfhost_statement_result(
        walk,
        selfhost_counters(
            selfhost_field_int(body, 1),
            selfhost_field_int(body, 2),
            selfhost_field_int(body, 3),
            selfhost_field_int(body, 4)
        ),
        statement,
        "",
        "node|" + to_text(statement) + "|for-range|" + to_text(at) + "|" +
        to_text(walk) + "|" + to_text(selfhost_scalar_id(types, "Void")) +
        "|copy|" + to_text(loop_binding) + "|" + to_text(statement + 1) +
        "|" + to_text(selfhost_field_int(body, 5)) + "\n" +
        selfhost_records(emitted) + selfhost_records(body)
    )
}

fn selfhost_return_statement(
    source: Text,
    functions: Text,
    types: Text,
    env: Text,
    declared: Text,
    cursor: Int,
    counters: Text
) -> Text {
    let at = cursor
    let keyword_end = token_end(source, at)
    let value_at = skip_trivia(source, keyword_end)
    let statement = selfhost_counter(counters, 0)
    let void_id = to_text(selfhost_scalar_id(types, "Void"))
    if value_at >= len(source) || token_text(source, value_at) == "}" ||
       newline_between(source, keyword_end, value_at) {
        if declared != "Void" {
            return selfhost_error("E2S19", at, "missing return value")
        }
        return selfhost_statement_result(
            value_at,
            selfhost_counters(
                statement + 1,
                selfhost_counter(counters, 1),
                selfhost_counter(counters, 2),
                selfhost_counter(counters, 3)
            ),
            statement,
            "",
            "node|" + to_text(statement) + "|return|" + to_text(at) +
            "|" + to_text(keyword_end) + "|" + void_id + "|copy|none\n"
        )
    }
    let value = selfhost_parse_expression(
        source,
        functions,
        env,
        value_at,
        0
    )
    if selfhost_failed(value) {
        return value
    }
    let tree = selfhost_records(value)
    let root = selfhost_field_int(value, 1)
    if selfhost_field(value, 3) != declared {
        return selfhost_error(
            "E2S15",
            selfhost_tree_int(tree, root, 3),
            "return type mismatch"
        )
    }
    let emitted = selfhost_emit_expression(
        source,
        types,
        tree,
        root,
        statement + 1
    )
    return selfhost_statement_result(
        selfhost_field_int(value, 0),
        selfhost_counters(
            selfhost_field_int(emitted, 0),
            selfhost_counter(counters, 1),
            selfhost_counter(counters, 2),
            selfhost_counter(counters, 3)
        ),
        statement,
        "",
        "node|" + to_text(statement) + "|return|" + to_text(at) + "|" +
        selfhost_tree_field(tree, root, 4) + "|" + void_id + "|copy|" +
        to_text(statement + 1) + "\n" + selfhost_records(emitted)
    )
}

fn selfhost_leading_statement(
    source: Text,
    functions: Text,
    types: Text,
    env: Text,
    cursor: Int,
    counters: Text
) -> Text {
    let at = cursor
    # Scoped parallelism v1 (#1160). `handle.join()` reaches no dispatch below
    # and was refused as an unsupported statement blamed on the whole line.
    # Name the construct, at its own token.
    let parallel_member = scoped_parallel_member(source, at)
    if parallel_member >= 0 {
        return selfhost_error(
            "E2S154",
            parallel_member,
            "scoped parallelism `" + token_text(source, parallel_member) +
            "` is specified but not implemented"
        )
    }
    let after = skip_trivia(source, token_end(source, at))
    let statement = selfhost_counter(counters, 0)
    let void_id = to_text(selfhost_scalar_id(types, "Void"))
    if after < len(source) && token_text(source, after) == "=" {
        let resolved = selfhost_resolve(env, token_text(source, at))
        if resolved < 0 {
            return selfhost_error("E2S35", at, "unknown lexical binding")
        }
        if pattern_line_field(env, resolved, 4) != "mut" {
            return selfhost_error(
                "E2S22",
                at,
                "assignment target is immutable"
            )
        }
        let value = selfhost_parse_expression(
            source,
            functions,
            env,
            skip_trivia(source, token_end(source, after)),
            0
        )
        if selfhost_failed(value) {
            return value
        }
        let tree = selfhost_records(value)
        let root = selfhost_field_int(value, 1)
        if selfhost_field(value, 3) != pattern_line_field(env, resolved, 2) {
            return selfhost_error(
                "E2S15",
                selfhost_tree_int(tree, root, 3),
                "assignment type mismatch"
            )
        }
        let emitted = selfhost_emit_expression(
            source,
            types,
            tree,
            root,
            statement + 1
        )
        return selfhost_statement_result(
            selfhost_field_int(value, 0),
            selfhost_counters(
                selfhost_field_int(emitted, 0),
                selfhost_counter(counters, 1),
                selfhost_counter(counters, 2),
                selfhost_counter(counters, 3)
            ),
            statement,
            "",
            "node|" + to_text(statement) + "|assign|" + to_text(at) +
            "|" + selfhost_tree_field(tree, root, 4) + "|" + void_id +
            "|edit|" + pattern_line_field(env, resolved, 3) + "|" +
            to_text(statement + 1) + "\n" + selfhost_records(emitted)
        )
    }
    let value = selfhost_parse_expression(source, functions, env, at, 0)
    if selfhost_failed(value) {
        return value
    }
    let tree = selfhost_records(value)
    let root = selfhost_field_int(value, 1)
    let emitted = selfhost_emit_expression(
        source,
        types,
        tree,
        root,
        statement + 1
    )
    return selfhost_statement_result(
        selfhost_field_int(value, 0),
        selfhost_counters(
            selfhost_field_int(emitted, 0),
            selfhost_counter(counters, 1),
            selfhost_counter(counters, 2),
            selfhost_counter(counters, 3)
        ),
        statement,
        "",
        "node|" + to_text(statement) + "|expr-stmt|" + to_text(at) + "|" +
        selfhost_tree_field(tree, root, 4) + "|" + void_id + "|copy|" +
        to_text(statement + 1) + "\n" + selfhost_records(emitted)
    )
}

fn selfhost_statement(
    source: Text,
    functions: Text,
    types: Text,
    env: Text,
    declared: Text,
    cursor: Int,
    counters: Text,
    scope_context: Text
) -> Text {
    let token = token_text(source, cursor)
    # See selfhost_parse_primary: `par` in statement position is refused by name
    # rather than falling through to the generic unsupported-statement code.
    if token == "par" {
        return selfhost_error(
            "E2S154",
            cursor,
            "scoped parallelism `par` is specified but not implemented"
        )
    }
    if token == "let" {
        return selfhost_let_statement(
            source,
            functions,
            types,
            env,
            cursor,
            counters,
            scope_context
        )
    }
    if token == "if" || token == "while" {
        return selfhost_branch_statement(
            source,
            functions,
            types,
            env,
            declared,
            cursor,
            counters,
            scope_context
        )
    }
    if token == "for" {
        return selfhost_for_statement(
            source,
            functions,
            types,
            env,
            declared,
            cursor,
            counters,
            scope_context
        )
    }
    if token == "return" {
        return selfhost_return_statement(
            source,
            functions,
            types,
            env,
            declared,
            cursor,
            counters
        )
    }
    if token_kind(source, cursor) == "identifier" {
        return selfhost_leading_statement(
            source,
            functions,
            types,
            env,
            cursor,
            counters
        )
    }
    return selfhost_error("E2S10", cursor, "unsupported Core statement")
}

fn selfhost_block(
    source: Text,
    functions: Text,
    types: Text,
    env: Text,
    declared: Text,
    cursor: Int,
    counters: Text,
    scope_context: Text,
    loop_name: Int
) -> Text {
    if cursor >= len(source) || token_text(source, cursor) != "{" {
        return selfhost_error("E2S18", cursor, "expected `{`")
    }
    let open = cursor
    let close = balanced_end(source, open, "{", "}")
    if close < 0 {
        return selfhost_error("E2S18", open, "unbalanced `{`")
    }
    let depth = decimal_value(pattern_line_field(scope_context, 0, 1))
    if depth >= 32 {
        return selfhost_error(
            "E2S35",
            open,
            "lexical scope depth limit is 32"
        )
    }
    let scope = selfhost_counter(counters, 1)
    let mut records = "scope|" + to_text(scope) + "|" +
    pattern_line_field(scope_context, 0, 0) + "|block|" + to_text(open) +
    "|" + to_text(close) + "\n"
    let mut block_counters = selfhost_counters(
        selfhost_counter(counters, 0),
        scope + 1,
        selfhost_counter(counters, 2),
        selfhost_counter(counters, 3)
    )
    let mut block_env = env
    if loop_name >= 0 {
        if selfhost_env_count(block_env) >= 512 {
            return selfhost_error(
                "E2S35",
                loop_name,
                "lexical binding limit is 512"
            )
        }
        let symbol = selfhost_counter(block_counters, 2)
        let binding = selfhost_counter(block_counters, 3)
        let name_text = token_text(source, loop_name)
        records = records + selfhost_bind_records(
            types,
            to_text(symbol) + "|" + to_text(binding),
            scope,
            name_text,
            "Int",
            "imm",
            "local",
            to_text(loop_name) + "|" +
            to_text(token_end(source, loop_name))
        )
        block_env = block_env + "env|" + name_text + "|Int|" +
        to_text(binding) + "|imm\n"
        block_counters = selfhost_counters(
            selfhost_counter(block_counters, 0),
            selfhost_counter(block_counters, 1),
            symbol + 1,
            binding + 1
        )
    }
    let inner_context = to_text(scope) + "|" + to_text(depth + 1)
    let mut walk = skip_trivia(source, token_end(source, open))
    let mut statement_count = 0
    while walk < len(source) && token_text(source, walk) != "}" {
        if statement_count >= 64 {
            return selfhost_error(
                "E2S35",
                walk,
                "block statement limit is 64"
            )
        }
        let statement = selfhost_statement(
            source,
            functions,
            types,
            block_env,
            declared,
            walk,
            block_counters,
            inner_context
        )
        if selfhost_failed(statement) {
            return statement
        }
        walk = selfhost_field_int(statement, 0)
        block_counters = selfhost_counters(
            selfhost_field_int(statement, 1),
            selfhost_field_int(statement, 2),
            selfhost_field_int(statement, 3),
            selfhost_field_int(statement, 4)
        )
        if len(selfhost_field(statement, 6)) > 0 {
            block_env = block_env + "env|" + selfhost_field(statement, 6) +
            "|" + selfhost_field(statement, 7) + "|" +
            selfhost_field(statement, 8) + "|" +
            selfhost_field(statement, 9) + "\n"
        }
        records = records + selfhost_records(statement)
        statement_count = statement_count + 1
    }
    if walk >= len(source) || token_text(source, walk) != "}" {
        return selfhost_error("E2S18", walk, "expected `}`")
    }
    return to_text(skip_trivia(source, token_end(source, walk))) + "|" +
    block_counters + "|" + to_text(scope) + "\n" + records
}

fn selfhost_first_line(value: Text) -> Text {
    let symbols = chars(value)
    let mut cursor = 0
    while cursor < len(symbols) && symbols[cursor] != "\n" {
        cursor = cursor + 1
    }
    return text_slice(value, 0, cursor)
}

# Collect the record lines carrying one tag, in generation order.
fn selfhost_lines(records: Text, tag: Text) -> Text {
    let symbols = chars(records)
    let mut collected = ""
    let mut line = 0
    while line < len(symbols) {
        let mut line_end = line
        while line_end < len(symbols) && symbols[line_end] != "\n" {
            line_end = line_end + 1
        }
        if line + len(tag) <= line_end &&
           text_slice(records, line, line + len(tag)) == tag {
            collected = collected + text_slice(records, line, line_end) +
            "\n"
        }
        line = line_end + 1
    }
    return collected
}

fn selfhost_node_lines(records: Text) -> Text {
    let symbols = chars(records)
    let mut collected = ""
    let mut line = 0
    while line < len(symbols) {
        let mut line_end = line
        while line_end < len(symbols) && symbols[line_end] != "\n" {
            line_end = line_end + 1
        }
        let mut keep = line + 5 <= line_end &&
        text_slice(records, line, line + 5) == "node|"
        if line + 9 <= line_end &&
           text_slice(records, line, line + 9) == "function|" {
            keep = true
        }
        if keep {
            collected = collected + text_slice(records, line, line_end) +
            "\n"
        }
        line = line_end + 1
    }
    return collected
}

# One function's scope, parameter bindings, and typed body: the function
# scope record, `parameter` symbol/binding pairs, the `function` node
# record, and the body's records. Packs the advanced counters.
fn selfhost_function_hir(
    source: Text,
    functions: Text,
    types: Text,
    index: Int,
    function_start: Int,
    counters: Text
) -> Text {
    let function_close = function_end(source, function_start)
    let parameters = parameter_open(source, function_start)
    let parameters_close = balanced_end(source, parameters, "(", ")")
    let function_scope = selfhost_counter(counters, 1)
    let mut records = "scope|" + to_text(function_scope) +
    "|0|function|" + to_text(parameters) + "|" +
    to_text(function_close) + "\n"
    let line = selfhost_function_line_at(functions, index)
    let mut symbol = selfhost_counter(counters, 2)
    let mut binding = selfhost_counter(counters, 3)
    let mut env = ""
    let mut cursor = skip_trivia(source, token_end(source, parameters))
    let mut parameter_index = 0
    while cursor < parameters_close && token_text(source, cursor) != ")" {
        if selfhost_env_count(env) >= 512 {
            return selfhost_error(
                "E2S35",
                cursor,
                "lexical binding limit is 512"
            )
        }
        let surface = pattern_line_field(
            functions,
            line,
            4 + parameter_index
        )
        let name_at = parameter_internal_start(
            source,
            cursor,
            parameters_close
        )
        let type_at = parameter_type_start(
            source,
            cursor,
            parameters_close
        )
        if name_at < 0 || type_at < 0 {
            return selfhost_error(
                "E2S35",
                cursor,
                "malformed parameter head"
            )
        }
        let name_text = token_text(source, name_at)
        records = records + selfhost_bind_records(
            types,
            to_text(symbol) + "|" + to_text(binding),
            function_scope,
            name_text,
            surface,
            "imm",
            "parameter",
            to_text(name_at) + "|" + to_text(token_end(source, name_at))
        )
        env = env + "env|" + name_text + "|" + surface + "|" +
        to_text(binding) + "|imm\n"
        symbol = symbol + 1
        binding = binding + 1
        cursor = skip_trivia(source, token_end(source, type_at))
        if surface == "List" {
            cursor = skip_trivia(source, token_end(source, cursor))
            cursor = skip_trivia(source, token_end(source, cursor))
        }
        parameter_index = parameter_index + 1
        if cursor < parameters_close && token_text(source, cursor) == "," {
            cursor = skip_trivia(source, token_end(source, cursor))
        }
    }
    let mut body_at = skip_trivia(source, parameters_close)
    while body_at < function_close && token_text(source, body_at) != "{" {
        body_at = skip_trivia(source, token_end(source, body_at))
    }
    let function_node = selfhost_counter(counters, 0)
    let body = selfhost_block(
        source,
        functions,
        types,
        env,
        pattern_line_field(functions, line, 2),
        body_at,
        selfhost_counters(
            function_node + 1,
            function_scope + 1,
            symbol,
            binding
        ),
        to_text(function_scope) + "|2",
        -1
    )
    if selfhost_failed(body) {
        return body
    }
    return selfhost_counters(
        selfhost_field_int(body, 1),
        selfhost_field_int(body, 2),
        selfhost_field_int(body, 3),
        selfhost_field_int(body, 4)
    ) + "\n" + records + "function|" + to_text(function_node) + "|" +
    to_text(index) + "|" + to_text(function_scope) + "|" +
    to_text(function_start) + "|" + to_text(function_close) + "\n" +
    selfhost_records(body)
}

# Walk every declared function in source order, threading the document
# counters: nodes from 0, scopes after the module scope, symbols and
# bindings after the registered functions and builtins.
fn selfhost_functions_hir(
    source: Text,
    functions: Text,
    types: Text
) -> Text {
    let count = selfhost_function_count(functions)
    let mut counters = selfhost_counters(0, 1, count + 17, count)
    let mut records = ""
    let mut function_start = next_function_start(source, 0)
    let mut index = 0
    while index < count {
        let one = selfhost_function_hir(
            source,
            functions,
            types,
            index,
            function_start,
            counters
        )
        if selfhost_failed(one) {
            return one
        }
        counters = selfhost_first_line(one)
        records = records + selfhost_records(one)
        let function_close = function_end(source, function_start)
        if function_close >= 0 {
            function_start = next_function_start(source, function_close)
        } else {
            index = count
        }
        index = index + 1
    }
    return "ok\n" + records
}

# Produce the whole kofun.selfhost-hir/v1 document. The first line of the
# result is `complete` or `rejected`; a rejected result carries the
# diagnostic line to print before the document itself.
fn selfhost_document(source: Text, path: Text, digest: Text) -> Text {
    let header = "schema|kofun.selfhost-hir/v1\n" + "source|" + path +
    "|" + digest + "\n"
    let mut failure = ""
    let mut functions = ""
    let mut registered = ""
    let mut types = ""
    let mut hir = ""
    if next_function_start(source, 0) >= len(source) {
        failure = selfhost_error("E2S04", 0, "source declares no functions")
    }
    if len(failure) == 0 {
        let signatures = selfhost_signatures(source)
        if selfhost_failed(signatures) {
            failure = signatures
        } else {
            functions = selfhost_records(signatures)
        }
    }
    if len(failure) == 0 {
        let registration = selfhost_register(source, functions)
        if selfhost_failed(registration) {
            failure = registration
        } else {
            registered = selfhost_records(registration)
        }
    }
    if len(failure) == 0 {
        types = selfhost_lines(registered, "type|")
        let walked = selfhost_functions_hir(source, functions, types)
        if selfhost_failed(walked) {
            failure = walked
        } else {
            hir = selfhost_records(walked)
        }
    }
    if len(failure) == 0 {
        return "complete\n" + header + "status|complete\n" + types +
        "scope|0|0|module|0|" + to_text(len(source)) + "\n" +
        selfhost_lines(hir, "scope|") +
        selfhost_lines(registered, "symbol|") +
        selfhost_lines(hir, "symbol|") +
        selfhost_lines(registered, "binding|") +
        selfhost_lines(hir, "binding|") +
        selfhost_node_lines(hir)
    }
    let code = pattern_line_field(failure, 0, 1)
    let at = decimal_value(pattern_line_field(failure, 0, 2))
    let message = pattern_line_field(failure, 0, 3)
    let mut printed = "error[" + code + "]: " + message
    if at >= 0 {
        printed = printed + " at byte " + to_text(at)
    }
    let mut clamped = at
    if clamped < 0 {
        clamped = 0
    }
    let mut span_end = clamped
    if clamped < len(source) {
        span_end = token_end(source, clamped)
    }
    let mut document = header + "status|rejected\n" + "diagnostic|" +
    code + "|" + to_text(clamped) + "|" + to_text(span_end) + "|" +
    selfhost_escape(message) + "\n"
    # hir-v1.md requires one `unsupported` record naming the construct family
    # for every construct outside the frozen profile, so `par` carries its own
    # family rather than being filed as a statement.
    if code == "E2S10" {
        document = document + "unsupported|" + to_text(clamped) + "|" +
        to_text(span_end) + "|statement\n"
    }
    if code == "E2S154" {
        document = document + "unsupported|" + to_text(clamped) + "|" +
        to_text(span_end) + "|scoped-parallelism\n"
    }
    return "rejected\n" + printed + "\n" + document
}

fn selfhost_valid_digest(digest: Text) -> Bool {
    let symbols = chars(digest)
    if len(symbols) != 64 {
        return false
    }
    let mut cursor = 0
    while cursor < 64 {
        if !contains("0123456789abcdef", symbols[cursor]) {
            return false
        }
        cursor = cursor + 1
    }
    return true
}

fn emit_selfhost_hir_file(
    input_path: Text,
    output_path: Text,
    digest: Text
) -> Int {
    if input_path == output_path {
        print("error[E2S35]: selfhost-HIR input and output must be distinct")
        return 2
    }
    if !selfhost_valid_digest(digest) {
        print("error[E2S35]: selfhost-HIR digest must be 64 lowercase hex")
        return 2
    }
    let source = read_text(input_path)
    let tokens = lex(source)
    if starts_with(tokens, "error[") {
        print(tokens)
        return 1
    }
    let result = selfhost_document(source, input_path, digest)
    if starts_with(result, "complete\n") {
        write_text(output_path, selfhost_records(result))
        return 0
    }
    let rejected = selfhost_records(result)
    print(selfhost_first_line(rejected))
    write_text(output_path, pattern_result_records(rejected))
    return 1
}

# selfhost-C11 lowering (#620): kofun.selfhost-hir/v1 -> deterministic
# standalone C11 for the non-looping Text/function profile slice.
#
# The document is the only input: node, symbol, binding, scope, and type
# records drive the lowering; source text is never reparsed. Every
# expression node lowers post-order to one temporary named after its
# node id, so argument evaluation is exactly-once and left-to-right, and
# `&&`/`||` keep short-circuit evaluation through guarded blocks.
# Constructs outside the slice classify as unsupported, never as invalid.
# Results pack C text after an `ok` header line; failures are one
# `error|EXIT|MESSAGE` line.

fn selfhost_c11_error(exit_code: Int, message: Text) -> Text {
    return "error|" + to_text(exit_code) + "|" + message
}

fn selfhost_c11_failed(result: Text) -> Bool {
    return starts_with(result, "error|")
}

fn selfhost_c11_line_end(document: Text, line: Int) -> Int {
    let symbols = chars(document)
    let mut cursor = line
    while cursor < len(symbols) && symbols[cursor] != "\n" {
        cursor = cursor + 1
    }
    return cursor
}

# Line offset of the record `TAG|ID|...`, or -1.
fn selfhost_c11_record(document: Text, tag: Text, id: Int) -> Int {
    let wanted = tag + "|" + to_text(id) + "|"
    let mut line = 0
    let size = len(document)
    while line < size {
        if starts_with(text_slice(document, line, size), wanted) {
            return line
        }
        line = selfhost_c11_line_end(document, line) + 1
    }
    return -1
}

fn selfhost_c11_field_count(document: Text, line: Int) -> Int {
    let symbols = chars(document)
    let mut cursor = line
    let mut count = 1
    while cursor < len(symbols) && symbols[cursor] != "\n" {
        if symbols[cursor] == "|" {
            count = count + 1
        }
        cursor = cursor + 1
    }
    return count
}

# The full key of one type record: the remainder after its second bar.
fn selfhost_c11_type_key(document: Text, type_id: Int) -> Text {
    let line = selfhost_c11_record(document, "type", type_id)
    if line < 0 {
        return ""
    }
    let head = len("type|" + to_text(type_id) + "|")
    return text_slice(
        document,
        line + head,
        selfhost_c11_line_end(document, line)
    )
}

fn selfhost_c11_c_type(key: Text) -> Text {
    if key == "int" {
        return "int64_t"
    }
    if key == "bool" {
        return "bool"
    }
    if key == "text" {
        return "const char *"
    }
    if key == "list-text" {
        return "kofun_text_list"
    }
    return ""
}

fn selfhost_c11_symbol_field(
    document: Text,
    symbol_id: Int,
    field: Int
) -> Text {
    let line = selfhost_c11_record(document, "symbol", symbol_id)
    if line < 0 {
        return ""
    }
    return pattern_line_field(document, line, field)
}

fn selfhost_c11_binding_field(
    document: Text,
    binding_id: Int,
    field: Int
) -> Text {
    let line = selfhost_c11_record(document, "binding", binding_id)
    if line < 0 {
        return ""
    }
    return pattern_line_field(document, line, field)
}

fn selfhost_c11_scope_field(
    document: Text,
    scope_id: Int,
    field: Int
) -> Text {
    let line = selfhost_c11_record(document, "scope", scope_id)
    if line < 0 {
        return ""
    }
    return pattern_line_field(document, line, field)
}

# The value type key of a binding: its symbol's recorded type.
fn selfhost_c11_binding_type(document: Text, binding_id: Int) -> Text {
    let symbol = selfhost_c11_binding_field(document, binding_id, 3)
    if len(symbol) == 0 {
        return ""
    }
    return selfhost_c11_type_key(
        document,
        decimal_value(
            selfhost_c11_symbol_field(document, decimal_value(symbol), 4)
        )
    )
}

# Result type key of a function-typed symbol: field 1 of its fn key.
fn selfhost_c11_result_key(document: Text, symbol_id: Int) -> Text {
    let key = selfhost_c11_type_key(
        document,
        decimal_value(selfhost_c11_symbol_field(document, symbol_id, 4))
    )
    if !starts_with(key, "fn|") {
        return ""
    }
    return selfhost_c11_type_key(
        document,
        decimal_value(pattern_line_field(key, 0, 1))
    )
}

# Whether a builtin symbol's single parameter is List[Text] (the len
# overload outside this slice).
fn selfhost_c11_list_parameter(document: Text, symbol_id: Int) -> Bool {
    let key = selfhost_c11_type_key(
        document,
        decimal_value(selfhost_c11_symbol_field(document, symbol_id, 4))
    )
    let parameter = pattern_line_field(key, 0, 2)
    if len(parameter) == 0 {
        return false
    }
    return selfhost_c11_type_key(document, decimal_value(parameter)) ==
    "list-text"
}

# Map a slice builtin to its runtime helper; empty when the builtin is
# outside the non-looping Text slice.
fn selfhost_c11_builtin_helper(name: Text) -> Text {
    if name == "args" {
        return "kofun_rt_args"
    }
    if name == "chars" {
        return "kofun_rt_chars"
    }
    if name == "contains" {
        return "kofun_rt_text_contains"
    }
    if name == "fail" {
        return "kofun_rt_fail"
    }
    if name == "find" {
        return "kofun_rt_find"
    }
    if name == "is_digit" {
        return "kofun_rt_is_digit"
    }
    if name == "is_space" {
        return "kofun_rt_is_space"
    }
    if name == "is_xid_continue" {
        return "kofun_rt_is_xid_continue"
    }
    if name == "len" {
        return "kofun_rt_text_len"
    }
    if name == "print" {
        return "printf"
    }
    if name == "read_text" {
        return "kofun_rt_read_text"
    }
    if name == "replace" {
        return "kofun_rt_replace"
    }
    if name == "starts_with" {
        return "kofun_rt_starts_with"
    }
    if name == "text_slice" {
        return "kofun_rt_text_slice"
    }
    if name == "trim" {
        return "kofun_rt_trim"
    }
    if name == "validate_unicode_source" {
        return "kofun_rt_validate_unicode_source"
    }
    if name == "write_text" {
        return "kofun_rt_write_text"
    }
    return ""
}

fn selfhost_c11_indent(level: Int) -> Text {
    let mut spaces = ""
    let mut remaining = level
    while remaining > 0 {
        spaces = spaces + "    "
        remaining = remaining - 1
    }
    return spaces
}

fn selfhost_c11_failed_check(fail_return: Text, level: Int) -> Text {
    if len(fail_return) == 0 {
        return selfhost_c11_indent(level) + "if (kofun_failed) return;\n"
    }
    return selfhost_c11_indent(level) + "if (kofun_failed) return " +
    fail_return + ";\n"
}

# Decode the record escaping of a literal-text field, then re-escape the
# bytes as one C string literal.
fn selfhost_c11_string(field: Text) -> Text {
    let symbols = chars(field)
    let mut emitted = "\""
    let mut cursor = 0
    while cursor < len(symbols) {
        let mut symbol = symbols[cursor]
        if symbol == "\\" && cursor + 1 < len(symbols) {
            let following = symbols[cursor + 1]
            if following == "\\" {
                symbol = "\\"
            } else if following == "p" {
                symbol = "|"
            } else if following == "n" {
                symbol = "\n"
            }
            cursor = cursor + 1
        }
        if symbol == "\\" {
            emitted = emitted + "\\\\"
        } else if symbol == "\"" {
            emitted = emitted + "\\\""
        } else if symbol == "\n" {
            emitted = emitted + "\\n"
        } else {
            emitted = emitted + symbol
        }
        cursor = cursor + 1
    }
    return emitted + "\""
}

# Line offset just past the pre-order expression subtree at `line`.
fn selfhost_c11_consume(document: Text, line: Int) -> Int {
    let kind = pattern_line_field(document, line, 2)
    let mut next = selfhost_c11_line_end(document, line) + 1
    if kind == "call" {
        let mut field = 8
        let count = selfhost_c11_field_count(document, line)
        while field < count {
            next = selfhost_c11_consume(document, next)
            field = field + 1
        }
        return next
    }
    if kind == "unary" {
        return selfhost_c11_consume(document, next)
    }
    if kind == "binary" || kind == "index" || kind == "range" {
        next = selfhost_c11_consume(document, next)
        return selfhost_c11_consume(document, next)
    }
    return next
}

# The audited C runtime shim emitted into every generated program;
# byte-identical to the seed. Text helpers keep the trusted stage-1
# semantics; the Unicode builtins consult the Unicode 17 tables via
# kofun_unicode.c; allocations are process-lifetime with an explicit
# panic on exhaustion.
fn selfhost_c11_prelude() -> Text {
    return "#include <ctype.h>\n" +
    "#include <inttypes.h>\n" +
    "#include <stdbool.h>\n" +
    "#include <stdint.h>\n" +
    "#include <stdio.h>\n" +
    "#include <stdlib.h>\n" +
    "#include <string.h>\n" +
    "\n" +
    "#include \"kofun_unicode.c\"\n" +
    "\n" +
    "typedef struct {\n" +
    "    int64_t len;\n" +
    "    const char **items;\n" +
    "} kofun_text_list;\n" +
    "\n" +
    "int kofun_runtime_argc = 0;\n" +
    "char **kofun_runtime_argv = NULL;\n" +
    "\n" +
    "static bool kofun_failed;\n" +
    "\n" +
    "static void kofun_error(const char *message) {\n" +
    "    if (!kofun_failed) {\n" +
    "        fputs(message, stderr);\n" +
    "        fputc('\\n', stderr);\n" +
    "    }\n" +
    "    kofun_failed = true;\n" +
    "}\n" +
    "\n" +
    "static int64_t kofun_add(int64_t left, int64_t right) {\n" +
    "    int64_t result;\n" +
    "    if (__builtin_add_overflow(left, right, &result)) {\n" +
    "        kofun_error(\"error[R010]: integer overflow in operator `+`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return result;\n" +
    "}\n" +
    "\n" +
    "static int64_t kofun_sub(int64_t left, int64_t right) {\n" +
    "    int64_t result;\n" +
    "    if (__builtin_sub_overflow(left, right, &result)) {\n" +
    "        kofun_error(\"error[R010]: integer overflow in operator `-`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return result;\n" +
    "}\n" +
    "\n" +
    "static int64_t kofun_mul(int64_t left, int64_t right) {\n" +
    "    int64_t result;\n" +
    "    if (__builtin_mul_overflow(left, right, &result)) {\n" +
    "        kofun_error(\"error[R010]: integer overflow in operator `*`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return result;\n" +
    "}\n" +
    "\n" +
    "static int64_t kofun_neg(int64_t value) {\n" +
    "    if (value == INT64_MIN) {\n" +
    "        kofun_error(\n" +
    "            \"error[R010]: integer overflow in unary operator `-`\"\n" +
    "        );\n" +
    "        return 0;\n" +
    "    }\n" +
    "    return -value;\n" +
    "}\n" +
    "\n" +
    "static int64_t kofun_floor_div(int64_t left, int64_t right) {\n" +
    "    if (right == 0) {\n" +
    "        kofun_error(\n" +
    "            \"error[R010]: operator `//` failed: division by zero\"\n" +
    "        );\n" +
    "        return 0;\n" +
    "    }\n" +
    "    if (left == INT64_MIN && right == -1) {\n" +
    "        kofun_error(\"error[R010]: integer overflow in operator `//`\");\n" +
    "        return 0;\n" +
    "    }\n" +
    "    int64_t quotient = left / right;\n" +
    "    int64_t remainder = left % right;\n" +
    "    if (remainder != 0 && ((remainder < 0) != (right < 0))) {\n" +
    "        --quotient;\n" +
    "    }\n" +
    "    return quotient;\n" +
    "}\n" +
    "\n" +
    "static int64_t kofun_floor_mod(int64_t left, int64_t right) {\n" +
    "    if (right == 0) {\n" +
    "        kofun_error(\n" +
    "            \"error[R010]: operator `%` failed: division by zero\"\n" +
    "        );\n" +
    "        return 0;\n" +
    "    }\n" +
    "    if (left == INT64_MIN && right == -1) {\n" +
    "        return 0;\n" +
    "    }\n" +
    "    int64_t remainder = left % right;\n" +
    "    if (remainder != 0 && ((remainder < 0) != (right < 0))) {\n" +
    "        remainder += right;\n" +
    "    }\n" +
    "    return remainder;\n" +
    "}\n" +
    "\n" +
    "void kofun_rt_panic(const char *message) {\n" +
    "    fprintf(stderr, \"Kofun runtime error: %s\\n\", message);\n" +
    "    exit(1);\n" +
    "}\n" +
    "\n" +
    "void kofun_rt_fail(void) {\n" +
    "    exit(1);\n" +
    "}\n" +
    "\n" +
    "void *kofun_rt_alloc(size_t size) {\n" +
    "    void *value = malloc(size == 0 ? 1 : size);\n" +
    "    if (value == NULL) {\n" +
    "        kofun_rt_panic(\"out of memory\");\n" +
    "    }\n" +
    "    return value;\n" +
    "}\n" +
    "\n" +
    "char *kofun_rt_copy_n(const char *value, size_t length) {\n" +
    "    char *result = (char *)kofun_rt_alloc(length + 1);\n" +
    "    if (length > 0) {\n" +
    "        memcpy(result, value, length);\n" +
    "    }\n" +
    "    result[length] = '\\0';\n" +
    "    return result;\n" +
    "}\n" +
    "\n" +
    "char *kofun_rt_text_concat(const char *left, const char *right) {\n" +
    "    size_t left_len = strlen(left);\n" +
    "    size_t right_len = strlen(right);\n" +
    "    char *result = (char *)kofun_rt_alloc(left_len + right_len + 1);\n" +
    "    memcpy(result, left, left_len);\n" +
    "    memcpy(result + left_len, right, right_len + 1);\n" +
    "    return result;\n" +
    "}\n" +
    "\n" +
    "bool kofun_rt_text_equal(const char *left, const char *right) {\n" +
    "    while (*left != '\\0' && *right != '\\0') {\n" +
    "        if (*left != *right) return false;\n" +
    "        left += 1;\n" +
    "        right += 1;\n" +
    "    }\n" +
    "    return *left == *right;\n" +
    "}\n" +
    "\n" +
    "int64_t kofun_rt_text_len(const char *value) {\n" +
    "    return (int64_t)strlen(value);\n" +
    "}\n" +
    "\n" +
    "int64_t kofun_rt_text_list_len(kofun_text_list values) {\n" +
    "    return values.len;\n" +
    "}\n" +
    "\n" +
    "kofun_text_list kofun_rt_args(void) {\n" +
    "    kofun_text_list result;\n" +
    "    result.len = (int64_t)kofun_runtime_argc;\n" +
    "    result.items = (const char **)kofun_runtime_argv;\n" +
    "    return result;\n" +
    "}\n" +
    "\n" +
    "kofun_text_list kofun_rt_chars(const char *value) {\n" +
    "    size_t length = strlen(value);\n" +
    "    if (length > SIZE_MAX / (sizeof(char *) + 2)) {\n" +
    "        kofun_rt_panic(\"List[Text] allocation is too large\");\n" +
    "    }\n" +
    "    size_t pointer_bytes = sizeof(char *) * length;\n" +
    "    char *storage = (char *)kofun_rt_alloc(\n" +
    "        length == 0 ? 1 : pointer_bytes + 2 * length\n" +
    "    );\n" +
    "    const char **items = (const char **)storage;\n" +
    "    char *characters = storage + pointer_bytes;\n" +
    "    for (size_t index = 0; index < length; ++index) {\n" +
    "        characters[2 * index] = value[index];\n" +
    "        characters[2 * index + 1] = '\\0';\n" +
    "        items[index] = characters + 2 * index;\n" +
    "    }\n" +
    "    kofun_text_list result;\n" +
    "    result.len = (int64_t)length;\n" +
    "    result.items = items;\n" +
    "    return result;\n" +
    "}\n" +
    "\n" +
    "const char *kofun_rt_text_list_get(kofun_text_list values, int64_t index) {\n" +
    "    if (index < 0 || index >= values.len) {\n" +
    "        kofun_rt_panic(\"List[Text] index out of bounds\");\n" +
    "    }\n" +
    "    return values.items[index];\n" +
    "}\n" +
    "\n" +
    "bool kofun_rt_text_contains(const char *value, const char *needle) {\n" +
    "    return strstr(value, needle) != NULL;\n" +
    "}\n" +
    "\n" +
    "int64_t kofun_rt_find(const char *value, const char *needle) {\n" +
    "    const char *found = strstr(value, needle);\n" +
    "    return found == NULL ? INT64_C(-1) : (int64_t)(found - value);\n" +
    "}\n" +
    "\n" +
    "char *kofun_rt_text_slice(const char *value, int64_t start, int64_t end) {\n" +
    "    int64_t length = (int64_t)strlen(value);\n" +
    "    if (start < 0) start = 0;\n" +
    "    if (end < start) end = start;\n" +
    "    if (start > length) start = length;\n" +
    "    if (end > length) end = length;\n" +
    "    return kofun_rt_copy_n(value + start, (size_t)(end - start));\n" +
    "}\n" +
    "\n" +
    "char *kofun_rt_trim(const char *value) {\n" +
    "    const unsigned char *start = (const unsigned char *)value;\n" +
    "    while (*start != '\\0' && isspace(*start)) {\n" +
    "        ++start;\n" +
    "    }\n" +
    "    const unsigned char *end =\n" +
    "        (const unsigned char *)value + strlen(value);\n" +
    "    while (end > start && isspace(end[-1])) {\n" +
    "        --end;\n" +
    "    }\n" +
    "    return kofun_rt_copy_n((const char *)start, (size_t)(end - start));\n" +
    "}\n" +
    "\n" +
    "char *kofun_rt_replace(\n" +
    "    const char *value,\n" +
    "    const char *old,\n" +
    "    const char *replacement\n" +
    ") {\n" +
    "    size_t old_len = strlen(old);\n" +
    "    if (old_len == 0) {\n" +
    "        return kofun_rt_copy_n(value, strlen(value));\n" +
    "    }\n" +
    "    size_t replacement_len = strlen(replacement);\n" +
    "    size_t count = 0;\n" +
    "    const char *cursor = value;\n" +
    "    while ((cursor = strstr(cursor, old)) != NULL) {\n" +
    "        ++count;\n" +
    "        cursor += old_len;\n" +
    "    }\n" +
    "    size_t value_len = strlen(value);\n" +
    "    size_t result_len;\n" +
    "    if (replacement_len >= old_len) {\n" +
    "        result_len = value_len + count * (replacement_len - old_len);\n" +
    "    } else {\n" +
    "        result_len = value_len - count * (old_len - replacement_len);\n" +
    "    }\n" +
    "    char *result = (char *)kofun_rt_alloc(result_len + 1);\n" +
    "    char *out = result;\n" +
    "    cursor = value;\n" +
    "    const char *match;\n" +
    "    while ((match = strstr(cursor, old)) != NULL) {\n" +
    "        size_t prefix = (size_t)(match - cursor);\n" +
    "        memcpy(out, cursor, prefix);\n" +
    "        out += prefix;\n" +
    "        memcpy(out, replacement, replacement_len);\n" +
    "        out += replacement_len;\n" +
    "        cursor = match + old_len;\n" +
    "    }\n" +
    "    strcpy(out, cursor);\n" +
    "    return result;\n" +
    "}\n" +
    "\n" +
    "bool kofun_rt_starts_with(const char *value, const char *prefix) {\n" +
    "    size_t prefix_len = strlen(prefix);\n" +
    "    return strncmp(value, prefix, prefix_len) == 0;\n" +
    "}\n" +
    "\n" +
    "bool kofun_rt_is_digit(const char *value) {\n" +
    "    return value[0] != '\\0' && value[1] == '\\0' &&\n" +
    "        isdigit((unsigned char)value[0]) != 0;\n" +
    "}\n" +
    "\n" +
    "bool kofun_rt_is_space(const char *value) {\n" +
    "    return value[0] != '\\0' && value[1] == '\\0' &&\n" +
    "        isspace((unsigned char)value[0]) != 0;\n" +
    "}\n" +
    "\n" +
    "bool kofun_rt_is_xid_continue(const char *value) {\n" +
    "    uint32_t codepoint = 0;\n" +
    "    size_t width = 0;\n" +
    "    size_t length = strlen(value);\n" +
    "    if (!kofun_unicode_decode(\n" +
    "            (const uint8_t *)value,\n" +
    "            length,\n" +
    "            0,\n" +
    "            &codepoint,\n" +
    "            &width)) {\n" +
    "        return false;\n" +
    "    }\n" +
    "    return kofun_unicode_is_xid_continue(codepoint);\n" +
    "}\n" +
    "\n" +
    "const char *kofun_rt_validate_unicode_source(const char *value) {\n" +
    "    KofunUnicodeError unicode_error;\n" +
    "    if (kofun_unicode_validate_source(\n" +
    "            (const uint8_t *)value,\n" +
    "            strlen(value),\n" +
    "            &unicode_error)) {\n" +
    "        return \"\";\n" +
    "    }\n" +
    "    char message[1024];\n" +
    "    kofun_unicode_format_error(\n" +
    "        &unicode_error,\n" +
    "        getenv(\"KOFUN_DIAGNOSTIC_LOCALE\"),\n" +
    "        message,\n" +
    "        sizeof(message)\n" +
    "    );\n" +
    "    return kofun_rt_copy_n(message, strlen(message));\n" +
    "}\n" +
    "\n" +
    "char *kofun_rt_read_text(const char *path) {\n" +
    "    FILE *file = fopen(path, \"rb\");\n" +
    "    if (file == NULL) {\n" +
    "        kofun_rt_panic(\"cannot open input file\");\n" +
    "    }\n" +
    "    if (fseek(file, 0, SEEK_END) != 0) {\n" +
    "        fclose(file);\n" +
    "        kofun_rt_panic(\"cannot seek input file\");\n" +
    "    }\n" +
    "    long size = ftell(file);\n" +
    "    if (size < 0) {\n" +
    "        fclose(file);\n" +
    "        kofun_rt_panic(\"cannot measure input file\");\n" +
    "    }\n" +
    "    rewind(file);\n" +
    "    char *result = (char *)kofun_rt_alloc((size_t)size + 1);\n" +
    "    size_t read = fread(result, 1, (size_t)size, file);\n" +
    "    if (read != (size_t)size && ferror(file)) {\n" +
    "        fclose(file);\n" +
    "        kofun_rt_panic(\"cannot read input file\");\n" +
    "    }\n" +
    "    result[read] = '\\0';\n" +
    "    fclose(file);\n" +
    "    return result;\n" +
    "}\n" +
    "\n" +
    "void kofun_rt_write_text(const char *path, const char *value) {\n" +
    "    FILE *file = fopen(path, \"wb\");\n" +
    "    if (file == NULL) {\n" +
    "        kofun_rt_panic(\"cannot open output file\");\n" +
    "    }\n" +
    "    size_t length = strlen(value);\n" +
    "    if (fwrite(value, 1, length, file) != length) {\n" +
    "        fclose(file);\n" +
    "        kofun_rt_panic(\"cannot write output file\");\n" +
    "    }\n" +
    "    if (fclose(file) != 0) {\n" +
    "        kofun_rt_panic(\"cannot close output file\");\n" +
    "    }\n" +
    "}\n" +
    "\n"
}

# Emission context: `RANGE_START|RANGE_END|IS_MAIN|FAIL_RETURN` — the
# function's node-record byte range in the document, whether it is
# `main`, and the value returned when kofun_failed is observed.

fn selfhost_c11_node_line(document: Text, context: Text, node_id: Int) -> Int {
    let range_end = decimal_value(pattern_line_field(context, 0, 1))
    let wanted = "node|" + to_text(node_id) + "|"
    let mut line = decimal_value(pattern_line_field(context, 0, 0))
    while line < range_end {
        if starts_with(text_slice(document, line, range_end), wanted) {
            return line
        }
        line = selfhost_c11_line_end(document, line) + 1
    }
    return -1
}

fn selfhost_c11_expression(
    document: Text,
    context: Text,
    node_id: Int,
    level: Int
) -> Text {
    let line = selfhost_c11_node_line(document, context, node_id)
    if line < 0 {
        return selfhost_c11_error(
            1,
            "error[E2S35]: selfhost-C11 node reference is out of range"
        )
    }
    let kind = pattern_line_field(document, line, 2)
    let type_key = selfhost_c11_type_key(
        document,
        decimal_value(pattern_line_field(document, line, 5))
    )
    let pad = selfhost_c11_indent(level)
    let fail_return = pattern_line_field(context, 0, 3)
    if kind == "literal-int" {
        let digits = pattern_line_field(document, line, 7)
        let symbols = chars(digits)
        let mut cleaned = ""
        let mut cursor = 0
        while cursor < len(symbols) {
            if symbols[cursor] != "_" {
                cleaned = cleaned + symbols[cursor]
            }
            cursor = cursor + 1
        }
        return "ok\n" + pad + "int64_t k_n" + to_text(node_id) +
        " = INT64_C(" + cleaned + ");\n"
    }
    if kind == "literal-bool" {
        return "ok\n" + pad + "bool k_n" + to_text(node_id) + " = " +
        pattern_line_field(document, line, 7) + ";\n"
    }
    if kind == "literal-text" {
        return "ok\n" + pad + "const char *k_n" + to_text(node_id) +
        " = " + selfhost_c11_string(pattern_line_field(document, line, 7)) +
        ";\n"
    }
    if kind == "name" {
        if len(selfhost_c11_c_type(type_key)) == 0 {
            return selfhost_c11_error(
                3,
                "error[E2S10]: unsupported selfhost-C11 type `" +
                type_key + "`"
            )
        }
        return "ok\n" + pad + selfhost_c11_c_type(type_key) + " k_n" +
        to_text(node_id) + " = k_b" +
        pattern_line_field(document, line, 7) + ";\n"
    }
    if kind == "call" {
        let symbol_id = decimal_value(pattern_line_field(document, line, 7))
        let symbol_line = selfhost_c11_record(document, "symbol", symbol_id)
        if symbol_line < 0 {
            return selfhost_c11_error(
                1,
                "error[E2S35]: selfhost-C11 call has no symbol"
            )
        }
        let name = selfhost_c11_symbol_field(document, symbol_id, 3)
        let builtin =
            selfhost_c11_symbol_field(document, symbol_id, 2) == "builtin"
        let mut helper = ""
        if builtin {
            helper = selfhost_c11_builtin_helper(name)
            if name == "len" &&
               selfhost_c11_list_parameter(document, symbol_id) {
                helper = "kofun_rt_text_list_len"
            }
            if len(helper) == 0 {
                return selfhost_c11_error(
                    3,
                    "error[E2S10]: unsupported selfhost-C11 builtin call `" +
                    name + "`"
                )
            }
        }
        let count = selfhost_c11_field_count(document, line)
        let mut emitted = ""
        let mut field = 8
        while field < count {
            let argument = selfhost_c11_expression(
                document,
                context,
                decimal_value(pattern_line_field(document, line, field)),
                level
            )
            if selfhost_c11_failed(argument) {
                return argument
            }
            emitted = emitted + selfhost_records(argument)
            field = field + 1
        }
        if builtin && name == "print" {
            return "ok\n" + emitted + pad + "printf(\"%s\\n\", k_n" +
            pattern_line_field(document, line, 8) + ");\n"
        }
        let mut open = "kofun_fn_" + name + "("
        if type_key == "void" && builtin {
            open = helper + "("
        }
        if type_key != "void" {
            if builtin {
                open = selfhost_c11_c_type(type_key) + " k_n" +
                to_text(node_id) + " = " + helper + "("
            } else {
                open = selfhost_c11_c_type(type_key) + " k_n" +
                to_text(node_id) + " = kofun_fn_" + name + "("
            }
        }
        let mut arguments = ""
        field = 8
        while field < count {
            if field > 8 {
                arguments = arguments + ", "
            }
            arguments = arguments + "k_n" +
            pattern_line_field(document, line, field)
            field = field + 1
        }
        emitted = emitted + pad + open + arguments + ");\n"
        if !builtin {
            emitted = emitted + selfhost_c11_failed_check(fail_return, level)
        }
        return "ok\n" + emitted
    }
    if kind == "unary" {
        let operator = pattern_line_field(document, line, 7)
        let operand = decimal_value(pattern_line_field(document, line, 8))
        let inner = selfhost_c11_expression(document, context, operand, level)
        if selfhost_c11_failed(inner) {
            return inner
        }
        if operator == "!" {
            return "ok\n" + selfhost_records(inner) + pad + "bool k_n" +
            to_text(node_id) + " = !k_n" + to_text(operand) + ";\n"
        }
        return "ok\n" + selfhost_records(inner) + pad + "int64_t k_n" +
        to_text(node_id) + " = kofun_neg(k_n" + to_text(operand) +
        ");\n" + selfhost_c11_failed_check(fail_return, level)
    }
    if kind == "binary" {
        let operator = pattern_line_field(document, line, 7)
        let left = decimal_value(pattern_line_field(document, line, 8))
        let right = decimal_value(pattern_line_field(document, line, 9))
        let left_line = selfhost_c11_node_line(document, context, left)
        let mut left_key = ""
        if left_line >= 0 {
            left_key = selfhost_c11_type_key(
                document,
                decimal_value(pattern_line_field(document, left_line, 5))
            )
        }
        if operator == "&&" || operator == "\\p\\p" {
            let first = selfhost_c11_expression(document, context, left, level)
            if selfhost_c11_failed(first) {
                return first
            }
            let second = selfhost_c11_expression(
                document,
                context,
                right,
                level + 1
            )
            if selfhost_c11_failed(second) {
                return second
            }
            let mut guard = "if (k_n"
            if operator != "&&" {
                guard = "if (!k_n"
            }
            return "ok\n" + selfhost_records(first) + pad + "bool k_n" +
            to_text(node_id) + " = k_n" + to_text(left) + ";\n" + pad +
            guard + to_text(node_id) + ") {\n" +
            selfhost_records(second) + selfhost_c11_indent(level + 1) +
            "k_n" + to_text(node_id) + " = k_n" + to_text(right) + ";\n" +
            pad + "}\n"
        }
        let first = selfhost_c11_expression(document, context, left, level)
        if selfhost_c11_failed(first) {
            return first
        }
        let second = selfhost_c11_expression(document, context, right, level)
        if selfhost_c11_failed(second) {
            return second
        }
        let emitted = selfhost_records(first) + selfhost_records(second)
        if operator == "+" && left_key == "text" {
            return "ok\n" + emitted + pad + "const char *k_n" +
            to_text(node_id) + " = kofun_rt_text_concat(k_n" +
            to_text(left) + ", k_n" + to_text(right) + ");\n"
        }
        if operator == "==" || operator == "!=" {
            if left_key == "text" {
                let mut negate = ""
                if operator == "!=" {
                    negate = "!"
                }
                return "ok\n" + emitted + pad + "bool k_n" +
                to_text(node_id) + " = " + negate +
                "kofun_rt_text_equal(k_n" + to_text(left) + ", k_n" +
                to_text(right) + ");\n"
            }
            return "ok\n" + emitted + pad + "bool k_n" + to_text(node_id) +
            " = k_n" + to_text(left) + " " + operator + " k_n" +
            to_text(right) + ";\n"
        }
        if operator == "<" || operator == "<=" || operator == ">" ||
           operator == ">=" {
            if left_key == "text" {
                return selfhost_c11_error(
                    3,
                    "error[E2S10]: unsupported selfhost-C11 operator `" +
                    operator + "`"
                )
            }
            return "ok\n" + emitted + pad + "bool k_n" + to_text(node_id) +
            " = k_n" + to_text(left) + " " + operator + " k_n" +
            to_text(right) + ";\n"
        }
        let mut arithmetic = ""
        if operator == "+" {
            arithmetic = "kofun_add"
        } else if operator == "-" {
            arithmetic = "kofun_sub"
        } else if operator == "*" {
            arithmetic = "kofun_mul"
        } else if operator == "//" {
            arithmetic = "kofun_floor_div"
        } else if operator == "%" {
            arithmetic = "kofun_floor_mod"
        }
        if len(arithmetic) == 0 {
            return selfhost_c11_error(
                3,
                "error[E2S10]: unsupported selfhost-C11 operator `" +
                operator + "`"
            )
        }
        return "ok\n" + emitted + pad + "int64_t k_n" + to_text(node_id) +
        " = " + arithmetic + "(k_n" + to_text(left) + ", k_n" +
        to_text(right) + ");\n" +
        selfhost_c11_failed_check(fail_return, level)
    }
    if kind == "index" {
        let base = decimal_value(pattern_line_field(document, line, 7))
        let position = decimal_value(pattern_line_field(document, line, 8))
        let first = selfhost_c11_expression(document, context, base, level)
        if selfhost_c11_failed(first) {
            return first
        }
        let second = selfhost_c11_expression(
            document,
            context,
            position,
            level
        )
        if selfhost_c11_failed(second) {
            return second
        }
        return "ok\n" + selfhost_records(first) +
        selfhost_records(second) + pad + "const char *k_n" +
        to_text(node_id) + " = kofun_rt_text_list_get(k_n" +
        to_text(base) + ", k_n" + to_text(position) + ");\n"
    }
    return selfhost_c11_error(
        3,
        "error[E2S10]: unsupported selfhost-C11 expression `" + kind + "`"
    )
}

# Statement results pack `NEXT|TERMINAL` over the emitted C lines.
fn selfhost_c11_statement(
    document: Text,
    context: Text,
    line: Int,
    level: Int
) -> Text {
    let kind = pattern_line_field(document, line, 2)
    let node_end = selfhost_c11_line_end(document, line) + 1
    let pad = selfhost_c11_indent(level)
    let is_main = pattern_line_field(context, 0, 2) == "1"
    if kind == "let" || kind == "let-mut" {
        let binding = pattern_line_field(document, line, 7)
        let value = decimal_value(pattern_line_field(document, line, 8))
        let emitted = selfhost_c11_expression(document, context, value, level)
        if selfhost_c11_failed(emitted) {
            return emitted
        }
        let binding_key = selfhost_c11_binding_type(
            document,
            decimal_value(binding)
        )
        if len(selfhost_c11_c_type(binding_key)) == 0 {
            return selfhost_c11_error(
                3,
                "error[E2S10]: unsupported selfhost-C11 type `" +
                binding_key + "`"
            )
        }
        return to_text(selfhost_c11_consume(document, node_end)) + "|0\n" +
        selfhost_records(emitted) + pad + selfhost_c11_c_type(binding_key) +
        " k_b" + binding + " = k_n" + to_text(value) + ";\n"
    }
    if kind == "return" {
        if pattern_line_field(document, line, 7) == "none" {
            let mut bare = pad + "return;\n"
            if is_main {
                bare = pad + "return 0;\n"
            }
            return to_text(node_end) + "|1\n" + bare
        }
        let value = decimal_value(pattern_line_field(document, line, 7))
        let emitted = selfhost_c11_expression(document, context, value, level)
        if selfhost_c11_failed(emitted) {
            return emitted
        }
        let mut returned = pad + "return k_n" + to_text(value) + ";\n"
        if is_main {
            returned = pad + "return (int)k_n" + to_text(value) + ";\n"
        }
        return to_text(selfhost_c11_consume(document, node_end)) + "|1\n" +
        selfhost_records(emitted) + returned
    }
    if kind == "expr-stmt" {
        let value = decimal_value(pattern_line_field(document, line, 7))
        let emitted = selfhost_c11_expression(document, context, value, level)
        if selfhost_c11_failed(emitted) {
            return emitted
        }
        let value_line = selfhost_c11_node_line(document, context, value)
        let mut discard = ""
        if selfhost_c11_type_key(
               document,
               decimal_value(pattern_line_field(document, value_line, 5))
           ) != "void" {
            discard = pad + "(void)k_n" + to_text(value) + ";\n"
        }
        return to_text(selfhost_c11_consume(document, node_end)) + "|0\n" +
        selfhost_records(emitted) + discard
    }
    if kind == "if" {
        let condition = decimal_value(pattern_line_field(document, line, 7))
        let then_scope = decimal_value(pattern_line_field(document, line, 8))
        let else_kind = pattern_line_field(document, line, 9)
        let emitted = selfhost_c11_expression(
            document,
            context,
            condition,
            level
        )
        if selfhost_c11_failed(emitted) {
            return emitted
        }
        let body = selfhost_c11_block(
            document,
            context,
            selfhost_c11_consume(document, node_end),
            then_scope,
            level + 1
        )
        if selfhost_c11_failed(body) {
            return body
        }
        let mut walk = decimal_value(pattern_line_field(body, 0, 0))
        let mut branch = selfhost_records(emitted) + pad + "if (k_n" +
        to_text(condition) + ") {\n" + selfhost_records(body)
        if else_kind == "none" {
            return to_text(walk) + "|0\n" + branch + pad + "}\n"
        }
        branch = branch + pad + "} else {\n"
        let mut alternative = ""
        if else_kind == "block" {
            alternative = selfhost_c11_block(
                document,
                context,
                walk,
                decimal_value(pattern_line_field(document, line, 10)),
                level + 1
            )
        } else {
            alternative = selfhost_c11_statement(
                document,
                context,
                walk,
                level + 1
            )
        }
        if selfhost_c11_failed(alternative) {
            return alternative
        }
        walk = decimal_value(pattern_line_field(alternative, 0, 0))
        let terminal =
            pattern_line_field(body, 0, 1) == "1" &&
            pattern_line_field(alternative, 0, 1) == "1"
        let mut flag = "0"
        if terminal {
            flag = "1"
        }
        return to_text(walk) + "|" + flag + "\n" + branch +
        selfhost_records(alternative) + pad + "}\n"
    }
    if kind == "assign" {
        let value = decimal_value(pattern_line_field(document, line, 8))
        let emitted = selfhost_c11_expression(document, context, value, level)
        if selfhost_c11_failed(emitted) {
            return emitted
        }
        return to_text(selfhost_c11_consume(document, node_end)) + "|0\n" +
        selfhost_records(emitted) + pad + "k_b" +
        pattern_line_field(document, line, 7) + " = k_n" + to_text(value) +
        ";\n"
    }
    if kind == "while" {
        let condition = decimal_value(pattern_line_field(document, line, 7))
        let emitted = selfhost_c11_expression(
            document,
            context,
            condition,
            level + 1
        )
        if selfhost_c11_failed(emitted) {
            return emitted
        }
        let body = selfhost_c11_block(
            document,
            context,
            selfhost_c11_consume(document, node_end),
            decimal_value(pattern_line_field(document, line, 8)),
            level + 1
        )
        if selfhost_c11_failed(body) {
            return body
        }
        return pattern_line_field(body, 0, 0) + "|0\n" + pad +
        "for (;;) {\n" + selfhost_records(emitted) +
        selfhost_c11_indent(level + 1) + "if (!k_n" + to_text(condition) +
        ") break;\n" + selfhost_records(body) + pad + "}\n"
    }
    if kind == "for-range" {
        let range_line = selfhost_c11_node_line(
            document,
            context,
            decimal_value(pattern_line_field(document, line, 8))
        )
        if range_line < 0 {
            return selfhost_c11_error(
                1,
                "error[E2S35]: selfhost-C11 node reference is out of range"
            )
        }
        let low = decimal_value(pattern_line_field(document, range_line, 7))
        let high = decimal_value(pattern_line_field(document, range_line, 8))
        let first = selfhost_c11_expression(document, context, low, level)
        if selfhost_c11_failed(first) {
            return first
        }
        let second = selfhost_c11_expression(document, context, high, level)
        if selfhost_c11_failed(second) {
            return second
        }
        let body = selfhost_c11_block(
            document,
            context,
            selfhost_c11_consume(document, node_end),
            decimal_value(pattern_line_field(document, line, 9)),
            level + 1
        )
        if selfhost_c11_failed(body) {
            return body
        }
        let binding = pattern_line_field(document, line, 7)
        return pattern_line_field(body, 0, 0) + "|0\n" +
        selfhost_records(first) + selfhost_records(second) + pad +
        "for (int64_t k_b" + binding + " = k_n" + to_text(low) +
        "; k_b" + binding + " < k_n" + to_text(high) + "; ++k_b" +
        binding + ") {\n" + selfhost_records(body) + pad + "}\n"
    }
    return selfhost_c11_error(
        3,
        "error[E2S10]: unsupported selfhost-C11 statement `" + kind + "`"
    )
}

# Emit the statements whose spans lie inside one block scope.
fn selfhost_c11_block(
    document: Text,
    context: Text,
    line: Int,
    scope_id: Int,
    level: Int
) -> Text {
    let scope_start = selfhost_c11_scope_field(document, scope_id, 4)
    let scope_end = selfhost_c11_scope_field(document, scope_id, 5)
    if len(scope_start) == 0 {
        return selfhost_c11_error(
            1,
            "error[E2S35]: selfhost-C11 scope reference is out of range"
        )
    }
    let range_end = decimal_value(pattern_line_field(context, 0, 1))
    let mut walk = line
    let mut emitted = ""
    let mut terminal = "0"
    let mut walking = true
    while walking && walk < range_end {
        if !starts_with(text_slice(document, walk, range_end), "node|") {
            walking = false
        } else {
            let start = decimal_value(pattern_line_field(document, walk, 3))
            if start < decimal_value(scope_start) ||
               start >= decimal_value(scope_end) {
                walking = false
            } else {
                let statement = selfhost_c11_statement(
                    document,
                    context,
                    walk,
                    level
                )
                if selfhost_c11_failed(statement) {
                    return statement
                }
                walk = decimal_value(pattern_line_field(statement, 0, 0))
                terminal = pattern_line_field(statement, 0, 1)
                emitted = emitted + selfhost_records(statement)
            }
        }
    }
    return to_text(walk) + "|" + terminal + "\n" + emitted
}

# Typed parameter list of one function scope: packs `ARITY` over the
# comma-joined C parameters, or an internal error.
fn selfhost_c11_signature(document: Text, function_scope: Int) -> Text {
    let size = len(document)
    let mut line = 0
    let mut arity = 0
    let mut parameters = ""
    while line < size {
        if starts_with(text_slice(document, line, size), "binding|") &&
           decimal_value(pattern_line_field(document, line, 2)) ==
           function_scope {
            let symbol = decimal_value(pattern_line_field(document, line, 3))
            if selfhost_c11_symbol_field(document, symbol, 2) ==
               "parameter" {
                let key = selfhost_c11_type_key(
                    document,
                    decimal_value(
                        selfhost_c11_symbol_field(document, symbol, 4)
                    )
                )
                if len(selfhost_c11_c_type(key)) == 0 {
                    return selfhost_c11_error(
                        3,
                        "error[E2S10]: unsupported selfhost-C11 type `" +
                        key + "`"
                    )
                }
                if arity > 0 {
                    parameters = parameters + ", "
                }
                let mut spelled = "bool "
                if key == "text" {
                    spelled = "const char *"
                } else if key == "int" {
                    spelled = "int64_t "
                } else if key == "list-text" {
                    spelled = "kofun_text_list "
                }
                parameters = parameters + spelled + "k_b" +
                pattern_line_field(document, line, 1)
                arity = arity + 1
            }
        }
        line = selfhost_c11_line_end(document, line) + 1
    }
    return to_text(arity) + "\n" + parameters
}

# One function record: packs the next record offset over the emitted C
# body (the driver assembles prototypes from the same signature).
fn selfhost_c11_function(
    document: Text,
    record: Int,
    range_end: Int,
    casts: Text
) -> Text {
    let symbol_id = decimal_value(pattern_line_field(document, record, 2))
    let symbol_line = selfhost_c11_record(document, "symbol", symbol_id)
    if symbol_line < 0 {
        return selfhost_c11_error(
            1,
            "error[E2S35]: selfhost-C11 function has no symbol"
        )
    }
    let name = selfhost_c11_symbol_field(document, symbol_id, 3)
    let result_key = selfhost_c11_result_key(document, symbol_id)
    let signature = selfhost_c11_signature(
        document,
        decimal_value(pattern_line_field(document, record, 3))
    )
    if selfhost_c11_failed(signature) {
        return signature
    }
    let arity = decimal_value(pattern_line_field(signature, 0, 0))
    let mut fail_return = ""
    if name == "main" {
        fail_return = "1"
    } else if result_key == "int" {
        fail_return = "INT64_C(0)"
    } else if result_key == "bool" {
        fail_return = "false"
    } else if result_key == "text" {
        fail_return = "\"\""
    } else if result_key != "void" {
        return selfhost_c11_error(
            3,
            "error[E2S10]: unsupported selfhost-C11 type `" + result_key +
            "`"
        )
    }
    let mut opened = ""
    if name == "main" {
        if arity != 0 {
            return selfhost_c11_error(
                1,
                "error[E2S15]: selfhost-C11 `main` takes no parameters"
            )
        }
        opened = "int main(int argc, char **argv) {\n" +
        "    kofun_runtime_argc = argc > 0 ? argc - 1 : 0;\n" +
        "    kofun_runtime_argv = argc > 0 ? argv + 1 : argv;\n" + casts
    } else {
        let mut result_type = "void "
        if result_key == "text" {
            result_type = "const char *"
        } else if result_key == "int" {
            result_type = "int64_t "
        } else if result_key == "bool" {
            result_type = "bool "
        }
        let mut parameters = selfhost_records(signature)
        if arity == 0 {
            parameters = "void"
        }
        opened = "static " + result_type + "kofun_fn_" + name + "(" +
        parameters + ") {\n"
    }
    let mut is_main = "0"
    if name == "main" {
        is_main = "1"
    }
    let context = to_text(selfhost_c11_line_end(document, record) + 1) +
    "|" + to_text(range_end) + "|" + is_main + "|" + fail_return
    let mut walk = selfhost_c11_line_end(document, record) + 1
    let mut body = ""
    let mut terminal = "0"
    while walk < range_end {
        let statement = selfhost_c11_statement(document, context, walk, 1)
        if selfhost_c11_failed(statement) {
            return statement
        }
        walk = decimal_value(pattern_line_field(statement, 0, 0))
        terminal = pattern_line_field(statement, 0, 1)
        body = body + selfhost_records(statement)
    }
    if terminal != "1" && result_key != "void" && name != "main" {
        return selfhost_c11_error(
            1,
            "error[E2S19]: selfhost-C11 function may complete without " +
            "returning a value: `" + name + "`"
        )
    }
    if name == "main" && terminal != "1" {
        body = body + "    return 0;\n"
    }
    return to_text(range_end) + "\n" + opened + body + "}\n\n"
}

# Prototype line for one non-main function.
fn selfhost_c11_prototype(document: Text, record: Int) -> Text {
    let symbol_id = decimal_value(pattern_line_field(document, record, 2))
    let name = selfhost_c11_symbol_field(document, symbol_id, 3)
    let result_key = selfhost_c11_result_key(document, symbol_id)
    let signature = selfhost_c11_signature(
        document,
        decimal_value(pattern_line_field(document, record, 3))
    )
    if selfhost_c11_failed(signature) {
        return signature
    }
    let mut result_type = "void "
    if result_key == "text" {
        result_type = "const char *"
    } else if result_key == "int" {
        result_type = "int64_t "
    } else if result_key == "bool" {
        result_type = "bool "
    }
    let mut parameters = selfhost_records(signature)
    if decimal_value(pattern_line_field(signature, 0, 0)) == 0 {
        parameters = "void"
    }
    return "static " + result_type + "kofun_fn_" + name + "(" +
    parameters + ");\n"
}

# Produce the whole generated C translation unit, or `error|EXIT|MESSAGE`.
fn selfhost_c11_document(document: Text) -> Text {
    if !starts_with(document, "schema|kofun.selfhost-hir/v1\n") {
        return selfhost_c11_error(
            1,
            "error[E2S35]: selfhost-C11 input is not a " +
            "kofun.selfhost-hir/v1 document"
        )
    }
    let source_line = text_find_from(document, "\nsource|", 0)
    if source_line < 0 {
        return selfhost_c11_error(
            1,
            "error[E2S35]: selfhost-C11 document has no source record"
        )
    }
    if !contains(document, "\nstatus|complete\n") {
        return selfhost_c11_error(
            1,
            "error[E2S35]: selfhost-C11 input must be a complete typed " +
            "document"
        )
    }
    let size = len(document)
    let mut casts = "    (void)kofun_failed;\n" +
    "    (void)kofun_error;\n" +
    "    (void)kofun_add;\n" +
    "    (void)kofun_sub;\n" +
    "    (void)kofun_mul;\n" +
    "    (void)kofun_neg;\n" +
    "    (void)kofun_floor_div;\n" +
    "    (void)kofun_floor_mod;\n"
    let mut main_count = 0
    let mut line = 0
    while line < size {
        if starts_with(text_slice(document, line, size), "function|") {
            let symbol =
                decimal_value(pattern_line_field(document, line, 2))
            if selfhost_c11_symbol_field(document, symbol, 3) == "main" {
                main_count = main_count + 1
            } else {
                casts = casts + "    (void)kofun_fn_" +
                selfhost_c11_symbol_field(document, symbol, 3) + ";\n"
            }
        }
        line = selfhost_c11_line_end(document, line) + 1
    }
    if main_count != 1 {
        return selfhost_c11_error(
            1,
            "error[E2S16]: selfhost-C11 program needs exactly one `main`"
        )
    }
    let mut prototypes = ""
    let mut bodies = ""
    line = 0
    while line < size {
        if starts_with(text_slice(document, line, size), "function|") {
            let mut range_end =
                selfhost_c11_line_end(document, line) + 1
            let mut scanning = true
            while scanning && range_end < size {
                if starts_with(
                       text_slice(document, range_end, size),
                       "function|"
                   ) {
                    scanning = false
                } else {
                    range_end =
                        selfhost_c11_line_end(document, range_end) + 1
                }
            }
            let symbol =
                decimal_value(pattern_line_field(document, line, 2))
            if selfhost_c11_symbol_field(document, symbol, 3) != "main" {
                let prototype = selfhost_c11_prototype(document, line)
                if selfhost_c11_failed(prototype) {
                    return prototype
                }
                prototypes = prototypes + prototype
            }
            let emitted = selfhost_c11_function(
                document,
                line,
                range_end,
                casts
            )
            if selfhost_c11_failed(emitted) {
                return emitted
            }
            bodies = bodies + selfhost_records(emitted)
            line = range_end
        } else {
            line = selfhost_c11_line_end(document, line) + 1
        }
    }
    let mut emitted =
    "/* Generated by kofun-stage2 --lower-selfhost-c11. */\n" +
    "/* Source: " + pattern_line_field(document, source_line + 1, 1) +
    " " + pattern_line_field(document, source_line + 1, 2) + " */\n\n" +
    selfhost_c11_prelude()
    if len(prototypes) > 0 {
        emitted = emitted + prototypes + "\n"
    }
    return "ok\n" + emitted + bodies
}

fn lower_selfhost_c11_file(input_path: Text, output_path: Text) -> Int {
    if input_path == output_path {
        print("error[E2S35]: selfhost-C11 input and output must be distinct")
        return 2
    }
    let document = read_text(input_path)
    let lowered = selfhost_c11_document(document)
    if selfhost_c11_failed(lowered) {
        print(pattern_line_field(lowered, 0, 2))
        return decimal_value(pattern_line_field(lowered, 0, 1))
    }
    write_text(output_path, selfhost_records(lowered))
    return 0
}

# The self-host compiler driver: one source-to-C command with no hidden
# Stage 1/2 fallback. The typed document is produced and lowered in
# memory; a rejected source prints its stable diagnostic and writes
# nothing.
fn selfhost_compile_file(
    input_path: Text,
    output_path: Text,
    digest: Text
) -> Int {
    if input_path == output_path {
        print("error[E2S35]: selfhost-compile input and output must be distinct")
        return 2
    }
    if !selfhost_valid_digest(digest) {
        print("error[E2S35]: selfhost-compile digest must be 64 lowercase hex")
        return 2
    }
    let source = read_text(input_path)
    let tokens = lex(source)
    if starts_with(tokens, "error[") {
        print(tokens)
        return 1
    }
    let result = selfhost_document(source, input_path, digest)
    if !starts_with(result, "complete\n") {
        print(selfhost_first_line(selfhost_records(result)))
        return 1
    }
    let lowered = selfhost_c11_document(selfhost_records(result))
    if selfhost_c11_failed(lowered) {
        print(pattern_line_field(lowered, 0, 2))
        return decimal_value(pattern_line_field(lowered, 0, 1))
    }
    write_text(output_path, selfhost_records(lowered))
    return 0
}

fn main() -> Int {
    let arguments = args()
    if len(arguments) == 5 && arguments[0] == "--compile-outcome" {
        return compile_file(
            arguments[1],
            arguments[2],
            arguments[3],
            arguments[4]
        )
    }
    if len(arguments) == 2 && arguments[0] == "--check-ownership" {
        if !check_ownership_file(arguments[1]) {
            return 1
        }
        return 0
    }
    if len(arguments) == 3 && arguments[0] == "--parse-patterns" {
        if !parse_patterns_file(arguments[1], arguments[2]) {
            return 1
        }
        return 0
    }
    if len(arguments) == 3 && arguments[0] == "--emit-scope-hir" {
        if !emit_scope_hir_file(arguments[1], arguments[2]) {
            return 1
        }
        return 0
    }
    if len(arguments) == 4 && arguments[0] == "--emit-selfhost-hir" {
        return emit_selfhost_hir_file(
            arguments[1],
            arguments[2],
            arguments[3]
        )
    }
    if len(arguments) == 3 && arguments[0] == "--lower-selfhost-c11" {
        return lower_selfhost_c11_file(arguments[1], arguments[2])
    }
    if len(arguments) == 4 && arguments[0] == "--selfhost-compile" {
        return selfhost_compile_file(
            arguments[1],
            arguments[2],
            arguments[3]
        )
    }
    if len(arguments) != 4 {
        print(
            "usage: kofun-stage2 INPUT.kofun OUTPUT.kofun OUTPUT.ir OUTPUT.tokens\n" +
            "       kofun-stage2 --compile-outcome INPUT.kofun OUTPUT.c OUTPUT.ir OUTPUT.tokens\n" +
            "       kofun-stage2 --check-ownership INPUT.kofun\n" +
            "       kofun-stage2 --parse-patterns INPUT.kofun OUTPUT.patterns\n" +
            "       kofun-stage2 --emit-scope-hir INPUT.kofun OUTPUT.scope-hir\n" +
            "       kofun-stage2 --emit-selfhost-hir INPUT.kofun OUTPUT.hir SOURCE-SHA256\n" +
            "       kofun-stage2 --lower-selfhost-c11 INPUT.hir OUTPUT.c\n" +
            "       kofun-stage2 --selfhost-compile INPUT.kofun OUTPUT.c SOURCE-SHA256"
        )
        return 2
    }
    if compile_file(
        arguments[0],
        arguments[1],
        arguments[2],
        arguments[3]
    ) != 0 {
        return 1
    }
    return 0
}
